---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallStrip from '../components/CallStrip.astro';
---

<BaseLayout
  title="Emergency Plumber Wirral & Local Plumbers | 24/7, From £120"
  description="Emergency plumber and local plumbers across the Wirral, 24/7. Burst pipes, leaks and boiler breakdowns in every CH postcode. No call-out fee. From £120."
>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "Plumber"],
    "name": "Liverpool Emergency Plumber",
    "image": "https://liverpoolemergencyplumber.co.uk/ideal-plumbing-logo.png",
    "url": "https://liverpoolemergencyplumber.co.uk/emergency-plumber-wirral",
    "telephone": "+441515580334",
    "email": "emergencyplumberliverpool@gmail.com",
    "priceRange": "££",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "29 Park Road",
      "addressLocality": "Kirkby",
      "addressRegion": "Merseyside",
      "postalCode": "L32 2AL",
      "addressCountry": "GB"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "areaServed": [
      { "@type": "Place", "name": "Wirral" },
      { "@type": "Place", "name": "Birkenhead" },
      { "@type": "Place", "name": "Wallasey" },
      { "@type": "Place", "name": "West Kirby" },
      { "@type": "Place", "name": "Heswall" },
      { "@type": "Place", "name": "Bebington" },
      { "@type": "Place", "name": "Bromborough" },
      { "@type": "Place", "name": "Moreton" },
      { "@type": "Place", "name": "Hoylake" },
      { "@type": "Place", "name": "Neston" }
    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Emergency Plumber Wirral",
    "description": "24/7 emergency plumber across the Wirral peninsula. All CH postcodes CH41 to CH64. Gas Safe registered. Fast response. Fixed prices from £120 for the first hour. Burst pipes, leaks, boiler breakdowns, gas leaks, no hot water. Gas Safe registered",
    "provider": { "@id": "https://liverpoolemergencyplumber.co.uk/#business" },
    "areaServed": { "@type": "Place", "name": "Wirral, CH41-CH64" },
    "hoursAvailable": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "offers": [
      { "@type": "Offer", "name": "Weekday Emergency Plumber Wirral", "price": "120", "priceCurrency": "GBP", "description": "Monday to Friday 9am to 4pm. Price for the first hour. No call-out fee." },
      { "@type": "Offer", "name": "Evening and Weekend Emergency Plumber Wirral", "price": "150", "priceCurrency": "GBP", "description": "Weekdays after 4pm, nights and weekends. Price for the first hour. No call-out fee." },
      { "@type": "Offer", "name": "Bank Holiday Emergency Plumber Wirral", "price": "180", "priceCurrency": "GBP", "description": "Bank holidays. Price for the first hour. No call-out fee." }
    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How quickly can you reach me on the Wirral?", "acceptedAnswer": { "@type": "Answer", "text": "We come out fast across the Wirral peninsula. Birkenhead, Wallasey and Bebington are usually the quickest to reach. West Kirby, Heswall and Neston are around 35 to 40 minutes. We know every route on the peninsula." } },
      { "@type": "Question", "name": "What CH postcodes do you cover on the Wirral?", "acceptedAnswer": { "@type": "Answer", "text": "We cover all Wirral postcodes including CH41, CH42, CH43, CH44, CH45, CH46, CH47, CH48, CH60, CH61, CH62, CH63, CH64 and CH65. From Birkenhead town centre and Wallasey to Heswall, West Kirby, Bebington, Bromborough and Neston. If you are on the Wirral peninsula, we cover you." } },
      { "@type": "Question", "name": "How much does an emergency plumber cost on the Wirral?", "acceptedAnswer": { "@type": "Answer", "text": "£120 for the first hour on weekdays 9am to 4pm. £150 for the first hour on weekday evenings, nights and weekends. £180 for the first hour on bank holidays. Parts at cost. Written quote before work begins." } },
      { "@type": "Question", "name": "Do you cover Heswall and West Kirby?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We cover all of the Wirral peninsula including Heswall CH60, West Kirby CH48, Hoylake CH47 and Neston CH64. Response times to these western and southern areas are around 35 to 40 minutes from our Kirkby base." } },
      { "@type": "Question", "name": "Who will come to my home on the Wirral?", "acceptedAnswer": { "@type": "Answer", "text": "One of our trusted, fully trained engineers, day or night. Gas work is always done by a Gas Safe registered engineer." } },
      { "@type": "Question", "name": "Can you work on unvented cylinders in larger Wirral homes?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Our engineers hold G3 training for unvented cylinder work. This is needed for the larger and more complex plumbing systems common in Heswall, West Kirby, Caldy and other affluent parts of the Wirral. Many bigger homes on the peninsula have high-spec systems that need this training. We have it." } },
      { "@type": "Question", "name": "Do you work on Port Sunlight listed buildings?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Port Sunlight is a conservation area with around 900 Grade II listed homes built for Lever Brothers soap workers from 1888 onwards. We work on these homes often. Our engineers know what is sensitive about working on listed buildings and what can be done without listed building consent under the Local Listed Building Consent Order." } },
      { "@type": "Question", "name": "Do you work on Birkenhead Victorian terraces?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We work on Victorian and Edwardian terraced homes in Birkenhead, Rock Ferry, Tranmere and Oxton often. Our engineers know gravity-fed systems, aged copper pipework and the layouts typical of Cammell Laird shipyard worker housing from this era. We carry the right parts for older system types on the van." } },
      { "@type": "Question", "name": "Do you handle Wirral landlord gas safety certificates?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We provide CP12 gas safety certificates from £100, same day available across all Wirral CH postcodes. Combined boiler service and CP12 from £199. We work with both individual landlords and letting agents across Birkenhead, Wallasey, Bebington, Bromborough and all Wirral areas." } }
    ]
  }
  </script>

  <!-- HERO -->
