  areasText="The same prices apply across Liverpool, the Wirral and St Helens."
  areas={[
    { href: '/gas-safety-certificate-liverpool', label: 'Liverpool' },
    { href: '/gas-safety-certificate-wirral', label: 'Wirral' },
