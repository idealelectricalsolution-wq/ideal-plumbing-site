    { href: '/boiler-installation-formby', title: 'Boiler installation Formby', text: 'New boiler from £2,195, free survey' },
    { href: '/hot-water-cylinders-formby', title: 'Hot water cylinders Formby', text: 'Unvented cylinders from £1,450, G3 qualified' },
    { href: '/emergency-plumber-formby', title: 'Emergency plumber Formby', text: 'From £120 for the first hour, no call-out fee' },
  ]}
  finalTitle="Book your Formby gas safety certificate"
  finalText="£100 including VAT. Certificate emailed the same day, ready for your tenant or solicitor."
