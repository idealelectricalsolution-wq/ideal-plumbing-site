  packages={packages}
  pkNote="Prices cover boilers, gas cookers, range cookers and hobs. Gas fires are not included; we can disconnect and cap one safely. Any repair is priced before we do it."
  factsTitle="Formby gas safety certificates at a glance"
  facts={[
    ['Price', '£100 for up to two appliances, usually the boiler and hob, £20 per extra appliance after two. With a boiler service: £199.'],
    ['Time', 'Usually under an hour. Certificate emailed the same day.'],
    ['Covers', 'Boilers, gas cookers and hobs. Not gas fires.'],
    ['Who needs it', 'Landlords by law, every 12 months. Sellers and buyers often want one too.'],
    ['Who', 'Gas Safe registered engineers, part of our team led by James.'],
    ['Area', 'Formby and Freshfield L37, plus Hightown, Ainsdale, Crosby and Maghull.'],
  ]}
  toc={[
    ['selling', 'Selling or buying in Formby'],
