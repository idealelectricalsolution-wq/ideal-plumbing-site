---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/gas-safety-certificate-formby';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'cp12', tier: 'Landlords, buyers, sellers', name: 'Gas safety certificate (CP12)', price: '£100', unit: 'up to 2 appliances, inc VAT',
    points: ['Each extra appliance after two: £20', 'Boiler and gas hob: £100 in total', 'Certificate emailed the same day'] },
  { id: 'combined', tier: 'Best value', popular: true, name: 'Gas safety certificate + boiler service', price: '£199', unit: 'one visit, inc VAT',
    points: ['Save £21 on booking them apart', 'Keeps the boiler warranty valid', 'Both records emailed the same day'] },
  { id: 'portfolio', tier: 'Landlords and agents', name: '3 or more properties', price: '£80', unit: 'per certificate, inc VAT',
    points: ['Save £20 on every certificate', 'We arrange access with tenants', 'Renewal dates tracked for you'] },
];

const faqs = [
  { q: 'Is a gas safe certificate the same as a gas safety certificate?', a: 'Yes. People call it a gas safe certificate, a landlord gas safety record or a CP12. They all mean the same yearly check, done by a Gas Safe registered engineer. In Formby ours costs £100 for up to two appliances.' },
  { q: 'How much is a gas safety certificate in Formby?', a: 'It is £100 including VAT for up to two gas appliances, usually the boiler and hob, so a boiler and a gas hob come to £100. Each extra appliance is £20. A certificate and a boiler service together are £199.' },
  { q: 'Should I get a gas safety certificate before I sell my Formby house?', a: 'It is not a legal must for a home you live in. But many buyers and their solicitors ask for one. Having it ready can stop a late question holding up the sale.' },
  { q: 'Can I get a gas safety check before I buy in Formby?', a: 'Yes, with the seller\'s permission to enter. We check the boiler, gas cooker and hob and give you the results in writing. A homebuyer survey does not test the gas like this.' },
  { q: 'Do you cover all of L37?', a: 'Yes. We cover Formby and Freshfield in L37, plus Hightown L38, Ainsdale PR8, Crosby L23, and Maghull and Lydiate L31. The price is the same, with no call-out fee.' },
  { q: 'My house has a range cooker and a gas hob. Is that extra?', a: 'The £100 price covers two appliances, so your boiler and gas hob are both included. The range cooker is £20 more. We check them all in one visit, on one certificate.' },
  { q: 'Does the gas fire need checking?', a: 'If you are a landlord and you supply the gas fire, it must be on the certificate. We do not check gas fires. We can disconnect and cap it safely, or it must be checked by an engineer registered for gas fires.' },
  { q: 'Can I renew early without losing months?', a: 'Yes. If the check is done up to 2 months before the old certificate runs out, the new one keeps the old expiry date.' },
  { q: 'How long does it take?', a: 'Most homes take under an hour. A larger house with several gas appliances can take a little longer.' },
  { q: 'Can I get a certificate today?', a: 'Often, yes, when we have a free slot. Call 0151 558 0334 to check. The certificate is emailed the same day, ready for your solicitor or tenant.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Every check is done by our Gas Safe registered engineers. You can ask to see the Gas Safe ID card on the day.' },
];
---

<ServiceGuide
  url={URL_}
  title="Gas Safety Certificate Formby | Landlords & Sellers From £100"
  description="Gas safety certificate (CP12) in Formby L37 from £100 inc VAT. For landlords, buyers and sellers. CP12 + boiler service £199. Gas Safe registered, emailed the same day. Call 0151 558 0334."
  h1="Gas Safety Certificate Formby"
  badge="CP12 for landlords, buyers and sellers · L37"
  intro="A gas safety certificate (CP12) in Formby from £100 including VAT. Our Gas Safe registered engineers check your boiler, gas cooker and hob, and email the certificate the same day. Ready for your tenant, letting agent or solicitor."
  stats={[['£100', 'CP12, inc VAT'], ['Same day', 'Certificate emailed']]}
  ticks={['Gas Safe Registered', 'Formby and Freshfield', 'Same-Day Certificate', '5.0 on Google']}
  pkTitle="Gas safety certificate prices in Formby"
