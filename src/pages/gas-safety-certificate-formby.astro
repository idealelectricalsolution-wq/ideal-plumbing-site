            <div style="background:var(--navy);color:#fff;border-radius:6px;padding:0.3rem 0.75rem;font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-weight:900;font-size:0.85rem;white-space:nowrap;flex-shrink:0;">LANDLORDS</div>
