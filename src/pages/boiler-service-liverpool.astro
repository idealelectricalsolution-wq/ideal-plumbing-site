---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/boiler-service-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

// Scope: gas boilers only. We do NOT service gas fires (we can disconnect and cap) or back boilers (we remove them and fit a combi).
// We do NOT sell a monthly boiler service plan or boiler cover. Pay per service, free yearly reminder.
const packages = [
  { id: 'service', tier: 'Homeowners', name: 'Annual boiler service', price: '£120', unit: 'fixed price, inc VAT',
    points: ['Combi, system and regular gas boilers', 'Benchmark service record filled in', 'Service record emailed the same day', 'Free reminder next year'] },
  { id: 'combined', tier: 'Best value', popular: true, name: 'Boiler service + gas safety certificate (CP12)', price: '£199', unit: 'one visit, inc VAT',
    points: ['Save £21 on booking them apart', 'Ideal for landlords', 'Boiler, gas cooker and hob checked', 'Both records emailed the same day'] },
  { id: 'cylinder', tier: 'Unvented hot water', name: 'Unvented cylinder service', price: '£120', unit: 'fixed price, inc VAT',
    points: ['For Megaflo-style mains pressure cylinders', 'Safety valves and expansion vessel checked', 'All our engineers are G3 qualified', 'Keeps the cylinder warranty valid'] },
];

const faqs = [
  { q: 'How much is a boiler service in Liverpool?', a: 'With us it is £120 including VAT, fixed price. There is no call-out fee. A boiler service and a landlord gas safety certificate together are £199. An unvented cylinder service is £120.' },
  { q: 'How long does a boiler service take?', a: 'Most boiler services take 45 to 60 minutes. A service and gas safety certificate together usually take about an hour and a quarter.' },
  { q: 'Do I need a boiler service every year?', a: 'Yes, if you want to keep the boiler safe and keep its warranty. Most boiler makers ask for a service every 12 months by a Gas Safe registered engineer. Miss one and a warranty claim can be refused.' },
  { q: 'Do you offer a boiler service plan?', a: 'No. We do not sell a monthly plan or boiler cover. You pay £120 when you have the service, and nothing in between. We send you a free reminder when the next one is due, so you do not miss a year.' },
  { q: 'Can you service any make of boiler?', a: 'We service gas boilers from all the main makers, including Worcester Bosch, Baxi, Vaillant, Ideal, Viessmann, Glow-worm and Potterton. If you are not sure about yours, call and tell us the make and model.' },
  { q: 'Do you service back boilers or gas fires?', a: 'No. We do not service back boilers. We can take an old back boiler out and fit a new combi in its place. We do not service gas fires either, but we can disconnect and cap one safely.' },
  { q: 'Can someone else let the engineer in?', a: 'Yes. A neighbour, a family member, a tenant or a letting agent can let us in. We just need someone there to open the door. We email the service record to you afterwards.' },
  { q: 'What if you find a fault?', a: 'We stop and explain it to you first. Then we give you a price for the repair. Nothing extra is done unless you say yes. Small repairs can often be done on the same visit.' },
  { q: 'When do I get my service record?', a: 'The same day. We fill in the Benchmark service record and email you a copy. Landlords get the gas safety certificate the same day as well.' },
  { q: 'Is a boiler service a legal requirement?', a: 'Not for home owners. For landlords, the law says gas appliances must be kept safe, with a gas safety check every 12 months. A yearly service is the usual way to keep the boiler in safe order, so most landlords book both.' },
  { q: 'Is a boiler service the same as a gas safety certificate?', a: 'No. A service cleans and checks the inside of the boiler, so it runs well and keeps its warranty. A gas safety certificate (CP12) checks that every gas appliance is safe. Landlords need the certificate by law. Both in one visit cost £199.' },
  { q: 'When is the best time to book?', a: 'Spring or summer, if you can. Autumn and winter are our busiest months, because that is when boilers break down. Booking early gets you a slot that suits you and finds faults before the cold weather.' },
  { q: 'Can I service my own boiler?', a: 'No. Work on a gas boiler must be done by a Gas Safe registered engineer. It is against the law to do it yourself, and it is not safe.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Every boiler service is done by our Gas Safe registered engineers. You can check any engineer on the Gas Safe Register before they start.' },
];
---

