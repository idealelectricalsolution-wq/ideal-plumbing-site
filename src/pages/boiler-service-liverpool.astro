      { "@type": "Offer", "name": "Annual Boiler Service Liverpool", "price": "120", "priceCurrency": "GBP", "availability": "https://schema.org/InStock", "priceValidUntil": "2026-12-31" },
      { "@type": "Offer", "name": "Boiler Service and Gas Safety Certificate Liverpool", "price": "175", "priceCurrency": "GBP", "availability": "https://schema.org/InStock", "priceValidUntil": "2026-12-31" },
