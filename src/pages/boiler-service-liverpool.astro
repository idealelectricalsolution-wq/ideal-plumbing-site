  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does an annual boiler service cost in Liverpool?", "acceptedAnswer": { "@type": "Answer", "text": "A standard annual boiler service in Liverpool costs £120 fixed price including the service certificate issued the same day. A combined boiler service and CP12 gas safety certificate costs £175 in a single visit. No call-out fee, no hidden extras. Call Liverpool Emergency Plumber on 0151 558 0334 to book." } },
      { "@type": "Question", "name": "Is an annual boiler service a legal requirement?", "acceptedAnswer": { "@type": "Answer", "text": "For homeowners, an annual boiler service is not a legal requirement but is strongly advised by the HSE, Gas Safe Register and all major makers as a condition of the warranty. For landlords, an annual gas safety inspection is a legal requirement under the Gas Safety Regulations 1998. Landlords must hold a valid CP12 certificate and provide a copy to tenants within 28 days of issue." } },
      { "@type": "Question", "name": "How often should I service my boiler?", "acceptedAnswer": { "@type": "Answer", "text": "Every year, without exception. All major boiler makers including Worcester Bosch and Vaillant need an annual boiler service by a Gas Safe registered engineer to keep the warranty valid. Missing one year can void a 10-year warranty entirely. A serviced boiler also runs up to 15% more efficiently than an unserviced one, saving money on energy bills every month." } },
      { "@type": "Question", "name": "Can I service my own boiler?", "acceptedAnswer": { "@type": "Answer", "text": "No. A gas boiler service must be carried out by a Gas Safe registered engineer. This is a legal requirement under the Gas Safety Regulations. Trying to service a gas boiler yourself is illegal and dangerous. Always verify your engineer's Gas Safe registration at gassaferegister.co.uk before any gas work." } },
      { "@type": "Question", "name": "What happens if a fault is found during the service?", "acceptedAnswer": { "@type": "Answer", "text": "If we find a fault or developing issue during the annual boiler service, we explain what we found and give you a written boiler repair quote before any work starts. We never start repair work without your approval. You are never charged for work you have not agreed to." } },
      { "@type": "Question", "name": "How long does a boiler service take in Liverpool?", "acceptedAnswer": { "@type": "Answer", "text": "A standard annual boiler service takes between 45 minutes and 1 hour. A combined service and gas safety certificate takes around 60 to 75 minutes. We confirm the appointment and work fast so you are not waiting around all day." } },
      { "@type": "Question", "name": "Does an annual boiler service protect my warranty?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Worcester Bosch, Vaillant, Ideal and Baxi all need an annual boiler service by a Gas Safe registered engineer and an updated Benchmark certificate to keep the maker warranty valid. Missing a single year can void a 10-year warranty entirely. We update the Benchmark record on every visit." } },
      { "@type": "Question", "name": "Do you provide the gas safety certificate landlords need?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Our combined annual boiler service and CP12 gas safety certificate costs £175 in a single visit. Both documents are emailed the same day. The CP12 is accepted by all Liverpool letting agents, Liverpool City Council HMO licensing and the NRLA. Landlords must hold a valid CP12 and provide a copy to tenants within 28 days." } },
      { "@type": "Question", "name": "Are you Gas Safe registered?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Liverpool Emergency Plumber is Gas Safe registered. Verify at gassaferegister.co.uk. All boiler services are carried out by Gas Safe registered engineers. All gas work is carried out by Gas Safe registered engineers." } }
    ]
  }
  </script>

