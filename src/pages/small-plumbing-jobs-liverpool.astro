---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/small-plumbing-jobs-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'outside-tap', tier: 'Supplied and fitted', popular: true, name: 'Outside tap fitted', price: '£145', unit: 'fixed price, inc VAT',
    points: ['Cold outside tap with a double check valve', 'Isolation valve fitted inside', 'Up to about 2m of pipe through the wall'] },
  { id: 'tap-swap', tier: 'You supply the tap', name: 'Tap swapped', price: '£110', unit: 'one tap, inc VAT',
    points: ['Kitchen mixer, basin mixer or a pair of bath taps', 'Second tap on the same visit: £50', 'Old tap taken away'] },
  { id: 'sink-swap', tier: 'Fit only', name: 'Kitchen sink swapped', price: '£225', unit: 'like for like, inc VAT',
    points: ['You supply the sink, tap and waste', 'Old sink taken out and taken away', 'Waste and supplies connected and tested'] },
  { id: 'gas-hob', tier: 'Gas Safe registered', name: 'Gas hob fitted', price: '£120', unit: 'you supply the hob, inc VAT',
    points: ['Connected to your existing gas point', 'Gas tightness test', 'Every burner checked'] },
];

const faqs = [
  { q: 'Do you do small plumbing jobs in Liverpool?', a: 'Yes. No job is too small. We swap taps, fit outside taps, fix toilets, swap sinks, fit gas hobs and change radiators. Most small jobs have a fixed price, including VAT.' },
  { q: 'Is there a minimum charge?', a: 'Fixed price jobs cost the price we quote, and nothing more. For repairs, we charge by time. The first hour is £120 on weekdays 9am to 4pm, and there is no call-out fee.' },
  { q: 'How much does a plumber charge for a small job?', a: 'With us, a tap swap is £110, an outside tap fitted is £145 and a gas hob fitted is £120. Repairs start with a first hour of £120 on weekdays. All prices include VAT.' },
  { q: 'Can you do several small jobs in one visit?', a: 'Yes, and it saves you money. Send us your list. We tell you the price before we start. Many small jobs fit inside our first hour of £120 on weekdays.' },
  { q: 'Do you charge a call-out fee?', a: 'No. There is no call-out fee on any job. You pay the fixed price or the time we spend, and we tell you the price first.' },
  { q: 'Can I supply my own tap, sink or toilet?', a: 'Yes. Most of our small job prices assume you supply the part. We fit it and take the old one away. Check the part fits your space before you buy. We are happy to help.' },
  { q: 'Can you supply the parts?', a: 'Yes. We can supply a tap at cost. Radiators and toilets can be supplied and fitted too. We tell you the price of any part before we fit it.' },
  { q: 'How soon can you come?', a: 'We book small jobs at a time that suits you. If water is leaking, call us now. For emergencies we typically arrive within 30 minutes.' },
  { q: 'Can a handyman fit my gas hob?', a: 'Only if they are Gas Safe registered. By law, anyone who works on gas must be on the Gas Safe Register. Our Gas Safe registered engineers fit gas hobs for £120.' },
  { q: 'Do you fit gas cookers?', a: 'Yes. A freestanding gas cooker connected to your existing gas point is £120. We test for leaks and check every burner before we leave.' },
  { q: 'Do you guarantee small jobs?', a: 'Yes. Every job has our 12-month workmanship guarantee, big or small. We also carry £2 million public liability insurance.' },
  { q: 'Do you plumb in washing machines or dishwashers?', a: 'Not as a job on its own. If we are already swapping your kitchen sink, we can price a plumb-in on top before we start.' },
  { q: 'Do you unblock drains?', a: 'No, we do not do blocked drains. We fix taps, toilets, pipes, sinks, radiators and gas appliances.' },
  { q: 'Do you cover my area?', a: 'We cover all of Liverpool, plus the Wirral, Sefton, Knowsley and St Helens. Small jobs cost the same price in every area.' },
];
---

