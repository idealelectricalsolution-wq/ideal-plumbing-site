  areasText="We cover all of Liverpool, the Wirral, Sefton, Knowsley and St Helens. The price is the same wherever you live."
  areas={[
    { href: '/emergency-plumber-city-centre', label: 'City Centre' },
    { href: '/emergency-plumber-wavertree', label: 'Wavertree' },
    { href: '/emergency-plumber-allerton', label: 'Allerton' },
