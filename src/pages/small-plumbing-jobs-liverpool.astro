    { href: '/kitchen-sink-replacement-liverpool', title: 'Kitchen sink replacement', text: '£225 like for like, fit only' },
    { href: '/gas-hob-installation-liverpool', title: 'Gas hob installation', text: '£120 by Gas Safe registered engineers' },
    { href: '/toilet-repair-liverpool', title: 'Toilet repair', text: 'First hour £120, no call-out fee' },
