---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/boiler-service-formby';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

// Scope: gas boilers only. We do NOT service gas fires (we can disconnect and cap) or back boilers (we remove them and fit a combi).
// We do NOT sell a monthly boiler service plan or boiler cover. Pay per service, free yearly reminder.
const packages = [
  { id: 'service', tier: 'Homeowners', name: 'Annual boiler service', price: '£120', unit: 'fixed price, inc VAT',
    points: ['Combi, system and regular gas boilers', 'System boilers at the same price', 'Service record emailed the same day', 'Free reminder next year'] },
  { id: 'pk-cylinder', tier: 'Unvented hot water', popular: true, name: 'Unvented cylinder service', price: '£120', unit: 'fixed price, inc VAT',
    points: ['For mains pressure cylinders', 'Can be done on the same visit as the boiler', 'All our engineers are G3 qualified', 'Keeps the cylinder warranty valid'] },
  { id: 'combined', tier: 'Landlords', name: 'Boiler service + gas safety certificate (CP12)', price: '£199', unit: 'one visit, inc VAT',
    points: ['Save £21 on booking them apart', 'Boiler, gas cooker and hob checked', 'Both records emailed the same day', 'We can arrange access with tenants'] },
];

const faqs = [
  { q: 'How much does a boiler service cost in Formby?', a: 'With us it is £120 including VAT, fixed price, with no call-out fee. System boilers cost the same as combis. An unvented cylinder service is £120. A boiler service and gas safety certificate together are £199.' },
  { q: 'Do you cover all of Formby and nearby villages?', a: 'Yes. We cover Formby, Freshfield and Little Altcar in L37, plus Hightown, Ince Blundell, Ainsdale, Crosby, Thornton, Maghull and Lydiate. The price is the same everywhere.' },
  { q: 'Do you service system boilers in Formby at the same price?', a: 'Yes. A system boiler service takes a little longer, because we also check the pump, zone valves and cylinder controls. The price is still £120.' },
  { q: 'Does my unvented cylinder need a yearly service?', a: 'Yes, if you want to keep its warranty. Cylinder makers ask for a yearly service by a qualified engineer. It is a separate job from the boiler service. We can do both on the same visit for £120 plus £120.' },
  { q: 'Are you G3 qualified for unvented cylinders?', a: 'Yes. All our engineers are G3 qualified, which is the qualification for working on unvented hot water cylinders.' },
  { q: 'How long does a boiler service take?', a: 'A combi takes 45 to 60 minutes. A system boiler takes 60 to 75 minutes. A system boiler and unvented cylinder together take about 75 to 90 minutes.' },
  { q: 'Does a service keep my boiler warranty valid?', a: 'Yes. Most boiler makers ask for a service every 12 months by a Gas Safe registered engineer. We fill in the Benchmark service record on every visit, which is what the maker will ask to see.' },
  { q: 'Do you provide CP12 certificates for Formby landlords?', a: 'Yes. A boiler service and CP12 in one visit cost £199. We can arrange access with your tenant or agent, and email both records the same day.' },
  { q: 'Do you offer a boiler service plan?', a: 'No. We do not sell a monthly plan or boiler cover. You pay when you have the service. We send a free reminder when the next one is due.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Every boiler service is done by our Gas Safe registered engineers. You can check any engineer on the Gas Safe Register before they start.' },
];
---

<ServiceGuide
  url={URL_}
  title="Boiler Service Formby | System Boilers & Cylinders From £120"
  description="Annual boiler service in Formby for £120 inc VAT, system boilers included. Unvented cylinder service £120 by G3 qualified engineers. Service + CP12 £199. Gas Safe registered, L37. Call 0151 558 0334."
  h1="Boiler Service Formby"
  badge="Gas Safe registered · G3 qualified · L37"
  intro="An annual boiler service in Formby for £120 including VAT, with no call-out fee. System boilers cost the same as combis. Got an unvented cylinder? Our G3 qualified engineers can service it on the same visit for £120."
  stats={[['£120', 'Boiler service, inc VAT'], ['£120', 'Unvented cylinder service']]}
  ticks={['Gas Safe Registered', 'G3 Qualified', 'No Call-Out Fee', '5.0 on Google']}
  pkTitle="Boiler service prices in Formby"
  pkLede="Fixed prices, including VAT. The same across Formby. No call-out fee."
  packages={packages}
  pkNote="Prices are for gas boilers. Boiler and cylinder on one visit: £120 plus £120. If we find a fault, we tell you the repair price before we do anything."
  factsTitle="Formby boiler servicing at a glance"
  facts={[
    ['Price', '£120 for a boiler service, combi or system. Unvented cylinder: £120.'],
    ['Time', '45 to 60 minutes for a combi. About 75 to 90 minutes for a system boiler and cylinder.'],
    ['Paper', 'Benchmark service record and cylinder record emailed the same day.'],
    ['Cylinders', 'All our engineers are G3 qualified for unvented cylinders.'],
    ['Who', 'Gas Safe registered engineers, part of our team led by James.'],
    ['Area', 'Formby and Freshfield L37, plus Hightown, Ainsdale and nearby Sefton.'],
  ]}
  toc={[
    ['which', 'Which service does your Formby home need?'],
    ['cylinder', 'Does my unvented cylinder need a service?'],
    ['checks', 'What does a boiler service include?'],
    ['how', 'How does the visit work?'],
    ['warranty', 'Will a service keep my warranty?'],
    ['signs', 'Signs your system needs a check now'],
    ['formby', 'Where around Formby?'],
  ]}
  reviews={['Brendan C', 'Edward M', 'David H', 'Ellie J']}
  faqs={faqs}
  areasTitle="Boiler servicing in other areas"
  areasText="The same prices apply across Liverpool, the Wirral and St Helens."
  areas={[
    { href: '/boiler-service-liverpool', label: 'Liverpool' },
    { href: '/boiler-service-wirral', label: 'Wirral' },
    { href: '/boiler-service-st-helens', label: 'St Helens' },
  ]}
  related={[
    { href: '/hot-water-cylinders-formby', title: 'Hot water cylinders Formby', text: 'Unvented cylinders from £1,450 fitted' },
    { href: '/gas-safety-certificate-formby', title: 'Gas safety certificate Formby', text: 'Landlord CP12 £100, or £199 with a service' },
    { href: '/boiler-installation-formby', title: 'Boiler installation Formby', text: 'Fixed-price packages from £2,195 fitted' },
    { href: '/power-flushing-formby', title: 'Power flushing Formby', text: 'Cold radiators and sludge, from £395' },
    { href: '/radiators-formby', title: 'Radiators Formby', text: 'New radiators supplied and fitted from £245' },
    { href: '/emergency-plumber-formby', title: 'Emergency plumber Formby', text: 'From £120 for the first hour, no call-out fee' },
  ]}
  finalTitle="Book your Formby boiler service"
  finalText="£120 including VAT. System boilers the same price. Cylinder service £120 on the same visit."
  serviceName="Boiler Service Formby"
  serviceType="Annual gas boiler service"
  serviceDesc="Annual gas boiler servicing across Formby L37 by Gas Safe registered engineers. Combi, system and regular boilers, plus unvented cylinder servicing by G3 qualified engineers. Records emailed the same day."
  areaServed={['Formby', 'Freshfield', 'Little Altcar', 'Hightown', 'Ince Blundell', 'Ainsdale', 'Crosby', 'Thornton', 'Maghull', 'Lydiate']}
>
  <section class="brx-sec brx-tint" id="which">
    <div class="brx-wrap">
      <h2>Which service does your Formby home need?</h2>
      <p class="brx-answer">It depends on your boiler. A combi needs the £120 boiler service. A system boiler with an unvented cylinder needs the boiler service and the £120 cylinder service.</p>
      <p>Many Formby homes are larger 3 to 5 bedroom houses. These often have a system boiler, a hot water cylinder and more than one heating zone. Some have underfloor heating too. A quick 45-minute combi service does not cover all of that.</p>
      <div class="brx-table-wrap">
        <table class="brx-table stk">
          <thead><tr><th>Your setup</th><th>What you need</th><th>Time</th><th>Price</th></tr></thead>
          <tbody>
            <tr><td data-label="Your setup"><strong>Combi boiler</strong></td><td data-label="What you need">Boiler service</td><td data-label="Time">45 to 60 min</td><td data-label="Price">£120</td></tr>
            <tr><td data-label="Your setup"><strong>System boiler, vented cylinder</strong></td><td data-label="What you need">Boiler service, with pump and zone valve checks</td><td data-label="Time">60 to 75 min</td><td data-label="Price">£120</td></tr>
            <tr><td data-label="Your setup"><strong>System boiler, unvented cylinder</strong></td><td data-label="What you need">Boiler service + cylinder service</td><td data-label="Time">75 to 90 min</td><td data-label="Price">£120 + £120</td></tr>
            <tr><td data-label="Your setup"><strong>Rented home</strong></td><td data-label="What you need">Boiler service + gas safety certificate</td><td data-label="Time">About 75 min</td><td data-label="Price">£199</td></tr>
          </tbody>
        </table>
      </div>
      <p>Not sure what you have? An unvented cylinder is usually a sealed metal tank with no cold water tank in the loft. Send us a photo and we will tell you.</p>
    </div>
  </section>

  <section class="brx-sec" id="cylinder">
    <div class="brx-wrap">
      <h2>Does my unvented cylinder need a service?</h2>
      <p class="brx-answer">Yes. Cylinder makers ask for a yearly service to keep the warranty. It is a separate job from the boiler service, and many Formby homeowners miss it.</p>
      <p>An unvented cylinder holds hot water at mains pressure. It has safety valves that stop the pressure and heat getting too high. These parts wear over time. The yearly service checks they still work.</p>
      <h3>What we check on the cylinder</h3>
      <ul class="sg-ticks">
        <li>Pressure relief valve and temperature relief valve</li>
        <li>Expansion vessel pressure</li>
        <li>Pressure reducing valve and inlet strainer</li>
        <li>Cylinder thermostat and immersion heater</li>
        <li>Discharge pipe route and signs of leaks</li>
      </ul>
      <p>All our engineers are G3 qualified for unvented cylinders. We can do the boiler and cylinder on the same visit, and email both records the same day. See <a href="/hot-water-cylinders-formby">hot water cylinders in Formby</a> if yours needs replacing.</p>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="checks">
    <div class="brx-wrap">
      <h2>What does a boiler service include?</h2>
      <p class="brx-answer">We take the cover off, clean and check the parts inside, and test that the boiler burns gas safely. System boilers get extra checks at no extra cost.</p>
      <div class="sg-cols">
        <div class="sg-box">
          <h3>Safety checks</h3>
          <ul class="sg-ticks">
            <li>Flue gas analysis, to prove the boiler burns gas cleanly</li>
            <li>Gas pressure and gas rate checked</li>
            <li>The flue checked, including the terminal outside</li>
            <li>Safety devices tested, so the boiler shuts down if it should</li>
            <li>Air supply and ventilation checked</li>
            <li>Your carbon monoxide alarm tested, if you have one</li>
          </ul>
        </div>
        <div class="sg-box">
          <h3>Inside the boiler</h3>
          <ul class="sg-ticks">
            <li>Burner and heat exchanger checked and cleaned</li>
            <li>Condensate trap cleaned</li>
            <li>Seals and gaskets checked for wear</li>
            <li>System pressure and expansion vessel checked</li>
            <li>Inhibitor level checked and topped up if low</li>
            <li>Magnetic filter cleaned, if you have one</li>
          </ul>
        </div>
      </div>
      <h3>System boilers also get</h3>
      <ul class="sg-ticks">
        <li>Pump and zone valves checked</li>
        <li>Cylinder thermostat and heating controls tested, zone by zone</li>
      </ul>
      <p>Near the coast, salt air can rust the flue terminal outside. We check it on every service. To finish, we run the heating and hot water, fill in the Benchmark record and email you a copy.</p>
    </div>
  </section>

  <section class="brx-sec" id="how">
    <div class="brx-wrap">
      <h2>How does the visit work?</h2>
      <p class="brx-answer">You book a time, we service the boiler (and cylinder, if you have one), and you get the records by email the same day.</p>
      <ol class="sg-steps">
        <li><strong>Book (2 minutes).</strong> Call or <a href="/get-started">book online</a>. Tell us if you have a system boiler or unvented cylinder, so we allow enough time.</li>
        <li><strong>We arrive.</strong> A Gas Safe registered, G3 qualified engineer comes at the agreed time. You can ask to see the Gas Safe card.</li>
        <li><strong>The service (45 to 90 minutes).</strong> We work through the full checklist. We use dust sheets and tidy up after.</li>
        <li><strong>What we found.</strong> We tell you how everything is doing. If something needs fixing, you get a price first. You decide.</li>
        <li><strong>Your records.</strong> We email the Benchmark record, and the cylinder record if done, the same day.</li>
        <li><strong>Next year.</strong> We send a free reminder when the next service is due.</li>
      </ol>
      <div class="brx-cta">
        <p><strong>Boiler or cylinder due a service in Formby?</strong> Call and we will find you the next free slot.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="warranty">
    <div class="brx-wrap">
      <h2>Will a service keep my boiler warranty valid?</h2>
      <p class="brx-answer">Yes. Most boiler makers want a service every 12 months by a Gas Safe registered engineer, written in the Benchmark record. We do both on every visit.</p>
      <p>Your boiler came with a Benchmark checklist, usually in the back of the manual. Each service goes into it. If the boiler breaks down under warranty, the maker can ask to see it. Miss a year and they can refuse a claim.</p>
      <p>We service all the main makes, including Worcester Bosch, Vaillant, Ideal, Baxi, Viessmann, Glow-worm and Potterton. Landlord? Book the service and gas safety certificate together for £199. See <a href="/gas-safety-certificate-formby">gas safety certificates in Formby</a>.</p>
    </div>
  </section>

  <section class="brx-sec" id="signs">
    <div class="brx-wrap">
      <h2>Does your heating system need a check now?</h2>
      <p class="brx-answer">If you see any of these signs, do not wait for the yearly service. Call us and we will take a look.</p>
      <ul class="sg-ticks">
        <li>Some rooms or zones heat up but others stay cold. A zone valve may be sticking.</li>
        <li>Hot water pressure has dropped upstairs. The cylinder's pressure reducing valve may be failing.</li>
        <li>Water is coming out of the cylinder's discharge pipe. Call us the same day.</li>
        <li>Banging, gurgling or kettling noises.</li>
        <li>The boiler keeps locking out, or the pressure keeps dropping.</li>
        <li>It has been more than 12 months since the last service.</li>
      </ul>
      <div class="brx-danger"><p><strong>Yellow or orange flame, or a carbon monoxide alarm going off?</strong> Turn the boiler off if you can, open the windows and get everyone outside. Call the National Gas Emergency Service on <a href="tel:0800111999">0800 111 999</a> first. Then ring us.</p></div>
      <p>If the boiler has stopped working, you need a repair, not a service. Call our <a href="/emergency-plumber-formby">emergency plumber in Formby</a>.</p>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="formby">
    <div class="brx-wrap">
      <h2>Where around Formby do you service boilers?</h2>
      <p class="brx-answer">All of Formby and the Sefton coast around it. The price is the same everywhere.</p>
      <div class="sg-cols">
        <div class="sg-box">
          <h3>Formby and Freshfield</h3>
          <p>Formby, Freshfield and Little Altcar L37. Many larger homes with system boilers and unvented cylinders.</p>
        </div>
        <div class="sg-box">
          <h3>Sefton coast villages</h3>
          <p>Hightown L38, Ince Blundell and Ainsdale PR8. Smaller homes here are often on combis. We check flues for salt damage.</p>
        </div>
        <div class="sg-box">
          <h3>Nearby</h3>
          <p>Crosby and Thornton L23, Maghull and Lydiate L31.</p>
        </div>
      </div>
    </div>
  </section>
</ServiceGuide>
