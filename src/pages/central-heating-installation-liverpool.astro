---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/central-heating-installation-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'two-bed', tier: 'Flats and small homes', name: '2-bed home', price: '£4,495', from: true, unit: 'full system, inc VAT',
    points: ['New A-rated combi boiler', 'New radiators with TRVs', 'All new pipework', 'Smart or programmable controls', 'Magnetic filter and inhibitor'] },
  { id: 'three-bed', tier: 'Family homes', popular: true, name: '3-bed home', price: '£5,295', from: true, unit: 'full system, inc VAT',
    points: ['New A-rated combi boiler', 'New radiators with TRVs', 'All new pipework', 'Smart or programmable controls', 'System cleaned to BS 7593', 'Old system taken away'] },
  { id: 'four-bed', tier: 'Bigger homes', name: '4-bed home', price: '£6,295', from: true, unit: 'full system, inc VAT',
    points: ['Boiler sized for a bigger home', 'New radiators with TRVs', 'All new pipework', 'Smart or programmable controls', 'Benchmark and gas safety checks'] },
  { id: 'combi-conversion', tier: 'Tank to combi', name: 'Combi conversion', price: '£2,890', from: true, unit: 'fitted, inc VAT',
    points: ['Cylinder system changed to a combi', 'Hot water cylinder and loft tanks removed', 'Keeps your radiators if they are sound', 'Usually 1 to 2 days'] },
];

const faqs = [
  { q: 'How much does central heating installation cost in Liverpool?', a: 'With us, a full new system starts from £4,495 for a 2-bed home, £5,295 for a 3-bed home and £6,295 for a 4-bed home, including VAT. A combi conversion starts from £2,890. Every price covers the boiler, radiators, pipework, controls and paperwork. Your final fixed price comes after a free survey.' },
  { q: 'How long does central heating installation take in Liverpool?', a: 'A full system usually takes 3 to 5 days. A small flat can be quicker, and a big home with lots of radiators can take longer. A combi conversion takes 1 to 2 days. We agree the dates with you at the survey.' },
  { q: 'What is the difference between a boiler installation and a central heating installation?', a: 'A boiler installation replaces just the boiler and keeps your radiators and pipes. It starts from £2,195. A central heating installation is the whole system: boiler, radiators, pipework and controls. It starts from £4,495. The free survey tells you which one your home needs.' },
  { q: 'Will you lift my floors?', a: 'We lift some floorboards to run the pipes, then put them back. We use dust sheets and clean up each day. We plan pipe routes at the survey to keep disruption low.' },
  { q: 'Can I keep my existing radiators?', a: 'Often, yes, if they are in good condition and the right size for the room. We check each one at the survey. Keeping sound radiators can lower the price. Old or sludged radiators are usually worth replacing.' },
  { q: 'Do I need a power flush with new central heating?', a: 'Not if every pipe and radiator is new. A new system is still cleaned and dosed with inhibitor, as BS 7593 asks. If we keep old radiators or pipes, a power flush is usually needed first. Added to a new boiler, a flush is £350.' },
  { q: 'What warranty do I get?', a: 'The boiler comes with a maker\'s warranty of 7 to 12 years, depending on the model. We register it for you. Our own work has a 12-month workmanship guarantee.' },
  { q: 'Do I need Building Regulations approval?', a: 'A new boiler must be notified to Building Control. We do this through the Gas Safe Register. You then get a Building Regulations Compliance Certificate by post. Keep it with your Benchmark checklist.' },
  { q: 'Can you fit central heating in a Victorian house?', a: 'Yes. Many Liverpool homes are Victorian or Edwardian, with solid walls and tight floor spaces. We plan pipe routes at the survey to keep pipes out of sight where we can and protect period features.' },
  { q: 'Do you fit central heating for landlords?', a: 'Yes. We fit systems in rented homes and can work with your tenants or agent. Rented homes need a gas safety certificate every year, which we do from £100.' },
  { q: 'Which boilers do you fit?', a: 'We fit Baxi, Worcester Bosch and Vaillant boilers. See our boiler installation page for each boiler, its price and its warranty.' },
  { q: 'Do you offer finance?', a: 'No, we do not offer finance. We give you a fixed written price, so you know the full cost before we start.' },
  { q: 'Is the survey really free?', a: 'Yes. We visit, look at your home and give you a fixed written price. There is no charge and no pressure to go ahead.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. All gas work is done by our Gas Safe registered engineers. You can check any engineer on the Gas Safe Register before they start.' },
];
---

