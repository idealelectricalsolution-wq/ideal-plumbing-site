  faqs={faqs}
  areasTitle="Where do you install central heating?"
  areasText="Every Liverpool postcode, plus the Wirral, St Helens, Formby and the rest of Sefton and Knowsley."
  areas={[
    { href: '/central-heating-installation-wirral', label: 'Wirral' },
    { href: '/central-heating-installation-st-helens', label: 'St Helens' },
