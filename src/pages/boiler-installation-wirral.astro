---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/boiler-installation-wirral';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

// Same five packages and prices as /boiler-installation-liverpool.
const boilers = [
  { id: 'pk-essential', tier: 'Essential', name: 'Baxi 600 Combi 2', img: 'baxi-600-combi-2', price: '£2,195', size: '24kW or 30kW', flow: '10.2 to 12.2', warranty: '7 years', best: 'Flats, small terraces and rental homes',
    points: ['Stainless steel heat exchanger', 'Simple, reliable and easy to service', 'Our lowest price for a named brand'] },
  { id: 'pk-value', tier: 'Value', name: 'Baxi 800 Combi 2', img: 'baxi-800-combi-2', price: '£2,495', size: '24kW or 30kW', flow: '10.2 to 12.2', warranty: '10 years', best: '2 to 3 bed homes, if you are staying put',
    points: ['The same boiler as the Baxi 600', 'Magnetic filter in the box', '3 more years of cover for £300 more'] },
  { id: 'pk-popular', tier: 'Most popular', popular: true, name: 'Worcester Bosch Greenstar 4000', img: 'worcester-greenstar-4000', price: '£2,695', size: '25kW or 30kW', flow: '12.3 (30kW)', warranty: 'Up to 10 years', best: 'Most 2 to 4 bed homes',
    points: ['A trusted brand with easy-to-get parts', 'Quiet, at 45dB', 'Ticks over gently on mild days, so it switches on and off less'] },
  { id: 'pk-premium', tier: 'Premium', name: 'Vaillant ecoTEC plus', img: 'vaillant-ecotec-plus', price: '£2,995', size: '26kW or 32kW', flow: '10.6 to 13.0', warranty: 'Up to 10 years', best: 'Busier homes and two bathrooms',
    points: ['More hot water at each size', 'Quality German brand', 'Works with Vaillant smart controls'] },
  { id: 'pk-flagship', tier: 'Flagship', name: 'Worcester Bosch Greenstar 8000+ Style', img: 'worcester-greenstar-8000-style', imgAlt: 'Worcester Bosch Greenstar 8000 Style boiler in gloss black', price: '£3,295', size: '32kW', flow: '13.7', warranty: 'Up to 12 years', best: 'Larger homes, or a boiler on show in the kitchen',
    points: ['Gloss black with a colour touchscreen', 'Optional auto-fill tops up its own pressure', 'The longest cover in our range'] },
];
const packages = boilers.map((b) => ({
  id: b.id, tier: b.tier, name: b.name, price: b.price, popular: b.popular, unit: 'fully fitted, inc VAT',
  img: `boilers/${b.img}`, imgAlt: b.imgAlt || `${b.name} combi boiler`,
  specs: [['Size', b.size], ['Hot water', `${b.flow} litres a minute`], ['Warranty', b.warranty], ['Best for', b.best]] as [string, string][],
  points: b.points,
}));

const extras = [
  ['Next size up (for example 30kW to 36kW)', '+£200'],
  ['Move the boiler within the same room', '+£450'],
  ['Move the boiler to another room on the same floor', '+£750'],
  ['Move the boiler to another floor, the loft or the garage', '+£850'],
  ['Swap a tank system (regular or system boiler) for a combi', '+£695'],
  ['Power flush instead of a chemical clean', '£350'],
  ['Back boiler removal, vertical flue or a gas pipe upgrade', 'Priced at the free survey'],
];

const faqs = [
  { q: 'How much does a new boiler cost on the Wirral?', a: 'Our five fixed-price combi packages run from £2,195 for a Baxi 600 to £3,295 for a Worcester Bosch Greenstar 8000+ Style, fully fitted and including VAT. Our most popular is the Worcester Bosch Greenstar 4000 at £2,695. System and regular boilers are priced at a free survey.' },
  { q: 'Do you cover all CH postcodes?', a: 'Yes. We fit boilers across the whole Wirral, from Birkenhead and Wallasey (CH41 to CH45) to Hoylake and West Kirby (CH47, CH48) and Heswall, Neston and Bromborough (CH60 to CH64). The prices are the same as in Liverpool.' },
  { q: 'Can I have a combi in my Birkenhead or Wallasey terrace?', a: 'Often, but not always. Some older terraces in CH41 to CH45 have low mains pressure. A combi then gives a weak shower, mostly upstairs. We test the pressure and flow at the free survey. If it is too low, a regular boiler with a cylinder is the better choice.' },
  { q: 'My Heswall house has three bathrooms. What boiler do I need?', a: 'Usually a system boiler with a hot water cylinder. A combi struggles to run two or three showers at once. Many larger homes in Heswall, Neston and West Kirby already have an unvented cylinder. All our engineers are G3 qualified to work on them.' },
  { q: 'How long does a boiler installation take?', a: 'A like-for-like combi swap is usually done in one day. Moving the boiler, or changing from a tank system to a combi, can take 2 to 3 days. We tell you how long at the survey.' },
  { q: 'What warranty do I get?', a: 'It depends on the boiler: 7 years on the Baxi 600, 10 years on the Baxi 800, up to 10 years on the Worcester Bosch 4000 and Vaillant ecoTEC plus, and up to 12 years on the Worcester Bosch 8000+ Style. We register it on the day. It needs a service every year to stay valid. Our own work is guaranteed for 12 months.' },
  { q: 'Can you move my boiler to a different room?', a: 'Yes. It needs new gas, water and condensate pipes and a new flue, so it costs more. Within the same room is £450 extra. Another room on the same floor is £750. Another floor, the loft or the garage is £850.' },
  { q: 'Can I still get a gas boiler?', a: 'Yes. You can replace a gas boiler in an existing home with a new gas boiler. The rules that limit gas boilers apply to newly built homes.' },
  { q: 'Is my boiler worth repairing instead?', a: 'Often it is. If the boiler is under 10 years old and one part has failed, a repair is usually better value. A repair visit is from £120 for the first hour, with no call-out fee. We will tell you honestly which makes sense.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Every boiler is fitted by our Gas Safe registered engineers. By law, only a Gas Safe registered engineer can fit a gas boiler. You can check any engineer on the Gas Safe Register website.' },
];
---

<ServiceGuide
  url={URL_}
  title="Boiler Installation Wirral | 5 Fixed-Price Packages From £2,195"
  description="New boiler installation on the Wirral from £2,195 fully fitted, inc VAT. Baxi, Worcester Bosch and Vaillant, up to 12-year warranty. Free survey, all CH postcodes. Call 0151 558 0334."
  h1="New Boiler Installation Wirral"
  badge="New boilers fitted across all CH postcodes"
  intro="Five fixed-price combi packages, from a Baxi 600 at £2,195 to a Worcester Bosch 8000+ Style at £3,295, fully fitted and including VAT. From Birkenhead terraces to Heswall detached homes, we check your home first and fit the right boiler. Free survey and a written fixed price."
  stats={[['£2,195', 'Fully fitted, from'], ['12 yr', 'Warranty, up to']]}
  ticks={['Gas Safe Registered', 'Free Survey', 'Fixed Price', '5.0 on Google']}
  secondaryCta={{ href: '#prices', label: 'See the 5 packages' }}
  pkTitle="New boiler prices on the Wirral"
  pkLede="Five fixed-price combi packages, including VAT. Every price includes a smart thermostat, magnetic filter, system clean, carbon monoxide alarm and removal of your old boiler."
  packages={packages}
  pkNote="Need a bigger boiler? The next size up is £200 more. Ideal Logic Max is also available, at £2,695. Hot water is at a 35°C rise. Warranties are the manufacturer's: 'up to' means the longest cover, which needs the boiler registered (we do it on the day) and serviced every year. System and regular boilers are priced after a free survey."
  factsTitle="A new Wirral boiler at a glance"
  facts={[
    ['Price', 'Five combi packages from £2,195 to £3,295, fully fitted, inc VAT.'],
    ['Quote', 'Free survey, then a written fixed price before any work starts.'],
    ['Time', 'A like-for-like combi swap is usually done in one day.'],
    ['Warranty', '7 to 12 years from the maker, plus our 12-month workmanship guarantee.'],
    ['Who', 'Gas Safe registered engineers, part of our team led by James.'],
    ['Area', 'Every Wirral CH postcode, from Birkenhead to the Dee coast.'],
  ]}
  toc={[
    ['choose', 'Which package is right for me?'],
    ['homes', 'Which boiler suits my Wirral home?'],
    ['cost', 'What can change the price?'],
    ['included', 'What is included?'],
    ['replace', 'Do I need a new boiler?'],
    ['how', 'How does it work?'],
  ]}
  reviewTitle="What do customers say about James and the team?"
  reviews={['David H', 'Edward M', 'Mark L', 'Brendan C']}
  faqs={faqs}
  areasTitle="Do you fit boilers near the Wirral?"
  areasText="Yes. We fit boilers across Merseyside at the same fixed prices."
  areas={[
    { href: '/boiler-installation-liverpool', label: 'Boiler installation Liverpool' },
    { href: '/boiler-installation-st-helens', label: 'Boiler installation St Helens' },
    { href: '/boiler-installation-formby', label: 'Boiler installation Formby' },
  ]}
  related={[
    { href: '/boiler-service-wirral', title: 'Boiler service Wirral', text: '£95 fixed price, keeps your warranty valid' },
    { href: '/gas-safety-certificate-wirral', title: 'Gas safety certificate Wirral', text: 'Landlord CP12 from £120' },
    { href: '/power-flushing-wirral', title: 'Power flushing Wirral', text: 'From £395 for up to 6 radiators' },
    { href: '/hot-water-cylinders-wirral', title: 'Hot water cylinders Wirral', text: 'Unvented from £1,450, G3 qualified' },
    { href: '/central-heating-installation-wirral', title: 'Central heating Wirral', text: 'Full systems from £4,495' },
    { href: '/emergency-plumber-wirral', title: 'Emergency plumber Wirral', text: 'From £120 for the first hour, no call-out fee' },
  ]}
  finalTitle="Book your free Wirral boiler survey"
  finalText="Five fixed-price packages from £2,195, inc VAT. Free survey and a written fixed price. Smell gas? Call the National Gas Emergency line on 0800 111 999 first."
  serviceName="Boiler Installation Wirral"
  serviceType="Gas boiler installation and replacement"
  serviceDesc="Five fixed-price combi boiler packages from £2,195 fully fitted, fitted across every Wirral CH postcode by Gas Safe registered engineers. Free survey, written fixed price, up to 12-year manufacturer warranty."
  areaServed={['Birkenhead', 'Wallasey', 'Prenton', 'Moreton', 'Bebington', 'Hoylake', 'West Kirby', 'Heswall', 'Neston', 'Bromborough']}
>
  <section class="brx-sec brx-tint" id="choose">
    <div class="brx-wrap">
      <h2>Which boiler package is right for you?</h2>
      <p class="brx-answer">Paying more buys three things: more years of warranty, more hot water, and a better-known brand or design. Here is a quick guide.</p>
      <div class="sg-quick">
        <p><strong>Flat, small terrace or rental?</strong> <a href="#pk-essential">Essential, Baxi 600</a></p>
        <p><strong>Staying put, on a budget?</strong> <a href="#pk-value">Value, Baxi 800</a></p>
        <p><strong>Most 2 to 4 bed homes</strong> <a href="#pk-popular">Most popular, Worcester Bosch 4000</a></p>
        <p><strong>Two bathrooms or lots of hot water?</strong> <a href="#pk-premium">Premium, Vaillant ecoTEC plus</a></p>
        <p><strong>Boiler on show in the kitchen?</strong> <a href="#pk-flagship">Flagship, Worcester Bosch 8000+ Style</a></p>
      </div>
      <div class="brx-table-wrap">
        <table class="brx-table sg-cmp">
          <thead><tr><th>Package</th><th>Price</th><th>Hot water (litres a minute)</th><th>Warranty</th></tr></thead>
          <tbody>
            {boilers.map((b) => <tr><td><a href={`#${b.id}`}><strong>{b.tier}</strong></a><br />{b.name}</td><td><strong>{b.price}</strong></td><td>{b.flow}</td><td>{b.warranty}</td></tr>)}
          </tbody>
        </table>
      </div>
      <h3>Is the Baxi 800 worth £300 more than the Baxi 600?</h3>
      <p>If you are staying in the house, yes. It is the same boiler, with a magnetic filter in the box and 10 years of cover instead of 7. Landlords, or anyone moving within 5 years, can save with the Baxi 600.</p>
      <h3>Do I need the extra hot water?</h3>
      <p>Only if two showers, or a bath and a tap, often run at once. With one bathroom, the Worcester Bosch 4000 is the better value. One limit: a bigger combi only gives more hot water if your mains can supply it. We test that at the survey.</p>
    </div>
  </section>

  <section class="brx-sec" id="homes">
    <div class="brx-wrap">
      <h2>Which boiler does your Wirral home need?</h2>
      <p class="brx-answer">It depends on where you live and what you have now. Wirral homes vary a lot, so we check yours before we recommend a boiler.</p>
      <div class="brx-parts">
        <div class="brx-part">
          <h3>Birkenhead and Wallasey (CH41, CH42, CH44, CH45)</h3>
          <p>Victorian terraces in Birkenhead, Tranmere, Rock Ferry and Wallasey often have tanks in the loft. Some streets have low mains pressure. Then a combi gives a weak shower upstairs, and a regular boiler is the better fit. We test the pressure first.</p>
        </div>
        <div class="brx-part">
          <h3>Prenton, Moreton and Bebington (CH43, CH46, CH49, CH62, CH63)</h3>
          <p>Most homes here are 1930s to 1970s semis. Most have good mains pressure. A 28kW to 32kW combi usually suits a 3 bed semi with one bathroom.</p>
        </div>
        <div class="brx-part">
          <h3>Hoylake and West Kirby (CH47, CH48)</h3>
          <p>Many large period homes, often with two or more bathrooms. A standard combi can struggle here. A 36kW to 40kW combi, or a system boiler with a cylinder, is often better. Salt air near the coast is hard on outside pipes, so we check them too.</p>
        </div>
        <div class="brx-part">
          <h3>Heswall, Neston and Pensby (CH60, CH61, CH64)</h3>
          <p>Larger detached homes, often with several bathrooms, heating zones or an unvented cylinder. These usually need a system boiler sized for the home. All our engineers are G3 qualified for unvented cylinders.</p>
        </div>
      </div>
      <div class="brx-note"><p><strong>Getting the type right matters most.</strong> The wrong boiler is the most costly mistake to fix. The free survey takes about 45 minutes, and you get a fixed price for the right system.</p></div>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="cost">
    <div class="brx-wrap">
      <h2>What can change the price?</h2>
      <p class="brx-answer">The package prices cover a like-for-like combi swap. These extras are priced openly, so you know before the survey.</p>
      <div class="brx-table-wrap">
        <table class="brx-table">
          <thead><tr><th>Extra</th><th>Price</th></tr></thead>
          <tbody>{extras.map(([h, p]) => <tr><td>{h}</td><td><strong>{p}</strong></td></tr>)}</tbody>
        </table>
      </div>
      <p>System and regular boilers are priced at the free survey, because the cylinder and pipework vary from house to house. All prices include VAT. Your written price covers everything, so there are no surprises on the day.</p>
      <div class="brx-cta">
        <p><strong>Not sure which boiler?</strong> Ring us. We will ask a few questions, recommend one, then confirm it at the free survey.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>

  <section class="brx-sec" id="included">
    <div class="brx-wrap">
      <h2>What is included in the price?</h2>
      <p class="brx-answer">Everything needed for a safe, finished install. There are no hidden extras.</p>
      <ul class="sg-ticks">
        <li><strong>The new boiler</strong>, A-rated and sized for your home.</li>
        <li><strong>A smart thermostat</strong>, fitted and set up. It meets the Boiler Plus rules.</li>
        <li><strong>A carbon monoxide alarm</strong> near the boiler.</li>
        <li><strong>A magnetic filter</strong> to catch sludge before it reaches the boiler.</li>
        <li><strong>A system clean and inhibitor.</strong> Boiler makers ask for this to keep the warranty valid.</li>
        <li><strong>The flue, valves and fittings.</strong></li>
        <li><strong>Old boiler removed</strong> and taken away. No skip needed.</li>
        <li><strong>Commissioning.</strong> Gas and safety checks, radiators balanced, and we show you the controls.</li>
        <li><strong>Paperwork.</strong> Benchmark checklist, warranty registered for you, and the install notified to Gas Safe Register.</li>
      </ul>
      <figure class="sg-photo" style="max-width:360px;margin-top:1.25rem;">
        <picture>
          <source type="image/webp" srcset="/images/jobs/boiler-smart-thermostat-fitted-480.webp 480w, /images/jobs/boiler-smart-thermostat-fitted-960.webp 960w" sizes="(max-width: 800px) 100vw, 360px" />
          <img src="/images/jobs/boiler-smart-thermostat-fitted-960.jpg" alt="Boiler and smart thermostat receiver fitted by our team" loading="lazy" decoding="async" width="960" height="1280" />
        </picture>
        <figcaption>A recent job: boiler controls fitted by our team.</figcaption>
      </figure>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="replace">
    <div class="brx-wrap">
      <h2>Do you need a new boiler, or just a repair?</h2>
      <p class="brx-answer">Not every broken boiler needs replacing. These are the signs a new one is the better buy.</p>
      <ul class="brx-list">
        <li><strong>It is over 10 to 15 years old</strong> and breaks down more often.</li>
        <li><strong>Repairs are adding up</strong> every winter.</li>
        <li><strong>The pressure keeps dropping.</strong> In older Birkenhead and Wallasey homes, this can mean several worn joints, not one.</li>
        <li><strong>Rust on the case or flue.</strong> Salt air on coastal homes can speed this up, mostly on boilers in outbuildings.</li>
        <li><strong>Your gas bills keep rising</strong> with no change in how you use the heating.</li>
        <li><strong>The flame is yellow or orange</strong>, or there are soot marks. Stop using it and call us. If you smell gas, call 0800 111 999 first.</li>
      </ul>
      <div class="brx-note"><p><strong>Not sure?</strong> If the boiler is under 10 years old and one part has failed, a repair is usually better value. A repair visit is from £120 for the first hour, with no call-out fee. We will tell you honestly.</p></div>
    </div>
  </section>

  <section class="brx-sec" id="how">
    <div class="brx-wrap">
      <h2>How does a new boiler install work?</h2>
      <ol class="sg-steps">
        <li><strong>Free survey (about 45 minutes).</strong> An engineer checks your boiler, pipes, flue route, gas supply and water pressure. You get a written fixed price.</li>
        <li><strong>You choose a date.</strong> We book the install for a day that suits you. Boiler broken? Tell us and we give you our earliest slot.</li>
        <li><strong>Clean the system.</strong> The heating is cleaned so old sludge does not harm the new boiler.</li>
        <li><strong>Fit and commission (usually one day).</strong> The old boiler comes out. The new boiler, flue, filter and controls go in. We test it and balance the radiators.</li>
        <li><strong>Handover.</strong> We show you the controls, fill in the Benchmark checklist and register the warranty.</li>
      </ol>
      <p style="margin-top:1rem;">After the install, Gas Safe Register posts you a Building Regulations Compliance Certificate. Keep it safe. You will need it if you sell. Then book a <a href="/boiler-service-wirral">boiler service</a> each year to keep the warranty valid.</p>
      <div class="brx-cta">
        <p><strong>Book your free survey.</strong> Ring us or book online and we will arrange a time.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>
</ServiceGuide>
