---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallStrip from '../components/CallStrip.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
---

<BaseLayout
  title="Emergency Plumber & Plumbers in Kirkby L32 | From £120"
  description="Plumbers in Kirkby, based at 29 Park Road L32. 24/7 emergency plumber for Northwood, Tower Hill, Westvale and L33. No call-out fee. From £120."
>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Emergency Plumber Kirkby",
    "alternateName": ["24 Hour Plumber Kirkby", "Kirkby Emergency Plumber L32", "Knowsley Plumber"],
    "serviceType": "Emergency Plumbing",
    "description": "Emergency plumber based at 29 Park Road, Kirkby L32. We cover Northwood, Tower Hill, Westvale, The Grange, Brookhaven, Southdene and the wider L32 and L33 area. 30 minute response. Gas Safe registered From £120 for the first hour.",
    "provider": { "@id": "https://liverpoolemergencyplumber.co.uk/#business" },
    "areaServed": [
      { "@type": "Place", "name": "Kirkby, L32" },
      { "@type": "Place", "name": "Northwood, L33" },
      { "@type": "Place", "name": "Tower Hill, L33" },
      { "@type": "Place", "name": "Westvale, L32" },
      { "@type": "Place", "name": "The Grange, L32" },
      { "@type": "Place", "name": "Brookhaven, L32" },
      { "@type": "Place", "name": "Southdene" },
      { "@type": "Place", "name": "Knowsley Industrial Park" }
    ],
    "hoursAvailable": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "00:00", "closes": "23:59" },
    "offers": [
      { "@type": "Offer", "name": "Weekday Emergency Plumber Kirkby", "price": "120", "priceCurrency": "GBP", "description": "Monday to Friday 9am to 4pm. Price for the first hour. No call-out fee." },
      { "@type": "Offer", "name": "Evening and Weekend Emergency Plumber Kirkby", "price": "150", "priceCurrency": "GBP", "description": "Weekdays after 4pm, nights and weekends. Price for the first hour. No call-out fee." },
      { "@type": "Offer", "name": "Bank Holiday Emergency Plumber Kirkby", "price": "180", "priceCurrency": "GBP", "description": "Bank holidays. Price for the first hour. No call-out fee." }
    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does an emergency plumber cost in Kirkby?", "acceptedAnswer": { "@type": "Answer", "text": "£120 for the first hour on weekdays 9am to 4pm. £150 for the first hour on weekday evenings, nights and weekends. £180 for the first hour on bank holidays. Extra time is priced before we carry on. Parts at cost. Most jobs cost £120 to £350. Same fair rates whatever the postcode. Written quote before work starts. No separate call-out fee." } },
      { "@type": "Question", "name": "How quickly can you reach Kirkby?", "acceptedAnswer": { "@type": "Answer", "text": "We guarantee a 30 minute response, and Kirkby is our home patch. We're based at 29 Park Road, Kirkby L32 2AL, so L32 and L33 are on our doorstep. A real person answers the phone any time of day or night." } },
      { "@type": "Question", "name": "Do you cover Knowsley Industrial Park?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We attend commercial plumbing emergencies on Knowsley Industrial Park, Knowsley Business Park and the wider commercial estates around Kirkby. Same fixed rates as residential. No commercial premium. £120 for the first hour on weekdays. We work with facilities managers and site teams to resolve faults fast." } },
      { "@type": "Question", "name": "Do you handle right-to-buy and ex-council properties in Kirkby?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A large share of Kirkby housing is former council stock now in private ownership. The original 1950s and 1960s pipework, copper heating runs and lead supply pipes are still in service in many of these homes. We know the standard layouts. We carry common replacement parts for the failures we see most often in this housing." } },
      { "@type": "Question", "name": "Do you cover lead supply pipe replacements?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Many Kirkby properties still have original lead supply pipes between the boundary stopcock and the kitchen. United Utilities has replaced most external sections in recent years, but the internal run from the boundary to the property is the homeowner's responsibility. We replace lead supply pipes with copper or MDPE plastic. Improves water quality and pressure." } },
      { "@type": "Question", "name": "Are your engineers Gas Safe registered?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All gas work is carried out by our Gas Safe registered. Verify our registration at gassaferegister.co.uk. It's illegal to work on gas without it. We provide gas safety certificates for all gas work in Kirkby." } },
      { "@type": "Question", "name": "Do you guarantee your work?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every job carries a 12-month workmanship guarantee. If something we fixed fails because of our work, we come back. No charge." } }
    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://liverpoolemergencyplumber.co.uk" },
      { "@type": "ListItem", "position": 2, "name": "Emergency Plumber Kirkby", "item": "https://liverpoolemergencyplumber.co.uk/emergency-plumber-kirkby" }
    ]
  }
  </script>

  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-badge" style="margin:0 auto 1rem;">
        <span class="live-dot"></span>
        Based in Kirkby L32. 24/7.
      </div>
      <h1>Emergency Plumber in Kirkby</h1>
      <p class="page-hero-sub">Your local plumber, based in Kirkby. We're at 29 Park Road, L32 2AL. We cover Northwood, Tower Hill, Westvale, The Grange, Brookhaven and the wider L32 and L33 area. Guaranteed 30 minute response. From £120 for the first hour. Gas Safe registered.</p>

      <div style="background:var(--navy);border-radius:var(--radius);padding:1rem 1.5rem;max-width:320px;margin:1.25rem auto;display:flex;flex-direction:column;align-items:center;gap:0.2rem;">
        <span style="font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-size:3rem;font-weight:900;color:#fb923c;line-height:1;">30<small style="font-size:1.4rem;color:#ffffff;">min</small></span>
        <span style="font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-size:1rem;font-weight:900;color:#ffffff;line-height:1.2;">Guaranteed Response in Kirkby</span>
        <p style="color:rgba(255,255,255,0.85);font-size:0.85rem;margin:0.3rem 0 0;">From <strong style="color:#fb923c;">£120</strong> for the first hour · No call-out fee</p>
      </div>

      <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;max-width:320px;margin:0 auto 1.5rem;">
        <a href="tel:01515580334" class="btn btn-orange btn-lg btn-full" style="box-shadow:0 4px 14px rgba(249,115,22,0.4);font-size:1.3rem;color:#ffffff;">CALL 0151 558 0334</a>
        <a href="/get-started" class="btn btn-lg btn-full" style="background:var(--navy);color:#ffffff;border:2px solid var(--navy);">BOOK ONLINE</a>
      </div>

      <div style="display:flex;justify-content:center;gap:0.75rem;flex-wrap:wrap;margin-top:1.5rem;">
        <span style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.45rem 1rem;font-size:0.82rem;font-weight:700;color:var(--navy);">✓ Based in L32</span>
        <span style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.45rem 1rem;font-size:0.82rem;font-weight:700;color:var(--navy);">✓ Gas Safe Registered</span>
        <span style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.45rem 1rem;font-size:0.82rem;font-weight:700;color:var(--navy);">✓ 12-Month Guarantee</span>
        <span style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.45rem 1rem;font-size:0.82rem;font-weight:700;color:var(--navy);">✓ Fixed Prices from £120</span>
      </div>
    </div>
  </section>

  <div class="pf">

  <!-- REVIEW TRUST BAR -->
  <section style="background:#1a3a5c;padding:1.25rem 0;">
    <div class="container">
      <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;text-align:center;">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <div style="color:#fbbf24;font-size:1.1rem;">★★★★★</div>
          <div style="color:#ffffff;font-size:0.88rem;font-weight:700;">5.0 · 53 Google Reviews</div>
        </div>
        <div style="color:rgba(255,255,255,0.85);font-size:0.84rem;font-style:italic;max-width:520px;">"Excellent service." Elaine McHugh</div>
        <a href="https://www.google.com/search?q=Liverpool+Emergency+Plumber+reviews" target="_blank" rel="noopener" style="background:#c2410c;color:#ffffff;font-size:0.82rem;font-weight:700;text-decoration:none;border:none;padding:0.4rem 1rem;border-radius:999px;">See our Google reviews →</a>
      </div>
    </div>
  </section>


  <!-- LOCAL PROOF -->
  <section class="pf-section" style="background:#f8fafc;">
    <div class="container">
      <span class="pf-section-label">WE'RE YOUR NEIGHBOURS</span>
      <h2>Based at 29 Park Road, Kirkby L32 2AL</h2>
      <div class="pf-card pf-card-left-orange" style="margin-top:1.5rem;">
        <p>This isn't a Liverpool plumber claiming to cover Kirkby. We're based in Kirkby. Our base is at 29 Park Road, L32 2AL. Same postcode as the homes we work in.</p>

        <p>Kirkby is our home patch. We know the housing here: the post-war estates, the ex-council semis and the newer builds. That helps us find the stopcock and the fault faster.</p>

        <p>If you need a plumber in Kirkby, you want one close by. We're local, we're open 24/7, and there is no call-out fee.</p>
      </div>
    </div>
  </section>


  <!-- PROPERTY TYPES -->
  <section class="pf-section" style="background:#f1f5f9;">
    <div class="container">
      <span class="pf-section-label">KIRKBY PROPERTIES WE COVER</span>
      <h2>One Trusted Team. Every Type of Kirkby Property.</h2>
      <p class="pf-sub">Kirkby's housing stock is more uniform than Liverpool's suburbs. We know what we'll find before we open the door.</p>
      <div class="pf-why-grid" style="margin-top:2rem;">

        <div class="pf-why-item">
          <h3>1950s and 60s Estate Housing</h3>
          <p>The largest share of Kirkby housing. Built fast after the war to rehouse Liverpool families. Standardised semi-detached and terraced layouts. Original lead supply pipes, copper heating runs from the 1970s upgrades. We carry common replacement parts as standard.</p>
        </div>

        <div class="pf-why-item">
          <h3>Right-to-Buy Properties</h3>
          <p>Many Kirkby homes were council stock and are now privately owned. Plumbing was installed to the minimum standard of the time. Often improved partially over decades. We diagnose what's original and what's been changed before quoting any work.</p>
        </div>

        <div class="pf-why-item">
          <h3>Modern Private Estates</h3>
          <p>The Grange off Whinberry Drive, Brookhaven, the newer developments in Northwood. Modern combi boilers, mains pressure systems, often still under manufacturer warranty. We honour warranty conditions.</p>
        </div>

        <div class="pf-why-item">
          <h3>Tower Hill and Northwood (L33)</h3>
          <p>Streets like Glendale Grove, Boyes Brow, Haweswater Close. Mix of older terraces and newer family homes. We cover all L33 emergencies at the same Kirkby rates.</p>
        </div>

        <div class="pf-why-item">
          <h3>Knowsley Industrial Park Commercial</h3>
          <p>One of the UK's largest industrial estates is on our doorstep. We cover commercial plumbing emergencies for the units, offices and warehouses across Knowsley Industrial Park and the wider commercial estates. Same fixed rates as residential.</p>
        </div>

        <div class="pf-why-item">
          <h3>Rental and Buy-to-Let Properties</h3>
          <p>Kirkby has a strong buy-to-let market. We carry out CP12 gas safety certificates for landlords, batch services across multiple properties, and provide written documentation for insurance claims.</p>
        </div>

      </div>
    </div>
  </section>


  <!-- PRICING -->
  <section class="pf-section" style="background:#f8fafc;">
    <div class="container">
      <h2>Emergency Plumber Kirkby. Fixed Rates. No Postcode Premium.</h2>
      <p class="pf-sub">Same fair rates whatever the postcode. Written quote before any work starts. Extra time is priced before we carry on. Parts at cost.</p>

      <div class="pf-pricing-grid">
        <div class="pf-price-card">
          <div class="pf-price-tier">WEEKDAY</div>
          <div class="pf-price-name">Monday to Friday</div>
          <div class="pf-price-sub">9am to 4pm</div>
          <div class="pf-price-amount">£120<small> first hour</small></div>
          <ul class="pf-price-list">
            <li>30 min guaranteed response</li>
            <li>Gas Safe engineer</li>
            <li>No call-out fee</li>
            <li>Parts at cost</li>
          </ul>
          <a href="tel:01515580334" class="btn btn-navy btn-full">Call Now</a>
        </div>
        <div class="pf-price-card">
          <div class="pf-price-tier">OUT OF HOURS</div>
          <div class="pf-price-name">Evenings and weekends</div>
          <div class="pf-price-sub">Weekdays after 4pm, nights and all weekend</div>
          <div class="pf-price-amount">£150<small> first hour</small></div>
          <ul class="pf-price-list">
            <li>Same fast service</li>
            <li>Gas Safe engineer</li>
            <li>No call-out fee</li>
            <li>Parts at cost</li>
          </ul>
          <a href="tel:01515580334" class="btn btn-navy btn-full">Call Now</a>
        </div>
        <div class="pf-price-card pf-price-card-featured">
          <div class="pf-price-badge">24/7</div>
          <div class="pf-price-tier">BANK HOLIDAYS</div>
          <div class="pf-price-name">Every bank holiday</div>
          <div class="pf-price-sub">Always available</div>
          <div class="pf-price-amount">£180<small> first hour</small></div>
          <ul class="pf-price-list">
            <li>Real person answers now</li>
            <li>Priority response</li>
            <li>Gas Safe engineer</li>
            <li>No call-out fee</li>
          </ul>
          <a href="tel:01515580334" class="btn btn-orange btn-full" style="color:#ffffff;">Call Now. We Answer.</a>
        </div>
      </div>

      <div class="pf-alert" style="margin-top:1.5rem;">
        <strong>Same rates as the premium postcodes</strong>
        <p>Some plumbers charge more for affluent areas. We don't. Kirkby pays the same as Woolton, Aigburth and Crosby. Our prices are fixed and published before you call. No separate call-out fee.</p>
      </div>
    </div>
  </section>


  <!-- LOCAL KNOWLEDGE SECTION -->
  <section class="pf-section" style="background:#f1f5f9;">
    <div class="container">
      <span class="pf-section-label">KIRKBY LOCAL KNOWLEDGE</span>
      <h2>Why Kirkby Housing Has Its Own Plumbing Reality</h2>

      <div class="pf-card pf-card-left-orange" style="margin-top:1.5rem;">
        <p>Kirkby was built fast in the 1950s. The town was a planned overspill estate to rehouse Liverpool families after slum clearance. Around 60,000 people moved here in a decade. The housing went up at speed.</p>

        <p>That history matters when something fails today. Plumbing was installed to the minimum standard required at the time. Original lead supply pipes are still in service in many homes. Copper heating runs from the 1970s upgrades are reaching end of life.</p>

        <p>The good news is that the housing stock is uniform. A semi-detached on one street usually has the same pipework layout as a semi-detached two roads away. We know where the stopcock will be. We know where the original boiler position was. That saves time on every call-out.</p>
      </div>

      <div class="pf-card pf-card-left-orange" style="margin-top:1rem;">
        <p>Kirkby sits in Knowsley Borough, not Liverpool City. That matters for some things. The council is Knowsley Council. Bins and drainage queries go to them, not Liverpool.</p>

        <p>The town also has Knowsley Industrial Park on its eastern side. One of the UK's largest industrial estates. We cover the commercial units there as well as residential. Same rates either way.</p>
      </div>
    </div>
  </section>


  <!-- COMMON JOBS -->
  <section class="pf-section" style="background:#f8fafc;">
    <div class="container">
      <h2>Common Emergency Jobs in Kirkby</h2>
      <p class="pf-sub">What we attend most often in L32 and L33.</p>
      <div class="jobs-grid" style="margin-top:2rem;">

        <div class="job-card">
          <h3>Lead Supply Pipe Failures</h3>
          <div class="job-meta"><span class="job-price">Gas Safe registered</span><span class="job-time">30 min response</span></div>
          <p>Original lead supply pipes between the boundary stopcock and the kitchen still serve many Kirkby homes. After 70 years they fail without warning. We replace with copper or MDPE plastic. Same-visit job in most cases.</p>
          <a class="job-link" href="/leak-detection-liverpool">Leak detection →</a>
        </div>
        <div class="job-card">
          <h3>1970s Boiler and Cylinder Replacements</h3>
          <div class="job-meta"><span class="job-price">Gas Safe registered</span><span class="job-time">30 min response</span></div>
          <p>Some Kirkby homes still have the original 1970s heating systems. Back boilers behind gas fires. Open vented cylinders in the airing cupboard. Beyond economic repair now. We replace with modern combi or system boilers.</p>
          <a class="job-link" href="/hot-water-cylinders-liverpool">Hot water cylinders →</a>
        </div>

        <div class="job-card">
          <h3>Frozen Pipe Bursts</h3>
          <div class="job-meta"><span class="job-price">Gas Safe registered</span><span class="job-time">30 min response</span></div>
          <p>Kirkby's older semis often have poorly insulated lofts. Cold snaps cause pipe bursts above ceilings. Damage shows up before the water's even off. We attend 24/7 and fit pipe lagging on the same visit to stop it happening again.</p>
          <a class="job-link" href="/burst-pipe-repair-liverpool">Burst pipe repair →</a>
        </div>
        <div class="job-card">
          <h3>Knowsley Industrial Park Commercial</h3>
          <div class="job-meta"><span class="job-price">Gas Safe registered</span><span class="job-time">30 min response</span></div>
          <p>Commercial plumbing emergencies on the industrial park. Factory water supplies, staff facilities, washroom plumbing. Same fixed rates as residential. Written invoices ready for business insurance claims.</p>
        </div>
        <div class="job-card">
          <h3>CP12 Landlord Certificates</h3>
          <div class="job-meta"><span class="job-price">Gas Safe registered</span><span class="job-time">30 min response</span></div>
          <p>Kirkby has a strong buy-to-let market. CP12 gas safety certificates from £100 per property. Same-day available. Combined boiler service and CP12 from £199. We batch multiple properties for landlords with several Kirkby rentals.</p>
          <a class="job-link" href="/gas-safety-certificate-liverpool">Gas safety certificates →</a>
        </div>
      </div>
    </div>
  </section>

  <CallStrip title="Got one of these right now?" text="Call us. A real person answers 24/7, and there is no call-out fee." book={false} />


  <!-- WHAT TO DO SECTION -->
  <section class="pf-section" style="background:#f1f5f9;">
    <div class="container">
      <h2>While You Wait For Us</h2>
      <p class="pf-sub">Four steps that protect your property. We're usually only minutes away.</p>
      <div class="pf-who-grid" style="margin-top:2rem;">
        <div class="pf-who-item pf-who-yes"><span class="pf-who-icon">1</span><div><strong>Find the stopcock and turn it off</strong><p>For any water leak, the stopcock is your first move. In most Kirkby semis it's under the kitchen sink. Turn it clockwise to stop all water. We'll be there before you've cleared the cupboard out.</p></div></div>
        <div class="pf-who-item pf-who-yes"><span class="pf-who-icon">2</span><div><strong>If you smell gas, get out</strong><p>Don't touch switches. Open windows as you leave. Call <a href="https://cadentgas.com/emergencies" target="_blank" rel="noopener" style="color:#c2410c;font-weight:700;">Cadent Gas on 0800 111 999</a> first. Then us on <a href="tel:01515580334">0151 558 0334</a> once the property is safe.</p></div></div>
        <div class="pf-who-item pf-who-yes"><span class="pf-who-icon">3</span><div><strong>No heating? Check the pressure gauge</strong><p>Look at the gauge on the boiler. It should sit between 1 and 1.5 bar. Below 0.5, you can repressurise using the filling loop underneath. That fixes about half of all "no heating" calls. If it doesn't, call us.</p></div></div>
        <div class="pf-who-item pf-who-yes"><span class="pf-who-icon">4</span><div><strong>Photograph the damage</strong><p>Take photos and video before you start cleaning. Insurance claims need evidence. We write our own fault report with photos as well, ready for your insurer or landlord.</p></div></div>
      </div>
    </div>
  </section>

  <CallStrip title="Water still coming through?" text="Turn off the stopcock and call us now. We answer 24/7." book={false} />


  <!-- SERVICES SECTION -->
  <section class="pf-section" style="background:#f8fafc;">
    <div class="container">
      <h2>Plumbers in Kirkby for Everyday Jobs Too</h2>
      <p class="pf-sub">Not an emergency? We cover all plumbing and heating work across L32 and L33. Gas Safe registered. Fixed prices. Free surveys.</p>
      <div class="pf-related" style="margin-top:1.5rem;">
        <a href="/boiler-repair-liverpool" class="pf-related-link"><div><strong>Boiler Repair Kirkby</strong><span>No heating or hot water? Emergency boiler repair 24/7. From £120 for the first hour, including diagnosis. No call-out fee.</span></div><span class="pf-related-arrow">&#8594;</span></a>
        <a href="/leak-detection-liverpool" class="pf-related-link"><div><strong>Leak Detection Kirkby</strong><span>Hidden leak, damp patch or a water bill that jumped? We find it with pressure tests and careful checks, then fix it.</span></div><span class="pf-related-arrow">&#8594;</span></a>
        <a href="/emergency-gas-engineer-liverpool" class="pf-related-link"><div><strong>Emergency Gas Engineer Kirkby</strong><span>Gas Safe registered engineers 24/7 for boilers, gas cookers and hobs. Smell gas? Call 0800 111 999 first, then call us.</span></div><span class="pf-related-arrow">&#8594;</span></a>
        <a href="/boiler-service-liverpool" class="pf-related-link"><div><strong>Boiler Service Kirkby</strong><span>Annual boiler service from £120. Gas Safe engineers. Certificate same day. Keeps your warranty valid.</span></div><span class="pf-related-arrow">&#8594;</span></a>
        <a href="/gas-safety-certificate-liverpool" class="pf-related-link"><div><strong>CP12 for Kirkby Landlords</strong><span>CP12 landlord certificates from £100. Same-day available. Batch pricing for landlords with multiple Kirkby properties. Combined service and CP12 from £199.</span></div><span class="pf-related-arrow">&#8594;</span></a>
        <a href="/power-flushing-liverpool" class="pf-related-link"><div><strong>Power Flushing Kirkby</strong><span>Cold radiators or noisy boiler? Power flush from £395 for systems up to 6 radiators. Protects new boiler warranty.</span></div><span class="pf-related-arrow">&#8594;</span></a>
        <a href="/radiators-liverpool" class="pf-related-link"><div><strong>Radiator Repairs and Replacements</strong><span>New radiators from £245 supply and fit. TRV upgrades from £65. Radiator balancing included.</span></div><span class="pf-related-arrow">&#8594;</span></a>
        <a href="/showers-liverpool" class="pf-related-link"><div><strong>Shower Installation and Repairs</strong><span>Electric showers from £375 supply and fit. Thermostatic mixer from £395. Common spec for Kirkby family bathroom upgrades.</span></div><span class="pf-related-arrow">&#8594;</span></a>
        <a href="/boiler-installation-liverpool" class="pf-related-link"><div><strong>Boiler Installation Kirkby</strong><span>New boiler from £2,195 fully fitted. Baxi, Worcester Bosch and Vaillant. Up to 12-year warranty. Free survey.</span></div><span class="pf-related-arrow">&#8594;</span></a>
        <a href="/hot-water-cylinders-liverpool" class="pf-related-link"><div><strong>Hot Water Cylinders</strong><span>Vented cylinders from £750, unvented from £1,450. Replacing the original 1970s open-vented cylinders is one of our most common Kirkby upgrades.</span></div><span class="pf-related-arrow">&#8594;</span></a>
        <a href="/bathroom-fitters-liverpool" class="pf-related-link"><div><strong>Bathroom Fitters Kirkby</strong><span>Full bathrooms supplied and fitted from £4,995. En-suites from £4,495. Free survey and a fixed written price.</span></div><span class="pf-related-arrow">&#8594;</span></a>
      </div>
    </div>
  </section>


  <!-- WHY CHOOSE -->
  <section class="pf-section" style="background:#f1f5f9;">
    <div class="container">
