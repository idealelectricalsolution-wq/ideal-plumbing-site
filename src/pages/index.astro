---
import BaseLayout from '../layouts/BaseLayout.astro';

const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const problems = [
  { icon: '💧', title: 'Leak or burst pipe', text: 'Water pouring or dripping from a pipe, joint or fitting. Turn off your stopcock, then call.', href: '/leak-detection-liverpool', link: 'Leak detection and repair', urgent: true },
  { icon: '🏠', title: 'Water through the ceiling', text: 'A wet patch or drip from above. We trace where it is coming from and stop it.', href: '/leak-detection-liverpool', link: 'How we find hidden leaks', urgent: true },
  { icon: '🔥', title: 'Boiler broken or no heating', text: 'Error code, no pressure, or the boiler will not fire. Gas Safe registered boiler repair.', href: '/boiler-repair-liverpool', link: 'Boiler repair Liverpool', urgent: true },
  { icon: '🚿', title: 'No hot water', text: 'Cold taps and showers. Usually a boiler or cylinder fault. James finds it and fixes it.', href: '/boiler-repair-liverpool', link: 'Boiler repair Liverpool', urgent: false },
  { icon: '♨️', title: 'Radiator leaking', text: 'Drips from a valve, pipe or the radiator itself. Fixed before it damages your floor.', href: '/radiators-liverpool', link: 'Radiator repairs', urgent: false },
  { icon: '🚰', title: 'Sink or tap leaking', text: 'Leaks under the sink, dripping taps and broken fittings, found and fixed.', href: '/leak-detection-liverpool', link: 'Leak repairs', urgent: false },
];

const reviews = [
  { name: 'Brendan C', job: 'Boiler repair', text: 'James was amazing and was at my house within 30 mins of calling on a sunday. He has not only fixed my boiler but improved it and taught me how to fix the problem in future. Affordable and easygoing great plumber and gas fitter!' },
  { name: 'Amanda', job: 'Radiator leak', text: 'Responded very quickly to my unexpected radiator pipe leak and fixed the issue. Very knowledgeable and reassuring - he did a very tidy job and cleaned up well. Would recommend.' },
  { name: 'James Alexander', job: 'Burst pipe', text: 'Great company, came within 30 mins for emergency burst pipe, couldn’t praise them enough !!' },
  { name: 'Edward M', job: 'Leaking pipe and boiler', text: 'James came out and fixed a leaking pipe and even got my boiler up and running by fixing an air lock. Professional , on time, cleaned up after himself and charged a fair rate.' },
  { name: 'David H', job: 'Boiler and leaking tap', text: 'Amazing service James was very professional. Fixed my boiler and leaking tap very knowledgeable very fast and polite great company 100% recommended' },
  { name: 'Roger D', job: 'No hot water', text: 'Wonderful service. Came within 24 hrs and got our hot water back on with an improvised repair. Returned few days later with the part needed to restore everything to normal Charming, calm, methodical. I highly recommend' },
];

const jobs = [
  { img: 'leak-under-bath-traced', alt: 'Leak traced under a bath panel in a Liverpool home', cap: 'Leak traced under a bath' },
  { img: 'failed-pipe-fitting-leak', alt: 'Failed pipe fitting found leaking and replaced', cap: 'Failed fitting found and replaced' },
  { img: 'water-main-connector-repair', alt: 'Water main connector under a bath repaired', cap: 'Water main connector repaired' },
  { img: 'boiler-smart-thermostat-fitted', alt: 'Boiler with smart thermostat receiver fitted', cap: 'Boiler controls fitted' },
  { img: 'towel-radiator-fitted', alt: 'Anthracite towel radiator fitted in a bathroom', cap: 'Towel radiator fitted' },
  { img: 'bathroom-bath-shower-fitted', alt: 'New bath and shower fitted in a Liverpool bathroom', cap: 'Bath and shower fitted' },
];

const areas = ['aigburth','aintree','allerton','anfield','bootle','childwall','city-centre','crosby','everton','fazakerley','formby','garston','huyton','kirkby','maghull','mossley-hill','norris-green','old-swan','southport','st-helens','toxteth','walton','wavertree','west-derby','wirral','woolton'];
const areaName = (a) => ({ 'city-centre': 'City Centre', 'st-helens': 'St Helens', 'mossley-hill': 'Mossley Hill', 'norris-green': 'Norris Green', 'old-swan': 'Old Swan', 'west-derby': 'West Derby' }[a] ?? a[0].toUpperCase() + a.slice(1));

const faqs = [
  { q: 'How much does an emergency plumber cost in Liverpool?', a: 'Weekdays 9am to 5pm: £80 per hour. Weekends 9am to 1pm: £120 per hour. Out of hours, nights and bank holidays: £150 per hour. There is a 1 hour minimum and no call-out fee. Parts are charged at cost and you get a written quote before any work begins.' },
  { q: 'Is there a call-out fee?', a: 'No. There is no call-out fee. You pay the hourly rate with a 1 hour minimum, so a weekday emergency starts at £80.' },
  { q: 'How quickly can you get to me?', a: 'Our 30 minute response is guaranteed across Liverpool L1 to L40, and our average arrival time is 28 minutes. Call 0151 558 0334 and we will tell you when James will arrive.' },
  { q: 'Do you cover commercial properties?', a: 'Yes. We cover commercial plumbing emergencies across Liverpool 24/7 at the same rates as homes. No commercial premium.' },
  { q: 'Can you find a leak I cannot see?', a: 'Yes. James traces hidden leaks by lifting floorboards, pressure testing the pipework and, where a leak is under a tiled or laminate floor, cutting a neat inspection hole in the ceiling below. Then he repairs it.' },
  { q: 'Can you give me a leak report for my insurance?', a: 'Yes. We can provide a leak report for your insurer explaining where the leak was and what was repaired.' },
  { q: 'How much is a boiler repair?', a: 'A boiler fault diagnosis is £95. If you prefer, we can work at the hourly rate instead, from £80 per hour on weekdays. James is Gas Safe registered.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. James is Gas Safe registered. You can check the register at gassaferegister.co.uk. It is illegal for anyone who is not Gas Safe registered to work on gas appliances.' },
  { q: 'Do you use sub-contractors?', a: 'No. James does every job himself, sometimes with his labourer to help. You get the same Gas Safe registered, insured plumber every time.' },
  { q: 'Is your work guaranteed?', a: 'Yes. All our work carries a 12-month workmanship guarantee, and we hold £2 million public liability insurance.' },
  { q: 'Are you a 24 hour plumber?', a: 'Yes. We take emergency calls 24 hours a day, 7 days a week, including nights, weekends and bank holidays.' },
  { q: 'What postcodes do you cover?', a: 'We cover every Liverpool postcode from L1 to L40, including the city centre, Anfield, Aigburth, Wavertree, West Derby, Woolton, Bootle, Crosby, Maghull, Kirkby, Huyton, Formby and Southport, plus St Helens and the Wirral.' },
  { q: 'What should I do if I smell gas?', a: 'Leave the property, do not use light switches or flames, turn off the gas at the meter if it is safe, and call the National Gas Emergency number on 0800 111 999. Once the leak is made safe, call us on 0151 558 0334 to repair the appliance or pipework.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title="Emergency Plumber Liverpool | Fastest 30min Response | From £80"
  description="Emergency plumber Liverpool available 24/7. 30 minute response across L1 to L40. Gas Safe registered. James does every job himself. Burst pipes, boiler breakdowns, no hot water, gas leaks. From £80/hour minimum. Call 0151 558 0334."
  canonical="https://liverpoolemergencyplumber.co.uk"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "Plumber"],
    "@id": "https://liverpoolemergencyplumber.co.uk/#business",
    "name": "Liverpool Emergency Plumber",
    "url": "https://liverpoolemergencyplumber.co.uk",
    "telephone": "+441515580334",
    "email": "emergencyplumberliverpool@gmail.com",
    "priceRange": "From £80/hour",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "29 Park Road",
      "addressLocality": "Kirkby",
      "addressRegion": "Merseyside",
      "postalCode": "L32 2AL",
      "addressCountry": "GB"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "areaServed": [
      { "@type": "Place", "name": "Liverpool City Centre" },
      { "@type": "Place", "name": "Aigburth" },
      { "@type": "Place", "name": "Aintree" },
      { "@type": "Place", "name": "Allerton" },
      { "@type": "Place", "name": "Anfield" },
      { "@type": "Place", "name": "Bootle" },
      { "@type": "Place", "name": "Childwall" },
      { "@type": "Place", "name": "Crosby" },
      { "@type": "Place", "name": "Everton" },
      { "@type": "Place", "name": "Fazakerley" },
      { "@type": "Place", "name": "Formby" },
      { "@type": "Place", "name": "Garston" },
      { "@type": "Place", "name": "Huyton" },
      { "@type": "Place", "name": "Kirkby" },
      { "@type": "Place", "name": "Maghull" },
      { "@type": "Place", "name": "Mossley Hill" },
      { "@type": "Place", "name": "Norris Green" },
      { "@type": "Place", "name": "Old Swan" },
      { "@type": "Place", "name": "Southport" },
      { "@type": "Place", "name": "St Helens" },
      { "@type": "Place", "name": "Toxteth" },
      { "@type": "Place", "name": "Walton" },
      { "@type": "Place", "name": "Wavertree" },
      { "@type": "Place", "name": "West Derby" },
      { "@type": "Place", "name": "Wirral" },
      { "@type": "Place", "name": "Woolton" }
    ],
    "review": [
      {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "author": { "@type": "Person", "name": "James Alexander" },
        "datePublished": "2026-05-14",
        "reviewBody": "Great company, came within 30 mins for emergency burst pipe, couldn't praise them enough!"
      },
      {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "author": { "@type": "Person", "name": "John Manley" },
        "datePublished": "2026-05-16",
        "reviewBody": "Fantastic service, less than two hours after phoning up to order a new shower the job was done. The young man who fitted it was a credit to himself. I would highly recommend this company."
      },
      {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "author": { "@type": "Person", "name": "Elaine McHugh" },
        "datePublished": "2026-05-15",
        "reviewBody": "Excellent service."
      }
    ]
  }
  </script>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Emergency Plumber Liverpool",
    "description": "24/7 emergency plumber and 24 hour plumber across Liverpool L1 to L40. James, a Gas Safe registered plumber, offers full emergency plumbing services and does every job himself. 30 minute response. Fixed hourly rates from £80 with 1 hour minimum. Burst pipes, water coming through ceiling, no hot water, boiler breakdown, gas leaks, frozen pipes. Gas Safe registered.",
    "provider": { "@id": "https://liverpoolemergencyplumber.co.uk/#business" },
    "areaServed": { "@type": "Place", "name": "Liverpool, L1-L40" },
    "hoursAvailable": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "offers": [
      { "@type": "Offer", "name": "Weekday Emergency Plumber Liverpool", "price": "80", "priceCurrency": "GBP", "description": "Monday to Friday 9am to 5pm. 1 hour minimum charge." },
      { "@type": "Offer", "name": "Weekend Emergency Plumber Liverpool", "price": "120", "priceCurrency": "GBP", "description": "Saturday and Sunday 9am to 1pm. 1 hour minimum charge." },
      { "@type": "Offer", "name": "Out of Hours Emergency Plumber Liverpool", "price": "150", "priceCurrency": "GBP", "description": "Nights and bank holidays, 24/7" }
    ]
  }
  </script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <link rel="preload" as="image" fetchpriority="high" slot="head" href="/images/jobs/leak-under-bath-traced-480.webp" imagesrcset="/images/jobs/leak-under-bath-traced-480.webp 480w, /images/jobs/leak-under-bath-traced-960.webp 960w" imagesizes="(max-width: 900px) 100vw, 520px" />

  <!-- HERO -->
  <section class="hp-hero">
    <div class="hp-wrap hp-hero-grid">
      <div class="hp-hero-copy">
        <p class="hp-live"><span class="hp-dot"></span> Answering now · 24 hours a day</p>
        <h1>Emergency Plumber Liverpool</h1>
        <p class="hp-lead">Leaks, burst pipes and boiler breakdowns fixed fast. James is Gas Safe registered and does every job himself.</p>
        <a href={TEL} class="hp-call-big">
          <span class="hp-call-label">Call James now</span>
          <span class="hp-call-num">{PHONE}</span>
        </a>
        <ul class="hp-promises">
          <li><strong>30 min</strong> guaranteed response, 28 min average</li>
          <li><strong>No</strong> call-out fee</li>
          <li><strong>From £80</strong> an hour</li>
          <li><strong>Gas Safe</strong> registered</li>
        </ul>
        <a class="hp-stars" href="#reviews"><span aria-hidden="true">★★★★★</span> <strong>5.0</strong> from 53 Google reviews</a>
      </div>
      <figure class="hp-hero-photo">
        <picture>
          <source type="image/webp" srcset="/images/jobs/leak-under-bath-traced-480.webp 480w, /images/jobs/leak-under-bath-traced-960.webp 960w" sizes="(max-width: 900px) 100vw, 520px" />
          <img src="/images/jobs/leak-under-bath-traced-960.jpg" width="960" height="720" alt="James tracing a leak under a bath in a Liverpool home" fetchpriority="high" />
        </picture>
        <figcaption>A real job: a hidden leak traced under a bath.</figcaption>
      </figure>
    </div>
  </section>

  <!-- PROBLEM PICKER -->
  <section class="hp-sec hp-sec-tint" id="emergencies">
    <div class="hp-wrap">
      <h2>What is the problem?</h2>
      <p class="hp-sub">Pick what is happening, then call. James fixes all of these across Liverpool.</p>
      <div class="hp-problems">
        {problems.map((p) => (
          <div class={`hp-problem${p.urgent ? ' is-urgent' : ''}`}>
            <div class="hp-problem-top">
              <span class="hp-problem-icon" aria-hidden="true">{p.icon}</span>
              <h3>{p.title}</h3>
            </div>
            <p>{p.text}</p>
            <div class="hp-problem-actions">
              <a href={TEL} class="hp-btn hp-btn-orange">Call {PHONE}</a>
              <a href={p.href} class="hp-more">{p.link} →</a>
            </div>
          </div>
        ))}
      </div>
      <div class="hp-gas">
        <strong>Smell gas?</strong> Get out, do not use switches, and call the National Gas Emergency line on <a href="tel:08001119999">0800 111 999</a> first. Once it is made safe, our <a href="/emergency-gas-engineer-liverpool">emergency gas engineer</a> can repair the fault.
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="hp-sec" id="reviews">
    <div class="hp-wrap">
      <div class="hp-rating">
        <div class="hp-rating-num">5.0</div>
        <div>
          <div class="hp-rating-stars" aria-hidden="true">★★★★★</div>
          <div>53 Google reviews</div>
        </div>
      </div>
      <h2>What Liverpool customers say</h2>
      <p class="hp-sub">Word for word from our Google reviews.</p>
      <div class="hp-reviews">
        {reviews.map((r) => (
          <figure class="hp-review">
            <div class="hp-review-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote>“{r.text}”</blockquote>
            <figcaption><strong>{r.name}</strong> · {r.job} · Google review</figcaption>
          </figure>
        ))}
      </div>
      <p class="hp-center"><a class="hp-more" href="https://www.google.com/search?q=Liverpool+Emergency+Plumber+reviews" target="_blank" rel="noopener">Read all our reviews on Google →</a></p>
    </div>
  </section>

  <!-- PRICES -->
  <section class="hp-sec hp-sec-tint" id="prices">
    <div class="hp-wrap hp-narrow">
      <h2>Emergency plumber prices in Liverpool</h2>
      <p class="hp-sub">Fixed hourly rates. No call-out fee. You get a written quote before any work starts.</p>
      <table class="hp-prices">
        <thead><tr><th scope="col">When</th><th scope="col">Hourly rate</th></tr></thead>
        <tbody>
          <tr><th scope="row">Weekdays<span>Monday to Friday, 9am to 5pm</span></th><td>£80</td></tr>
          <tr><th scope="row">Weekends<span>Saturday and Sunday, 9am to 1pm</span></th><td>£120</td></tr>
          <tr><th scope="row">Out of hours<span>Nights and bank holidays, 24/7</span></th><td>£150</td></tr>
          <tr><th scope="row">Boiler fault diagnosis<span>Gas Safe registered</span></th><td>£95</td></tr>
        </tbody>
      </table>
      <ul class="hp-ticks">
        <li>1 hour minimum, then charged in 30 minute blocks</li>
        <li>Parts at cost</li>
        <li>12-month workmanship guarantee</li>
        <li>£2 million public liability insurance</li>
      </ul>
      <a href={TEL} class="hp-btn hp-btn-orange hp-btn-wide">Call {PHONE} for a price</a>
    </div>
  </section>

  <!-- RECENT JOBS -->
  <section class="hp-sec" id="jobs">
    <div class="hp-wrap">
      <h2>Recent jobs by James</h2>
      <p class="hp-sub">Real photos from Liverpool homes. No stock images.</p>
      <div class="hp-jobs">
        {jobs.map((j) => (
          <figure class="hp-job">
            <picture>
              <source type="image/webp" srcset={`/images/jobs/${j.img}-480.webp 480w, /images/jobs/${j.img}-960.webp 960w`} sizes="(max-width: 600px) 50vw, 360px" />
              <img src={`/images/jobs/${j.img}-960.jpg`} alt={j.alt} loading="lazy" decoding="async" width="480" height="480" />
            </picture>
            <figcaption>{j.cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="hp-sec hp-sec-navy">
    <div class="hp-wrap">
      <h2>What happens when you call</h2>
      <ol class="hp-steps">
        <li><strong>You call {PHONE}.</strong> Tell us what is happening. We give you safety tips on the phone, like where to turn off your water.</li>
        <li><strong>James comes to you.</strong> Guaranteed 30 minute response across Liverpool L1 to L40, with the most common parts in the van.</li>
        <li><strong>It is fixed.</strong> You get a clear price before work starts. James repairs the fault, tests it and cleans up before he leaves.</li>
      </ol>
      <a href={TEL} class="hp-btn hp-btn-orange hp-btn-wide">Call {PHONE}</a>
    </div>
  </section>

  <!-- WHY US + LEAK DETECTION -->
  <section class="hp-sec">
    <div class="hp-wrap hp-two">
      <div>
        <h2>Why Liverpool chooses us</h2>
        <ul class="hp-why">
          <li><strong>One plumber, every job.</strong> James does every job himself. You know exactly who is coming to your home.</li>
          <li><strong>Gas Safe registered.</strong> Boilers, gas cookers and hobs. <a href="https://www.gassaferegister.co.uk" target="_blank" rel="noopener">Check the Gas Safe Register</a>.</li>
          <li><strong>Guaranteed 30 minute response.</strong> Across every Liverpool postcode from L1 to L40.</li>
          <li><strong>Clear prices.</strong> From £80 an hour, no call-out fee, written quote first.</li>
          <li><strong>Guaranteed work.</strong> 12 months on workmanship. New boilers come with up to a 10 year warranty.</li>
        </ul>
      </div>
      <div class="hp-card">
        <h2>Leak detection in Liverpool</h2>
        <p>Not every leak is easy to see. A damp patch on the ceiling, a rising water bill or a boiler that keeps losing pressure can all mean a hidden leak.</p>
        <p>James finds it by tracing the pipework, lifting floorboards and pressure testing. Under tiled or laminate floors he can cut a neat inspection hole in the ceiling below instead of lifting the floor. Then he repairs it, and we can give you a leak report for your insurer.</p>
        <a href="/leak-detection-liverpool" class="hp-more">More about leak detection →</a>
      </div>
    </div>
  </section>

  <!-- AREAS -->
  <section class="hp-sec hp-sec-tint" id="areas">
    <div class="hp-wrap">
      <h2>Plumber near me in Liverpool</h2>
      <p class="hp-sub">We cover all Liverpool postcodes from L1 to L40, plus Formby, Southport, St Helens and the Wirral. Pick your area:</p>
      <ul class="hp-areas">
        {areas.map((a) => <li><a href={`/emergency-plumber-${a}`}>{areaName(a)}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="hp-sec" id="faq">
    <div class="hp-wrap hp-narrow">
      <h2>Questions people ask</h2>
      <div class="hp-faqs">
        {faqs.map((f, i) => (
          <details class="hp-faq" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="hp-final">
    <div class="hp-wrap hp-narrow">
      <h2>Leak, burst pipe or boiler down?</h2>
      <p>Call now. A guaranteed 30 minute response across Liverpool, from £80 an hour with no call-out fee.</p>
      <a href={TEL} class="hp-call-big hp-call-light">
        <span class="hp-call-label">Call James now</span>
        <span class="hp-call-num">{PHONE}</span>
      </a>
      <p class="hp-final-small">Not urgent? <a href="/get-started">Book a visit at a time that suits you</a>.</p>
    </div>
  </section>

</BaseLayout>

<style>
  .hp-wrap { max-width: 1140px; margin: 0 auto; padding: 0 1.25rem; }
  .hp-narrow { max-width: 760px; }
  .hp-sec { padding: 3.5rem 0; text-align: left; }
  .hp-sec-tint { background: #f1f5f9; }
  .hp-sec-navy { background: var(--navy); color: #fff; }
  .hp-sec-navy h2 { color: #fff; }
  .hp-sec h2, .hp-final h2 { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: clamp(1.9rem, 5vw, 2.6rem); line-height: 1.05; color: var(--navy); margin: 0 0 0.6rem; text-align: left; }
  .hp-sec-navy h2 { color: #fff; }
  .hp-sub { font-size: 1.08rem; color: #475569; margin: 0 0 1.75rem; max-width: 46rem; text-align: left; line-height: 1.6; }
  .hp-center { text-align: center; margin-top: 1.5rem; }
  .hp-more { color: var(--orange-dark); font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  .hp-more:hover { color: var(--navy); }

  .hp-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0.7rem 1.2rem; border-radius: 10px; font: 900 1.2rem 'Barlow Condensed', sans-serif; letter-spacing: 0.02em; text-decoration: none; }
  .hp-btn-orange { background: var(--orange); color: #fff; box-shadow: 0 6px 18px rgba(234,88,12,0.28); }
  .hp-btn-orange:hover { background: var(--orange-dark); }
  .hp-btn-wide { display: flex; width: 100%; max-width: 420px; margin: 1.75rem auto 0; font-size: 1.4rem; min-height: 58px; }

  /* hero */
  .hp-hero { background: linear-gradient(180deg, #fff 0%, #fff7ed 100%); padding: 2rem 0 3rem; text-align: left; }
  .hp-hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.5rem; align-items: center; }
