---
import BaseLayout from '../layouts/BaseLayout.astro';

const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const ICONS = {
  drop: '<path d="M12 2.7s-6.5 7-6.5 11.8a6.5 6.5 0 0 0 13 0C18.5 9.7 12 2.7 12 2.7z"/>',
  ceiling: '<path d="M3 5h18"/><path d="M8 9.5c0 1.4-1.2 2.6-1.2 3.6a1.2 1.2 0 0 0 2.4 0c0-1-1.2-2.2-1.2-3.6z"/><path d="M16 12c0 1.6-1.5 3-1.5 4.2a1.5 1.5 0 0 0 3 0c0-1.2-1.5-2.6-1.5-4.2z"/><path d="M12 5v3"/>',
  flame: '<path d="M12 2.5c.5 3.5 5.5 5.5 5.5 11a5.5 5.5 0 0 1-11 0c0-2.6 1.4-4 2.5-5.5.3 2 1.3 3 2.3 3.2C10.8 8 11 5 12 2.5z"/>',
  thermo: '<path d="M14 14.8V4.5a2 2 0 0 0-4 0v10.3a4 4 0 1 0 4 0z"/><path d="M4 4l16 16"/>',
  radiator: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7.5 6v12M12 6v12M16.5 6v12M5 18v2M19 18v2"/>',
  tap: '<path d="M3 9h9a5 5 0 0 1 5 5v1"/><path d="M8 9V5M5 5h6"/><path d="M17 18.5c0 .8-.6 1.5-1.2 2.5h2.4c-.6-1-1.2-1.7-1.2-2.5z"/>',
  toilet: '<path d="M5 3h6v7H5z"/><path d="M4 10h14a0 0 0 0 1 0 0 6 6 0 0 1-6 6H10a6 6 0 0 1-6-6z"/><path d="M9 16l-1 5h7l-1-5"/>',
  shower: '<path d="M4 20V8a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4"/><path d="M10 8h8"/><path d="M12 12v1M15 12v1M18 12v1M12 16v1M15 16v1M18 16v1"/>',
  gauge: '<circle cx="12" cy="13" r="8"/><path d="M12 13l4-4"/><path d="M8 21h8"/>',
};
const problems = [
  { icon: 'drop', title: 'Leak or burst pipe', text: 'Water pouring or dripping', href: '/burst-pipe-repair-liverpool' },
  { icon: 'ceiling', title: 'Water through ceiling', text: 'Drips or a wet patch above', href: '/leak-detection-liverpool' },
  { icon: 'flame', title: 'Boiler broken', text: 'Error code, no heating', href: '/boiler-repair-liverpool' },
  { icon: 'thermo', title: 'No hot water', text: 'Cold taps and showers', href: '/no-heating-no-hot-water-liverpool' },
  { icon: 'radiator', title: 'Radiator leaking', text: 'Valve, pipe or radiator', href: '/radiators-liverpool' },
  { icon: 'tap', title: 'Sink or tap leaking', text: 'Under the sink or dripping', href: '/leak-detection-liverpool' },
  { icon: 'shower', title: 'Shower not working', text: 'No flow, too hot or cold', href: '/shower-repair-liverpool' },
  { icon: 'toilet', title: 'Toilet not flushing', text: 'Or running all the time', href: '/toilet-repair-liverpool' },
];

const smallJobs = [
  { title: 'Outside tap fitted', price: '£145', href: '/outside-tap-installation-liverpool' },
  { title: 'Tap swapped', price: '£110', href: '/tap-replacement-liverpool' },
  { title: 'Gas hob fitted', price: '£120', href: '/gas-hob-installation-liverpool' },
  { title: 'Kitchen sink swapped', price: '£225', href: '/kitchen-sink-replacement-liverpool' },
  { title: 'Radiator valve fitted', price: '£65', href: '/radiator-valve-replacement-liverpool' },
  { title: 'Smart thermostat, any brand', price: '£120', href: '/smart-thermostat-installation-liverpool' },
];

const reviews = [
  { name: 'Brendan C', job: 'Boiler repair', text: 'James was amazing and was at my house within 30 mins of calling on a sunday. He has not only fixed my boiler but improved it and taught me how to fix the problem in future. Affordable and easygoing great plumber and gas fitter!' },
  { name: 'Amanda', job: 'Radiator leak', text: 'Responded very quickly to my unexpected radiator pipe leak and fixed the issue. Very knowledgeable and reassuring - he did a very tidy job and cleaned up well. Would recommend.' },
  { name: 'James Alexander', job: 'Burst pipe', text: 'Great company, came within 30 mins for emergency burst pipe, couldn’t praise them enough !!' },
  { name: 'Edward M', job: 'Leaking pipe and boiler', text: 'James came out and fixed a leaking pipe and even got my boiler up and running by fixing an air lock. Professional , on time, cleaned up after himself and charged a fair rate.' },
  { name: 'David H', job: 'Boiler and leaking tap', text: 'Amazing service James was very professional. Fixed my boiler and leaking tap very knowledgeable very fast and polite great company 100% recommended' },
  { name: 'Roger D', job: 'No hot water', text: 'Wonderful service. Came within 24 hrs and got our hot water back on with an improvised repair. Returned few days later with the part needed to restore everything to normal Charming, calm, methodical. I highly recommend' },
];

const jobs = [
  { img: 'leak-under-bath-traced', alt: 'Leak traced under a bath panel in a Liverpool home', cap: 'Leak traced under a bath' },
  { img: 'failed-pipe-fitting-leak', alt: 'Failed pipe fitting found leaking and replaced', cap: 'Failed fitting found and replaced' },
  { img: 'gas-hob-oven-fitted', alt: 'Gas hob and oven fitted in a Liverpool kitchen', cap: 'Gas hob and oven fitted' },
  { img: 'shower-room-fitted', alt: 'New shower room fitted in a Liverpool home', cap: 'Shower room fitted' },
  { img: 'towel-radiator-fitted', alt: 'Anthracite towel radiator fitted in a bathroom', cap: 'Towel radiator fitted' },
  { img: 'bathroom-bath-shower-fitted', alt: 'New bath and shower fitted in a Liverpool bathroom', cap: 'Bath and shower fitted' },
];

const areas = ['aigburth','aintree','allerton','anfield','bootle','childwall','city-centre','crosby','everton','fazakerley','formby','garston','huyton','kirkby','maghull','mossley-hill','norris-green','old-swan','southport','st-helens','toxteth','walton','wavertree','west-derby','wirral','woolton'];
const areaName = (a) => ({ 'city-centre': 'City Centre', 'st-helens': 'St Helens', 'mossley-hill': 'Mossley Hill', 'norris-green': 'Norris Green', 'old-swan': 'Old Swan', 'west-derby': 'West Derby' }[a] ?? a[0].toUpperCase() + a.slice(1));

const faqs = [
  { q: 'How much does an emergency plumber cost in Liverpool?', a: 'Weekdays 9am to 4pm: £120 for the first hour. Weekday evenings, nights and weekends: £150 for the first hour. Bank holidays: £180 for the first hour. There is no call-out fee. The first hour includes finding the fault, and most jobs are fixed within it. Any extra time or parts are priced before we carry on.' },
  { q: 'Is there a call-out fee?', a: 'No. There is no call-out fee. You pay for the first hour of the engineer\'s time, which includes finding the fault: £120 on weekdays 9am to 4pm, £150 on weekday evenings, nights and weekends, and £180 on bank holidays. Nothing is added for coming out.' },
  { q: 'How quickly can you get to me?', a: 'Our 30 minute response is guaranteed across Liverpool L1 to L40, and our average arrival time is 28 minutes. Call 0151 558 0334 and we will tell you when an engineer will arrive.' },
  { q: 'Do you cover commercial properties?', a: 'Yes. We cover commercial plumbing emergencies across Liverpool 24/7 at the same rates as homes. No commercial premium.' },
  { q: 'Can you find a leak I cannot see?', a: 'Yes. We trace hidden leaks by lifting floorboards and pressure testing the pipework. If a leak is under a tiled or laminate floor, we cut a neat inspection hole in the ceiling below. Then we repair it.' },
  { q: 'Can you give me a leak report for my insurance?', a: 'Yes. We can provide a leak report for your insurer explaining where the leak was and what was repaired.' },
  { q: 'How much is a boiler repair?', a: 'A boiler repair is £120 for the first hour on weekdays 9am to 4pm, £150 on weekday evenings, nights and weekends, and £180 on bank holidays. The first hour includes diagnosis, and faults that do not need a part are usually fixed within it. No call-out fee. Gas work is done by Gas Safe registered engineers.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Gas work is done by Gas Safe registered engineers. You can check the register at gassaferegister.co.uk. It is illegal for anyone who is not Gas Safe registered to work on gas appliances.' },
  { q: 'Who will come to my home?', a: 'One of our highly trained plumbing and heating engineers. Our team is led by James, and gas work is always done by a Gas Safe registered engineer. All our work is insured and guaranteed for 12 months.' },
  { q: 'Is your work guaranteed?', a: 'Yes. All our work carries a 12-month workmanship guarantee, and we hold £2 million public liability insurance.' },
  { q: 'Are you a 24 hour plumber?', a: 'Yes. We take emergency calls 24 hours a day, 7 days a week, including nights, weekends and bank holidays.' },
  { q: 'What postcodes do you cover?', a: 'We cover every Liverpool postcode from L1 to L40. That includes the city centre, Anfield, Aigburth, Wavertree, West Derby, Woolton, Bootle, Crosby, Maghull, Kirkby and Huyton, plus Formby, Southport, St Helens and the Wirral.' },
  { q: 'What should I do if I smell gas?', a: 'Leave the property and do not use light switches or flames. Turn off the gas at the meter if it is safe, and call the National Gas Emergency number on 0800 111 999. Once the leak is made safe, call us on 0151 558 0334 to repair the appliance or pipework.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
import CallStrip from '../components/CallStrip.astro';
import { telify } from '../lib/tel';
---

<BaseLayout
  title="Emergency Plumber Liverpool | Fastest 30min Response | From £120"
  description="Emergency plumber Liverpool available 24/7. 30 minute response across L1 to L40. Gas Safe registered. A trusted team of engineers, led by James. Burst pipes, boiler breakdowns, no hot water, gas leaks. From £120 for the first hour. Call 0151 558 0334."
  canonical="https://liverpoolemergencyplumber.co.uk"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "Plumber"],
    "@id": "https://liverpoolemergencyplumber.co.uk/#business",
    "name": "Liverpool Emergency Plumber",
    "url": "https://liverpoolemergencyplumber.co.uk",
    "telephone": "+441515580334",
    "email": "emergencyplumberliverpool@gmail.com",
    "priceRange": "From £120",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "29 Park Road",
      "addressLocality": "Kirkby",
      "addressRegion": "Merseyside",
      "postalCode": "L32 2AL",
      "addressCountry": "GB"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "areaServed": [
      { "@type": "Place", "name": "Liverpool City Centre" },
      { "@type": "Place", "name": "Aigburth" },
      { "@type": "Place", "name": "Aintree" },
      { "@type": "Place", "name": "Allerton" },
      { "@type": "Place", "name": "Anfield" },
      { "@type": "Place", "name": "Bootle" },
      { "@type": "Place", "name": "Childwall" },
      { "@type": "Place", "name": "Crosby" },
      { "@type": "Place", "name": "Everton" },
      { "@type": "Place", "name": "Fazakerley" },
      { "@type": "Place", "name": "Formby" },
      { "@type": "Place", "name": "Garston" },
      { "@type": "Place", "name": "Huyton" },
      { "@type": "Place", "name": "Kirkby" },
      { "@type": "Place", "name": "Maghull" },
      { "@type": "Place", "name": "Mossley Hill" },
      { "@type": "Place", "name": "Norris Green" },
      { "@type": "Place", "name": "Old Swan" },
      { "@type": "Place", "name": "Southport" },
      { "@type": "Place", "name": "St Helens" },
      { "@type": "Place", "name": "Toxteth" },
      { "@type": "Place", "name": "Walton" },
      { "@type": "Place", "name": "Wavertree" },
      { "@type": "Place", "name": "West Derby" },
      { "@type": "Place", "name": "Wirral" },
      { "@type": "Place", "name": "Woolton" }
    ],
    "review": [
      {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "author": { "@type": "Person", "name": "James Alexander" },
        "datePublished": "2026-05-14",
        "reviewBody": "Great company, came within 30 mins for emergency burst pipe, couldn't praise them enough!"
      },
      {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "author": { "@type": "Person", "name": "John Manley" },
        "datePublished": "2026-05-16",
        "reviewBody": "Fantastic service, less than two hours after phoning up to order a new shower the job was done. The young man who fitted it was a credit to himself. I would highly recommend this company."
      },
      {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "author": { "@type": "Person", "name": "Elaine McHugh" },
        "datePublished": "2026-05-15",
        "reviewBody": "Excellent service."
      }
    ]
  }
  </script>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Emergency Plumber Liverpool",
    "description": "24/7 emergency plumber and 24 hour plumber across Liverpool L1 to L40. A trusted team of Gas Safe registered plumbing and heating engineers, led by James, offering full emergency plumbing services. 30 minute response. Fixed prices from £120 for the first hour. Burst pipes, water coming through ceiling, no hot water, boiler breakdown, gas leaks, frozen pipes. Gas Safe registered.",
    "provider": { "@id": "https://liverpoolemergencyplumber.co.uk/#business" },
    "areaServed": { "@type": "Place", "name": "Liverpool, L1-L40" },
    "hoursAvailable": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "offers": [
      { "@type": "Offer", "name": "Weekday Emergency Plumber Liverpool", "price": "120", "priceCurrency": "GBP", "description": "Monday to Friday 9am to 4pm. Price for the first hour. No call-out fee." },
      { "@type": "Offer", "name": "Evening and Weekend Emergency Plumber Liverpool", "price": "150", "priceCurrency": "GBP", "description": "Weekdays after 4pm, nights and weekends. Price for the first hour. No call-out fee." },
      { "@type": "Offer", "name": "Bank Holiday Emergency Plumber Liverpool", "price": "180", "priceCurrency": "GBP", "description": "Bank holidays. Price for the first hour. No call-out fee." }
    ]
  }
  </script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <link rel="preload" as="image" fetchpriority="high" slot="head" media="(min-width: 601px)" href="/images/jobs/leak-under-bath-traced-480.webp" imagesrcset="/images/jobs/leak-under-bath-traced-480.webp 480w, /images/jobs/leak-under-bath-traced-960.webp 960w" imagesizes="(max-width: 900px) 100vw, 520px" />

  <!-- HERO -->
  <section class="hp-hero" id="hero">
    <div class="hp-wrap hp-hero-grid">
      <div class="hp-hero-copy">
        <p class="hp-live"><span class="hp-dot"></span> Answering now · 24 hours a day</p>
        <h1>Emergency Plumber Liverpool</h1>
        <p class="hp-lead">Leaks, burst pipes and boiler breakdowns fixed fast by our team of trusted plumbing and heating engineers.</p>
        <a href={TEL} class="hp-call-big">
          <span class="hp-call-label">Call us now</span>
          <span class="hp-call-num">{PHONE}</span>
        </a>
        <ul class="hp-promises">
          <li><strong>30 min</strong> guaranteed response</li>
          <li><strong>£0</strong> call-out fee</li>
          <li><strong>£120</strong> first hour, weekdays</li>
          <li><strong>Gas Safe</strong> registered team</li>
        </ul>
        <a class="hp-stars" href="#reviews"><span aria-hidden="true">★★★★★</span> <strong>5.0</strong> from 53 Google reviews</a>
      </div>
      <figure class="hp-hero-photo">
        <picture>
          <source media="(max-width: 600px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
          <source type="image/webp" srcset="/images/jobs/leak-under-bath-traced-480.webp 480w, /images/jobs/leak-under-bath-traced-960.webp 960w" sizes="(max-width: 900px) 100vw, 520px" />
          <img src="/images/jobs/leak-under-bath-traced-960.jpg" width="960" height="720" alt="Our engineer tracing a leak under a bath in a Liverpool home" fetchpriority="high" />
        </picture>
        <figcaption>A real job: a hidden leak traced under a bath.</figcaption>
      </figure>
    </div>
  </section>

  <!-- PROBLEM PICKER -->
  <section class="hp-sec hp-sec-tint" id="emergencies">
    <div class="hp-wrap">
      <h2>What is the problem?</h2>
      <p class="hp-sub">We fix all of these across Liverpool. Tap yours to see how, or just call.</p>
      <div class="hp-tiles">
        {problems.map((p) => (
          <a href={p.href} class="hp-tile">
            <svg class="hp-tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[p.icon]} />
            <strong>{p.title}</strong>
            <span>{p.text}</span>
          </a>
        ))}
      </div>
      <a href={TEL} class="hp-call-big hp-call-center">
        <span class="hp-call-label">Whatever it is, call us</span>
        <span class="hp-call-num">{PHONE}</span>
      </a>
      <div class="hp-gas">
        <strong>Smell gas?</strong> Get out, do not use switches, and call the National Gas Emergency line on <a href="tel:08001119999">0800 111 999</a> first. Once it is made safe, our <a href="/emergency-gas-engineer-liverpool">emergency gas engineer</a> can repair the fault.
      </div>
    </div>
  </section>

  <!-- PRICES + HOW IT WORKS -->
  <section class="hp-sec" id="prices">
    <div class="hp-wrap hp-two hp-two-prices">
      <div>
        <h2>Emergency plumber prices in Liverpool</h2>
        <p class="hp-sub">One fixed price for the first hour, including finding the fault. No call-out fee.</p>
        <table class="hp-prices">
          <thead><tr><th scope="col">When</th><th scope="col">First hour</th></tr></thead>
          <tbody>
            <tr><th scope="row">Weekdays<span>Monday to Friday, 9am to 4pm</span></th><td>£120</td></tr>
            <tr><th scope="row">Evenings and weekends<span>Weekdays after 4pm, nights, Saturday and Sunday</span></th><td>£150</td></tr>
            <tr><th scope="row">Bank holidays<span>24 hours</span></th><td>£180</td></tr>
          </tbody>
        </table>
        <p class="hp-price-boiler"><strong>Boiler repairs are the same price.</strong> <a href="/boiler-repair-liverpool">Boiler repair →</a></p>
        <ul class="hp-ticks">
          <li>Extra time priced before we carry on</li>
          <li>Parts at cost</li>
          <li>12-month workmanship guarantee</li>
          <li>Same rates for businesses</li>
        </ul>
      </div>
      <div class="hp-how">
        <h3>What happens when you call</h3>
        <ol class="hp-steps">
          <li><strong>You call {PHONE}.</strong> Tell us what is happening. We talk you through making it safe, like turning off your water.</li>
          <li><strong>An engineer comes to you.</strong> Guaranteed within 30 minutes across L1 to L40. Average arrival 28 minutes.</li>
          <li><strong>It is fixed.</strong> You agree the price first. Our engineer repairs it, tests it and cleans up before leaving.</li>
        </ol>
        <a href={TEL} class="hp-btn hp-btn-orange hp-btn-block">Call {PHONE}</a>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="hp-sec" id="reviews">
    <div class="hp-wrap">
      <div class="hp-rating">
        <div class="hp-rating-num">5.0</div>
        <div>
          <div class="hp-rating-stars" aria-hidden="true">★★★★★</div>
          <div>53 Google reviews</div>
        </div>
      </div>
      <h2>What Liverpool customers say</h2>
      <p class="hp-sub">Word for word from our Google reviews.</p>
      <div class="hp-reviews">
        {reviews.map((r) => (
          <figure class="hp-review">
            <div class="hp-review-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote>“{r.text}”</blockquote>
            <figcaption><strong>{r.name}</strong> · {r.job} · Google review</figcaption>
          </figure>
        ))}
      </div>
      <p class="hp-center"><a class="hp-more" href="https://www.google.com/search?q=Liverpool+Emergency+Plumber+reviews" target="_blank" rel="noopener">Read all our reviews on Google →</a></p>
    </div>
  </section>

  <!-- WHILE YOU WAIT -->
  <section class="hp-sec hp-sec-tint" id="while-you-wait">
    <div class="hp-wrap">
      <h2>What to do while you wait</h2>
      <p class="hp-sub">Help is on the way. These steps stop the damage getting worse.</p>
      <div class="hp-wait">
        <div class="hp-wait-card">
          <h3>Leak or burst pipe</h3>
          <ol>
            <li>Turn off the water at the stopcock. It is usually under the kitchen sink, in a hallway cupboard or under the stairs. Turn it clockwise.</li>
            <li>Switch off the boiler and any immersion heater.</li>
            <li>Turn on the cold taps to drain the pipes.</li>
            <li>Catch drips with buckets and towels. Move valuables away.</li>
            <li>Take photos of the damage for your insurer.</li>
          </ol>
        </div>
        <div class="hp-wait-card hp-wait-warn">
          <h3>Water near electrics</h3>
          <ol>
            <li>Do not touch switches, sockets or light fittings that are wet.</li>
            <li>If water is coming through a light fitting, turn off the electricity at the fuse box if it is safe to reach.</li>
            <li>Do not turn it back on until an electrician has checked it. Our partner <a href="https://www.idealelectricalsolutions.co.uk/emergency-electrician">emergency electrician</a> can help.</li>
          </ol>
        </div>
        <div class="hp-wait-card">
          <h3>Boiler stopped working</h3>
          <ol>
            <li>Check the pressure gauge. It should read between 1 and 1.5 bar.</li>
            <li>If it is below 1 bar, you can top it up with the filling loop if you know how.</li>
            <li>Note any error code on the display. It helps our engineer bring the right part.</li>
            <li>Never take the boiler casing off. Only a Gas Safe registered engineer should work inside it.</li>
          </ol>
        </div>
        <div class="hp-wait-card hp-wait-danger">
          <h3>Smell of gas</h3>
          <ol>
            <li>Do not use switches, flames or anything that could spark.</li>
            <li>Open doors and windows.</li>
            <li>Turn off the gas at the meter if it is safe to do so.</li>
            <li>Get everyone outside and call the National Gas Emergency line on <a href="tel:08001119999">0800 111 999</a>.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- BOILER REPAIR + LEAK DETECTION -->
  <section class="hp-sec" id="boilers-and-leaks">
    <div class="hp-wrap">
      <div class="hp-twin">
        <article class="hp-feature hp-feature-boiler">
          <picture>
            <source type="image/webp" srcset="/images/jobs/boiler-smart-thermostat-fitted-480.webp 480w, /images/jobs/boiler-smart-thermostat-fitted-960.webp 960w" sizes="(max-width: 900px) 100vw, 540px" />
            <img src="/images/jobs/boiler-smart-thermostat-fitted-960.jpg" alt="Boiler and controls fitted by our team in a Liverpool home" loading="lazy" decoding="async" width="960" height="1280" />
          </picture>
          <div class="hp-feature-body">
            <p class="hp-kicker">Gas Safe registered</p>
            <h2>Boiler repair in Liverpool</h2>
            <p>No heating, no hot water, an error code or a boiler that keeps losing pressure. Our Gas Safe registered engineers repair boilers across Liverpool 24/7, with the same guaranteed 30 minute response for breakdowns.</p>
            <ul class="hp-ticks hp-ticks-one">
              <li><strong>From £120</strong> for the first hour, including diagnosis</li>
