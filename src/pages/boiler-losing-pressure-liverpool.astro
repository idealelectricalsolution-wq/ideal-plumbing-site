---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/boiler-losing-pressure-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const faqs = [
  { q: 'What should my boiler pressure be?', a: 'Between 1 and 1.5 bar when the heating is off and the system is cold. It rises a little when the heating is on, often to around 2 bar. Your boiler manual gives the exact figure.' },
  { q: 'Why does my boiler keep losing pressure?', a: 'Water is getting out somewhere. The usual cause is a small leak on a radiator valve or pipe joint. It can also be a faulty pressure relief valve letting water out through a pipe outside, a flat expansion vessel, or a leak inside the boiler.' },
  { q: 'Is it normal to top up the pressure?', a: 'Once in a while, yes, for example after bleeding radiators. If you have to top it up every week or more, there is a fault that needs fixing.' },
  { q: 'Is low boiler pressure dangerous?', a: 'No. The boiler shuts down to protect itself. But a hidden leak can damage floors and ceilings over time, so it is worth finding.' },
  { q: 'What happens if the pressure is too high?', a: 'Above about 2.5 bar when cold, check both filling loop valves are fully closed. Bleeding a radiator lets some water out and lowers it. If it keeps rising, the filling valve or expansion vessel needs looking at. The pressure relief valve will let water out if it gets too high.' },
  { q: 'Where is the pressure relief valve pipe?', a: 'It is usually a copper pipe coming through the wall near the boiler, often pointing down at the ground. If it drips or has a wet patch below it, the valve may be letting water out.' },
  { q: 'Can you find a hidden leak?', a: 'Yes. We check the boiler, valves and visible pipework first, then pressure test the system. See our leak detection service.' },
  { q: 'How much does it cost to fix?', a: 'Our first hour is £120 on weekdays from 9am to 4pm, £150 in the evenings, at night and at weekends, and £180 on bank holidays. It includes finding the fault. There is no call-out fee. Parts are priced before we fit them.' },
  { q: 'My boiler has no filling loop. What do I do?', a: 'Some boilers have a built-in key or lever instead, and some systems are topped up from a tank in the loft. Check your boiler manual, or call us and we will talk you through it.' },
];
---

<ServiceGuide
  url={URL_}
  title="Boiler Losing Pressure? How to Top Up + Fix It | Liverpool"
  description="Boiler keeps losing pressure? How to top it up safely, why it keeps dropping, and when to call. Gas Safe engineers across Liverpool, first hour £120, no call-out fee. Call 0151 558 0334."
  h1="Boiler Losing Pressure in Liverpool?"
  badge="Top up safely · find the leak"
  intro="Boiler pressure below 1 bar? You can usually top it up yourself in a few minutes. If it keeps dropping, water is escaping somewhere and it needs fixing. Our Gas Safe registered engineers find the cause and fix it, with no call-out fee."
  stats={[['1 to 1.5', 'Bar, when cold'], ['£0', 'Call-out fee']]}
  ticks={['24/7', 'No Call-Out Fee', 'Gas Safe Registered', '5.0 on Google']}
  secondaryCta={{ href: '#top-up', label: 'How to top it up' }}
  factsTitle="Boiler pressure at a glance"
  facts={[
    ['Right pressure', '1 to 1.5 bar when the heating is off.'],
    ['Too low', 'Below 1 bar. Top it up with the filling loop.'],
    ['Keeps dropping', 'There is a leak or a faulty valve. Call us.'],
    ['Price', 'First hour £120 weekdays 9am to 4pm. Includes finding the fault.'],
    ['Call-out fee', 'None, day or night.'],
  ]}
  toc={[
    ['top-up', 'How do I top up the pressure?'],
    ['why', 'Why does it keep dropping?'],
    ['check', 'What can I check myself?'],
    ['call', 'When should I call you?'],
    ['cost', 'How much does it cost?'],
  ]}
  reviews={['Edward M', 'Amanda', 'Brendan C', 'David H']}
  reviewTitle="What do customers say?"
  faqs={faqs}
  areasTitle="Where do you fix boilers?"
  areasText="All of Liverpool, L1 to L40, plus Kirkby, Huyton, Bootle, Crosby, Maghull, the Wirral, St Helens, Formby and Southport. Same prices everywhere."
  areas={[
    { href: '/emergency-plumber-aigburth', label: 'Aigburth' },
    { href: '/emergency-plumber-childwall', label: 'Childwall' },
    { href: '/emergency-plumber-woolton', label: 'Woolton' },
    { href: '/emergency-plumber-mossley-hill', label: 'Mossley Hill' },
    { href: '/emergency-plumber-garston', label: 'Garston' },
    { href: '/emergency-plumber-fazakerley', label: 'Fazakerley' },
    { href: '/emergency-plumber-maghull', label: 'Maghull' },
    { href: '/emergency-plumber-kirkby', label: 'Kirkby' },
  ]}
  related={[
    { href: '/boiler-repair-liverpool', title: 'Boiler repair', text: 'All faults and error codes, first hour £120' },
    { href: '/leak-detection-liverpool', title: 'Leak detection', text: 'Find and fix hidden leaks' },
    { href: '/no-heating-no-hot-water-liverpool', title: 'No heating or hot water', text: '5 checks to try before you call' },
    { href: '/frozen-condensate-pipe-liverpool', title: 'Frozen condensate pipe', text: 'The 15 minute winter fix' },
  ]}
  finalTitle="Boiler still losing pressure?"
  finalText="Call us. We find where the water is going and fix it. No call-out fee."
  serviceName="Boiler Losing Pressure Repair Liverpool"
  serviceType="Boiler repair"
  serviceDesc="Boilers losing pressure diagnosed and fixed across Liverpool and Merseyside by Gas Safe registered engineers: leaks, pressure relief valves and expansion vessels. No call-out fee."
  noPackagesOffers={[
    { name: 'Boiler repair, first hour, weekdays 9am to 4pm', price: '120' },
    { name: 'Boiler repair, first hour, evenings, nights and weekends', price: '150' },
  ]}
>
  <section class="brx-sec brx-tint" id="top-up">
    <div class="brx-wrap">
      <h2>How do I top up my boiler pressure?</h2>
      <p class="brx-answer">Use the filling loop under the boiler to let water in until the gauge reads 1 to 1.5 bar. It takes about 5 minutes.</p>
      <ol class="sg-steps">
        <li><strong>Turn the heating off and let it cool.</strong> Read the pressure when the system is cold.</li>
        <li><strong>Find the filling loop.</strong> It is usually a silver braided hose or a small lever or key under the boiler. Your boiler manual shows where it is.</li>
        <li><strong>Open the valve slowly.</strong> You will hear water running in. Watch the pressure gauge.</li>
        <li><strong>Close it at 1 to 1.5 bar.</strong> Close both valves fully, so the pressure does not keep rising.</li>
        <li><strong>Reset the boiler</strong> if it shows a fault, then turn the heating back on.</li>
      </ol>
      <div class="brx-note"><p><strong>Not sure?</strong> Every boiler is a bit different. Follow your boiler manual, or call us on <a href={TEL}>{PHONE}</a> and we will talk you through it.</p></div>
    </div>
  </section>

  <section class="brx-sec" id="why">
    <div class="brx-wrap">
      <h2>Why does my boiler keep losing pressure?</h2>
      <p class="brx-answer">Because water is getting out of the system somewhere. A sealed system should hold its pressure.</p>
      <div class="brx-table-wrap">
        <table class="brx-table">
          <thead><tr><th>Cause</th><th>What you might see</th></tr></thead>
          <tbody>
            <tr><td><strong>A leak on a radiator valve or pipe</strong></td><td>Drips, rust marks, damp patches or stained ceilings</td></tr>
            <tr><td><strong>A faulty pressure relief valve</strong></td><td>A copper pipe outside that drips, or a wet patch below it</td></tr>
            <tr><td><strong>A flat expansion vessel</strong></td><td>Pressure shoots up when the heating is on, then drops</td></tr>
            <tr><td><strong>A leak inside the boiler</strong></td><td>Water under the boiler or inside the casing</td></tr>
            <tr><td><strong>Recently bled radiators</strong></td><td>A one-off drop. Top it up once and it should hold</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="check">
    <div class="brx-wrap">
      <h2>What can I check myself?</h2>
      <p class="brx-answer">Look for water. Most pressure loss leaves a sign somewhere.</p>
      <ul class="sg-ticks">
        <li>Under every radiator valve. Wipe with tissue and look for damp</li>
        <li>Under the boiler, and on the pipes below it</li>
        <li>The copper pipe outside the wall near the boiler</li>
        <li>Ceilings under the bathroom and any upstairs radiators</li>
        <li>Floors near pipes, for damp or warm patches</li>
      </ul>
      <p>Do not take the boiler casing off. Only a Gas Safe registered engineer can work inside a gas boiler.</p>
    </div>
  </section>

  <section class="brx-sec" id="call">
    <div class="brx-wrap">
      <h2>When should I call you?</h2>
      <p class="brx-answer">Call us if you have to top it up more than once in a few weeks, or you can see water leaking.</p>
      <ul class="sg-ticks">
        <li>The pressure drops again within days of topping up</li>
        <li>Water is dripping from the boiler or the pipe outside</li>
        <li>The pressure goes above 2.5 bar when the heating is on</li>
        <li>A damp patch on a ceiling or floor</li>
        <li>You cannot find or use the filling loop</li>
      </ul>
      <p>If we cannot see the leak, we pressure test the system to find it. See <a href="/leak-detection-liverpool">leak detection</a>.</p>
      <div class="brx-cta">
        <p><strong>Pressure keeps dropping?</strong> We find the cause and fix it.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="cost">
    <div class="brx-wrap">
      <h2>How much does it cost?</h2>
      <p class="brx-answer">The first hour is £120 on weekdays, 9am to 4pm, and includes finding the fault. There is no call-out fee.</p>
      <div class="brx-table-wrap">
        <table class="brx-table">
          <thead><tr><th>When</th><th>First hour, inc VAT</th></tr></thead>
          <tbody>
            <tr><td><strong>Weekdays, 9am to 4pm</strong></td><td>£120</td></tr>
            <tr><td><strong>Evenings, nights and weekends</strong></td><td>£150</td></tr>
            <tr><td><strong>Bank holidays</strong></td><td>£180</td></tr>
          </tbody>
        </table>
      </div>
      <p>A new pressure relief valve or expansion vessel repair is priced before we start. See our full <a href="/plumber-prices-liverpool">price list</a>.</p>
    </div>
  </section>
</ServiceGuide>
