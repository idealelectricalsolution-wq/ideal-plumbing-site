---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/smart-thermostat-installation-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'fit-own', tier: 'You buy it', name: 'Fit your own smart thermostat', price: '£120', unit: 'fitted, inc VAT',
    points: ['Any brand: Hive, Nest, Tado, Wiser and more', 'Boiler compatibility checked first', 'Receiver wired, old controls taken off', 'App set up and shown to you'] },
  { id: 'supplied', tier: 'We supply it', popular: true, name: 'Smart thermostat supplied and fitted', price: '£249', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Exact price for your brand before we start', 'We help you pick the right one', 'Fitted, tested and set up on the app', '12-month workmanship guarantee'] },
  { id: 'with-service', tier: 'Best value', name: 'Fitted with a boiler service', price: '£210', unit: 'one visit, inc VAT',
    points: ['£120 boiler service + £90 to fit your thermostat', 'Boiler checked before the new controls go on', 'Service record emailed the same day', 'You supply the thermostat'] },
];

const faqs = [
  { q: 'How much does smart thermostat installation cost in Liverpool?', a: 'With us it is £120 including VAT to fit a thermostat you have bought. Supplied and fitted starts from £249, and we give you the exact price for your brand first. Fitted on the same visit as a boiler service, it is £210 for both.' },
  { q: 'Which smart thermostat brands do you fit?', a: 'All of them. Our engineers fit Hive, Google Nest, Tado, Drayton Wiser, Honeywell Home (T6 and evohome), Netatmo, Danfoss, Worcester Bosch EasyControl, Vaillant controls, Baxi uSense, Ideal Halo, Salus and others.' },
  { q: 'Do you fit Hive?', a: 'Yes. We fit Hive thermostats for heating only, or with hot water control if you have a cylinder. It is £120 to fit one you have bought, or from £249 supplied and fitted.' },
  { q: 'Do you fit Google Nest thermostats?', a: 'Yes. We fit the Nest thermostat and wire its Heat Link receiver to your boiler. We check first whether your boiler can use OpenTherm, so the Nest can control the boiler more finely.' },
  { q: 'Do you fit Tado?', a: 'Yes. We fit Tado smart thermostats and Tado smart radiator thermostats. Smart radiator valves are £65 per radiator to fit if you supply them.' },
  { q: 'Will a smart thermostat work with my boiler?', a: 'Almost every working gas boiler can take a smart thermostat. Some brands work better with some boilers. We check your boiler and wiring before we fit anything, and tell you if a different model would suit you better.' },
  { q: 'Can I fit a smart thermostat myself?', a: 'Some are sold as DIY. But most need mains wiring at the boiler or the old programmer. If you are not sure, it is safer to have it fitted. A wrong connection can stop your heating or damage the boiler controls.' },
  { q: 'How long does it take to fit?', a: 'Most installs take 1 to 2 hours. That includes taking off the old controls, wiring the receiver, testing, and setting up the app with you.' },
  { q: 'Can it control my hot water too?', a: 'If you have a hot water cylinder, yes, with the right model. On a combi boiler, hot water is made on demand, so the thermostat mainly controls the heating.' },
  { q: 'Will a smart thermostat save me money?', a: 'It can help cut wasted heating. You can turn the heating down when you are out, and heat the house only when you need it. How much you save depends on your home and how you use it.' },
  { q: 'Does a new boiler come with a smart thermostat?', a: 'Yes. Every combi boiler package on our boiler installation page includes a smart thermostat, fitted and set up for you.' },
  { q: 'Can you fit smart radiator valves?', a: 'Yes. Smart radiator valves let you set a different temperature in each room. We fit your own for £65 per radiator. A standard TRV supplied and fitted is also £65, or up to 6 for £295.' },
  { q: 'Do I need Wi-Fi?', a: 'For the app and remote control, yes. Most smart thermostats keep running your heating schedule if the Wi-Fi drops. Put the hub near your router if the brand uses one.' },
];
---

