---
import BaseLayout from '../layouts/BaseLayout.astro';

const URL_ = 'https://liverpoolemergencyplumber.co.uk/boiler-repair-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';
const UPDATED = '26 November 2026';

// ---------- Common problems ----------
const guides: Record<string, [string, string]> = {
  'no-heating-no-hot-water': ['/no-heating-no-hot-water-liverpool', 'Full guide: no heating or hot water'],
  'hot-water-no-heating': ['/no-heating-no-hot-water-liverpool', 'Full guide: no heating or hot water'],
  'heating-no-hot-water': ['/no-heating-no-hot-water-liverpool', 'Full guide: no heating or hot water'],
  'losing-pressure': ['/boiler-losing-pressure-liverpool', 'Full guide: boiler losing pressure'],
  'pressure-too-high': ['/boiler-losing-pressure-liverpool', 'Full guide: boiler pressure'],
  'frozen-condensate': ['/frozen-condensate-pipe-liverpool', 'Full guide: how to thaw a frozen condensate pipe'],
};
const problems = [
  {
    id: 'no-heating-no-hot-water', q: 'Why do I have no heating and no hot water?', t: 'No heating and no hot water',
    sign: 'The boiler is silent, shows a fault light or an error code, and nothing is warm.',
    causes: ['Low water pressure (below 1 bar)', 'No gas reaching the boiler: gas off, or a prepayment meter out of credit', 'A frozen condensate pipe in cold weather', 'A failed ignition electrode, fan, gas valve or circuit board (PCB)', 'No power: a tripped fuse spur or a power cut'],
    tryIt: 'Check the pressure gauge, check your hob works, check the fused switch next to the boiler is on, and in freezing weather check the condensate pipe outside. Then press reset once.',
    call: 'If the boiler locks out again, or shows the same error code, the fault is inside the boiler.',
  },
  {
    id: 'hot-water-no-heating', q: 'Why do I have hot water but no heating?', t: 'Hot water but no heating',
    sign: 'The taps run hot but the radiators stay cold.',
    causes: ['The thermostat or timer is set wrong, or lost its settings after a power cut', 'A diverter valve stuck in the hot water position (combi boilers)', 'A failed zone valve or motorised valve (system and regular boilers)', 'A faulty pump, or air locked in the system'],
    tryIt: 'Turn the room thermostat up a few degrees above room temperature and check the timer is calling for heating. Check smart thermostat batteries and app.',
    call: 'If the thermostat is calling for heat and the radiators stay cold, a valve or the pump has usually failed.',
  },
  {
    id: 'heating-no-hot-water', q: 'Why does my heating work but I have no hot water?', t: 'Heating works but no hot water',
    sign: 'The radiators heat up but the taps run cold or only lukewarm.',
    causes: ['A diverter valve stuck in the heating position (combi boilers)', 'A faulty flow sensor that does not notice the tap is on', 'A blocked plate heat exchanger from limescale', 'On a cylinder system: the hot water timer, cylinder thermostat or immersion'],
    tryIt: 'Check the hot water setting on the boiler or programmer is on. On a combi, try a different tap and open it fully.',
    call: 'If the boiler does not fire up when a hot tap is turned on, the diverter valve or flow sensor usually needs replacing.',
  },
  {
    id: 'losing-pressure', q: 'Why does my boiler keep losing pressure?', t: 'Boiler losing pressure',
    sign: 'You top the pressure up to 1 to 1.5 bar and within days it has dropped again.',
    causes: ['A leak on a radiator valve, pipe joint or inside the boiler', 'A faulty pressure relief valve letting water out through the pipe outside', 'A flat expansion vessel', 'Recently bled radiators (a one-off drop is normal)'],
    tryIt: 'Top it up once with the filling loop, then close both valves fully. Look under radiators and along visible pipes for damp, and check the copper pipe outside for dripping.',
    call: 'If you are topping up more than once a month, there is a leak or a failed part. Topping up every week only hides it.',
  },
  {
    id: 'pressure-too-high', q: 'Why is my boiler pressure too high?', t: 'Boiler pressure too high',
    sign: 'The gauge reads over 2.5 bar, often climbing when the heating is on, and water may drip from the pipe outside.',
    causes: ['The filling loop has been left slightly open', 'A flat expansion vessel', 'A filling loop valve that lets water through when closed'],
    tryIt: 'Check both filling loop valves are fully closed. Bleeding a radiator lets some water out and lowers the pressure.',
    call: 'If the pressure keeps rising with the loop closed, the expansion vessel or filling valve needs attention.',
  },
  {
    id: 'boiler-leaking', q: 'Why is my boiler leaking water?', t: 'Boiler leaking water',
    sign: 'Water under the boiler, dripping from the casing, or a damp patch on the ceiling below.',
    causes: ['A failed pressure relief valve', 'A perished seal on the pump, diverter valve or heat exchanger', 'A loose or corroded pipe joint', 'A leaking condensate trap or pipe'],
    tryIt: 'Turn the boiler off, put a tray or towels underneath and keep water away from plugs and the electrics. If it is pouring, turn the water off at the stopcock.',
    call: 'Call straight away. Never open the casing to look for the leak yourself.',
  },
  {
    id: 'boiler-noises', q: 'Why is my boiler banging, kettling or gurgling?', t: 'Banging, kettling, gurgling or whistling',
    sign: 'The boiler sounds like a kettle boiling, bangs when it fires up, or gurgles.',
    causes: ['Kettling: limescale or sludge in the heat exchanger making the water boil', 'Gurgling: air in the system, low pressure or a partly frozen condensate pipe', 'Banging: a failing pump, sludge or pipes moving as they heat', 'Whistling: a restricted flow from sludge or a sticking valve'],
    tryIt: 'Check the pressure and bleed any radiators that are cold at the top.',
    call: 'Kettling and banging get worse over time and strain the heat exchanger, the most expensive part to replace.',
  },
  {
    id: 'keeps-turning-off', q: 'Why does my boiler keep turning off?', t: 'Boiler keeps turning off',
    sign: 'The boiler fires up, runs for a few minutes, then cuts out or locks out.',
    causes: ['Low pressure or poor water flow from sludge', 'A faulty temperature sensor (thermistor)', 'A blocked flue or condensate system', 'A thermostat in the wrong place, such as next to a radiator'],
    tryIt: 'Check the pressure and that the condensate pipe outside is clear.',
    call: 'Cutting out over and over needs a proper diagnosis. It wastes gas and wears the boiler.',
  },
  {
    id: 'frozen-condensate', q: 'Has my boiler condensate pipe frozen?', t: 'Frozen condensate pipe',
    sign: 'In a cold snap the boiler gurgles, then locks out and shows a fault code. This is the most common winter breakdown in Liverpool.',
    causes: ['The plastic condensate pipe runs outside and freezes, so the water backs up into the boiler'],
    tryIt: 'Find the plastic pipe running from the boiler to a drain outside. Pour warm water, not boiling water, slowly along it, especially at bends and the open end. Then reset the boiler.',
    call: 'If it freezes every winter, the pipe needs re-routing, upsizing or lagging so it does not happen again.',
  },
  {
    id: 'cold-radiators', q: 'Why are my radiators cold at the top or bottom?', t: 'Radiators cold at the top or bottom',
    sign: 'Some radiators are warm in places but cold in others.',
    causes: ['Cold at the top: air trapped in the radiator', 'Cold at the bottom or in the middle: sludge (black iron oxide) settled in the radiator', 'Some radiators cold: the system needs balancing'],
    tryIt: 'Bleed radiators that are cold at the top with a radiator key, then check the boiler pressure and top it up.',
    call: 'Radiators cold at the bottom need the sludge cleaning out, often with a power flush and a magnetic filter.',
  },
  {
    id: 'pilot-light', q: 'Why does my pilot light keep going out?', t: 'Pilot light keeps going out',
    sign: 'Older boilers and back boilers with a pilot light that will not stay lit.',
    causes: ['A faulty thermocouple', 'A dirty pilot jet', 'A draught or a flue problem'],
    tryIt: 'Relight it once following the instructions on the boiler.',
    call: 'If it keeps going out, it needs a Gas Safe registered engineer. On a very old boiler it may be time to replace it.',
  },
  {
    id: 'lukewarm-water', q: 'Why is my hot water lukewarm or going hot and cold?', t: 'Hot water lukewarm or going hot and cold',
    sign: 'The shower runs hot, then cold, then hot again.',
    causes: ['Low water pressure or flow into the house', 'A faulty diverter valve or flow sensor', 'Limescale in the plate heat exchanger', 'A faulty thermostatic shower valve rather than the boiler'],
    tryIt: 'Check whether every hot tap does it or only the shower. If only the shower, the shower valve is the likely cause.',
    call: 'If all the taps do it, the boiler needs checking.',
  },
];

// ---------- Error codes ----------
const brands = [
  {
    id: 'baxi', name: 'Baxi', models: 'Baxi 400, 600 and 800 combi and system boilers. Many Potterton boilers use the same codes.',
    codes: [
      { code: 'E119', means: 'Water pressure too low', try: 'Check the pressure gauge. If it is below 1 bar, top it up to between 1 and 1.5 bar with the filling loop, then reset.', call: 'If the pressure keeps dropping, there is a leak somewhere in the system or a faulty pressure relief valve.' },
      { code: 'E133', means: 'The boiler did not detect a flame', try: 'Check your gas is on and other gas appliances work, and that a prepayment meter has credit. In freezing weather, check the condensate pipe outside is not frozen. Then reset once.', call: 'If it locks out again and your gas supply is fine, the fault is usually the ignition electrode, the gas valve or a blocked condensate system.', causes: ['Gas off, or a prepayment meter out of credit', 'A frozen or blocked condensate pipe', 'A faulty ignition electrode', 'A faulty gas valve or control board'] },
      { code: 'E160', means: 'Fan fault', try: 'Reset once.', call: 'If it comes back, the fan or its wiring needs checking by a Gas Safe registered engineer.' },
    ],
  },
  {
    id: 'ideal', name: 'Ideal', models: 'Ideal Logic, Vogue and Independent boilers.',
    codes: [
      { code: 'F1', means: 'Water pressure too low', try: 'Top the pressure up to between 1 and 1.5 bar with the filling loop, then reset.', call: 'If you have to keep topping it up, there is a leak or a faulty valve.' },
      { code: 'F2', means: 'The flame was lost after lighting', try: 'Check the gas supply and, in cold weather, the condensate pipe outside. Then reset once.', call: 'If it keeps happening, the gas pressure, flame sensor or condensate system needs checking.' },
      { code: 'L2', means: 'Ignition lockout: the boiler failed to light after several tries', try: 'Check the gas is on and the condensate pipe is not frozen, then reset once.', call: 'Repeated L2 lockouts usually point to the condensate system, the ignition electrode, the gas valve or the PCB.', causes: ['Gas off, or a prepayment meter with no credit', 'A frozen or blocked condensate pipe, very common on Ideal boilers in winter', 'A worn ignition electrode or faulty ignition lead', 'A faulty gas valve or control board'] },
    ],
  },
  {
    id: 'worcester', name: 'Worcester Bosch', models: 'Worcester Bosch Greenstar boilers.',
    codes: [
      { code: 'EA 227', means: 'No flame detected after the boiler tried to light', try: 'Check your hob works, check a prepayment meter has credit and, in freezing weather, thaw the condensate pipe outside. Then press reset once.', call: 'If EA comes back after one reset, the ignition or flame sensing needs a Gas Safe registered engineer.', causes: ['Gas off at the meter, or a prepayment meter out of credit', 'A frozen or blocked condensate pipe', 'A worn or dirty ignition electrode, or a damaged ignition lead', 'A faulty flame sensing electrode', 'A faulty gas valve or control board (PCB)'] },
      { code: 'CE 207', means: 'Water pressure too low', try: 'Top the pressure up to between 1 and 1.5 bar using the filling key or loop.', call: 'Pressure that keeps dropping means a leak somewhere in the heating system.' },
    ],
  },
  {
    id: 'vaillant', name: 'Vaillant', models: 'Vaillant ecoTEC boilers.',
    codes: [
      { code: 'F22', means: 'Water pressure too low', try: 'Top the pressure up to between 1 and 1.5 bar, then reset.', call: 'If it drops again, there is a leak or a faulty pressure sensor.' },
      { code: 'F28', means: 'The boiler failed to light when starting up', try: 'Check your hob works and a prepayment meter has credit, thaw the condensate pipe in cold weather, then reset once.', call: 'If F28 shows again after one reset, stop resetting it. The ignition, gas valve or electronics need a Gas Safe registered engineer.', causes: ['No gas reaching the boiler', 'A frozen or blocked condensate pipe', 'A faulty ignition electrode or ignition lead', 'A faulty gas valve', 'A fault on the control board (PCB)'] },
      { code: 'F29', means: 'The flame went out while the boiler was running', try: 'Check the gas supply and the condensate pipe, then reset once.', call: 'Repeated F29 faults need a Gas Safe registered engineer to check the gas supply and combustion.' },
      { code: 'F75', means: 'The boiler did not detect the pump or a pressure change', try: 'Check the pressure. If it is below 1 bar, top it up to between 1 and 1.5 bar and reset once.', call: 'If the pressure is fine and F75 stays, the pump or the pressure sensor usually needs replacing. An engineer can test both before fitting anything.', causes: ['Low water pressure in the heating system', 'Air trapped in the system or the pump', 'A faulty or seized pump', 'A faulty water pressure sensor'] },
    ],
  },
  {
    id: 'glow-worm', name: 'Glow-worm', models: 'Glow-worm Energy and Ultimate boilers. Glow-worm is made by the same group as Vaillant, so many codes match.',
    codes: [
      { code: 'F22', means: 'Water pressure too low', try: 'Top the pressure up to between 1 and 1.5 bar, then reset.', call: 'If it keeps dropping, there is a leak or a faulty valve.' },
      { code: 'F28', means: 'The boiler failed to light', try: 'Check the gas supply and the condensate pipe, then reset once.', call: 'If it locks out again, the ignition or gas valve needs checking.' },
      { code: 'F29', means: 'The flame was lost while running', try: 'Check the gas supply and, in cold weather, the condensate pipe. Reset once.', call: 'If it keeps happening, it needs a Gas Safe registered engineer.' },
      { code: 'F75', means: 'Pump or water pressure sensor fault', try: 'Check the system pressure.', call: 'If the pressure is fine, the pump or sensor usually needs replacing.' },
    ],
  },
];
const codeCount = brands.reduce((n, b) => n + b.codes.length, 0);

// ---------- Parts ----------
const parts = [
  { p: 'Diverter valve', does: 'Switches hot water between the radiators and the taps on a combi boiler.', signs: 'Hot water but no heating, heating but no hot water, or radiators warming when only a tap is on.' },
  { p: 'Printed circuit board (PCB)', does: 'The boiler’s brain. Controls ignition, the fan, the pump and safety checks.', signs: 'No display, random lockouts, or several different faults at once.' },
  { p: 'Ignition and flame sensing electrodes', does: 'Make the spark that lights the gas, then confirm the flame is there.', signs: 'Ignition lockouts such as Worcester EA 227, Vaillant F28, Ideal L2 and Baxi E133.' },
  { p: 'Gas valve', does: 'Opens to let gas into the burner when the boiler fires.', signs: 'The boiler sparks but will not light, with the gas supply fine.' },
  { p: 'Fan', does: 'Pushes flue gases out and pulls fresh air in.', signs: 'A loud hum or rattle, or fan fault codes such as Baxi E160.' },
  { p: 'Pump', does: 'Moves hot water around the radiators.', signs: 'Radiators cold with the boiler firing, banging, overheating, Vaillant F75.' },
  { p: 'Pressure relief valve', does: 'Lets water out safely if the pressure gets too high.', signs: 'Pressure dropping and the copper pipe outside dripping.' },
  { p: 'Expansion vessel', does: 'Absorbs the water as it expands when it heats up.', signs: 'Pressure rising high when the heating is on, then dropping when it cools.' },
  { p: 'Pressure sensor', does: 'Tells the boiler the water pressure.', signs: 'Low pressure codes while the gauge reads correctly.' },
  { p: 'Plate heat exchanger', does: 'Heats your tap water on a combi boiler.', signs: 'Hot water lukewarm or going hot and cold, worse in hard water areas.' },
  { p: 'Main heat exchanger', does: 'Transfers heat from the burner to the water.', signs: 'Kettling, leaks inside the casing. Often a sign to replace an older boiler.' },
  { p: 'Condensate trap and pipe', does: 'Drain the acidic water a condensing boiler makes.', signs: 'Gurgling, lockouts in cold weather, water around the boiler.' },
];

// ---------- FAQs ----------
const faqs = [
  { q: 'How much does a boiler repair cost in Liverpool?', a: 'A boiler repair is £120 for the first hour on weekdays 9am to 4pm, £150 on weekday evenings, nights and weekends, and £180 on bank holidays. The first hour includes finding the fault, and there is no call-out fee on top. Most faults that do not need a part are fixed within that first hour. If a part is needed or the job will take longer, you get the price before we carry on.' },
  { q: 'Who will repair my boiler?', a: 'One of our Gas Safe registered heating engineers. Our team is led by James. It is illegal for anyone who is not Gas Safe registered to work on a gas boiler. You can check any engineer on the Gas Safe Register before they start.' },
  { q: 'What does the error code on my boiler mean?', a: `Each brand uses its own codes. Low pressure codes include Baxi E119, Ideal F1, Worcester Bosch CE 207 and Vaillant F22. Ignition lockouts include Baxi E133, Ideal L2, Worcester Bosch EA 227 and Vaillant F28. This page explains ${codeCount} common codes. If yours is not listed, read it to us over the phone. Error codes are our speciality.` },
  { q: 'Is it safe to reset my boiler?', a: 'Pressing reset once is safe and is what the manufacturer expects you to try. If the same code comes back, stop resetting it and call a Gas Safe registered engineer. Never take the boiler casing off.' },
  { q: 'Why does my boiler keep losing pressure?', a: 'Pressure should sit between 1 and 1.5 bar when the heating is cold. If you top it up and it drops again within days, there is a leak somewhere in the system or a faulty pressure relief valve or expansion vessel. That needs finding and fixing, not topping up every week.' },
  { q: 'How do I top up my boiler pressure?', a: 'Find the filling loop, usually under the boiler. Open the valves slowly until the gauge reads between 1 and 1.5 bar, then close both fully. If you are not sure, call us and we will talk you through it.' },
  { q: 'My boiler stopped in the cold weather. What is wrong?', a: 'The most common cause in a cold snap is a frozen condensate pipe, the plastic pipe that runs outside from the boiler. Pour warm, not boiling, water along the pipe to thaw it, then press reset. If it freezes every winter, the pipe needs re-routing or lagging.' },
  { q: 'Why do I have hot water but no heating?', a: 'First check the thermostat and timer, especially after a power cut. On a combi boiler, a stuck diverter valve is the most common cause. On a system or regular boiler, a failed zone valve or pump is likely.' },
  { q: 'Why is my boiler making a banging or kettling noise?', a: 'Kettling is usually limescale or sludge in the heat exchanger making the water boil. Banging can be the pump, sludge or air in the system. Both get worse if left and put strain on the heat exchanger.' },
  { q: 'Which boiler brands do you repair?', a: 'All the common makes in Liverpool homes, including Worcester Bosch, Vaillant, Ideal, Baxi, Potterton, Glow-worm and Viessmann. Combi, system and regular boilers.' },
  { q: 'Should I repair or replace my boiler?', a: 'If the boiler is under about 10 years old and the fault is a single part, repairing it is usually the better value. If it is older, breaking down every winter, or the part costs a large share of a new boiler, we will tell you honestly and price both options so you can choose.' },
  { q: 'My boiler is still under warranty. Should I call you?', a: 'Check your warranty paperwork first. Most manufacturer warranties expect you to call the manufacturer for a repair, and some need a yearly service to stay valid. If your warranty has run out, or you need help sooner, ring us.' },
  { q: 'Is a broken boiler an emergency?', a: 'If you smell gas, ring the National Gas Emergency line on 0800 111 999 first. A boiler leaking water, or no heating for elderly people, babies or anyone unwell in cold weather, is urgent. Ring us 24/7 on 0151 558 0334.' },
  { q: 'Do you repair boilers for landlords and letting agents?', a: 'Yes. We can meet your tenant at the property, send you photos of the fault and agree the cost with you before we fix it. If the CP12 is due, we can do the gas safety check on the same visit.' },
  { q: 'Do you repair boilers in commercial properties?', a: 'Yes, at the same rates as homes.' },
];

const reviews = [
  { n: 'Brendan C', t: 'James was amazing and was at my house within 30 mins of calling on a sunday. He has not only fixed my boiler but improved it and taught me how to fix the problem in future. Affordable and easygoing great plumber and gas fitter!' },
  { n: 'Edward M', t: 'James came out and fixed a leaking pipe and even got my boiler up and running by fixing an air lock. Professional , on time, cleaned up after himself and charged a fair rate.' },
  { n: 'David H', t: 'Amazing service James was very professional. Fixed my boiler and leaking tap very knowledgeable very fast and polite great company 100% recommended' },
  { n: 'Roger D', t: 'Wonderful service. Came within 24 hrs and got our hot water back on with an improvised repair. Returned few days later with the part needed to restore everything to normal Charming, calm, methodical. I highly recommend' },
];

const areas = [
  ['Anfield','anfield'],['Bootle','bootle'],['Crosby','crosby'],['Huyton','huyton'],['Kirkby','kirkby'],['Garston','garston'],
  ['Aintree','aintree'],['West Derby','west-derby'],['Old Swan','old-swan'],['Wavertree','wavertree'],['Allerton','allerton'],['Woolton','woolton'],
  ['Walton','walton'],['Toxteth','toxteth'],['Maghull','maghull'],['Formby','formby'],['Wirral','wirral'],['St Helens','st-helens'],
];

const toc = [
  ['today', 'Can you do an emergency boiler repair today?'],
  ['prices', 'How much does it cost?'],
  ['checks', 'What to check before you call'],
  ['problems', 'What is wrong with my boiler?'],
  ['error-codes', 'What does my error code mean?'],
  ['parts', 'Which part has failed?'],
  ['boiler-types', 'Combi, system and regular boilers'],
  ['how-it-works', 'What happens when you call'],
  ['reviews', 'Customer reviews'],
  ['repair-or-replace', 'Repair or replace?'],
  ['safety', 'Is my boiler safe?'],
  ['prevent', 'How to stop breakdowns'],
  ['faq', 'More questions'],
];

const schemaFaq = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const schemaService = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Boiler Repair Liverpool', serviceType: 'Gas boiler repair', url: URL_,
  description: 'Gas Safe registered boiler repair across Liverpool and Merseyside, 24/7. Fault finding, error code diagnosis and repairs on Worcester Bosch, Vaillant, Ideal, Baxi, Potterton, Glow-worm and Viessmann boilers. No call-out fee.',
  provider: { '@id': 'https://liverpoolemergencyplumber.co.uk/#business' },
  areaServed: [{ '@type': 'City', name: 'Liverpool' }, { '@type': 'City', name: 'Wirral' }, { '@type': 'City', name: 'St Helens' }, { '@type': 'City', name: 'Formby' }],
  offers: [
    { '@type': 'Offer', name: 'Boiler repair, first hour including diagnosis, weekdays 9am to 4pm, no call-out fee', price: '120', priceCurrency: 'GBP' },
    { '@type': 'Offer', name: 'Boiler repair, first hour including diagnosis, weekday evenings, nights and weekends', price: '150', priceCurrency: 'GBP' },
    { '@type': 'Offer', name: 'Boiler repair, first hour including diagnosis, bank holidays', price: '180', priceCurrency: 'GBP' },
  ],
};
const schemaPage = {
  '@context': 'https://schema.org', '@type': 'WebPage', '@id': URL_ + '#webpage', url: URL_,
  name: 'Boiler Repair Liverpool: prices, common problems and error codes explained',
  dateModified: '2026-11-26', inLanguage: 'en-GB',
  about: { '@id': 'https://liverpoolemergencyplumber.co.uk/#business' },
};
const schemaCrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://liverpoolemergencyplumber.co.uk' },
    { '@type': 'ListItem', position: 2, name: 'Boiler Repair Liverpool', item: URL_ },
  ],
};
---

<BaseLayout
  title="Emergency Boiler Repair Liverpool | 24/7, No Call-Out Fee"
  description="Emergency boiler repair in Liverpool by our Gas Safe registered team, 24/7. From £120 for the first hour, including diagnosis. No call-out fee. Common faults and error codes explained. Call 0151 558 0334."
  canonical={URL_}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaService)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaFaq)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaPage)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaCrumbs)} />

  <!-- HERO -->
  <section class="page-hero" id="hero">
    <div class="container">
      <div class="page-hero-badge" style="margin:0 auto 1rem;"><span class="badge-dot"></span>Boiler error code experts · 24/7</div>
      <h1>Boiler Repair Liverpool</h1>
      <p class="page-hero-sub">No heating, no hot water or an error code on the boiler? Our team of Gas Safe registered engineers, led by James, finds the fault and fixes it, day or night. No call-out fee, and you get the price before any work starts.</p>
      <div style="display:flex;gap:1rem;max-width:340px;margin:1.25rem auto;">
        <div class="br-stat"><div class="br-stat-n">£0</div><div class="br-stat-l">Call-out fee</div></div>
        <div class="br-stat"><div class="br-stat-n">30 min</div><div class="br-stat-l">Guaranteed response</div></div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;max-width:320px;margin:0 auto 1.25rem;">
        <a href={TEL} class="btn btn-orange btn-lg btn-full" style="box-shadow:0 4px 14px rgba(249,115,22,0.4);font-size:1.15rem;color:#ffffff;">CALL {PHONE}</a>
        <a href="/get-started" class="btn btn-lg btn-full" style="background:var(--navy);color:#ffffff;font-weight:700;">Book a Repair Online</a>
      </div>
      <div style="display:flex;justify-content:center;gap:1.5rem;flex-wrap:wrap;padding-top:1.25rem;border-top:1px solid #e2e8f0;">
        <span class="br-tick"><span>✓</span> Gas Safe Registered</span>
        <span class="br-tick"><span>✓</span> All Major Brands</span>
        <span class="br-tick"><span>✓</span> Price Agreed First</span>
        <span class="br-tick"><span>✓</span> 5.0 on Google</span>
      </div>
    </div>
  </section>

  <div class="brx">

  <!-- KEY FACTS + CONTENTS -->
  <section class="brx-sec" id="key-facts">
    <div class="brx-wrap">
      <div class="brx-facts">
        <h2 class="brx-facts-h">Boiler repair in Liverpool at a glance</h2>
        <dl>
          <div><dt>Who</dt><dd>A trusted team of Gas Safe registered heating engineers, led by James.</dd></div>
          <div><dt>Price</dt><dd>First hour, including diagnosis: £120 weekdays 9am to 4pm, £150 evenings, nights and weekends, £180 bank holidays. No call-out fee.</dd></div>
