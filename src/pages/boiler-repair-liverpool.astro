<script>
  // Phones: long reference lists start closed (tap to open). Desktop and no-JS: all open.
  if (window.matchMedia('(max-width: 600px)').matches) {
    const keep = decodeURIComponent(location.hash.slice(1));
    document.querySelectorAll<HTMLDetailsElement>('details[data-mcollapse]').forEach((d) => { if (!keep || d.id !== keep) d.open = false; });
  }
  const openTarget = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id && document.getElementById(id);
    if (el && el.tagName === 'DETAILS') { (el as HTMLDetailsElement).open = true; el.scrollIntoView({ block: 'start' }); }
  };
  window.addEventListener('hashchange', openTarget);
  openTarget();
  const input = document.getElementById('code-finder') as HTMLInputElement | null;
  if (input) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.brx-code'));
    const brandsEls = Array.from(document.querySelectorAll<HTMLElement>('[data-brand]'));
    const status = document.getElementById('code-finder-status');
    const none = document.getElementById('code-finder-none');
    const run = () => {
      const q = input.value.toLowerCase().replace(/\s+/g, ' ').trim();
      const qs = q.replace(/\s/g, '');
      let shown = 0;
      cards.forEach((c) => {
        const hay = c.dataset.code || '';
        const hit = !q || hay.includes(q) || hay.includes(qs);
        c.hidden = !hit; if (hit) shown++;
      });
      brandsEls.forEach((b) => { const hit = !!b.querySelector('.brx-code:not([hidden])'); b.hidden = !!q && !hit; if (q && hit) (b as HTMLDetailsElement).open = true; });
      if (status) status.textContent = q ? (shown ? `${shown} matching code${shown > 1 ? 's' : ''}` : '') : '';
      if (none) none.hidden = !(q && shown === 0);
    };
    input.addEventListener('input', run);
    input.addEventListener('change', () => {
      const v = input.value.trim();
      if (v && typeof (window as any).gtag === 'function') (window as any).gtag('event', 'error_code_search', { search_term: v.slice(0, 20), page_path: location.pathname });
    });
  }
</script>

