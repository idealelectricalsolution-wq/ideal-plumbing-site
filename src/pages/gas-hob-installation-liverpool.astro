---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/gas-hob-installation-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'hob', tier: 'Fit only', popular: true, name: 'Gas hob fitted', price: '£120', unit: 'you supply the hob, inc VAT',
    points: ['Gas point already in place', 'Hob connected and sealed in the worktop', 'Gas tightness test', 'Every burner lit and checked'] },
  { id: 'cooker', tier: 'Freestanding', name: 'Gas cooker connected', price: '£120', unit: 'you supply the cooker, inc VAT',
    points: ['New bayonet hose if needed', 'Stability chain or bracket fitted', 'Gas tightness test', 'Hob, oven and grill checked'] },
  { id: 'disconnect', tier: 'Moving or swapping', name: 'Disconnect and cap', price: '£120', unit: 'first hour, weekdays 9am–4pm, inc VAT',
    points: ['Old hob or cooker disconnected', 'Gas pipe capped safely', 'Tightness test after', 'Often done with a new fit on the same visit'] },
  { id: 'new-point', tier: 'New gas supply', name: 'New or moved gas point', price: 'Free', unit: 'visit, then a fixed written price',
    points: ['New gas pipe runs', 'Moving the gas point', 'Changing from electric to gas', 'Price agreed before we start'] },
];

const faqs = [
  { q: 'How much does it cost to fit a gas hob in Liverpool?', a: 'With us it is £120 including VAT when you supply the hob and there is a gas point in place. That covers the connection, a gas tightness test and checking every burner. New pipe runs are priced at a free visit.' },
  { q: 'How much is it to connect a gas cooker?', a: 'A freestanding gas cooker connected is £120 including VAT. We fit a new bayonet hose if the old one is worn or the wrong length, and a stability chain or bracket so the cooker cannot tip.' },
  { q: 'Can I fit a gas hob myself?', a: 'No. By law, only a Gas Safe registered engineer may fit or connect a gas appliance for you. A bad joint can leak gas or carbon monoxide. Many hob makers also void the warranty if it is not fitted by a Gas Safe engineer.' },
  { q: 'Can a kitchen fitter connect my gas hob?', a: 'Only if they are Gas Safe registered for cookers and hobs. Many kitchen fitters are not. Your fitter can cut the worktop, then we make the gas connection and test it.' },
  { q: 'How long does it take to fit a gas hob?', a: 'Usually about an hour for a like-for-like swap. If the worktop needs cutting or the gas point is in the wrong place, it takes longer. We tell you before we start.' },
  { q: 'Can a gas hob go on a flexible hose?', a: 'Only if the hob maker allows it, and only with the approved type of hose. Most built-in hobs are hard-piped in copper. Freestanding cookers use a bayonet hose. We follow the maker\'s instructions every time.' },
  { q: 'Do I need a new gas pipe for a new hob?', a: 'Not usually. If the gas point is close and in good order, we connect to it. If it is too far away, in the wrong place or not safe, we price a new pipe run first.' },
  { q: 'Can you disconnect my gas cooker before I move?', a: 'Yes. We disconnect it, cap the gas pipe safely and test it. This is covered by our first hour, £120 on weekdays. Tell us when you book if you want the new owner\'s cooker or your new one fitted too.' },
  { q: 'Can I change from an electric cooker to gas?', a: 'Yes, if there is gas in the house. We run a new gas pipe to the kitchen and fit an isolation valve. We price this at a free visit, so you know the cost first.' },
  { q: 'Can I change from gas to an induction hob?', a: 'Yes. We disconnect and cap the gas. An induction hob usually needs its own electric circuit. Our partner firm Ideal Electrical Solutions can fit that.' },
  { q: 'Do you supply the hob?', a: 'Most customers buy their own hob online or in store. Our £120 price is for fitting a hob you supply. Buy a natural gas (G20) model, not an LPG one, unless your home runs on bottled gas.' },
  { q: 'Do I get a certificate?', a: 'You get a written record of the work and the gas tightness test, emailed the same day. Landlords also need a yearly gas safety certificate (CP12), which we can do on the same visit for £100.' },
  { q: 'Do you fit gas fires?', a: 'No. We fit and connect gas hobs and gas cookers only. If you have an old gas fire you no longer use, we can disconnect and cap it safely.' },
  { q: 'What if I smell gas?', a: 'Turn the gas off at the meter if it is safe, open windows and do not use light switches. Get everyone out and ring the National Gas Emergency line on 0800 111 999. Once it is made safe, we can find and fix the fault.' },
];
---

