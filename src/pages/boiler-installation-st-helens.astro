---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/boiler-installation-st-helens';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

// Same five packages and prices as /boiler-installation-liverpool.
const boilers = [
  { id: 'pk-essential', tier: 'Essential', name: 'Baxi 600 Combi 2', img: 'baxi-600-combi-2', price: '£2,195', size: '24kW or 30kW', flow: '10.2 to 12.2', warranty: '7 years', best: 'Flats, small terraces and rental homes',
    points: ['Stainless steel heat exchanger', 'Simple, reliable and easy to service', 'Our lowest price for a named brand'] },
  { id: 'pk-value', tier: 'Value', name: 'Baxi 800 Combi 2', img: 'baxi-800-combi-2', price: '£2,495', size: '24kW or 30kW', flow: '10.2 to 12.2', warranty: '10 years', best: '2 to 3 bed homes, if you are staying put',
    points: ['The same boiler as the Baxi 600', 'Magnetic filter in the box', '3 more years of cover for £300 more'] },
  { id: 'pk-popular', tier: 'Most popular', popular: true, name: 'Worcester Bosch Greenstar 4000', img: 'worcester-greenstar-4000', price: '£2,695', size: '25kW or 30kW', flow: '12.3 (30kW)', warranty: 'Up to 10 years', best: 'Most 2 to 4 bed homes',
    points: ['A trusted brand with easy-to-get parts', 'Quiet, at 45dB', 'Ticks over gently on mild days, so it switches on and off less'] },
  { id: 'pk-premium', tier: 'Premium', name: 'Vaillant ecoTEC plus', img: 'vaillant-ecotec-plus', price: '£2,995', size: '26kW or 32kW', flow: '10.6 to 13.0', warranty: 'Up to 10 years', best: 'Busier homes and two bathrooms',
    points: ['More hot water at each size', 'Quality German brand', 'Works with Vaillant smart controls'] },
  { id: 'pk-flagship', tier: 'Flagship', name: 'Worcester Bosch Greenstar 8000+ Style', img: 'worcester-greenstar-8000-style', imgAlt: 'Worcester Bosch Greenstar 8000 Style boiler in gloss black', price: '£3,295', size: '32kW', flow: '13.7', warranty: 'Up to 12 years', best: 'Larger homes, or a boiler on show in the kitchen',
    points: ['Gloss black with a colour touchscreen', 'Optional auto-fill tops up its own pressure', 'The longest cover in our range'] },
];
const packages = boilers.map((b) => ({
  id: b.id, tier: b.tier, name: b.name, price: b.price, popular: b.popular, unit: 'fully fitted, inc VAT',
  img: `boilers/${b.img}`, imgAlt: b.imgAlt || `${b.name} combi boiler`,
  specs: [['Size', b.size], ['Hot water', `${b.flow} litres a minute`], ['Warranty', b.warranty], ['Best for', b.best]] as [string, string][],
  points: b.points,
}));

const extras = [
  ['Next size up (for example 30kW to 36kW)', '+£200'],
  ['Move the boiler within the same room', '+£450'],
  ['Move the boiler to another room on the same floor', '+£750'],
  ['Move the boiler to another floor, the loft or the garage', '+£850'],
  ['Swap a tank system (regular or system boiler) for a combi', '+£695'],
  ['Power flush instead of a chemical clean', '£350'],
  ['Back boiler removal, vertical flue or a gas pipe upgrade', 'Priced at the free survey'],
];

const faqs = [
  { q: 'How much does a new boiler cost in St Helens?', a: 'Our five fixed-price combi packages run from £2,195 for a Baxi 600 to £3,295 for a Worcester Bosch Greenstar 8000+ Style, fully fitted and including VAT. Our most popular is the Worcester Bosch Greenstar 4000 at £2,695. Back boiler removal, and system or regular boilers, are priced at a free survey.' },
  { q: 'Can you replace my back boiler in St Helens?', a: 'Yes. We take out the back boiler and the gas fire in front of it, cap the old flue and make the fireplace safe. Then we fit a new combi on a wall, with its own flue. It usually takes 2 days. The removal work is priced at the free survey, on top of the combi package you choose.' },
  { q: 'Can you service or repair my back boiler instead?', a: 'No. We do not service or repair back boilers. Parts for many of them are now hard to get. We remove them and fit a modern combi.' },
  { q: 'Do you cover all WA postcodes in St Helens?', a: 'Yes. We cover St Helens town and the wider borough: WA9, WA10 and WA11, Newton-le-Willows and Earlestown in WA12, and Billinge in WN5. The prices are the same as in Liverpool.' },
  { q: 'How long does a boiler installation take?', a: 'A like-for-like combi swap is usually done in one day. A back boiler swap, a boiler move, or a change from a tank system to a combi takes about 2 to 3 days. We tell you how long at the survey.' },
  { q: 'Can you fit boilers in my St Helens rental homes?', a: 'Yes. We fit boilers for landlords and letting agents across St Helens. The Baxi 600 at £2,195 is a popular choice for rentals. We can also do the landlord gas safety certificate (CP12) from £75.' },
  { q: 'What warranty do I get?', a: 'It depends on the boiler: 7 years on the Baxi 600, 10 years on the Baxi 800, up to 10 years on the Worcester Bosch 4000 and Vaillant ecoTEC plus, and up to 12 years on the Worcester Bosch 8000+ Style. We register it on the day. It needs a service every year to stay valid. Our own work is guaranteed for 12 months.' },
  { q: 'Can I still get a gas boiler?', a: 'Yes. You can replace a gas boiler in an existing home with a new gas boiler. The rules that limit gas boilers apply to newly built homes.' },
  { q: 'Is my boiler worth repairing instead?', a: 'Often it is. If a modern boiler is under 10 years old and one part has failed, a repair is usually better value. A repair visit is from £120 for the first hour, with no call-out fee. We will tell you honestly which makes sense.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Every boiler is fitted by our Gas Safe registered engineers. By law, only a Gas Safe registered engineer can fit a gas boiler. You can check any engineer on the Gas Safe Register website.' },
];
---

<ServiceGuide
  url={URL_}
  title="Boiler Installation St Helens | Back Boiler Swaps | From £2,195"
  description="New boiler installation in St Helens from £2,195 fully fitted, inc VAT. Five fixed-price packages, back boilers removed and replaced with a combi. Free survey, WA9 to WA12. Call 0151 558 0334."
  h1="New Boiler Installation St Helens"
  badge="New boilers and back boiler swaps in St Helens"
  intro="Five fixed-price combi packages, from a Baxi 600 at £2,195 to a Worcester Bosch 8000+ Style at £3,295, fully fitted and including VAT. Still on a back boiler? We take it out and fit a modern combi. Free survey and a written fixed price."
  stats={[['£2,195', 'Fully fitted, from'], ['12 yr', 'Warranty, up to']]}
  ticks={['Gas Safe Registered', 'Free Survey', 'Back Boilers Replaced', '5.0 on Google']}
  secondaryCta={{ href: '#prices', label: 'See the 5 packages' }}
  pkTitle="New boiler prices in St Helens"
  pkLede="Five fixed-price combi packages, including VAT. Every price includes a smart thermostat, magnetic filter, system clean, carbon monoxide alarm and removal of your old boiler."
  packages={packages}
  pkNote="Need a bigger boiler? The next size up is £200 more. Ideal Logic Max is also available, at £2,695. Hot water is at a 35°C rise. Warranties are the manufacturer's: 'up to' means the longest cover, which needs the boiler registered (we do it on the day) and serviced every year. Back boiler removal, and system and regular boilers, are priced after a free survey."
  factsTitle="A new St Helens boiler at a glance"
  facts={[
    ['Price', 'Five combi packages from £2,195 to £3,295, fully fitted, inc VAT.'],
    ['Back boilers', 'Removed and replaced with a combi. Removal priced at the free survey.'],
    ['Time', 'A combi swap is usually one day. A back boiler swap is usually 2 days.'],
    ['Warranty', '7 to 12 years from the maker, plus our 12-month workmanship guarantee.'],
    ['Who', 'Gas Safe registered engineers, part of our team led by James.'],
    ['Area', 'St Helens, Haydock, Rainford, Newton-le-Willows and Billinge.'],
  ]}
  toc={[
    ['back-boiler', 'Can you replace a back boiler?'],
    ['choose', 'Which package is right for me?'],
    ['homes', 'Which boiler suits my St Helens home?'],
    ['cost', 'What can change the price?'],
    ['included', 'What is included?'],
    ['how', 'How does it work?'],
  ]}
  reviewTitle="What do customers say about James and the team?"
  reviews={['Edward M', 'Mark L', 'Peter H', 'Roger D']}
  faqs={faqs}
  areasTitle="Do you fit boilers near St Helens?"
  areasText="Yes. We fit boilers across Merseyside at the same fixed prices."
  areas={[
    { href: '/boiler-installation-liverpool', label: 'Boiler installation Liverpool' },
    { href: '/boiler-installation-wirral', label: 'Boiler installation Wirral' },
    { href: '/boiler-installation-formby', label: 'Boiler installation Formby' },
  ]}
  related={[
    { href: '/boiler-service-st-helens', title: 'Boiler service St Helens', text: '£95 fixed price, keeps your warranty valid' },
    { href: '/gas-safety-certificate-st-helens', title: 'Gas safety certificate St Helens', text: 'Landlord CP12 from £75' },
    { href: '/power-flushing-st-helens', title: 'Power flushing St Helens', text: 'From £395 for up to 6 radiators' },
    { href: '/hot-water-cylinders-st-helens', title: 'Hot water cylinders St Helens', text: 'Vented from £750, unvented from £1,450' },
    { href: '/central-heating-installation-st-helens', title: 'Central heating St Helens', text: 'Full systems from £4,495' },
    { href: '/emergency-plumber-st-helens', title: 'Emergency plumber St Helens', text: 'From £120 for the first hour, no call-out fee' },
  ]}
  finalTitle="Book your free St Helens boiler survey"
  finalText="Five fixed-price packages from £2,195, inc VAT. Back boilers removed and replaced. Smell gas? Call the National Gas Emergency line on 0800 111 999 first."
  serviceName="Boiler Installation St Helens"
  serviceType="Gas boiler installation and back boiler replacement"
  serviceDesc="Five fixed-price combi boiler packages from £2,195 fully fitted, plus back boiler removal and replacement with a combi, across St Helens by Gas Safe registered engineers. Free survey and written fixed price."
  areaServed={['St Helens', 'Eccleston', 'Sutton', 'Thatto Heath', 'Clock Face', 'Haydock', 'Rainford', 'Billinge', 'Newton-le-Willows', 'Earlestown']}
>
  <section class="brx-sec brx-tint" id="back-boiler">
    <div class="brx-wrap">
      <h2>Can you replace a back boiler in St Helens?</h2>
      <p class="brx-answer">Yes. We remove the back boiler and the gas fire in front of it, and fit a modern combi on a wall. It is one of our most common St Helens jobs.</p>
      <p>A back boiler sits behind a gas fire, inside the chimney breast. They are still common in St Helens, mostly in the WA10 terraces. Many were fitted in the 1970s and 1980s.</p>
      <h3>Why replace it?</h3>
      <ul class="sg-ticks">
        <li>Old back boilers waste far more gas than a modern condensing boiler.</li>
        <li>Parts for many models are now hard or impossible to get.</li>
        <li>A crack inside an old boiler is not always easy to see, and can leak carbon monoxide.</li>
        <li>A combi frees up the airing cupboard and loft, with no tanks or cylinder.</li>
      </ul>
      <h3>What does the job involve?</h3>
      <ol class="sg-steps">
        <li><strong>Remove the fire and back boiler.</strong> We take out the gas fire, the surround and the back boiler, and cap the gas.</li>
        <li><strong>Make the chimney safe.</strong> The old flue is capped and the fireplace made good or capped off.</li>
        <li><strong>Choose the new spot.</strong> We agree with you where the combi goes, often the kitchen.</li>
        <li><strong>Fit the combi.</strong> We run new pipes, cut a new flue through an outside wall, then fit and test the boiler.</li>
      </ol>
      <div class="brx-note"><p><strong>Price and time.</strong> You pick any of the five combi packages. The back boiler removal is priced at the free survey, because every house is laid out differently. Most back boiler swaps take 2 days. We do not service or repair back boilers.</p></div>
    </div>
  </section>

  <section class="brx-sec" id="choose">
    <div class="brx-wrap">
      <h2>Which boiler package is right for you?</h2>
      <p class="brx-answer">Paying more buys three things: more years of warranty, more hot water, and a better-known brand or design. Here is a quick guide.</p>
      <div class="sg-quick">
        <p><strong>Flat, small terrace or rental?</strong> <a href="#pk-essential">Essential, Baxi 600</a></p>
        <p><strong>Staying put, on a budget?</strong> <a href="#pk-value">Value, Baxi 800</a></p>
        <p><strong>Most 2 to 4 bed homes</strong> <a href="#pk-popular">Most popular, Worcester Bosch 4000</a></p>
        <p><strong>Two bathrooms or lots of hot water?</strong> <a href="#pk-premium">Premium, Vaillant ecoTEC plus</a></p>
        <p><strong>Boiler on show in the kitchen?</strong> <a href="#pk-flagship">Flagship, Worcester Bosch 8000+ Style</a></p>
      </div>
      <div class="brx-table-wrap">
        <table class="brx-table sg-cmp">
          <thead><tr><th>Package</th><th>Price</th><th>Hot water (litres a minute)</th><th>Warranty</th></tr></thead>
          <tbody>
            {boilers.map((b) => <tr><td><a href={`#${b.id}`}><strong>{b.tier}</strong></a><br />{b.name}</td><td><strong>{b.price}</strong></td><td>{b.flow}</td><td>{b.warranty}</td></tr>)}
          </tbody>
        </table>
      </div>
      <h3>Is the Baxi 800 worth £300 more than the Baxi 600?</h3>
      <p>If you are staying in the house, yes. It is the same boiler, with a magnetic filter in the box and 10 years of cover instead of 7. Landlords, or anyone moving within 5 years, can save with the Baxi 600.</p>
      <h3>Do I need the extra hot water?</h3>
      <p>Only if two showers, or a bath and a tap, often run at once. With one bathroom, the Worcester Bosch 4000 is the better value. A bigger combi only gives more hot water if your mains can supply it. We test that at the survey.</p>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="homes">
    <div class="brx-wrap">
      <h2>Which boiler suits your St Helens home?</h2>
      <p class="brx-answer">St Helens homes were built in very different eras. The right boiler depends on when yours was built and what it has now.</p>
      <div class="brx-parts">
        <div class="brx-part">
          <h3>Victorian terraces (WA10)</h3>
          <p>Built for glass and factory workers before 1914. Many still have a back boiler or tanks in the loft. Mains pressure varies from street to street, so we test it first.</p>
        </div>
        <div class="brx-part">
          <h3>Haydock semis (WA11)</h3>
          <p>Mostly 1950s to 1970s semis, often with old boilers and pipes. Most have good mains pressure. A 28kW combi usually suits a 3 bed with one bathroom.</p>
        </div>
        <div class="brx-part">
          <h3>Newton-le-Willows (WA12)</h3>
          <p>A real mix. Terraces near Earlestown station are like WA10, and back boilers turn up there too. The newer estates on the edge usually take a simple combi swap.</p>
        </div>
        <div class="brx-part">
          <h3>Billinge, Thatto Heath and Clock Face (WN5, WA9)</h3>
          <p>Older homes in former mining villages, many never changed to a combi. Vented cylinders and old regular boilers are common. We check if a combi will work, or keep a regular boiler.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="brx-sec" id="cost">
    <div class="brx-wrap">
      <h2>What can change the price?</h2>
      <p class="brx-answer">The package prices cover a like-for-like combi swap. These extras are priced openly, so you know before the survey.</p>
      <div class="brx-table-wrap">
        <table class="brx-table">
          <thead><tr><th>Extra</th><th>Price</th></tr></thead>
          <tbody>{extras.map(([h, p]) => <tr><td>{h}</td><td><strong>{p}</strong></td></tr>)}</tbody>
        </table>
      </div>
      <p>System and regular boilers are priced at the free survey, because the cylinder and pipework vary from house to house. All prices include VAT. Your written price covers everything, so there are no surprises on the day.</p>
      <div class="brx-cta">
        <p><strong>Still on a back boiler?</strong> Ring us. We will book a free survey and give you a fixed price.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="included">
    <div class="brx-wrap">
      <h2>What is included in the price?</h2>
      <p class="brx-answer">Everything needed for a safe, finished install. There are no hidden extras.</p>
      <ul class="sg-ticks">
        <li><strong>The new boiler</strong>, A-rated and sized for your home.</li>
        <li><strong>A smart thermostat</strong>, fitted and set up. It meets the Boiler Plus rules.</li>
        <li><strong>A carbon monoxide alarm</strong> near the boiler.</li>
        <li><strong>A magnetic filter</strong> to catch sludge before it reaches the boiler.</li>
        <li><strong>A system clean and inhibitor.</strong> Older St Helens systems often hold years of sludge, which can harm a new boiler.</li>
        <li><strong>The flue, valves and fittings.</strong></li>
        <li><strong>Old boiler removed</strong> and taken away. No skip needed.</li>
        <li><strong>Commissioning.</strong> Gas and safety checks, radiators balanced, and we show you the controls.</li>
        <li><strong>Paperwork.</strong> Benchmark checklist, warranty registered for you, and the install notified to Gas Safe Register.</li>
      </ul>
      <figure class="sg-photo" style="max-width:360px;margin-top:1.25rem;">
        <picture>
          <source type="image/webp" srcset="/images/jobs/boiler-smart-thermostat-fitted-480.webp 480w, /images/jobs/boiler-smart-thermostat-fitted-960.webp 960w" sizes="(max-width: 800px) 100vw, 360px" />
          <img src="/images/jobs/boiler-smart-thermostat-fitted-960.jpg" alt="Boiler and smart thermostat receiver fitted by our team" loading="lazy" decoding="async" width="960" height="1280" />
        </picture>
        <figcaption>A recent job: boiler controls fitted by our team.</figcaption>
      </figure>
    </div>
  </section>

  <section class="brx-sec" id="how">
    <div class="brx-wrap">
      <h2>How does a new boiler install work?</h2>
      <ol class="sg-steps">
        <li><strong>Free survey (about 45 minutes).</strong> An engineer checks your boiler, pipes, flue route, gas supply and water pressure. For a back boiler, we agree where the new one goes. You get a written fixed price.</li>
        <li><strong>You choose a date.</strong> We book the install for a day that suits you. Boiler broken? Tell us and we give you our earliest slot.</li>
        <li><strong>Clean the system.</strong> The heating is cleaned so old sludge does not harm the new boiler.</li>
        <li><strong>Fit and commission.</strong> The old boiler comes out and the new one goes in. We test it and balance the radiators. A combi swap is usually one day. A back boiler swap is usually 2.</li>
        <li><strong>Handover.</strong> We show you the controls, fill in the Benchmark checklist and register the warranty.</li>
      </ol>
      <p style="margin-top:1rem;">Landlords: we can also do your <a href="/gas-safety-certificate-st-helens">gas safety certificate</a> from £75. Then book a <a href="/boiler-service-st-helens">boiler service</a> each year to keep the warranty valid.</p>
      <div class="brx-cta">
        <p><strong>Book your free survey.</strong> Ring us or book online and we will arrange a time.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>
</ServiceGuide>
