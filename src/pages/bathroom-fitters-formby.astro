    ['cost', 'How much does a bathroom cost?'],
    ['included', 'What is included?'],
    ['selling', 'A new bathroom before you sell'],
    ['how', 'How long does it take?'],
    ['en-suite', 'En-suites and extensions'],
    ['which', 'Which option is right for me?'],
    ['postcodes', 'Areas we cover'],
    ['why', 'Our work and guarantee'],
  ]}
  reviews={['Jonathon W', 'Stephen D', 'Meghann S']}
