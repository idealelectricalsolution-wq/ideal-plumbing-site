---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/bathroom-fitters-formby';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'cloakroom', tier: 'Small room', name: 'Cloakroom or WC', price: '£2,495', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['New toilet and basin', 'Taps, waste and pipework', 'Tiling or wall panels', 'Old suite taken away'] },
  { id: 'full', tier: 'Full bathroom', popular: true, name: 'Full bathroom, supplied and fitted', price: '£4,995', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Bath or shower, toilet, basin and taps', 'Strip-out and disposal', 'All plumbing and tiling', 'Usually 5 to 7 working days'] },
  { id: 'en-suite', tier: 'En-suite', name: 'En-suite shower room', price: '£4,495', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Shower tray, enclosure and valve', 'Toilet and basin', 'Tiling and waterproofing', 'Extractor fan by our partner electricians'] },
  { id: 'bath-to-shower', tier: 'Most asked for', name: 'Bath to shower conversion', price: '£2,395', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Bath removed and taken away', 'Tray, enclosure and thermostatic valve', 'Shower area tiled or panelled', 'Usually 2 to 3 days'] },
];

const faqs = [
  { q: 'How much does a bathroom installation cost in Formby?', a: 'A full bathroom in Formby, supplied and fitted, starts from £4,995 including VAT. An en-suite is from £4,495 and a cloakroom or WC is from £2,495. A bath to shower conversion is from £2,395. If you buy your own suite, a labour-only full refit is from £2,750. You get a fixed written price after a free home visit.' },
  { q: 'How long does a bathroom installation take in Formby?', a: 'A full bathroom usually takes 5 to 7 working days. A bath to shower conversion takes 2 to 3 days. A large bathroom with big format tiles, or an en-suite with a new cylinder, can take longer. We give you the dates in your quote.' },
  { q: 'Do you cover all of Formby and L37?', a: 'Yes. We fit bathrooms across Formby Village, Freshfield and Formby Point in L37. We also cover Maghull and Lydiate in L31, Aughton in L39, and Crosby, Waterloo and Litherland. Travel is included in your quote.' },
  { q: 'Can you add an en-suite with mains pressure in my Formby home?', a: 'Yes. A strong shower in a new en-suite often needs an unvented cylinder, so two showers can run at once. Our engineers are G3 qualified to fit them. We can do the en-suite and the cylinder as one job, with one price. En-suites start from £4,495 and unvented cylinders from £1,450.' },
  { q: 'Can you fit a new bathroom before I sell?', a: 'Yes. Tell us your listing date at the free visit. We give you a fixed price and plan the work so the room is finished, cleaned and ready for photos.' },
  { q: 'Do you work on extensions and loft conversions?', a: 'Yes. We work alongside your builder. We do the first fix plumbing during the build, then come back to tile and fit the bathroom once the room is ready.' },
  { q: 'Do I need a separate tiler or electrician?', a: 'No. Our team does the plumbing and the tiling. Lights, extractor fans and shower circuits are done by our partner firm Ideal Electrical Solutions. We book them into the same plan, so you only deal with us.' },
  { q: 'Do I need to pay up front?', a: 'Nothing is paid before the visit, and the visit is free. Payment terms are agreed in writing with your quote, before the job is booked in. We do not offer finance.' },
];
---

<ServiceGuide
  url={URL_}
  title="Bathroom Fitters Formby | Full Bathrooms and En-Suites From £4,995"
  description="Bathroom fitters in Formby. New bathroom installation from £4,995, en-suites from £4,495, bath to shower from £2,395, inc VAT. Plumbing and tiling by our team. All L37 postcodes. Call 0151 558 0334."
  h1="Bathroom Fitters Formby"
  badge="Free home visit · Formby L37 and Sefton"
  intro="New bathrooms fitted across Formby from £4,995, including VAT. Our team, led by James, does the strip-out, the plumbing and the tiling. We fit en-suites, main bathrooms and bathrooms before a sale. You get a fixed written price after a free home visit, and a 12-month guarantee on our work."
  secondaryCta={{ href: '#prices', label: 'See bathroom prices' }}
  stats={[['£4,995', 'Full bathroom fitted'], ['£4,495', 'En-suite fitted']]}
