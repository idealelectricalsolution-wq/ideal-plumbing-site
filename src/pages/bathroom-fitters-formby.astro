  areas={[
    { href: '/bathroom-fitters-liverpool', label: 'Liverpool' },
    { href: '/bathroom-fitters-wirral', label: 'Wirral' },
    { href: '/bathroom-fitters-st-helens', label: 'St Helens' },
  ]}
  related={[
    { href: '/hot-water-cylinders-formby', title: 'Hot water cylinders Formby', text: 'Unvented cylinders for new en-suites, from £1,450' },
    { href: '/radiators-formby', title: 'Radiators Formby', text: 'New radiators and towel rails from £245 fitted' },
    { href: '/boiler-installation-formby', title: 'Boiler installation Formby', text: 'New boilers from £2,195 with a free survey' },
    { href: '/emergency-plumber-formby', title: 'Emergency plumber Formby', text: 'No call-out fee. First hour from £120' },
  ]}
  finalTitle="Book your free Formby bathroom visit"
  finalText="Full bathrooms from £4,995 and en-suites from £4,495, including VAT. Fixed price in writing. Plumbing and tiling by our team."
  serviceName="Bathroom Fitters Formby"
  serviceType="Bathroom installation"
