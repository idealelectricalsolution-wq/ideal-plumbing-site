  factsTitle="Formby bathroom fitting at a glance"
  facts={[
    ['Price', 'Full bathroom from £4,995. En-suite from £4,495. Bath to shower from £2,395. All inc VAT.'],
    ['Time', 'Full bathroom usually 5 to 7 working days. Bath to shower 2 to 3 days.'],
    ['Who', 'Our team led by James does plumbing and tiling. Electrics by our partner firm.'],
    ['Quote', 'Free home visit. Fixed price in writing.'],
