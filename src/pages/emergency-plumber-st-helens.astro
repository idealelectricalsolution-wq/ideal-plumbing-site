---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallStrip from '../components/CallStrip.astro';
---

<BaseLayout
  title="Emergency Plumber St Helens & Local Plumbers | From £120"
  description="Emergency plumber and local plumbers in St Helens, 24/7. WA9 to WA12. Burst pipes, leaks and boiler breakdowns fixed. No call-out fee. From £120."
>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "Plumber"],
    "name": "Liverpool Emergency Plumber",
    "image": "https://liverpoolemergencyplumber.co.uk/ideal-plumbing-logo.png",
    "url": "https://liverpoolemergencyplumber.co.uk/emergency-plumber-st-helens",
    "telephone": "+441515580334",
    "email": "emergencyplumberliverpool@gmail.com",
    "priceRange": "££",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "29 Park Road",
      "addressLocality": "Kirkby",
      "addressRegion": "Merseyside",
      "postalCode": "L32 2AL",
      "addressCountry": "GB"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "areaServed": [
      { "@type": "Place", "name": "St Helens" },
      { "@type": "Place", "name": "Newton-le-Willows" },
      { "@type": "Place", "name": "Haydock" },
      { "@type": "Place", "name": "Rainford" },
      { "@type": "Place", "name": "Billinge" },
      { "@type": "Place", "name": "Earlestown" },
      { "@type": "Place", "name": "Eccleston" },
      { "@type": "Place", "name": "Thatto Heath" }
    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Emergency Plumber St Helens",
    "description": "24/7 emergency plumber across St Helens and surrounding areas. WA10, WA11, WA12 postcodes covered. Gas Safe registered. Fast response. Fixed prices from £120 for the first hour. Burst pipes, leaks, boiler breakdowns, no hot water, gas leaks. Gas Safe registered",
    "provider": { "@id": "https://liverpoolemergencyplumber.co.uk/#business" },
    "areaServed": { "@type": "Place", "name": "St Helens, WA10-WA12" },
    "hoursAvailable": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "offers": [
      { "@type": "Offer", "name": "Weekday Emergency Plumber St Helens", "price": "120", "priceCurrency": "GBP", "description": "Monday to Friday 9am to 4pm. Price for the first hour. No call-out fee." },
      { "@type": "Offer", "name": "Evening and Weekend Emergency Plumber St Helens", "price": "150", "priceCurrency": "GBP", "description": "Weekdays after 4pm, nights and weekends. Price for the first hour. No call-out fee." },
      { "@type": "Offer", "name": "Bank Holiday Emergency Plumber St Helens", "price": "180", "priceCurrency": "GBP", "description": "Bank holidays. Price for the first hour. No call-out fee." }
    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How quickly can you reach me in St Helens?", "acceptedAnswer": { "@type": "Answer", "text": "We come out fast across St Helens and surrounding areas. Newton-le-Willows, Haydock, Rainford and Billinge are around 30 to 35 minutes. We know the roads across St Helens borough and are on our way as soon as you call." } },
      { "@type": "Question", "name": "What postcodes do you cover in St Helens?", "acceptedAnswer": { "@type": "Answer", "text": "We cover all of St Helens. That includes WA10 St Helens town centre and Eccleston, WA11 Haydock and Rainford, WA12 Newton-le-Willows and Earlestown, WA9 Thatto Heath and Sutton, and WN5 Billinge." } },
      { "@type": "Question", "name": "How much does an emergency plumber cost in St Helens?", "acceptedAnswer": { "@type": "Answer", "text": "£120 for the first hour on weekdays 9am to 4pm. £150 for the first hour on weekday evenings, nights and weekends. £180 for the first hour on bank holidays. Parts at cost. Written quote before work begins." } },
      { "@type": "Question", "name": "Do you cover Newton-le-Willows and Haydock?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We cover Newton-le-Willows WA12, Earlestown WA12, Haydock WA11 and all surrounding villages as part of our St Helens coverage area. Response times to these areas are typically 30 to 35 minutes." } },
      { "@type": "Question", "name": "Who will come to my home in St Helens?", "acceptedAnswer": { "@type": "Answer", "text": "One of our trusted, fully trained engineers, day or night. Gas work is always done by a Gas Safe registered engineer." } },
      { "@type": "Question", "name": "Can you repair older back boilers and gravity-fed systems in St Helens?", "acceptedAnswer": { "@type": "Answer", "text": "No. We do not repair or service back boilers. We remove old back boilers, safely cap the gas fire in front, and fit a new combi. We do work on vented hot water cylinders and gravity-fed heating systems often. These remain common across WA10 Victorian terraces and older homes through the borough. We will tell you straight whether a repair is worth it or if a swap would save you money long-term." } },
      { "@type": "Question", "name": "Do you guarantee your St Helens plumbing work?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All our work carries a full 12-month workmanship guarantee. If anything we fix fails within 12 months due to our work we come back and sort it at no charge. This covers all homes across St Helens and the surrounding areas we serve." } },
      { "@type": "Question", "name": "Do you provide gas safety certificates for St Helens landlords?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. CP12 gas safety certificates from £100, same day where needed, across all St Helens postcodes. Combined boiler service and CP12 from £199. We work with both individual landlords and letting agents across WA10, WA11 and WA12." } }
    ]
  }
  </script>

  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-badge" style="margin:0 auto 1rem;">
        <span class="live-dot"></span>
        Available 24/7 Across St Helens and Surrounding Areas
      </div>
      <h1>Emergency Plumber St Helens</h1>
      <p class="page-hero-sub">Burst pipes, leaks, boiler breakdowns or gas leaks. We are the 24/7 emergency plumber that covers WA10, WA11 and WA12. Gas Safe registered engineers, fixed prices from £120.</p>

      <div style="background:var(--navy);border-radius:var(--radius);padding:1rem 1.5rem;max-width:320px;margin:1.25rem auto;display:flex;flex-direction:column;align-items:center;gap:0.2rem;">
        <span style="font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-size:3rem;font-weight:900;color:#fb923c;line-height:1;">24/7</span>
        <span style="font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-size:1rem;font-weight:900;color:#ffffff;line-height:1.2;">Emergency Cover Across St Helens</span>
        <p style="color:rgba(255,255,255,0.85);font-size:0.85rem;margin:0.3rem 0 0;">From <strong style="color:#fb923c;">£120</strong> for the first hour · No call-out fee</p>
      </div>

      <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;max-width:320px;margin:0 auto 1.5rem;">
        <a href="tel:01515580334" class="btn btn-orange btn-lg btn-full" style="box-shadow:0 4px 14px rgba(249,115,22,0.4);font-size:1.3rem;color:#ffffff;">CALL 0151 558 0334</a>
        <a href="/get-started" class="btn btn-lg btn-full" style="background:var(--navy);color:#ffffff;border:2px solid var(--navy);">BOOK A SLOT ONLINE</a>
      </div>

      <div class="trust-row">
        <div class="trust-item"><strong>£0</strong><span>Call-Out Fee</span></div>
        <div class="trust-item"><strong>24/7</strong><span>Real Person Answers</span></div>
        <div class="trust-item"><strong>5.0★</strong><span>Google Reviews</span></div>
      </div>

      <div class="hero-chips">
        <span>✓ Gas Safe Registered</span>
        <span>✓ Borough-Wide Cover</span>
        <span>✓ 12-Month Guarantee</span>
        <span>✓ £2M Public Liability</span>
      </div>
    </div>
  </section>

  <div class="pf">

  <!-- EMERGENCY LEVELS -->
  <section class="pf-section" style="background:#f8fafc;">
    <div class="container">
      <h2>What Is a Plumbing Emergency in St Helens?</h2>
      <p class="pf-sub">Some St Helens plumbing problems need an immediate call. Others can wait until morning. Here is how to tell which is which.</p>
      <div class="emerg-levels" style="margin-top:2rem;">
        <div class="emerg-level emerg-level--danger">
          <div class="level-header">
            <span style="font-size:1.5rem;">🔴</span>
            <div><strong>Call Immediately. Do Not Wait.</strong><span>Stop what you are doing and call now</span></div>
          </div>
          <ul>
            <li>Gas leak. Smell of gas or hissing sound</li>
            <li>Burst pipe. Water pouring out</li>
            <li>Flooding. Water rapidly accumulating</li>
            <li>Toilet overflowing and will not stop</li>
            <li>Boiler leaking gas or carbon monoxide alarm</li>
            <li>No water to entire property</li>
          </ul>
          <a href="tel:01515580334" class="btn btn-red btn-full" style="margin-top:1rem;color:#ffffff;">Call 0151 558 0334 Now</a>
        </div>
        <div class="emerg-level emerg-level--urgent">
          <div class="level-header">
            <span style="font-size:1.5rem;">🟡</span>
            <div><strong>Call Today. Do Not Leave Overnight.</strong><span>Urgent but not immediate danger</span></div>
          </div>
          <ul>
            <li>Major leak. Constant drip or puddle forming</li>
            <li>Blocked toilet. Backing up or overflowing</li>
            <li>No hot water. Boiler not working</li>
            <li>Frozen pipes. Risk of bursting</li>
            <li>Water tank overflow</li>
            <li>Radiator leak</li>
          </ul>
          <a href="tel:01515580334" class="btn btn-navy btn-full" style="margin-top:1rem;">Call for Advice</a>
        </div>
        <div class="emerg-level emerg-level--routine">
          <div class="level-header">
            <span style="font-size:1.5rem;">🟢</span>
            <div><strong>Can Wait. Book an Appointment.</strong><span>No immediate danger</span></div>
          </div>
          <ul>
            <li>Dripping tap</li>
            <li>Slow drain</li>
            <li>Boiler service due</li>
            <li>Radiator not heating well</li>
            <li>Shower pressure low</li>
            <li>General plumbing work</li>
          </ul>
          <a href="/get-started" class="btn btn-navy btn-full" style="margin-top:1rem;opacity:0.8;">Book Appointment</a>
        </div>
      </div>
      <p style="text-align:center;margin-top:1.5rem;font-size:0.95rem;color:var(--muted);">Not sure? Call us and we will tell you straight. <a href="tel:01515580334" style="color:#c2410c;font-weight:700;">0151 558 0334</a></p>
    </div>
  </section>


  <!-- PRICING -->
  <section class="pf-section" style="background:#f8fafc;">
    <div class="container">
      <h2>Emergency Plumber St Helens. Fixed Hourly Rates.</h2>
      <p class="pf-sub">Fixed prices for the first hour on every St Helens call-out. No hidden charges. Parts at cost. The price we quote is the price you pay.</p>

      <div class="pf-pricing-grid">
        <div class="pf-price-card">
          <div class="pf-price-tier">WEEKDAY EMERGENCY</div>
          <div class="pf-price-name">Monday to Friday</div>
          <div class="pf-price-sub">9am to 4pm</div>
          <div class="pf-price-amount">£120<small> first hour</small></div>
          <ul class="pf-price-list">
            <li>Fast St Helens response</li>
            <li>Gas Safe engineer</li>
            <li>Parts at cost only</li>
            <li>No call-out fee</li>
          </ul>
          <a href="tel:01515580334" class="btn btn-navy btn-full">Call Now</a>
        </div>

        <div class="pf-price-card">
          <div class="pf-price-tier">OUT OF HOURS</div>
          <div class="pf-price-name">Evenings and weekends</div>
          <div class="pf-price-sub">Weekdays after 4pm, nights and all weekend</div>
          <div class="pf-price-amount">£150<small> first hour</small></div>
          <ul class="pf-price-list">
            <li>Same fast service</li>
            <li>Gas Safe engineer</li>
            <li>Parts at cost only</li>
            <li>No call-out fee</li>
          </ul>
          <a href="tel:01515580334" class="btn btn-navy btn-full">Call Now</a>
        </div>

        <div class="pf-price-card pf-price-card-featured">
          <div class="pf-price-badge">MOST COMMON</div>
          <div class="pf-price-tier">BANK HOLIDAYS</div>
          <div class="pf-price-name">Every bank holiday</div>
          <div class="pf-price-sub">Anytime, 24/7</div>
          <div class="pf-price-amount">£180<small> first hour</small></div>
          <ul class="pf-price-list">
            <li>24/7 St Helens cover</li>
            <li>Emergency priority response</li>
            <li>Gas Safe engineer</li>
            <li>No call-out fee</li>
          </ul>
          <a href="tel:01515580334" class="btn btn-orange btn-full" style="color:#ffffff;">Call Now. We Answer.</a>
        </div>
      </div>

      <div class="pf-info-bar" style="margin-top:2rem;">
        <p style="font-size:0.9rem;color:var(--text);font-weight:600;">Extra time is priced before we carry on. Parts at cost. Written quote before any work begins. Most emergency jobs take 30 to 90 minutes.</p>
      </div>
    </div>
  </section>


  <!-- ST HELENS HOUSING STOCK - UNIQUE SECTION -->
  <section class="pf-section" style="background:#f1f5f9;">
    <div class="container">
      <span class="pf-section-label">LOCAL EXPERTISE</span>
      <h2>St Helens Housing. What We Find.</h2>
      <p class="pf-sub">St Helens has a distinct mix of homes built across five different eras, each with its own plumbing quirks. Knowing the era of your home helps our engineers know what to expect before they arrive.</p>

      <div style="display:grid;grid-template-columns:1fr;gap:1.5rem;margin-top:2rem;">

        <div class="pf-card pf-card-left-orange">
          <div style="display:flex;gap:1rem;align-items:flex-start;">
            <div style="background:#c2410c;color:#fff;border-radius:6px;padding:0.3rem 0.7rem;font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-weight:900;font-size:0.85rem;white-space:nowrap;flex-shrink:0;">WA10</div>
            <div>
              <strong style="display:block;color:var(--navy);font-size:1rem;margin-bottom:0.35rem;">Town Centre and the Pilkington Terraces</strong>
              <p style="font-size:0.93rem;color:var(--muted);margin:0;line-height:1.65;">The dense terraced streets of WA10 were built around 1900. They housed Pilkington Glass workers and their families. Many still have loft tanks feeding the hot water. The copper pipework is often original or swapped only once. Many WA10 terraces are now HMOs. In these homes, a fault in one flat can cut the water to several others. We handle HMO call-outs across WA10 often and know the extra complexity they bring.</p>
            </div>
          </div>
        </div>

        <div class="pf-card pf-card-left-orange">
          <div style="display:flex;gap:1rem;align-items:flex-start;">
            <div style="background:#c2410c;color:#fff;border-radius:6px;padding:0.3rem 0.7rem;font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-weight:900;font-size:0.85rem;white-space:nowrap;flex-shrink:0;">WA11</div>
            <div>
              <strong style="display:block;color:var(--navy);font-size:1rem;margin-bottom:0.35rem;">Haydock and Rainford</strong>
              <p style="font-size:0.93rem;color:var(--muted);margin:0;line-height:1.65;">Haydock is mostly post-war semi and detached housing, much of it built between the 1950s and 1970s. Homes of this era used copper pipework that is now reaching the end of its design life in many cases. Boilers in these homes are often the original 1970s and 1980s back boilers or early combi units that have outlived their working life. Rainford by contrast has a mix of older village homes and newer private estates. We work on Haydock and Rainford often and carry stock for the most common faults found in this era of housing.</p>
            </div>
          </div>
        </div>

        <div class="pf-card pf-card-left-orange">
          <div style="display:flex;gap:1rem;align-items:flex-start;">
            <div style="background:#c2410c;color:#fff;border-radius:6px;padding:0.3rem 0.7rem;font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-weight:900;font-size:0.85rem;white-space:nowrap;flex-shrink:0;">WA12</div>
            <div>
              <strong style="display:block;color:var(--navy);font-size:1rem;margin-bottom:0.35rem;">Newton-le-Willows and Earlestown</strong>
              <p style="font-size:0.93rem;color:var(--muted);margin:0;line-height:1.65;">Newton-le-Willows is a market town with a varied home mix. The streets around Earlestown station hold Victorian and Edwardian terraces with older plumbing layouts. The outskirts of Newton have large private estates built from the 1980s onwards with modern combi boilers. The M6 corridor around Newton has grown fast. We cover business sites across WA12 24/7, at the same fixed rates as homes. Newton has a lot of buy-to-let homes. We work with landlords and letting agents across WA12 to keep gas safety up to date.</p>
            </div>
          </div>
        </div>

        <div class="pf-card pf-card-left-orange">
          <div style="display:flex;gap:1rem;align-items:flex-start;">
            <div style="background:#c2410c;color:#fff;border-radius:6px;padding:0.3rem 0.7rem;font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-weight:900;font-size:0.85rem;white-space:nowrap;flex-shrink:0;">WA9 WN5</div>
            <div>
              <strong style="display:block;color:var(--navy);font-size:1rem;margin-bottom:0.35rem;">Thatto Heath, Billinge and Surrounding Villages</strong>
              <p style="font-size:0.93rem;color:var(--muted);margin:0;line-height:1.65;">The villages around St Helens include Billinge, Seneley Green and Thatto Heath. They mix older cottages with 1960s to 1980s council-built homes. The former mining areas here have older heating that predates the spread of combi boilers. Many homes still run vented hot water cylinders and older heating set-ups that need an engineer who knows how they work. Billinge in particular sits on the boundary with Wigan borough and the housing stock here shows that split between the two areas.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <CallStrip title="Need a plumber in St Helens?" text="Emergency or everyday job, call us. We answer 24/7, and there is no call-out fee." />


  <!-- COMMON JOBS -->
  <section class="pf-section" style="background:#f8fafc;">
    <div class="container">
      <h2>Common Emergencies We Fix Across St Helens</h2>
      <p class="pf-sub">The plumbing faults we attend most often across WA10, WA11, WA12 and surrounding areas.</p>
      <div class="jobs-grid" style="margin-top:2rem;">
        <div class="job-card"><h3>Burst Pipes and Water Through the Ceiling</h3><div class="job-meta"><span class="job-price">£120 to £350</span><span class="job-time">30 to 90 mins</span></div><p>Common in WA10 Victorian terraces where loft tanks and outdoor pipework have never been insulated. We stop the leak, repair or swap the bad section and check for hidden water damage before we leave your St Helens home.</p>  <a class="job-link" href="/burst-pipe-repair-liverpool"><span>Burst pipe repair</span><span class="lc-arr" aria-hidden="true">→</span></a>
        </div>
        <div class="job-card"><h3>No Hot Water and Boiler Breakdown</h3><div class="job-meta"><span class="job-price">£150 to £500</span><span class="job-time">45 to 120 mins</span></div><p>Old boiler in a WA10 terrace or a modern one in Newton-le-Willows, we aim to find and fix the fault on the same visit. Most St Helens boiler call-outs are sorted on the first visit with parts from the van. Gas Safe registered.</p>  <a class="job-link" href="/no-heating-no-hot-water-liverpool"><span>No heating or hot water</span><span class="lc-arr" aria-hidden="true">→</span></a>
        </div>

        <div class="job-card job-card--warning"><h3>Gas Leaks</h3><div class="job-meta"><span class="job-price">Call Cadent first</span><span class="job-time">Priority response</span></div><p>If you smell gas, get out and call <a href="https://cadentgas.com/emergencies" target="_blank" rel="noopener" style="font-weight:700;">Cadent Gas on 0800 111 999</a> first. Then call us. Gas safety make-safe visit is FREE. Gas Safe registered engineers only on all gas work across St Helens.</p></div>
        <div class="job-card"><h3>Major Leaks</h3><div class="job-meta"><span class="job-price">£120 to £250</span><span class="job-time">20 to 60 mins</span></div><p>Leaking radiators, pipes under sinks, toilet cistern failures and valve issues. We find the source fast and repair or swap the part before it causes water damage. Most major leak call-outs in St Helens are sorted within 60 minutes.</p>  <a class="job-link" href="/leak-detection-liverpool"><span>Leak detection</span><span class="lc-arr" aria-hidden="true">→</span></a>
        </div>
        <div class="job-card"><h3>Heating Failure</h3><div class="job-meta"><span class="job-price">£120 to £350</span><span class="job-time">60 to 120 mins</span></div><p>Heating failing is a priority in cold months. We check pump, motor valves, thermostats and pipework on every heating call-out across St Helens. Priority response for elderly and vulnerable people in WA10, WA11 and WA12.</p>  <a class="job-link" href="/boiler-repair-liverpool"><span>Boiler repair</span><span class="lc-arr" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>


  <!-- ALL ST HELENS SERVICES -->
  <section class="pf-section" style="background:#f1f5f9;">
    <div class="container">
      <h2 >Plumbers in St Helens for Every Job</h2>
      <p class="pf-sub" >Not an emergency? We cover the full range of plumbing and heating work across WA10, WA11 and WA12.</p>
      <div class="services-grid" style="margin-top:2rem;">
        <a href="/boiler-installation-st-helens" class="service-card" style="background:#ffffff;border:1px solid #e2e8f0;border-left:3px solid var(--orange);display:flex;flex-direction:column;">
          <strong style="color:var(--navy);">Boiler Installation St Helens</strong>
          <span style="color:var(--text);flex:1;">New combi, system and regular boilers from £2,195. Baxi, Worcester Bosch and Vaillant. Up to 12-year warranty.</span>
          <span style="display:block;margin-top:0.75rem;color:#c2410c;font-weight:700;font-size:0.88rem;">View service &rarr;</span>
        </a>
        <a href="/boiler-service-st-helens" class="service-card" style="background:#ffffff;border:1px solid #e2e8f0;border-left:3px solid var(--orange);display:flex;flex-direction:column;">
          <strong style="color:var(--navy);">Boiler Service St Helens</strong>
          <span style="color:var(--text);flex:1;">Annual boiler service £120. Gas Safe engineer. Benchmark updated. Certificate same day.</span>
          <span style="display:block;margin-top:0.75rem;color:#c2410c;font-weight:700;font-size:0.88rem;">View service &rarr;</span>
        </a>
        <a href="/gas-safety-certificate-st-helens" class="service-card" style="background:#ffffff;border:1px solid #e2e8f0;border-left:3px solid var(--orange);display:flex;flex-direction:column;">
          <strong style="color:var(--navy);">Gas Safety Certificates St Helens</strong>
          <span style="color:var(--text);flex:1;">CP12 landlord certificates from £100. Same-day available. Combined with service for £199.</span>
          <span style="display:block;margin-top:0.75rem;color:#c2410c;font-weight:700;font-size:0.88rem;">View service &rarr;</span>
        </a>
        <a href="/power-flushing-st-helens" class="service-card" style="background:#ffffff;border:1px solid #e2e8f0;border-left:3px solid var(--orange);display:flex;flex-direction:column;">
          <strong style="color:var(--navy);">Power Flushing St Helens</strong>
          <span style="color:var(--text);flex:1;">Cold radiators or noisy boiler? Power flush from £395. Warranty protection included.</span>
