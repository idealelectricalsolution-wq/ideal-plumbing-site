      { "@type": "Question", "name": "How much does an emergency plumber cost in St Helens?", "acceptedAnswer": { "@type": "Answer", "text": "Weekdays 9am to 5pm: £80 per hour with a 1 hour minimum. Weekends 9am to 1pm: £120 per hour with a 1 hour minimum. Out of hours, nights and holidays: £150 per hour with a 1 hour minimum. Parts at cost. Written quote before work begins." } },
      { "@type": "Question", "name": "Do you cover Newton-le-Willows and Haydock?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We cover Newton-le-Willows WA12, Earlestown WA12, Haydock WA11 and all surrounding villages as part of our St Helens coverage area. Response times to these areas are typically 30 to 35 minutes." } },
