const packages = [
  { id: 'cloakroom', tier: 'Small room', name: 'Cloakroom or WC', price: '£2,495', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['New toilet and basin', 'Taps, waste and pipework', 'Tiling or wall panels', 'Old suite taken away'] },
  { id: 'full', tier: 'Full bathroom', popular: true, name: 'Full bathroom, supplied and fitted', price: '£4,995', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Bath or shower, toilet, basin and taps', 'Strip-out and disposal', 'All plumbing and tiling', 'Usually 5 to 10 working days'] },
  { id: 'en-suite', tier: 'En-suite or shower room', name: 'En-suite or shower room', price: '£4,495', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Shower tray, enclosure and valve', 'Toilet and basin', 'Tiling and waterproofing', 'Extractor fan by our partner electricians'] },
  { id: 'bath-to-shower', tier: 'Most asked for', name: 'Bath to shower conversion', price: '£2,395', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Bath removed and taken away', 'Tray, enclosure and thermostatic valve', 'Shower area tiled or panelled', 'Usually 2 to 3 days'] },
];

const faqs = [
  { q: 'How much does a bathroom installation cost in St Helens?', a: 'A full bathroom in St Helens, supplied and fitted, starts from £4,995 including VAT. An en-suite or shower room is from £4,495 and a cloakroom or WC is from £2,495. A bath to shower conversion is from £2,395. If you buy your own suite, a labour-only full refit is from £2,750. You get a fixed written price after a free home visit.' },
  { q: 'How long does a bathroom installation take in St Helens?', a: 'A full bathroom usually takes 5 to 10 working days. A bath to shower conversion takes 2 to 3 days. Moving a bathroom upstairs takes longer, as there is more pipework. We give you the dates in your quote.' },
  { q: 'Can you move a downstairs bathroom upstairs in a WA10 terrace?', a: 'Yes. Many WA10 terraces have the bathroom in the old rear extension. Moving it upstairs means a new soil and waste route, new hot and cold pipes, and a new bathroom in the bedroom. We look at both rooms at the free visit and give you one fixed price for the whole job.' },
  { q: 'Do you cover every St Helens postcode?', a: 'Yes. We cover WA9, WA10, WA11 and WA12, including Parr, Thatto Heath, Eccleston, Haydock, Rainford, Billinge and Newton-le-Willows. We also cover Prescot, Whiston and Rainhill. Travel is included in your quote.' },
  { q: 'Can you fit a bathroom between tenants?', a: 'Yes. We work with St Helens landlords and book the job into the gap between tenants. A full bathroom usually takes 5 to 10 working days. Tell us your dates at the visit and we plan around them.' },
  { q: 'Do I need a separate tiler or electrician?', a: 'No. Our team does the plumbing and the tiling. Lights, extractor fans and shower circuits are done by our partner firm Ideal Electrical Solutions. We book them into the same plan, so you only deal with us.' },
  { q: 'What if you find a problem under the old bath?', a: 'We show you and give you a price before we fix it. Older St Helens terraces often hide corroded cast iron waste pipes or a rotten board. Nothing gets covered up, and you decide.' },
  { q: 'Do I need to pay up front?', a: 'Nothing is paid before the visit, and the visit is free. Payment terms are agreed in writing with your quote, before the job is booked in. We do not offer finance.' },
];
