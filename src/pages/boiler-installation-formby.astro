---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/boiler-installation-formby';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

// Same five packages and prices as /boiler-installation-liverpool.
const boilers = [
  { id: 'pk-essential', tier: 'Essential', name: 'Baxi 600 Combi 2', img: 'baxi-600-combi-2', price: '£2,195', size: '24kW or 30kW', flow: '10.2 to 12.2', warranty: '7 years', best: 'Flats, small terraces and rental homes',
    points: ['Stainless steel heat exchanger', 'Simple, reliable and easy to service', 'Our lowest price for a named brand'] },
  { id: 'pk-value', tier: 'Value', name: 'Baxi 800 Combi 2', img: 'baxi-800-combi-2', price: '£2,495', size: '24kW or 30kW', flow: '10.2 to 12.2', warranty: '10 years', best: '2 to 3 bed homes, if you are staying put',
    points: ['The same boiler as the Baxi 600', 'Magnetic filter in the box', '3 more years of cover for £300 more'] },
  { id: 'pk-popular', tier: 'Most popular', popular: true, name: 'Worcester Bosch Greenstar 4000', img: 'worcester-greenstar-4000', price: '£2,695', size: '25kW or 30kW', flow: '12.3 (30kW)', warranty: 'Up to 10 years', best: 'Most 2 to 4 bed homes',
    points: ['A trusted brand with easy-to-get parts', 'Quiet, at 45dB', 'Ticks over gently on mild days, so it switches on and off less'] },
  { id: 'pk-premium', tier: 'Premium', name: 'Vaillant ecoTEC plus', img: 'vaillant-ecotec-plus', price: '£2,995', size: '26kW or 32kW', flow: '10.6 to 13.0', warranty: 'Up to 10 years', best: 'Busier homes and two bathrooms',
    points: ['More hot water at each size', 'Quality German brand', 'Works with Vaillant smart controls'] },
  { id: 'pk-flagship', tier: 'Flagship', name: 'Worcester Bosch Greenstar 8000+ Style', img: 'worcester-greenstar-8000-style', imgAlt: 'Worcester Bosch Greenstar 8000 Style boiler in gloss black', price: '£3,295', size: '32kW', flow: '13.7', warranty: 'Up to 12 years', best: 'Larger homes, or a boiler on show in the kitchen',
    points: ['Gloss black with a colour touchscreen', 'Optional auto-fill tops up its own pressure', 'The longest cover in our range'] },
];
const packages = boilers.map((b) => ({
  id: b.id, tier: b.tier, name: b.name, price: b.price, popular: b.popular, unit: 'fully fitted, inc VAT',
  img: `boilers/${b.img}`, imgAlt: b.imgAlt || `${b.name} combi boiler`,
  specs: [['Size', b.size], ['Hot water', `${b.flow} litres a minute`], ['Warranty', b.warranty], ['Best for', b.best]] as [string, string][],
  points: b.points,
}));

const extras = [
  ['Next size up (for example 30kW to 36kW)', '+£200'],
  ['Move the boiler within the same room', '+£450'],
  ['Move the boiler to another room on the same floor', '+£750'],
  ['Move the boiler to another floor, the loft or the garage', '+£850'],
  ['Swap a tank system (regular or system boiler) for a combi', '+£695'],
  ['Power flush instead of a chemical clean', '£350'],
  ['Back boiler removal, vertical flue or a gas pipe upgrade', 'Priced at the free survey'],
];

const sizes = [
  ['2 to 3 bed, one bathroom (Formby village, Freshfield cottages and semis)', '24 to 28kW combi'],
  ['Bungalows in Freshfield and Hightown', 'Combi, usually 24 to 30kW'],
  ['3 to 4 bed detached, two bathrooms', '36 to 40kW combi, or a system boiler with a cylinder'],
  ['4 to 6 bed, three or more bathrooms', 'System boiler with an unvented cylinder'],
];

const faqs = [
  { q: 'How much does a new boiler cost in Formby?', a: 'Our five fixed-price combi packages run from £2,195 for a Baxi 600 to £3,295 for a Worcester Bosch Greenstar 8000+ Style, fully fitted and including VAT. Our most popular is the Worcester Bosch Greenstar 4000 at £2,695. System and regular boilers are priced at a free survey.' },
  { q: 'Do Formby homes need a system boiler rather than a combi?', a: 'Many do. A combi heats water as it flows, so two showers at once can run weak. For a Formby home with two or more bathrooms in use at the same time, a system boiler with a cylinder is often better. Smaller homes and bungalows usually suit a combi. We check at the free survey.' },
  { q: 'Are you G3 qualified for unvented cylinder work in Formby?', a: 'Yes. All our engineers are G3 qualified. By law, an unvented cylinder must be fitted and serviced by someone with this qualification. Unvented cylinders are common in larger Formby and Freshfield homes.' },
  { q: 'Do you cover all of L37?', a: 'Yes. We cover Formby, Freshfield and Little Altcar in L37, plus Hightown, Ince Blundell, Ainsdale and Woodvale. We also cover Crosby, Thornton, Maghull and Lydiate. The prices are the same as in Liverpool.' },
  { q: 'How long does a boiler installation take?', a: 'A like-for-like combi swap is usually done in one day. A system boiler with a new cylinder takes about 2 days. Larger homes with several heating zones can take 2 to 3 days. We tell you how long at the survey.' },
  { q: 'Why is my hot water weak upstairs?', a: 'In larger Formby homes, a combi that is too small for the house is a common cause. It cannot heat enough water for more than one tap at once. A bigger combi, or a system boiler with a cylinder, fixes it. We test your mains pressure too, so we know the real cause.' },
  { q: 'What warranty do I get?', a: 'It depends on the boiler: 7 years on the Baxi 600, 10 years on the Baxi 800, up to 10 years on the Worcester Bosch 4000 and Vaillant ecoTEC plus, and up to 12 years on the Worcester Bosch 8000+ Style. We register it on the day. It needs a service every year to stay valid. Our own work is guaranteed for 12 months.' },
  { q: 'Can I still get a gas boiler?', a: 'Yes. You can replace a gas boiler in an existing home with a new gas boiler. The rules that limit gas boilers apply to newly built homes.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Every boiler is fitted by our Gas Safe registered engineers. By law, only a Gas Safe registered engineer can fit a gas boiler. You can check any engineer on the Gas Safe Register website.' },
];
---

<ServiceGuide
  url={URL_}
  title="Boiler Installation Formby | Combi & System Boilers | From £2,195"
  description="New boiler installation in Formby from £2,195 fully fitted, inc VAT. Five combi packages, plus system boilers and unvented cylinders by G3 qualified engineers. Free survey across L37. Call 0151 558 0334."
  h1="New Boiler Installation Formby"
  badge="Combi and system boilers fitted across L37"
  intro="Five fixed-price combi packages, from a Baxi 600 at £2,195 to a Worcester Bosch 8000+ Style at £3,295, fully fitted and including VAT. Many larger Formby homes need a system boiler instead. We check yours at a free survey and give you a written fixed price."
  stats={[['£2,195', 'Fully fitted, from'], ['G3', 'Qualified engineers']]}
  ticks={['Gas Safe Registered', 'G3 Qualified', 'Free Survey', '5.0 on Google']}
  secondaryCta={{ href: '#prices', label: 'See the 5 packages' }}
  pkTitle="New boiler prices in Formby"
  pkLede="Five fixed-price combi packages, including VAT. Every price includes a smart thermostat, magnetic filter, system clean, carbon monoxide alarm and removal of your old boiler."
  packages={packages}
  pkNote="Need a bigger boiler? The next size up is £200 more. Ideal Logic Max is also available, at £2,695. Hot water is at a 35°C rise. Warranties are the manufacturer's: 'up to' means the longest cover, which needs the boiler registered (we do it on the day) and serviced every year. System and regular boilers, with or without a new cylinder, are priced after a free survey."
  factsTitle="A new Formby boiler at a glance"
  facts={[
    ['Price', 'Five combi packages from £2,195 to £3,295, fully fitted, inc VAT.'],
    ['Larger homes', 'System boilers and cylinders priced at a free survey.'],
    ['Time', 'A combi swap is usually one day. A system boiler and cylinder about 2 days.'],
    ['Warranty', '7 to 12 years from the maker, plus our 12-month workmanship guarantee.'],
    ['Who', 'Gas Safe registered, G3 qualified engineers, part of our team led by James.'],
    ['Area', 'Formby, Freshfield, Hightown, Ainsdale and the Sefton coast.'],
  ]}
  toc={[
    ['choose', 'Which package is right for me?'],
    ['system', 'Combi or system boiler?'],
    ['unvented', 'Unvented cylinders and G3'],
    ['cost', 'What can change the price?'],
    ['included', 'What is included?'],
    ['how', 'How does it work?'],
  ]}
  reviewTitle="What do customers say about James and the team?"
  reviews={['Brendan C', 'David H', 'Ellie J', 'Peter H']}
  faqs={faqs}
  areasTitle="Do you fit boilers near Formby?"
  areasText="Yes. We fit boilers across Merseyside at the same fixed prices."
  areas={[
    { href: '/boiler-installation-liverpool', label: 'Boiler installation Liverpool' },
    { href: '/boiler-installation-wirral', label: 'Boiler installation Wirral' },
    { href: '/boiler-installation-st-helens', label: 'Boiler installation St Helens' },
  ]}
  related={[
    { href: '/boiler-service-formby', title: 'Boiler service Formby', text: '£95 fixed price, keeps your warranty valid' },
    { href: '/gas-safety-certificate-formby', title: 'Gas safety certificate Formby', text: 'Landlord CP12 from £75' },
    { href: '/hot-water-cylinders-formby', title: 'Hot water cylinders Formby', text: 'Unvented from £1,450, G3 qualified' },
    { href: '/power-flushing-formby', title: 'Power flushing Formby', text: 'From £395 for up to 6 radiators' },
    { href: '/central-heating-installation-formby', title: 'Central heating Formby', text: 'Full systems from £4,495' },
    { href: '/emergency-plumber-formby', title: 'Emergency plumber Formby', text: 'From £120 for the first hour, no call-out fee' },
  ]}
  finalTitle="Book your free Formby boiler survey"
  finalText="Five fixed-price packages from £2,195, inc VAT. System boilers for larger homes. Smell gas? Call the National Gas Emergency line on 0800 111 999 first."
  serviceName="Boiler Installation Formby"
  serviceType="Gas boiler installation and replacement"
  serviceDesc="Five fixed-price combi boiler packages from £2,195 fully fitted, plus system boilers and unvented cylinders by G3 qualified engineers, across Formby and the Sefton coast. Free survey and written fixed price."
  areaServed={['Formby', 'Freshfield', 'Little Altcar', 'Hightown', 'Ince Blundell', 'Ainsdale', 'Woodvale', 'Crosby', 'Maghull']}
>
  <section class="brx-sec brx-tint" id="choose">
    <div class="brx-wrap">
      <h2>Which boiler package is right for you?</h2>
      <p class="brx-answer">Paying more buys three things: more years of warranty, more hot water, and a better-known brand or design. Here is a quick guide.</p>
      <div class="sg-quick">
        <p><strong>Flat, cottage or rental?</strong> <a href="#pk-essential">Essential, Baxi 600</a></p>
        <p><strong>Small home, staying put?</strong> <a href="#pk-value">Value, Baxi 800</a></p>
        <p><strong>Most 2 to 4 bed homes</strong> <a href="#pk-popular">Most popular, Worcester Bosch 4000</a></p>
        <p><strong>Two bathrooms or lots of hot water?</strong> <a href="#pk-premium">Premium, Vaillant ecoTEC plus</a></p>
        <p><strong>Boiler on show in the kitchen?</strong> <a href="#pk-flagship">Flagship, Worcester Bosch 8000+ Style</a></p>
      </div>
      <div class="brx-table-wrap">
        <table class="brx-table sg-cmp">
          <thead><tr><th>Package</th><th>Price</th><th>Hot water (litres a minute)</th><th>Warranty</th></tr></thead>
          <tbody>
            {boilers.map((b) => <tr><td><a href={`#${b.id}`}><strong>{b.tier}</strong></a><br />{b.name}</td><td><strong>{b.price}</strong></td><td>{b.flow}</td><td>{b.warranty}</td></tr>)}
          </tbody>
        </table>
      </div>
      <h3>Is the Baxi 800 worth £300 more than the Baxi 600?</h3>
      <p>If you are staying in the house, yes. It is the same boiler, with a magnetic filter in the box and 10 years of cover instead of 7.</p>
      <h3>Vaillant or Worcester Bosch 8000+ Style?</h3>
      <p>Both suit busier homes. The 8000+ Style gives the most hot water in our range and up to 12 years of cover. It is gloss black with a touchscreen. If the boiler lives in a cupboard, the Vaillant does the job for £300 less.</p>
    </div>
  </section>

  <section class="brx-sec" id="system">
    <div class="brx-wrap">
      <h2>Does your Formby home need a combi or a system boiler?</h2>
      <p class="brx-answer">Smaller homes and bungalows usually suit a combi. Many Formby homes have three or more bedrooms and two bathrooms. For those, a big combi or a system boiler with a cylinder is often better.</p>
      <p>A combi heats water as it flows through. When two people shower at once, it cannot heat enough water for both. One shower runs weak or cold. A system boiler heats a cylinder full of hot water ahead of time, so several taps can run at once.</p>
      <div class="brx-table-wrap">
        <table class="brx-table">
          <thead><tr><th>Your home</th><th>What usually suits it</th></tr></thead>
          <tbody>{sizes.map(([h, s]) => <tr><td>{h}</td><td><strong style="white-space:normal;">{s}</strong></td></tr>)}</tbody>
        </table>
      </div>
      <p>These are a guide. Too small and the shower runs lukewarm. Too big and the boiler wastes gas. We work out the right size at the survey.</p>
      <div class="brx-note"><p><strong>Freshfield bungalows:</strong> many have old pipes running through the loft. We check their condition before a new boiler is connected.</p></div>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="unvented">
    <div class="brx-wrap">
      <h2>What about unvented cylinders?</h2>
      <p class="brx-answer">Unvented cylinders are common in larger Formby homes. They give strong, mains-pressure hot water to several bathrooms. By law, only a G3 qualified engineer can fit or service one.</p>
      <ul class="sg-ticks">
        <li>All our engineers are G3 qualified.</li>
        <li>We check if your cylinder is vented or unvented at the survey.</li>
        <li>We size the boiler and cylinder for your bathrooms and how you use them.</li>
        <li>We show you how to use the cylinder settings at handover.</li>
      </ul>
      <p>Need a new cylinder too? An unvented 150 litre cylinder is from £1,450, fitted. See our <a href="/hot-water-cylinders-formby">hot water cylinders</a> page for sizes and prices.</p>
    </div>
  </section>

  <section class="brx-sec" id="cost">
    <div class="brx-wrap">
      <h2>What can change the price?</h2>
      <p class="brx-answer">The package prices cover a like-for-like combi swap. These extras are priced openly, so you know before the survey.</p>
      <div class="brx-table-wrap">
        <table class="brx-table">
          <thead><tr><th>Extra</th><th>Price</th></tr></thead>
          <tbody>{extras.map(([h, p]) => <tr><td>{h}</td><td><strong>{p}</strong></td></tr>)}</tbody>
        </table>
      </div>
      <p>System and regular boilers are priced at the free survey, because the cylinder and pipework vary from house to house. All prices include VAT. Your written price covers everything, so there are no surprises on the day.</p>
      <div class="brx-cta">
        <p><strong>Combi or system?</strong> Ring us. We will ask a few questions, then confirm it at the free survey.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="included">
    <div class="brx-wrap">
      <h2>What is included in the price?</h2>
      <p class="brx-answer">Everything needed for a safe, finished install. There are no hidden extras.</p>
      <ul class="sg-ticks">
        <li><strong>The new boiler</strong>, A-rated and sized for your home.</li>
        <li><strong>A smart thermostat</strong>, fitted and set up. It meets the Boiler Plus rules.</li>
        <li><strong>A carbon monoxide alarm</strong> near the boiler.</li>
        <li><strong>A magnetic filter</strong> to catch sludge before it reaches the boiler.</li>
        <li><strong>A system clean and inhibitor.</strong> Boiler makers ask for this to keep the warranty valid.</li>
        <li><strong>The flue, valves and fittings.</strong></li>
        <li><strong>Old boiler removed</strong> and taken away. No skip needed.</li>
        <li><strong>Commissioning.</strong> Gas and safety checks, radiators balanced, and we show you the controls.</li>
        <li><strong>Paperwork.</strong> Benchmark checklist, warranty registered for you, and the install notified to Gas Safe Register.</li>
      </ul>
      <figure class="sg-photo" style="max-width:360px;margin-top:1.25rem;">
        <picture>
          <source type="image/webp" srcset="/images/jobs/boiler-smart-thermostat-fitted-480.webp 480w, /images/jobs/boiler-smart-thermostat-fitted-960.webp 960w" sizes="(max-width: 800px) 100vw, 360px" />
          <img src="/images/jobs/boiler-smart-thermostat-fitted-960.jpg" alt="Boiler and smart thermostat receiver fitted by our team" loading="lazy" decoding="async" width="960" height="1280" />
        </picture>
        <figcaption>A recent job: boiler controls fitted by our team.</figcaption>
      </figure>
    </div>
  </section>

  <section class="brx-sec" id="how">
    <div class="brx-wrap">
      <h2>How does a new boiler install work?</h2>
      <ol class="sg-steps">
        <li><strong>Free survey (about 45 minutes).</strong> An engineer checks your boiler, cylinder, pipes, flue route and water pressure. We ask how many bathrooms you use at once. You get a written fixed price.</li>
        <li><strong>You choose a date.</strong> We book the install for a day that suits you. Boiler broken? Tell us and we give you our earliest slot.</li>
        <li><strong>Clean the system.</strong> The heating is cleaned so old sludge does not harm the new boiler.</li>
        <li><strong>Fit and commission.</strong> The old boiler comes out. The new boiler, and cylinder if needed, go in. We test it and balance the radiators. A combi swap is usually one day.</li>
        <li><strong>Handover.</strong> We show you the controls, fill in the Benchmark checklist and register the warranty.</li>
      </ol>
      <p style="margin-top:1rem;">Signs it is time to replace: the boiler is over 10 to 15 years old, repairs keep adding up, or hot water is weak upstairs. Not sure? A <a href="/boiler-service-formby">boiler service</a> or repair visit will tell you. Repairs are from £120 for the first hour, with no call-out fee.</p>
      <div class="brx-cta">
        <p><strong>Book your free survey.</strong> Ring us or book online and we will arrange a time.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>
</ServiceGuide>
