---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/tap-replacement-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'one-tap', tier: 'Fit only', popular: true, name: 'One tap replaced', price: '£110', unit: 'you supply the tap, inc VAT',
    points: ['Kitchen mixer, basin mixer or a pair of bath taps', 'Old tap taken out and taken away', 'Checked for leaks and left clean'] },
  { id: 'two-taps', tier: 'Same visit', name: 'Second tap swapped', price: '£50', unit: 'extra, same visit, inc VAT',
    points: ['Two taps for £160 in total', 'Kitchen and bathroom in one go', 'One visit, one fixed price'] },
  { id: 'we-supply', tier: 'Supply and fit', name: 'We supply the tap', price: '£110', unit: 'fitting, plus the tap at cost',
    points: ['We source a tap that suits your sink and pressure', 'You pay what we pay for it, no mark-up', 'Price agreed before we order'] },
  { id: 'repair', tier: 'Dripping or leaking tap', name: 'Tap repair', price: '£120', unit: 'first hour, weekdays 9am–4pm, inc VAT',
    points: ['No call-out fee', 'Most drips fixed in the first hour', 'Parts priced before we fit them'] },
];

const faqs = [
  { q: 'How much does tap replacement cost in Liverpool?', a: 'With us it is £110 including VAT to fit one tap you have bought. A pair of bath taps counts as one tap. A second tap on the same visit is £50 more. If we supply the tap, you pay what it costs us, plus the £110 fitting.' },
  { q: 'Do you charge a call-out fee?', a: 'No. Tap fitting is a fixed price. Tap repairs are charged by time, from £120 for the first hour on weekdays 9am to 4pm, with no call-out fee.' },
  { q: 'How long does it take to change a tap?', a: 'A kitchen or basin mixer usually takes about an hour. Bath taps can take longer if the bath panel has to come off.' },
  { q: 'Can you fit a tap I bought online?', a: 'Yes. Check it suits your water pressure and your sink before you order. Send us the link and we will check it for you.' },
  { q: 'Can you replace a tap without replacing the sink?', a: 'Yes, in almost every case. A new mixer fits the same hole as the old one. If you are moving from two pillar taps to one mixer, the sink needs a single tap hole, or a blanking plate for the spare hole.' },
  { q: 'Do I need isolation valves?', a: 'They are a good idea. An isolation valve lets you turn the water off to one tap without turning off the whole house. If yours has none, we can fit them on the same visit. We tell you the price first.' },
  { q: 'Will a new tap work with my water pressure?', a: 'Most modern taps need a mains or combi system. If your hot water comes from a tank in the loft, the pressure is low, and you need a tap marked for low pressure. We check this before you buy.' },
  { q: 'Why is my tap dripping?', a: 'In an older tap with a rubber washer, the washer is worn. In a mixer or quarter-turn tap, the ceramic cartridge is usually worn. Water around the base of the spout often means a worn O-ring. All three can usually be fixed.' },
  { q: 'Should I repair or replace a dripping tap?', a: 'If the tap is in good shape and parts are easy to get, a repair is cheaper. If it is old, loose, corroded, or the parts are hard to find, a new tap is often better value. We will tell you honestly which makes sense.' },
  { q: 'Can a dripping tap wait?', a: 'A slow drip is not an emergency, but it wastes water and can stain the sink. If water is leaking under the sink or into a cupboard, turn it off at the isolation valve or stopcock and call us.' },
  { q: 'Do you fit boiling water taps?', a: 'Yes. A boiling water tap has a tank under the sink and needs a power socket. We price it before we start. If you need a new socket, our partner firm Ideal Electrical Solutions can fit one.' },
  { q: 'Do you take the old tap away?', a: 'Yes. We take the old tap and packaging away and leave the sink clean. It is included in the price.' },
  { q: 'Can you do other small jobs on the same visit?', a: 'Yes. Many customers add a second tap, a toilet fix or a new outside tap. Make a list and we will tell you the full price before we start.' },
  { q: 'Is the work guaranteed?', a: 'Yes. Our workmanship is guaranteed for 12 months, and we carry £2 million public liability insurance. The tap itself is covered by its maker.' },
];
---

