---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/boiler-service-wirral';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

// Scope: gas boilers only. We do NOT service gas fires (we can disconnect and cap) or back boilers (we remove them and fit a combi).
// We do NOT sell a monthly boiler service plan or boiler cover. Pay per service, free yearly reminder.
const packages = [
  { id: 'service', tier: 'Homeowners', name: 'Annual boiler service', price: '£95', unit: 'fixed price, inc VAT',
    points: ['Combi, system and regular gas boilers', 'Same price in every CH postcode', 'Service record emailed the same day', 'Free reminder next year'] },
  { id: 'combined', tier: 'Best value', popular: true, name: 'Boiler service + gas safety certificate (CP12)', price: '£195', unit: 'one visit, inc VAT',
    points: ['Save £20 on booking them apart', 'Ideal for Wirral landlords', 'Boiler, gas cooker and hob checked', 'Both records emailed the same day'] },
  { id: 'cylinder', tier: 'Unvented hot water', name: 'Unvented cylinder service', price: '£120', unit: 'fixed price, inc VAT',
    points: ['For mains pressure cylinders', 'Safety valves and expansion vessel checked', 'All our engineers are G3 qualified', 'Keeps the cylinder warranty valid'] },
];

const faqs = [
  { q: 'How much does a boiler service cost on the Wirral?', a: 'With us it is £95 including VAT, fixed price, with no call-out fee. A boiler service and gas safety certificate together are £195. An unvented cylinder service is £120.' },
  { q: 'Do you cover all Wirral CH postcodes?', a: 'Yes. We cover CH41 to CH64, from Birkenhead and Wallasey to Hoylake, West Kirby, Heswall and Neston. The price is the same in every postcode.' },
  { q: 'Do you service system boilers in Heswall and West Kirby?', a: 'Yes. A system boiler service takes a little longer, because we also check the pump, zone valves and cylinder controls. The price is still £95. There is no extra charge for a system boiler.' },
  { q: 'My Birkenhead terrace has an old boiler. Is it worth servicing?', a: 'Usually, yes. Most boilers can be serviced at any age. On older boilers we pay close attention to the heat exchanger and flue seals. If it keeps breaking down, we will tell you honestly if a new boiler makes more sense.' },
  { q: 'Do you provide CP12 certificates for Wirral landlords?', a: 'Yes. A boiler service and CP12 in one visit cost £195. We can arrange access with your tenant or letting agent, and email both records the same day.' },
  { q: 'How long does a boiler service take?', a: 'Most combi services take 45 to 60 minutes. A system boiler takes about 60 to 75 minutes.' },
  { q: 'Does a service keep my boiler warranty valid?', a: 'Yes. Most boiler makers ask for a service every 12 months by a Gas Safe registered engineer. We fill in the Benchmark service record on every visit, which is what the maker will ask to see.' },
  { q: 'Do you service back boilers or gas fires?', a: 'No. We can take an old back boiler out and fit a new combi in its place. We do not service gas fires, but we can disconnect and cap one safely.' },
  { q: 'Do you offer a boiler service plan?', a: 'No. We do not sell a monthly plan or boiler cover. You pay £95 when you have the service. We send a free reminder when the next one is due.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Every boiler service is done by our Gas Safe registered engineers. You can check any engineer on the Gas Safe Register before they start.' },
];
---

