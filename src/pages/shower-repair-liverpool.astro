---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/shower-repair-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const faqs = [
  { q: 'Why is my shower not working?', a: 'Common causes are a blocked shower head, a worn thermostatic cartridge, a failed pump on a power shower, a problem with the boiler hot water, or on an electric shower, a failed heater or tripped circuit. Try the checks on this page first.' },
  { q: 'Why is my shower going hot and cold?', a: 'Usually the thermostatic cartridge in the shower valve is worn or full of limescale. A new cartridge often fixes it. On a combi boiler, low water pressure can also cause it.' },
  { q: 'Why is my shower pressure so low?', a: 'Limescale in the shower head is the most common cause. Soak it in descaler or vinegar. If every tap in the house is weak, the problem is the water supply, not the shower.' },
  { q: 'Why does my electric shower keep cutting out?', a: 'Electric showers have a safety cut-out that stops the water getting too hot. Low flow, limescale or a worn part can trip it. If the shower trips the power at the fuse box, stop using it and get it checked.' },
  { q: 'How much does a shower repair cost?', a: 'Shower repairs are charged by time. The first hour is £120 on weekdays from 9am to 4pm, £150 in the evenings, at night and at weekends, and £180 on bank holidays. There is no call-out fee. Parts are priced before we fit them.' },
  { q: 'Should I repair or replace my shower?', a: 'Many faults can be fixed with a new cartridge, seal or hose. Electric showers often last 5 to 10 years. If yours is over 10 years old and has a fault, a new one is often better value. A new electric shower supplied and fitted is from £375.' },
  { q: 'My shower is leaking through the ceiling. What do I do?', a: 'Stop using the shower. Turn off the water to it if there is an isolation valve. Call us on 0151 558 0334. A leak under a shower can damage the ceiling below quickly.' },
  { q: 'Do you fix electric showers?', a: 'Yes, we fix the plumbing side and swap electric showers on a suitable circuit. If the shower needs a new or upgraded electric circuit, our partner firm Ideal Electrical Solutions does that part.' },
  { q: 'Do you fix power showers and pumps?', a: 'Yes. A noisy pump, or one that will not start, often needs a new pump or a repair. We tell you the price first.' },
];
---

<ServiceGuide
  url={URL_}
  title="Shower Repair Liverpool | Shower Not Working? From £120"
  description="Shower not working, going hot and cold, low pressure or leaking? Quick checks to try first, then shower repair across Liverpool. First hour £120, no call-out fee. Call 0151 558 0334."
  h1="Shower Repair in Liverpool"
  badge="Shower not working? · no call-out fee"
  intro="Shower not working, going hot and cold, or just a trickle? Try the quick checks below first. If it is still not right, we fix all types of shower: mixer, electric and power showers. First hour from £120, with no call-out fee."
  stats={[['£120', 'First hour, weekdays'], ['£0', 'Call-out fee']]}
  ticks={['All Shower Types', 'No Call-Out Fee', 'Gas Safe Registered', '5.0 on Google']}
  secondaryCta={{ href: '#checks', label: 'Try the quick checks' }}
  factsTitle="Shower repair at a glance"
  facts={[
    ['Quick checks', 'Clean the shower head, check other hot taps, check the isolation switch or valve.'],
    ['Price', 'First hour £120 weekdays 9am to 4pm, £150 out of hours. No call-out fee.'],
    ['We fix', 'Mixer showers, electric showers, power showers and pumps.'],
    ['New shower', 'Electric shower supplied and fitted from £375.'],
    ['Electrics', 'New circuits by our partner firm, Ideal Electrical Solutions.'],
  ]}
  toc={[
    ['checks', 'What should I check first?'],
    ['faults', 'What is wrong with my shower?'],
