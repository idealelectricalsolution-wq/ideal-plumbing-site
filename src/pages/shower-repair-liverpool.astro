    ['cost', 'How much does it cost?'],
    ['replace', 'Repair or replace?'],
  ]}
  reviews={['Meghann S', 'David H', 'Peter H', 'Mark L']}
  reviewTitle="What do customers say?"
  faqs={faqs}
  areasTitle="Where do you repair showers?"
  areasText="All of Liverpool, L1 to L40, plus Kirkby, Huyton, Bootle, Crosby, Maghull, the Wirral, St Helens, Formby and Southport."
  areas={[
    { href: '/emergency-plumber-allerton', label: 'Allerton' },
    { href: '/emergency-plumber-woolton', label: 'Woolton' },
    { href: '/emergency-plumber-childwall', label: 'Childwall' },
    { href: '/emergency-plumber-west-derby', label: 'West Derby' },
    { href: '/emergency-plumber-aintree', label: 'Aintree' },
    { href: '/emergency-plumber-crosby', label: 'Crosby' },
    { href: '/emergency-plumber-kirkby', label: 'Kirkby' },
    { href: '/emergency-plumber-huyton', label: 'Huyton' },
  ]}
  related={[
    { href: '/showers-liverpool', title: 'New showers fitted', text: 'Electric showers from £375 supplied and fitted' },
    { href: '/no-heating-no-hot-water-liverpool', title: 'No hot water', text: '5 checks to try before you call' },
    { href: '/leak-detection-liverpool', title: 'Leak detection', text: 'Water coming through the ceiling?' },
    { href: '/bathroom-fitters-liverpool', title: 'Bathrooms', text: 'Full bathrooms from £4,995' },
  ]}
  finalTitle="Shower still not working?"
  finalText="Call us and tell us what it is doing. We will tell you the price before we start. No call-out fee."
