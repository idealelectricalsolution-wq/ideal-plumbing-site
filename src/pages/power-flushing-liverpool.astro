      <script>
      (function(){
        'use strict';
        var state = { symptoms: [], age: null, property: null, urgency: null };
        var widget = document.getElementById('powerflush-widget');
        if (!widget) return;

        var checkboxes = widget.querySelectorAll('.pfw-checkbox');
        var nextBtn1 = document.getElementById('pfw-next-1');
        checkboxes.forEach(function(cb){
          cb.addEventListener('click', function(e){
            e.preventDefault();
            cb.classList.toggle('checked');
            var symptom = cb.getAttribute('data-symptom');
            if (cb.classList.contains('checked')) {
              if (state.symptoms.indexOf(symptom) === -1) state.symptoms.push(symptom);
            } else {
              state.symptoms = state.symptoms.filter(function(s){ return s !== symptom; });
            }
            nextBtn1.disabled = state.symptoms.length === 0;
          });
        });
        nextBtn1.addEventListener('click', function(){ goToStep(2); });

        ['age', 'property', 'urgency'].forEach(function(question, idx){
          var stepNum = idx + 2;
          var container = widget.querySelector('[data-question="' + question + '"]');
          var nextBtn = document.getElementById('pfw-next-' + stepNum);
          var options = container.querySelectorAll('.pfw-option');
          options.forEach(function(opt){
            opt.addEventListener('click', function(){
              options.forEach(function(o){ o.classList.remove('selected'); });
              opt.classList.add('selected');
              state[question] = opt.getAttribute('data-value');
              nextBtn.disabled = false;
            });
          });
          nextBtn.addEventListener('click', function(){
            if (stepNum < 4) goToStep(stepNum + 1);
            else showResult();
          });
        });

        widget.querySelectorAll('[data-back]').forEach(function(btn){
          btn.addEventListener('click', function(){
            var fromStep = parseInt(btn.getAttribute('data-back'), 10);
            goToStep(fromStep - 1);
          });
        });

        function goToStep(n){
          widget.querySelectorAll('.pfw-step').forEach(function(s){
            s.classList.toggle('active', parseInt(s.getAttribute('data-step'), 10) === n);
          });
          widget.querySelectorAll('.pfw-dot').forEach(function(d){
            var dn = parseInt(d.getAttribute('data-step'), 10);
            d.classList.remove('active', 'done');
            if (dn < n) d.classList.add('done');
            else if (dn === n) d.classList.add('active');
          });
          if (window.innerWidth < 768) {
            widget.scrollIntoView({behavior: 'smooth', block: 'start'});
          }
        }

        var classicSymptoms = ['cold-bottoms', 'boiler-noise', 'slow-warmup', 'rad-not-heating', 'black-water', 'boiler-cuts-out'];

        function classifyResult(){
          var s = state;
          var classicCount = s.symptoms.filter(function(x){ return classicSymptoms.indexOf(x) !== -1; }).length;
          var hasNewBoiler = s.symptoms.indexOf('new-boiler') !== -1;
          var hasJustChecking = s.symptoms.indexOf('just-checking') !== -1;
          var isSpecialistProperty = s.property === 'microbore' || s.property === 'open-vented';
          var isOldSystem = s.age === 'gt-25';
          var isMidSystem = s.age === '5-15' || s.age === '15-25';
          var isNewSystem = s.age === 'lt-5';

          if (s.urgency === 'research') return 'soft-blue';
          if (hasNewBoiler) return 'amber';
          if (isSpecialistProperty && classicCount > 0) return 'blue';
          if (classicCount >= 3 && (isMidSystem || s.age === 'unsure')) return 'red';
          if (isOldSystem && classicCount > 0) return 'blue';
          if (classicCount >= 1 && (isMidSystem || s.age === 'unsure')) return 'blue';
          if (hasJustChecking && (isNewSystem || isMidSystem) && classicCount === 0) return 'soft-grey';
          if (classicCount >= 2 && isNewSystem) return 'blue';
          return 'soft-grey';
        }

        var RESULTS = {
          'red': {
            tag: 'POWER FLUSH RECOMMENDED',
            title: "Your system shows clear signs a power flush is needed",
            body: "Multiple classic symptoms point to significant sludge contamination. A power flush is very likely the right solution and will resolve cold spots, noisy boilers and slow warm-up in most cases. We can carry out a free assessment first to confirm your system is suitable, then complete the flush in a single day.",
            ctaPrimary: { label: "CALL 0151 558 0334", href: "tel:0151 558 0334" },
            ctaSecondary: { label: "Get a written quote", href: "/get-started" }
          },
          'amber': {
            tag: 'WARRANTY PROTECTION',
            title: "Power flush before your new boiler. Manufacturer warranty depends on it",
            body: "Worcester Bosch, Vaillant, Ideal and Baxi all require a clean system as a warranty condition. Installing a new boiler on a contaminated system can void the warranty and damage the new heat exchanger within months. We can carry out the flush before the new boiler is connected, often as a bundled price.",
            ctaPrimary: { label: "CALL FOR BUNDLE PRICE", href: "tel:0151 558 0334" },
            ctaSecondary: { label: "Get a written quote", href: "/get-started" }
          },
          'blue': {
            tag: 'ASSESSMENT FIRST',
            title: "We would recommend an honest assessment before committing",
            body: "Your system shows some signs of contamination but a power flush may not be the right or safest first step. Older or specialist systems often respond better to a chemical flush, targeted radiator work, or specialist technique. We will inspect your system, give you an honest read on what is needed, and recommend the right approach, even if that is not the most expensive one.",
            ctaPrimary: { label: "BOOK FREE ASSESSMENT", href: "tel:0151 558 0334" },
            ctaSecondary: { label: "Read about alternatives to power flushing", href: "#alternatives" }
          },
          'soft-grey': {
            tag: 'NO FLUSH NEEDED YET',
            title: "Probably no power flush needed at the moment",
            body: "Your system shows no significant signs of contamination right now. Annual servicing with inhibitor checks is more appropriate than a flush at this stage. Industry guidance is to power flush every 5 to 7 years as preventative maintenance, sooner if symptoms develop. Save our number for when you need us.",
            ctaPrimary: { label: "Read our maintenance guide", href: "/blog/power-flushing-central-heating-liverpool" },
            ctaSecondary: { label: "Save our number: 0151 558 0334", href: "tel:0151 558 0334" }
          },
          'soft-blue': {
            tag: 'RESEARCHING',
            title: "Here is what is worth reading next",
            body: "Based on your answers, you are at the research stage. Below are the guides most relevant to what you have told us, written by working Liverpool plumbers, not marketing copy. Save our number for when you are ready and we will be straight with you about whether you need a flush or not.",
            ctaPrimary: { label: "Read: What is a power flush?", href: "/blog/what-is-a-power-flush-liverpool" },
            ctaSecondary: { label: "Read: How to choose a power flush plumber", href: "/blog/how-to-choose-power-flush-plumber-liverpool" }
          }
        };

        function showResult(){
          var key = classifyResult();
          var data = RESULTS[key];
          var card = document.getElementById('pfw-result-card');
          card.className = 'pfw-result r-' + key;
          document.getElementById('pfw-result-tag').textContent = data.tag;
          document.getElementById('pfw-result-title').textContent = data.title;
          document.getElementById('pfw-result-body').textContent = data.body;
          var ctaWrap = document.getElementById('pfw-result-cta');
          ctaWrap.innerHTML = '';
          var p = document.createElement('a');
          p.className = 'pfw-cta-primary';
          p.href = data.ctaPrimary.href;
          p.textContent = data.ctaPrimary.label;
          ctaWrap.appendChild(p);
          var s = document.createElement('a');
          s.className = 'pfw-cta-secondary';
          s.href = data.ctaSecondary.href;
          s.textContent = data.ctaSecondary.label;
          ctaWrap.appendChild(s);
          goToStep(5);
          widget.querySelectorAll('.pfw-dot').forEach(function(d){
            d.classList.remove('active');
            d.classList.add('done');
          });
        }

        document.getElementById('pfw-restart').addEventListener('click', function(){
          state = { symptoms: [], age: null, property: null, urgency: null };
          widget.querySelectorAll('.pfw-checkbox.checked').forEach(function(c){ c.classList.remove('checked'); });
          widget.querySelectorAll('.pfw-option.selected').forEach(function(o){ o.classList.remove('selected'); });
          widget.querySelectorAll('.pfw-btn-primary[id^="pfw-next"]').forEach(function(b){ b.disabled = true; });
          goToStep(1);
        });

      })();
      </script>

    </div>
  </section>
