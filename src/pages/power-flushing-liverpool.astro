    ]
  }
  </script>

  <style>
    /* ========================================================
       Design tokens. Extends the site brand, does not replace it.
       Signature device: sludge-to-clear water gradient.
       ======================================================== */
    .pfx {
      --ink: #0d1f33;        /* deeper than brand navy, for contrast blocks */
      --navy: #1a3a5c;
      --orange: #f97316;
      --sludge: #1c1917;     /* the black water */
      --clear: #7dd3fc;      /* the clean water */
      --paper: #ffffff;
      --mist: #eef2f7;
      --line: #dbe3ec;
      --muted: #5b6b7f;
    }

    /* Vertical rhythm: tighter than default, mobile reads faster */
    .pfx-sec { padding: 2.5rem 0; }
    .pfx-sec--mist { background: var(--mist); }
    .pfx-sec--paper { background: var(--paper); }
    .pfx-sec--ink { background: var(--ink); }
    .pfx-sec--ink h2, .pfx-sec--ink h3, .pfx-sec--ink p { color: #fff; }
    .pfx-sec--ink .pfx-lede { color: rgba(255,255,255,0.72); }

    .pfx-eyebrow {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--orange); margin-bottom: 0.4rem;
    }
    .pfx h2 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 1.85rem; font-weight: 800; line-height: 1.08;
      color: var(--navy); margin: 0 0 0.5rem; letter-spacing: -0.01em;
    }
    .pfx-lede { font-size: 1rem; line-height: 1.6; color: var(--muted); margin: 0 0 1.25rem; }

    /* ---- SIGNATURE: sludge-to-clear bar ---- */
    .pfx-water {
      height: 6px; border-radius: 99px; margin: 0 0 1.5rem;
      background: linear-gradient(90deg, var(--sludge) 0%, #3f3f46 22%, #78716c 42%, #a8a29e 58%, #bae6fd 80%, var(--clear) 100%);
    }
    .pfx-water--sm { height: 4px; margin-bottom: 1rem; }

    /* ---- ANCHOR CHIPS: wayfinding on a long mobile page ---- */
    .pfx-jump { display: flex; gap: 0.45rem; overflow-x: auto; padding: 0 0 0.35rem;
      -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .pfx-jump::-webkit-scrollbar { display: none; }
    .pfx-jump a {
      flex: 0 0 auto; font-size: 0.82rem; font-weight: 700; text-decoration: none;
      color: var(--navy); background: #fff; border: 1px solid var(--line);
      padding: 0.5rem 0.85rem; border-radius: 99px; white-space: nowrap;
      min-height: 38px; display: flex; align-items: center;
    }
    .pfx-jump a:active { background: var(--mist); }

    /* ========================================================
       RADIATOR COUNT SELECTOR  (pure CSS, no JS)
       Replaces four stacked cards. Cuts ~2,400px of scroll.
       ======================================================== */
    .rc { margin-top: 1rem; }
    .rc > input { position: absolute; opacity: 0; pointer-events: none; }

    .rc-tabs {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.4rem;
      background: var(--mist); padding: 0.35rem; border-radius: 14px;
      border: 1px solid var(--line);
    }
    .rc-tabs label {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      min-height: 60px; border-radius: 10px; cursor: pointer; background: transparent;
      transition: background 0.15s ease, box-shadow 0.15s ease;
    }
    .rc-tabs label .n {
      font-family: 'Barlow Condensed', sans-serif; font-size: 1.35rem;
      font-weight: 800; color: var(--navy); line-height: 1;
    }
    .rc-tabs label .u {
      font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--muted); margin-top: 0.15rem;
    }

    .rc-panel { display: none; }
    .rc-out {
      background: var(--paper); border: 1px solid var(--line);
      border-top: none; border-radius: 0 0 16px 16px; padding: 1.25rem;
    }
    .rc-head {
      background: var(--navy); border-radius: 16px 16px 0 0;
      padding: 1.15rem 1.25rem 1rem; margin-top: 0.75rem;
    }
    .rc-fits { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: rgba(255,255,255,0.62); line-height: 1.35;
      margin-bottom: 0.15rem; }
    .rc-price {
      font-family: 'Barlow Condensed', sans-serif; font-size: 3.4rem;
      font-weight: 900; color: #fff; line-height: 0.95; margin: 0.15rem 0 0;
    }
    .rc-price sup { font-size: 1.3rem; vertical-align: baseline; position: relative; top: -1.35rem; font-weight: 800; margin-right: 0.05rem; }
    .rc-price small { font-size: 0.9rem; font-weight: 700; color: rgba(255,255,255,0.65); }
    .rc-meta { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.65rem; }
    .rc-chip {
      font-size: 0.72rem; font-weight: 700; color: #fff;
      background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.2);
      padding: 0.28rem 0.6rem; border-radius: 99px;
    }

    .rc-inc { list-style: none; padding: 0; margin: 0 0 1rem; }
    .rc-inc li {
      font-size: 0.9rem; color: #27364a; line-height: 1.45;
      padding: 0.42rem 0 0.42rem 1.55rem; position: relative;
      border-bottom: 1px solid #f1f5f9;
    }
    .rc-inc li:last-child { border-bottom: none; }
    .rc-inc li::before {
      content: ""; position: absolute; left: 2px; top: 0.78rem;
      width: 10px; height: 5px; border-left: 2px solid #16a34a;
      border-bottom: 2px solid #16a34a; transform: rotate(-45deg);
    }

    /* checked states */
    .rc #r1:checked ~ .rc-tabs label[for="r1"],
    .rc #r2:checked ~ .rc-tabs label[for="r2"],
    .rc #r3:checked ~ .rc-tabs label[for="r3"],
    .rc #r4:checked ~ .rc-tabs label[for="r4"] {
      background: var(--paper); box-shadow: 0 1px 3px rgba(13,31,51,0.12);
    }
    .rc #r1:checked ~ .rc-tabs label[for="r1"] .n,
    .rc #r2:checked ~ .rc-tabs label[for="r2"] .n,
    .rc #r3:checked ~ .rc-tabs label[for="r3"] .n,
    .rc #r4:checked ~ .rc-tabs label[for="r4"] .n { color: var(--orange); }
    .rc #r1:checked ~ .rc-body .rc-panel[data-r="1"],
    .rc #r2:checked ~ .rc-body .rc-panel[data-r="2"],
    .rc #r3:checked ~ .rc-body .rc-panel[data-r="3"],
    .rc #r4:checked ~ .rc-body .rc-panel[data-r="4"] { display: block; }

    /* keyboard focus must stay visible */
    .rc > input:focus-visible ~ .rc-tabs label { outline: 2px solid var(--orange); outline-offset: 2px; }

    .rc-cta {
      display: flex; align-items: center; justify-content: center;
      width: 100%; box-sizing: border-box; min-height: 52px;
      background: var(--orange); color: #fff; text-decoration: none;
      font-weight: 800; font-size: 1.05rem; border-radius: 10px;
      box-shadow: 0 4px 14px rgba(249,115,22,0.32);
    }
    .rc-foot { font-size: 0.82rem; color: var(--muted); text-align: center; margin: 0.7rem 0 0; }

    /* ---- NOTE / ALERT blocks ---- */
    .pfx-note {
      background: var(--paper); border: 1px solid var(--line);
      border-left: 3px solid var(--orange);
      border-radius: 0 12px 12px 0; padding: 1rem 1.15rem; margin-top: 1.25rem;
    }
    .pfx-note strong { display: block; color: var(--navy); margin-bottom: 0.35rem; font-size: 1rem; }
    .pfx-note p { margin: 0 0 0.6rem; font-size: 0.92rem; line-height: 1.6; color: #33475f; }
    .pfx-note p:last-child { margin-bottom: 0; }
    .pfx-sec--ink .pfx-note {
      background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.14);
      border-left-color: var(--orange);
    }
    .pfx-sec--ink .pfx-note strong { color: #fff; }
    .pfx-sec--ink .pfx-note p { color: rgba(255,255,255,0.78); }

    /* ---- COMPARISON TABLE: stacks under 560px ---- */
    .ct { width: 100%; border-collapse: collapse; font-size: 0.9rem; background: var(--paper);
      border: 1px solid var(--line); border-radius: 12px; overflow: hidden; margin-top: 1.25rem; }
    .ct th, .ct td { padding: 0.7rem 0.85rem; text-align: left;
      border-bottom: 1px solid #eef2f7; vertical-align: top; }
    .ct thead th { background: var(--navy); color: #fff;
      font-family: 'Barlow Condensed', sans-serif; font-size: 0.95rem;
      font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; }
    .ct tbody th { font-weight: 800; color: var(--navy); width: 32%; }
    .ct tr:last-child th, .ct tr:last-child td { border-bottom: none; }
    .ct-win { color: #15803d; font-weight: 800; }

    @media (max-width: 560px) {
      .ct, .ct tbody, .ct tr, .ct td, .ct th { display: block; width: auto; }
      .ct thead { position: absolute; left: -9999px; }
      .ct tbody tr { border-bottom: 1px solid var(--line); padding: 0.45rem 0; }
      .ct tbody tr:last-child { border-bottom: none; }
      .ct tbody th { width: auto; background: #f6f9fc; border-bottom: none;
        padding-bottom: 0.3rem; font-size: 0.95rem; }
      .ct tbody td { border-bottom: none; padding: 0.15rem 0.85rem; }
      .ct tbody td::before { content: attr(data-label); display: block;
        font-size: 0.68rem; font-weight: 800; text-transform: uppercase;
        letter-spacing: 0.06em; color: var(--muted); margin-bottom: 0.05rem; }
    }

    /* ---- VERDICT ROWS: replaces generic yes/no grid ---- */
    .vd { margin-top: 1.25rem; }
    .vd-row { display: flex; gap: 0.8rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
    .vd-row:last-child { border-bottom: none; }
    .vd-mark { flex: 0 0 26px; height: 26px; border-radius: 8px; display: flex;
      align-items: center; justify-content: center; font-weight: 900; font-size: 0.9rem; }
    .vd-no  { background: #fee2e2; color: #b91c1c; }
    .vd-yes { background: #dcfce7; color: #15803d; }
    .vd-row strong { display: block; color: var(--navy); font-size: 0.98rem; margin-bottom: 0.15rem; }
    .vd-row p { margin: 0; font-size: 0.9rem; line-height: 1.55; color: #4b5c72; }

    /* ---- PROCESS: numbered because it IS a sequence ---- */
    .pr { margin-top: 1.25rem; counter-reset: pr; }
    .pr-step { display: flex; gap: 0.9rem; padding-bottom: 1.1rem; position: relative; }
    .pr-step:not(:last-child)::after {
      content: ""; position: absolute; left: 15px; top: 34px; bottom: 0;
      width: 2px; background: var(--line);
    }
    .pr-num {
      flex: 0 0 32px; height: 32px; border-radius: 50%; background: var(--navy);
