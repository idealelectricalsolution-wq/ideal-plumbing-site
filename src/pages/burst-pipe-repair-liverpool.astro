---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/burst-pipe-repair-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const faqs = [
  { q: 'What should I do first if a pipe bursts?', a: 'Turn off the water at the stopcock, usually under the kitchen sink. Turn it clockwise. Then switch off the boiler, open the cold taps to drain the pipes, keep away from wet electrics, and call us on 0151 558 0334.' },
  { q: 'Where is my stopcock?', a: 'In most Liverpool homes it is under the kitchen sink. In older terraces it can be in the cellar, under the stairs or near the front door. There is often another one outside, under a small cover in the path near your boundary.' },
  { q: 'What if my stopcock will not turn?', a: 'Do not force it with tools, as old stopcocks can snap. Call us straight away. You can also call United Utilities on 0345 672 3723 and ask about turning off the supply outside.' },
  { q: 'How much does a burst pipe repair cost?', a: 'We charge by time, with no call-out fee. The first hour is £120 on weekdays from 9am to 4pm, £150 in the evenings, at night and at weekends, and £180 on bank holidays. Many burst pipes are repaired within the first hour. Parts are priced before we fit them.' },
  { q: 'How fast can you get here?', a: 'We guarantee a 30 minute response across Liverpool, 24/7. Our average arrival is 28 minutes. A real person answers the phone.' },
  { q: 'Will my insurance pay for a burst pipe?', a: 'Most home insurance covers water damage from a burst pipe. The repair itself may or may not be covered, so check your policy. Take photos before you clean up. We give you an itemised invoice for your claim.' },
  { q: 'What if water has reached the electrics?', a: 'Do not touch anything wet. If you can reach the fuse box safely from a dry spot, switch off the power. If not, leave it. Get an electrician to check before you switch back on. Our partner firm, Ideal Electrical Solutions, can help.' },
  { q: 'Why do pipes burst?', a: 'Most bursts in Liverpool happen in cold snaps, when water freezes in a pipe and splits it. Others come from old or corroded pipes, failed joints, worn flexible tap hoses, or a nail or screw through a pipe.' },
  { q: 'How do I stop my pipes freezing?', a: 'Lag pipes in lofts, garages and outside walls. Keep the heating on low, around 12 degrees, if you go away in winter. Fix dripping taps and know where your stopcock is.' },
  { q: 'Do you fix the ceiling too?', a: 'We fix the pipe and make it safe. We can advise on drying out. Plastering and decorating is a job for a plasterer, and your insurer may arrange it.' },
];
---

<ServiceGuide
  url={URL_}
  title="Burst Pipe Repair Liverpool | 24/7, 30 Min Response, From £120"
  description="Burst pipe in Liverpool? Turn off your stopcock, then call 0151 558 0334. 24/7 burst pipe repair, guaranteed 30 minute response, first hour from £120, no call-out fee."
  h1="Burst Pipe Repair in Liverpool"
  badge="24/7 · 30 minute response"
  intro="Burst pipe? Turn off the water at the stopcock first. It is usually under the kitchen sink, and turns clockwise. Then call us. We come out 24/7, with a guaranteed 30 minute response across Liverpool and no call-out fee."
  stats={[['30 min', 'Guaranteed response'], ['£0', 'Call-out fee']]}
  ticks={['24/7', 'No Call-Out Fee', 'Gas Safe Registered', '5.0 on Google']}
  secondaryCta={{ href: '#now', label: 'What to do right now' }}
  factsTitle="Burst pipe at a glance"
  facts={[
    ['Do this now', 'Turn off the stopcock, usually under the kitchen sink. Clockwise to close.'],
    ['Then', 'Boiler off, cold taps on, keep away from wet electrics.'],
    ['Response', 'Guaranteed within 30 minutes across Liverpool, 24/7.'],
    ['Price', 'First hour £120 weekdays 9am to 4pm, £150 out of hours. No call-out fee.'],
    ['Insurance', 'Itemised invoice for your claim.'],
  ]}
  toc={[
    ['now', 'What do I do right now?'],
    ['stopcock', 'Where is my stopcock?'],
    ['repair', 'How do you fix it?'],
    ['cost', 'How much does it cost?'],
    ['insurance', 'What about insurance?'],
    ['prevent', 'How do I stop it happening again?'],
  ]}
  reviews={['James Alexander', 'Tonia K', 'Frank B', 'Chris C']}
  reviewTitle="What do customers say about our burst pipe call-outs?"
  faqs={faqs}
  areasTitle="Where do you fix burst pipes?"
  areasText="All of Liverpool, L1 to L40, plus Kirkby, Huyton, Bootle, Crosby, Maghull, the Wirral, St Helens, Formby and Southport."
  areas={[
    { href: '/emergency-plumber-city-centre', label: 'City Centre' },
    { href: '/emergency-plumber-anfield', label: 'Anfield' },
    { href: '/emergency-plumber-walton', label: 'Walton' },
    { href: '/emergency-plumber-everton', label: 'Everton' },
    { href: '/emergency-plumber-toxteth', label: 'Toxteth' },
    { href: '/emergency-plumber-wavertree', label: 'Wavertree' },
    { href: '/emergency-plumber-kirkby', label: 'Kirkby' },
    { href: '/emergency-plumber-bootle', label: 'Bootle' },
  ]}
  related={[
    { href: '/', title: 'Emergency plumber Liverpool', text: '24/7, guaranteed 30 minute response' },
    { href: '/leak-detection-liverpool', title: 'Leak detection', text: 'Hidden leaks found and fixed' },
    { href: '/blog/frozen-pipes-liverpool-winter-guide', title: 'Frozen pipes guide', text: 'Stop your pipes freezing this winter' },
    { href: '/frozen-condensate-pipe-liverpool', title: 'Frozen condensate pipe', text: 'Boiler stopped in the cold?' },
  ]}
  finalTitle="Water still coming through?"
  finalText="Turn off the stopcock and call us now. A real person answers 24/7, and there is no call-out fee."
  serviceName="Burst Pipe Repair Liverpool"
  serviceType="Emergency plumbing"
  serviceDesc="24/7 burst pipe repair across Liverpool and Merseyside with a guaranteed 30 minute response in Liverpool. First hour from £120, no call-out fee."
  noPackagesOffers={[
    { name: 'Burst pipe repair, first hour, weekdays 9am to 4pm', price: '120' },
    { name: 'Burst pipe repair, first hour, evenings, nights and weekends', price: '150' },
    { name: 'Burst pipe repair, first hour, bank holidays', price: '180' },
  ]}
>
  <section class="brx-sec brx-tint" id="now">
    <div class="brx-wrap">
      <h2>What do I do right now?</h2>
      <p class="brx-answer">Turn off the water, switch off the boiler, drain the pipes and call us. It takes about 2 minutes.</p>
      <ol class="sg-steps">
        <li><strong>Turn off the stopcock.</strong> It is usually under the kitchen sink. Turn it clockwise until it stops.</li>
        <li><strong>Switch off the boiler and immersion heater.</strong> This stops them running without water.</li>
        <li><strong>Turn on the cold taps.</strong> This drains the water left in the pipes down the sink, not out of the burst.</li>
        <li><strong>Keep away from wet electrics.</strong> If water is near sockets or lights, switch off at the fuse box only if you can reach it from a dry spot.</li>
        <li><strong>Catch the water.</strong> Buckets and towels under the leak. Move valuables out of the way.</li>
        <li><strong>Take photos.</strong> Photos and video of the damage help your insurance claim.</li>
        <li><strong>Call us.</strong> Ring {PHONE}. We can talk you through it while you wait.</li>
      </ol>
      <div class="brx-cta">
        <p><strong>Water still coming through?</strong> We guarantee a 30 minute response across Liverpool.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
      <div class="brx-note"><p><strong>Smell gas?</strong> Stop. Leave the house and call the National Gas Emergency line on 0800 111 999 first.</p></div>
    </div>
  </section>

  <section class="brx-sec" id="stopcock">
    <div class="brx-wrap">
      <h2>Where is my stopcock?</h2>
      <p class="brx-answer">In most Liverpool homes, it is under the kitchen sink.</p>
      <ul class="sg-ticks">
        <li><strong>Under the kitchen sink.</strong> The most common place</li>
        <li><strong>In the cellar</strong>, in many Victorian and Edwardian terraces</li>
        <li><strong>Under the stairs</strong> or in a cupboard by the front door</li>
        <li><strong>In a flat</strong>, sometimes in the airing cupboard or a hallway cupboard</li>
        <li><strong>Outside</strong>, under a small metal cover in the path near your boundary</li>
      </ul>
      <p>If the stopcock is stuck, do not force it with tools. Old stopcocks can snap. Call us, or call United Utilities on 0345 672 3723 about turning off the supply outside.</p>
      <p>Find your stopcock now, before you need it. Give it a quarter turn to check it moves.</p>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="repair">
    <div class="brx-wrap">
      <h2>How do you fix a burst pipe?</h2>
      <p class="brx-answer">We find the burst, cut out the damaged section, fit new pipe and test it. Many repairs are done in the first hour.</p>
      <ol class="sg-steps">
        <li><strong>Make it safe.</strong> Water off, and the electrics checked for water near them.</li>
        <li><strong>Find the burst.</strong> Some are easy to see. Others are hidden in a ceiling, wall or floor. If we cannot see it, we use our <a href="/leak-detection-liverpool">leak detection</a> methods.</li>
        <li><strong>Repair it.</strong> We cut out the split section and fit new pipe and fittings.</li>
        <li><strong>Test it.</strong> Water back on, every joint checked, and the heating and hot water tested.</li>
        <li><strong>Paperwork.</strong> An itemised invoice for your insurer.</li>
      </ol>
    </div>
  </section>

  <section class="brx-sec" id="cost">
    <div class="brx-wrap">
      <h2>How much does a burst pipe repair cost?</h2>
      <p class="brx-answer">The first hour is £120 on weekdays, 9am to 4pm. There is no call-out fee. Many burst pipes are fixed inside the first hour.</p>
      <div class="brx-table-wrap">
        <table class="brx-table">
          <thead><tr><th>When</th><th>First hour, inc VAT</th></tr></thead>
          <tbody>
            <tr><td><strong>Weekdays, 9am to 4pm</strong></td><td>£120</td></tr>
            <tr><td><strong>Evenings, nights and weekends</strong></td><td>£150</td></tr>
            <tr><td><strong>Bank holidays</strong></td><td>£180</td></tr>
          </tbody>
        </table>
      </div>
      <p>If the job needs more time or parts, we tell you the price before we carry on. See our full <a href="/plumber-prices-liverpool">price list</a>.</p>
    </div>
  </section>

  <section class="brx-sec brx-tint" id="insurance">
    <div class="brx-wrap">
      <h2>Will my insurance cover it?</h2>
      <p class="brx-answer">Most home insurance covers water damage from a burst pipe. Check your policy for the repair itself.</p>
      <ul class="sg-ticks">
        <li>Take photos and video before you clean up</li>
        <li>Call your insurer once the water is under control</li>
        <li>Keep receipts for anything you buy to dry out the room</li>
        <li>We give you an itemised invoice for your claim</li>
      </ul>
      <p>Tenants should tell their landlord or letting agent straight away. Landlords: we can send the invoice to you or your agent.</p>
    </div>
  </section>

  <section class="brx-sec" id="prevent">
    <div class="brx-wrap">
      <h2>How do I stop pipes bursting again?</h2>
      <p class="brx-answer">Most bursts happen when pipes freeze. Keep them warm and know where your stopcock is.</p>
      <ul class="sg-ticks">
        <li>Lag pipes in the loft, garage and on outside walls</li>
        <li>Keep the heating on low, around 12 degrees, if you go away in winter</li>
        <li>Turn off and drain outside taps before winter</li>
        <li>Fix dripping taps, which can freeze and block a pipe</li>
        <li>Check the stopcock turns, once a year</li>
      </ul>
      <p>Read our <a href="/blog/frozen-pipes-liverpool-winter-guide">frozen pipes winter guide</a> for more.</p>
    </div>
  </section>
</ServiceGuide>
