---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/outside-tap-installation-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'fitted', tier: 'New outside tap', popular: true, name: 'Outside tap supplied and fitted', price: '£145', unit: 'fixed price, inc VAT',
    points: ['Standard cold garden tap with hose fitting', 'Double check valve to protect your drinking water', 'Isolation valve inside, so you can drain it in winter', 'Up to about 2m of pipe from the kitchen supply', 'Frost advice before we leave'] },
  { id: 'repair', tier: 'Leaking or frozen tap', name: 'Outside tap repair', price: '£120', unit: 'first hour, weekdays 9am–4pm, inc VAT',
    points: ['No call-out fee', 'Most leaks and stiff taps fixed in the first hour', 'Parts priced before we fit them', 'Extra time priced before we carry on'] },
  { id: 'urgent', tier: 'Burst or won\'t turn off', name: 'Evening and weekend repair', price: '£150', unit: 'first hour, evenings, nights and weekends, inc VAT',
    points: ['For a burst pipe or a tap that will not stop', '£180 first hour on bank holidays', 'No call-out fee', 'Typically with you within 30 minutes'] },
];

const faqs = [
  { q: 'How much does it cost to fit an outside tap in Liverpool?', a: 'With us it is £145 including VAT. That covers the tap, a double check valve, an isolation valve inside and up to about 2m of pipe from your kitchen supply. Longer runs are priced before we start.' },
  { q: 'How long does it take to fit an outside tap?', a: 'Most standard outside taps take about 1 to 2 hours. A longer pipe run, or a tap on a different wall, can take longer. We tell you before we start.' },
  { q: 'Do I need a double check valve on an outside tap?', a: 'Yes. The water rules say a garden tap needs protection against backflow, so dirty water from a hose cannot get back into your drinking water. A double check valve does this. Every tap we fit has one.' },
  { q: 'Do I need planning permission for an outside tap?', a: 'For most homes, no. It is a small fitting on the wall. If you live in a listed building, check with the council first.' },
  { q: 'Can you fit an outside tap if my kitchen is at the front?', a: 'Often, yes. We find the nearest cold supply to where you want the tap. If the pipe has to go further than about 2m, or through more than one wall, we give you a fixed price first.' },
  { q: 'Can I have a hot and cold outside tap?', a: 'Yes. A hot and cold outside tap is useful for washing cars, dogs and bins. It needs a hot supply as well as a cold one, so we price it before we start.' },
  { q: 'Will an outside tap work with a pressure washer?', a: 'Yes. Our taps run off your mains cold supply and take a standard hose connector. Most pressure washers plug straight into the hose.' },
  { q: 'My outside tap is leaking. Can you fix it?', a: 'Yes. A drip from the spout is often a worn washer. A leak behind the wall can be a split pipe or a failed joint. Repairs are £120 for the first hour on weekdays, with no call-out fee.' },
  { q: 'My outside tap is frozen. What should I do?', a: 'Turn off the isolation valve inside. Open the outside tap and leave it open. Warm the pipe gently with a cloth soaked in warm water. Never use a flame or boiling water. If it has split, call us.' },
  { q: 'How do I stop my outside tap freezing?', a: 'Before the first frost, turn off the valve inside and open the outside tap to drain it. Then close the tap and fit a frost cover. Turn the valve back on in spring.' },
  { q: 'Can you move or remove an old outside tap?', a: 'Yes. We can move a tap to a better spot, or remove an old one and cap the pipe safely inside. We price it before we start.' },
  { q: 'My outside tap will not turn off. Is that an emergency?', a: 'It can waste a lot of water. Turn off the isolation valve inside, or your stop tap if there is no valve. Then call us on 0151 558 0334. We work 24/7.' },
  { q: 'Is your work guaranteed?', a: 'Yes. Every outside tap we fit comes with a 12-month workmanship guarantee. We also carry £2 million public liability insurance.' },
];
---

