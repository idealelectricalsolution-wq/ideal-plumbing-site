const packages = [
  { id: 'vented', tier: 'Loft tank systems', name: 'Vented cylinder replaced', price: '£750', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Like-for-like swap on a loft tank system', 'Immersion heater fitted', 'Old cylinder taken away', 'Usually done in one day'] },
  { id: 'unvented-150', tier: 'Mains pressure', popular: true, name: 'Unvented cylinder, 150 litres', price: '£1,450', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Suits 1 to 2 people, one bathroom', 'Fitted by a G3 qualified engineer', 'All safety valves fitted and tested', 'Notified as Building Regulations require'] },
  { id: 'unvented-210', tier: 'Family homes', name: 'Unvented cylinder, 210 litres', price: '£1,695', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Suits 3 to 4 people', 'One bathroom, or a bath and en-suite shower', 'Expansion vessel and discharge pipe', 'Old cylinder taken away'] },
  { id: 'unvented-250', tier: 'Bigger homes', name: 'Unvented cylinder, 250 to 300 litres', price: '£1,995', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Suits 4 or more people', 'Two bathrooms used at once', 'Mains pressure at every tap', 'Free survey to confirm the size'] },
];

const faqs = [
  { q: 'How much does a hot water cylinder cost in St Helens?', a: 'A vented cylinder replaced starts from £750 including VAT. An unvented cylinder starts from £1,450 for 150 litres, £1,695 for 210 litres and £1,995 for 250 to 300 litres. Changing from vented to unvented starts from £1,895. You get a fixed written price after a free survey.' },
  { q: 'Do you cover all St Helens WA postcodes?', a: 'Yes. We cover WA9 to WA12, including St Helens town centre, Eccleston, Thatto Heath, Sutton, Haydock, Rainford, Billinge and Newton-le-Willows. The price is the same everywhere, with no call-out fee.' },
  { q: 'My immersion heater keeps failing. Should I replace it or the cylinder?', a: 'If the cylinder is sound and under about 15 years old, a new immersion heater is usually the right call. It is £175 on a vented cylinder. If the cylinder is over 20 years old, or the immersion has failed more than once, a new cylinder from £750 is often better value. We tell you honestly on the visit.' },
  { q: 'Can you replace an immersion heater the same day?', a: 'Often, yes, when we have a free slot. Call 0151 558 0334 to check. Most immersion heater swaps are done in one visit.' },
  { q: 'We are moving our bathroom upstairs. Do we need a new cylinder?', a: 'Not always. It depends on how high the loft tank sits above the new shower. If the pressure will be too weak, an unvented cylinder gives mains pressure upstairs. We check this at the free survey.' },
  { q: 'Are your engineers G3 qualified?', a: 'Yes. All our engineers are G3 qualified to fit and service unvented cylinders. The work is notified as the Building Regulations require, and you get the paperwork to keep.' },
  { q: 'How long does a cylinder swap take?', a: 'Most swaps are done in one day. A change from vented to unvented, or a tight airing cupboard, can take a little longer. We tell you at the survey.' },
  { q: 'Does an unvented cylinder need a yearly service?', a: 'Yes. Makers ask for a yearly service to keep the warranty valid. It also checks the safety valves still work. Our unvented cylinder service is £120 including VAT.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Gas work is done by our Gas Safe registered engineers. You can check any engineer on the Gas Safe Register before they start.' },
];
---

