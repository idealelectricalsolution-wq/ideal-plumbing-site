      { "@type": "Offer", "name": "TRV Upgrade Liverpool", "description": "Thermostatic radiator valve upgrade. Fitted per valve. Required on new installations under Boiler Plus regulations.", "price": "50", "priceCurrency": "GBP", "availability": "https://schema.org/InStock", "priceValidUntil": "2026-12-31" },
