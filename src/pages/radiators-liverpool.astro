---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/radiators-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'new-radiator', tier: 'Supply and fit', name: 'New radiator supplied and fitted', price: '£245', from: true, unit: 'inc VAT',
    points: ['Standard double panel radiator with a new TRV', 'Old radiator taken away', 'Inhibitor topped up, system balanced'] },
  { id: 'five-radiators', tier: 'Whole house', popular: true, name: 'Five radiators supplied and fitted', price: '£1,195', from: true, unit: 'inc VAT',
    points: ['Five new double panel radiators', 'Usually done in one day', 'Old radiators taken away'] },
  { id: 'fit-only', tier: 'Labour only', name: 'Fit your own radiator', price: '£95', from: true, unit: 'inc VAT',
    points: ['You buy the radiator, we fit it', 'Same spot, no new pipework', 'About 1 to 2 hours'] },
  { id: 'move', tier: 'Relocation', name: 'Move a radiator', price: '£225', from: true, unit: 'inc VAT',
    points: ['Pipework moved to the new wall', 'Pipes under the floor or neatly boxed', 'About 3 to 4 hours'] },
];

const faqs = [
  { q: 'How much does a new radiator cost in Liverpool?', a: 'A standard double panel radiator supplied and fitted is from £245 including VAT. Five radiators supplied and fitted are from £1,195. If you buy your own, fitting is from £95. Designer and column radiators are from £250 to fit.' },
  { q: 'How long does it take to fit a radiator?', a: 'A like-for-like swap takes 1 to 2 hours. Moving a radiator takes 3 to 4 hours. A new radiator with new pipework takes 2 to 4 hours. Five radiators are usually done in one day.' },
  { q: 'Do you take the old radiator away?', a: 'Yes. We take the old radiator away and dispose of it. This is included in the price.' },
  { q: 'Do you have to drain the whole system?', a: 'Often not. For a straight swap, we close the valves on each side and drain just that radiator. If the valves will not hold, or we are moving pipework, we drain down the system and refill it.' },
  { q: 'Will you fit a radiator I bought myself?', a: 'Yes. Fitting your own radiator is from £95 in the same spot. Check the size and heat output before you buy. We are happy to help you choose.' },
  { q: 'What size radiator do I need?', a: 'It depends on the room size, the windows, the walls and the insulation. A heat loss check gives the output needed, in watts or BTU. We work it out for you and pick a radiator that meets it.' },
  { q: 'Do designer radiators give out less heat?', a: 'Some do. Many slim and vertical styles give out less heat than a double panel radiator of the same width. Always compare the output figure, not the size. We check it before you order.' },
  { q: 'Why is my radiator cold at the bottom?', a: 'Usually sludge. It settles at the bottom and blocks the heat. Bleeding will not fix it. One radiator may need a flush. If several are cold at the bottom, the whole system needs a power flush.' },
  { q: 'Why is my radiator cold at the top?', a: 'Usually air. Bleed it with a radiator key, then check the boiler pressure. If it needs bleeding every few weeks, air or gas is getting in. That is worth a check.' },
  { q: 'Can you add a radiator to a room without one?', a: 'Yes. We run new pipes from the nearest part of the circuit and fit a radiator with a TRV. A new radiator in a new position is from £325. It suits extensions, loft rooms and conservatories.' },
  { q: 'How much does a radiator repair cost?', a: 'Repairs are charged by time. The first hour is £120 on weekdays 9am to 4pm, £150 evenings, nights and weekends, and £180 on bank holidays. There is no call-out fee. Most small repairs are done in the first hour.' },
  { q: 'How long do radiators last?', a: 'Steel panel radiators often last 15 to 20 years. Good inhibitor in the water helps them last longer. Rust spots, pinhole leaks or cold patches that a flush will not clear mean it is time to replace one.' },
  { q: 'What is a TRV?', a: 'A thermostatic radiator valve. It sets the heat for each room, so you do not heat rooms you are not using. We fit TRVs for £65 each, or up to six for £295.' },
  { q: 'What radiator brands do you fit?', a: 'We fit Stelrad, Quinn, Myson, Reina, Hudson Reed, Bisque, Carron and more. Panel, column, designer and period-style radiators are all fine. We can supply the radiator or fit one you bought.' },
];
---

