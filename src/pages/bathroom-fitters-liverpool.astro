---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/bathroom-fitters-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'cloakroom', tier: 'Small room', name: 'Cloakroom or WC', price: '£2,495', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['New toilet and basin', 'Taps, waste and pipework', 'Tiling or wall panels', 'Old suite taken away'] },
  { id: 'full', tier: 'Full bathroom', popular: true, name: 'Full bathroom, supplied and fitted', price: '£4,995', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Bath or shower, toilet, basin and taps', 'Strip-out and disposal', 'All plumbing and tiling', 'Usually 5 to 7 working days'] },
  { id: 'en-suite', tier: 'En-suite', name: 'En-suite shower room', price: '£4,495', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Shower tray, enclosure and valve', 'Toilet and basin', 'Tiling and waterproofing', 'Extractor fan by our partner electricians'] },
  { id: 'bath-to-shower', tier: 'Most asked for', name: 'Bath to shower conversion', price: '£2,395', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Bath removed and taken away', 'Tray, enclosure and thermostatic valve', 'Shower area tiled or panelled', 'Usually 2 to 3 days'] },
];

const faqs = [
  { q: 'How much does a bathroom installation cost in Liverpool?', a: 'With us, a full bathroom supplied and fitted starts from £4,995 including VAT. An en-suite is from £4,495 and a cloakroom or WC is from £2,495. A bath to shower conversion is from £2,395. If you buy your own suite, a labour-only full refit is from £2,750. You get a fixed written price after a free home visit.' },
  { q: 'How long does a bathroom installation take in Liverpool?', a: 'A full bathroom usually takes 5 to 7 working days. A bath to shower conversion takes 2 to 3 days. Smaller rooms, like a cloakroom, take less time. The exact time depends on the size of the room, tiling and any pipe moves. We tell you the dates in your quote.' },
  { q: 'What is included in the price?', a: 'Strip-out and disposal of the old bathroom, the new suite, and all plumbing and waste pipework. Then tiling or wall panels, sealing, testing and a clean when we finish. Lights, an extractor fan or a shower circuit are done by our partner firm Ideal Electrical Solutions and priced in the same quote.' },
  { q: 'Do you supply the tiles, or can I buy my own?', a: 'Both work. We can supply tiles to suit your budget, or fit tiles you have chosen. Tell us at the home visit and we will price it either way.' },
  { q: 'Do I need a separate tiler or electrician?', a: 'No. Our team does the plumbing and the tiling. Electrical work, such as lights, an extractor fan or an electric shower circuit, is done by our partner firm Ideal Electrical Solutions. We book it into the same plan, so you only deal with us.' },
  { q: 'Do you take the old bathroom away?', a: 'Yes. The old suite, tiles and pipework leave with us. You do not need to hire a skip.' },
  { q: 'Can I supply my own bathroom suite?', a: 'Yes. A labour-only full refit is from £2,750 including VAT. You buy the suite and we fit it. We check what you have ordered at the home visit, so nothing is missing on the day.' },
  { q: 'How much does it cost to replace a bath with a shower?', a: 'A bath to shower conversion in Liverpool starts from £2,395 including VAT. It covers taking the bath out, adapting the pipes and waste, the tray, enclosure and thermostatic valve, and finishing the walls. It takes 2 to 3 days.' },
  { q: 'Do you fit accessible bathrooms?', a: 'Yes. We fit low level shower trays, grab rails and raised toilet seats. Swapping a bath for a low level shower is the most common change we make for people who struggle to get in and out of the bath.' },
  { q: 'Do you offer a free quote?', a: 'Yes. We visit your home for free, measure up and check where the pipes and waste run. You then get a fixed price in writing. There is no pressure to book.' },
  { q: 'Is the work guaranteed?', a: 'Yes. Every bathroom has a 12-month workmanship guarantee. The suite and taps also have the maker\'s own warranty. We hold £2 million public liability insurance.' },
  { q: 'Do I need to pay up front?', a: 'Nothing is paid before the visit, and the visit is free. Payment terms are agreed in writing with your quote, before the job is booked in. We do not offer finance.' },
  { q: 'What if you find a problem under the old bath?', a: 'We show you and give you a price before we fix it. Old baths often hide a rotten floorboard or a leaking waste. Nothing gets covered up, and you decide.' },
];
---

<ServiceGuide
  url={URL_}
  title="Bathroom Fitters & Installation Liverpool | From £4,995"
  description="Bathroom fitters in Liverpool. Full bathrooms from £4,995, en-suites from £4,495, bath to shower from £2,395, inc VAT. Plumbing and tiling by our team. Free home visit. Call 0151 558 0334."
  h1="Bathroom Fitters Liverpool"
  badge="Free home visit · fixed written price"
  intro="New bathrooms fitted across Liverpool from £4,995, including VAT. Our team, led by James, does the strip-out, the plumbing and the tiling. Our partner firm handles the electrics. You get a fixed written price after a free home visit, and a 12-month guarantee on our work."
  secondaryCta={{ href: '#prices', label: 'See bathroom prices' }}
  stats={[['£4,995', 'Full bathroom fitted'], ['5-7 days', 'Typical full bathroom']]}
  ticks={['Free Home Visit', 'Fixed Written Price', '12-Month Guarantee', '5.0 on Google']}
  pkTitle="Bathroom installation prices"
