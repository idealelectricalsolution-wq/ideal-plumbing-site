    { href: '/emergency-plumber-west-derby', label: 'West Derby' },
    { href: '/emergency-plumber-crosby', label: 'Crosby' },
    { href: '/emergency-plumber-maghull', label: 'Maghull' },
  ]}
  related={[
    { href: '/showers-liverpool', title: 'Shower installation', text: 'Electric showers from £375, mixers from £395' },
    { href: '/radiators-liverpool', title: 'Radiators and towel rails', text: 'New radiators from £245 supplied and fitted' },
    { href: '/hot-water-cylinders-liverpool', title: 'Hot water cylinders', text: 'Unvented cylinders for strong showers, from £1,450' },
