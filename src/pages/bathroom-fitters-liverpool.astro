  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much do bathroom fitters in Liverpool cost?", "acceptedAnswer": { "@type": "Answer", "text": "A premium bathroom in Liverpool costs from £8,500 supply and fit. An en suite is from £5,500. A wet room is from £10,500. A new shower fit is from £600. The price covers the suite, brand-name taps, full tiling and all fitting. We give a free survey and a fixed-price quote in writing before any work starts." } },
      { "@type": "Question", "name": "How long does a bathroom installation in Liverpool take?", "acceptedAnswer": { "@type": "Answer", "text": "A full bathroom fit takes 7 to 10 working days. An en suite takes 5 to 7 days. A wet room takes 7 to 10 days due to the tanking work. A new shower on its own takes 1 to 2 days. We agree the exact timing at the free survey and stick to a fixed start and end date." } },
      { "@type": "Question", "name": "What brands do you fit?", "acceptedAnswer": { "@type": "Answer", "text": "We fit premium UK and EU brands as standard. The list covers Villeroy & Boch, Duravit, Geberit, Hansgrohe, Grohe, Crosswater, Lusso Stone and BC Designs. We only fit products with a strong track record on long-term wear. The cheapest part of a bathroom is the labour. The materials are what last." } },
      { "@type": "Question", "name": "Do you offer a free design consultation?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every job starts with a free home survey. We sit with you, look at the space, talk through brand and tile choices, and write up a full spec. We do not charge for the survey. There is no pressure to book." } },
      { "@type": "Question", "name": "Do you do the plumbing, tiling and fitting?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Our own team does the plumbing, tiling and fitting. Gas Safe registered for the plumbing. An employed tiler does the wall and floor work. No subcontractors. You get one team, one schedule and one point of contact for the whole job." } },
      { "@type": "Question", "name": "Can you fit a bathroom in a Liverpool Victorian property?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Liverpool's Victorian and Edwardian houses are our most common job. These homes often have a narrow bathroom layout, an unusual shape, old cast iron waste pipes and solid brick walls. We plan the fit around the house and keep period features where we can. Roll-top baths, freestanding pieces and period taps fit these homes well." } },
      { "@type": "Question", "name": "Will a premium bathroom add value to my Liverpool property?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A premium new bathroom is one of the best home upgrades for return on cost in Liverpool. Estate agents flag bathroom quality as a top buyer factor on resale. A premium fit also speeds up a sale. The most common pre-exchange friction is bathroom condition. We can deliver a full fit in 7 to 10 working days for owners getting ready to sell." } },
      { "@type": "Question", "name": "Are you Gas Safe registered?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All plumbing work is done by our own Gas Safe registered engineers. You can check us on the Gas Safe Register at gassaferegister.co.uk. The tiling and fitting are also done by our own employed team. We never use subcontractors on any bathroom job." } },
      { "@type": "Question", "name": "What is the lead time before you can start?", "acceptedAnswer": { "@type": "Answer", "text": "Our lead time for a full bathroom is 1 to 2 weeks. Smaller jobs may start sooner. We book the job in for a fixed start date that works for you and we hold to it. Once on site, the job is done in 7 to 10 working days." } },
      { "@type": "Question", "name": "Do you fit wet rooms in Liverpool?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We fit full wet rooms with a linear drain, level access and a tanked floor and walls. The price starts at £10,500 supply and fit. Wet rooms need the whole space behind every tile to be tanked. We do not cut corners on this part. A wet room takes 7 to 10 working days." } },
      { "@type": "Question", "name": "Do you fit accessible bathrooms?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We fit level-access showers, grab rails, raised toilet seats and walk-in baths. Often the right answer is a full wet room. We design the room around the needs of the user. Call us on 0151 558 0334 to talk it through." } },
      { "@type": "Question", "name": "What is included in the £8,500 price?", "acceptedAnswer": { "@type": "Answer", "text": "The £8,500 price covers a full strip-out, all plumbing and waste work, full wall and floor tiling, the suite and taps from premium brands, underfloor heating, a heated towel rail, an extractor fan and a full clean on the day we hand it over. The free survey and fixed-price quote come first." } }
    ]
  }
