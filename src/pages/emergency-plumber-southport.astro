---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Emergency Plumber Southport | 24/7 Cover | From £80"
  description="Emergency plumber in Southport PR8. We cover Lord Street, Birkdale, Hesketh Park, Ainsdale and the wider PR8. Same Sefton Council as our Kirkby base. 40 minute response. Gas Safe registered. No premium for distance."
>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Emergency Plumber Southport",
    "alternateName": ["24 Hour Plumber Southport", "Southport Emergency Plumber PR8"],
    "serviceType": "Emergency Plumbing",
    "description": "Emergency plumber in Southport PR8. We cover Lord Street, Birkdale, Hesketh Park, Ainsdale, Churchtown and the wider PR8 and PR9. Same Sefton Council as our Kirkby base. 40 minute response. Gas Safe registered. Same fixed rates as our Liverpool coverage. No distance premium.",
    "provider": { "@id": "https://liverpoolemergencyplumber.co.uk/#business" },
    "areaServed": [
      { "@type": "Place", "name": "Southport, PR8" },
      { "@type": "Place", "name": "Lord Street" },
      { "@type": "Place", "name": "Birkdale" },
      { "@type": "Place", "name": "Hesketh Park" },
      { "@type": "Place", "name": "Ainsdale" },
      { "@type": "Place", "name": "Churchtown" },
      { "@type": "Place", "name": "Marshside" }
    ],
    "hoursAvailable": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "00:00", "closes": "23:59" },
    "offers": [
      { "@type": "Offer", "name": "Weekday Emergency Plumber Southport", "price": "80", "priceCurrency": "GBP", "description": "Monday to Friday 9am to 5pm. 1 hour minimum charge." },
      { "@type": "Offer", "name": "Weekend Emergency Plumber Southport", "price": "120", "priceCurrency": "GBP", "description": "Saturday and Sunday 9am to 1pm. 1 hour minimum charge." },
      { "@type": "Offer", "name": "Out of Hours Emergency Plumber Southport", "price": "150", "priceCurrency": "GBP", "description": "Nights, bank holidays and out of hours. 24/7 availability." }
    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does an emergency plumber cost in Southport?", "acceptedAnswer": { "@type": "Answer", "text": "£80 an hour weekdays 9am to 5pm. £120 an hour weekends 9am to 1pm. £150 an hour out of hours, nights and bank holidays. 1 hour minimum on every call-out. Parts at cost. Same rates as our Liverpool coverage. No distance premium for Southport. Most jobs cost £80 to £350. Written quote before work starts. No call-out fee." } },
      { "@type": "Question", "name": "How quickly can you reach Southport from Kirkby?", "acceptedAnswer": { "@type": "Answer", "text": "Honest answer: 35 to 45 minutes via the A570 or A59. Southport has no direct motorway link. If you need a 15 minute response, a local Southport plumber will be faster. We're useful when the local plumbers are tied up, for out of hours cover, and for landlords with portfolios spanning Sefton." } },
      { "@type": "Question", "name": "Why would I call a Kirkby plumber for Southport?", "acceptedAnswer": { "@type": "Answer", "text": "Three reasons. First: when the local Southport plumbers are tied up or unavailable, we are. Second: we charge our standard rates with no Southport distance premium. Third: we cover the whole of Sefton at the same rates, so landlords with rentals in Maghull, Crosby, Formby and Southport can use one phone number." } },
      { "@type": "Question", "name": "Do you cover Birkdale and Ainsdale?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Birkdale (PR8 4), Ainsdale (PR8 3), Hillside, Hesketh Park, Churchtown (PR9), Marshside and the wider PR8 are all covered at the same fixed rates." } },
      { "@type": "Question", "name": "Do you work on the Lord Street Victorian properties?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Lord Street buildings are 130 to 170 years old. Most have been converted to flats and shops with mixed-era plumbing. Original lead supply, Victorian cast iron, 1970s upgrades, 2010s push-fit all in the same building. We work it out before we quote." } },
      { "@type": "Question", "name": "Do you cover landlord rentals in Southport?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Lord Street area has high private rental and lots of HMO conversions. We cover landlord call-outs 24/7. CP12 gas safety paperwork from £80. Batch pricing for landlords with rentals across Sefton." } },
      { "@type": "Question", "name": "Are your engineers Gas Safe registered?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All gas work is done by our own Gas Safe engineers. Check our entry at gassaferegister.co.uk. It's against the law to work on gas without it." } },
      { "@type": "Question", "name": "Do you guarantee your work?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every job has a 12-month workmanship guarantee. If something we fixed fails because of our work, we come back. No charge." } }
    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://liverpoolemergencyplumber.co.uk" },
      { "@type": "ListItem", "position": 2, "name": "Emergency Plumber Southport", "item": "https://liverpoolemergencyplumber.co.uk/emergency-plumber-southport" }
    ]
  }
  </script>

  <!-- HERO -->
  <section class="page-hero">
    <div class="container" style="text-align:center;">
      <div class="page-hero-badge" style="margin:0 auto 1rem;">
        <span class="live-dot"></span>
        Available 24/7 in Southport PR8
