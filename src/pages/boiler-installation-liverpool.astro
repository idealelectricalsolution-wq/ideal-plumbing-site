---
import BaseLayout from '../layouts/BaseLayout.astro';

const URL_ = 'https://liverpoolemergencyplumber.co.uk/boiler-installation-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';
const UPDATED = '26 November 2026';

const packages = [
  { id: 'pk-essential', tier: 'Essential', name: 'Baxi 600 Combi 2', img: 'baxi-600-combi-2', price: '2,195', size: '24kW or 30kW', flow: '10.2 to 12.2', warranty: '7 years', best: 'Flats, small terraces and rental homes',
    points: ['Stainless steel heat exchanger', 'Simple, reliable and easy to service', 'Our lowest price for a named brand'] },
  { id: 'pk-value', tier: 'Value', name: 'Baxi 800 Combi 2', img: 'baxi-800-combi-2', price: '2,495', size: '24kW or 30kW', flow: '10.2 to 12.2', warranty: '10 years', best: '2 to 3 bed homes, if you are staying put',
    points: ['The same boiler as the Baxi 600', 'Magnetic filter in the box', '3 more years of cover for £300 more'] },
  { id: 'pk-popular', tier: 'Most popular', popular: true, name: 'Worcester Bosch Greenstar 4000', img: 'worcester-greenstar-4000', price: '2,695', size: '25kW or 30kW', flow: '12.3 (30kW)', warranty: 'Up to 10 years', best: 'Most 2 to 4 bed homes',
    points: ['Top-rated brand in the 2025 Which? owner survey', 'Quiet, at 45dB', 'Ticks over gently on mild days, so it switches on and off less'] },
  { id: 'pk-premium', tier: 'Premium', name: 'Vaillant ecoTEC plus', img: 'vaillant-ecotec-plus', price: '2,995', size: '26kW or 32kW', flow: '10.6 to 13.0', warranty: 'Up to 10 years', best: 'Busier homes and two bathrooms',
    points: ['More hot water at each size', 'Quality German brand', 'Works with Vaillant smart controls'] },
  { id: 'pk-flagship', tier: 'Flagship', name: 'Worcester Bosch Greenstar 8000+ Style', img: 'worcester-greenstar-8000-style', imgAlt: 'Worcester Bosch Greenstar 8000 Style boiler in gloss black', price: '3,295', size: '32kW', flow: '13.7', warranty: 'Up to 12 years', best: 'Larger homes, or a boiler on show in the kitchen',
    points: ['Gloss black with a colour touchscreen', 'Optional auto-fill tops up its own pressure', 'The longest cover in our range'] },
];

const extras = [
  ['Next size up (for example 30kW to 36kW)', '+£200'],
  ['Move the boiler within the same room', '+£450'],
  ['Move the boiler to another room on the same floor', '+£750'],
  ['Move the boiler to another floor, the loft or the garage', '+£850'],
  ['Swap a tank system (regular or system boiler) for a combi', '+£695'],
  ['Power flush instead of a chemical clean', '£350'],
  ['Back boiler removal, vertical flue or a gas pipe upgrade', 'Priced at the free survey'],
];

const included = [
  ['The new boiler', 'A-rated combi, system or regular boiler from Worcester Bosch, Vaillant, Ideal or Baxi, sized for your home.'],
  ['Smart thermostat', 'Fitted and set up for you. It meets the Boiler Plus rules for new combi boilers.'],
  ['Carbon monoxide alarm', 'Fitted near the boiler.'],
  ['Magnetic filter', 'Fitted on the return pipe to catch sludge before it reaches the new boiler.'],
  ['System clean and inhibitor', 'The heating system is cleaned and dosed with inhibitor. Boiler makers ask for this to keep the warranty valid.'],
  ['Flue and fittings', 'All flue parts, valves and fittings for a safe, compliant install.'],
  ['Old boiler taken away', 'We disconnect it, remove it and dispose of it. No skip needed.'],
  ['Commissioning and handover', 'Gas pressure and combustion checked, radiators balanced, and we show you how the controls work.'],
  ['Paperwork', 'Benchmark checklist filled in, the manufacturer warranty registered for you, and the install notified to Gas Safe Register.'],
];

const signs = [
  ['It is over 10 to 15 years old', 'And it is breaking down more often. Parts for older models get harder to find and more expensive.'],
  ['Repairs are adding up', 'If you are paying for repairs every winter, the money is often better put towards a new boiler.'],
  ['A major part has failed', 'A cracked heat exchanger on an older boiler usually costs more to fix than the boiler is worth.'],
  ['The flame is yellow or orange', 'Or there are soot marks around the boiler. Stop using it and call us. If you smell gas, call 0800 111 999 first.'],
  ['Your gas bills keep rising', 'With no change in how you use the heating. An old non-condensing boiler wastes far more gas than a modern one.'],
  ['It takes ages to heat up', 'If the radiators take much longer to warm than they used to, the boiler or the system is struggling. Sludge is often the cause, which a power flush can fix if the boiler is otherwise sound.'],
  ['Some rooms never get warm', 'Common in homes that have been extended. The boiler was sized for a smaller house and now cannot keep up.'],
  ['It bangs, whistles or kettles', 'Kettling is limescale in the heat exchanger making the water boil. On a younger boiler it can be cleared. On an old boiler it often means the heat exchanger is close to failing.'],
  ['The pilot light keeps going out', 'On older boilers this is usually a thermocouple or gas valve. Fixable on its own, but on an old boiler with other faults it is a sign it is near the end.'],
  ['You want to change the system', 'For example, swapping a tank-fed system for a combi to free up the airing cupboard and loft.'],
];

const sizes = [
  ['1 to 2 bed flat or terrace, one bathroom', '24 to 28kW combi'],
  ['3 bed semi or terrace, one bathroom', '28 to 32kW combi'],
  ['4 bed or larger, one main bathroom', '32 to 40kW combi'],
  ['Two or more bathrooms used at once', 'System or regular boiler with a cylinder'],
];

const brands = [
  ['Worcester Bosch', 'Greenstar range. A common choice in Liverpool homes, with good parts availability.'],
  ['Vaillant', 'ecoTEC range. Quiet, well built and a good fit for larger homes.'],
  ['Ideal', 'Logic and Vogue ranges. Built in Hull. Good value, popular with landlords.'],
  ['Baxi', 'A reliable option when budget matters most.'],
];

const steps = [
  ['Free survey', 'An engineer visits, looks at your boiler, pipework, flue route, gas supply and water pressure, and asks how you use your hot water. You get a written fixed price.'],
  ['You choose a date', 'Once you are happy with the quote, we book the install for a day that suits you. Boiler broken and need it urgently? Tell us and we will give you our earliest slot.'],
  ['Clean the system', 'Before the new boiler goes on, the heating system is cleaned so old sludge does not damage it.'],
  ['Out with the old', 'The old boiler and any old controls or pipework being replaced are taken out and taken away.'],
  ['Fit and commission', 'The new boiler, flue, filter and controls are fitted. Gas pressure, combustion and safety devices are checked, and the radiators are balanced.'],
  ['Handover', 'We show you how to use the boiler and controls, fill in the Benchmark checklist and register the warranty. A like-for-like combi swap is usually done in one day.'],
];

const reviews = [
  { n: 'Brendan C', t: 'James was amazing and was at my house within 30 mins of calling on a sunday. He has not only fixed my boiler but improved it and taught me how to fix the problem in future. Affordable and easygoing great plumber and gas fitter!' },
  { n: 'Edward M', t: 'James came out and fixed a leaking pipe and even got my boiler up and running by fixing an air lock. Professional , on time, cleaned up after himself and charged a fair rate.' },
  { n: 'David H', t: 'Amazing service James was very professional. Fixed my boiler and leaking tap very knowledgeable very fast and polite great company 100% recommended' },
];

const faqs = [
  { q: 'How much does a new boiler cost in Liverpool?', a: 'Our five fixed-price combi packages run from £2,195 for a Baxi 600 to £3,295 for a Worcester Bosch Greenstar 8000+ Style, fully fitted. Our most popular, the Worcester Bosch Greenstar 4000, is £2,695. Every package includes a smart thermostat, magnetic filter, system clean, carbon monoxide alarm and removal of your old boiler. System and regular boilers are priced after a free survey.' },
  { q: 'Which boiler package should I choose?', a: 'For a flat, a small terrace or a rental, the Baxi 600 (£2,195). If you are staying put, the Baxi 800 (£2,495) adds a filter and 3 more years of cover. For most 2 to 4 bed homes, the Worcester Bosch Greenstar 4000 (£2,695). For two bathrooms or heavy hot water use, the Vaillant ecoTEC plus (£2,995). For a boiler on show in a kitchen, the Worcester Bosch 8000+ Style (£3,295).' },
  { q: 'Why does a Worcester Bosch cost more than a Baxi?', a: 'You pay for the brand homeowners rate highest, a quieter boiler that runs more gently on mild days, and up to 10 years of cover against 7 on the Baxi 600. The Baxi 800 closes the warranty gap for £200 less than the Worcester.' },
  { q: 'How long does it take to fit a new boiler?', a: 'A like-for-like combi swap is usually done in one day. Moving the boiler, converting from a regular or system boiler to a combi, or adding a cylinder can take 2 to 3 days. We tell you how long at the survey.' },
  { q: 'What warranty do I get?', a: 'It depends on the boiler: 7 years on the Baxi 600, 10 years on the Baxi 800, up to 10 years on the Worcester Bosch 4000 and Vaillant ecoTEC plus, and up to 12 years on the Worcester Bosch 8000+ Style. We register the boiler with the manufacturer on the day. It then needs a service every year to keep the warranty valid. On top of that, our own workmanship is guaranteed for 12 months.' },
  { q: 'Can I swap my old tank system for a combi?', a: 'Usually, yes. A combi heats water straight from the mains, so we check your water pressure and flow at the survey. If they are good enough, we can remove the cylinder and the loft tanks and fit a combi. In homes with two or more bathrooms used at the same time, a system boiler with a cylinder often works better.' },
  { q: 'Can you move my boiler to a different room?', a: 'Yes. Moving a boiler means new gas, water and condensate pipes and a new flue route, so it costs more than a straight swap. We price it at the survey.' },
  { q: 'Do I need a power flush with a new boiler?', a: 'The system has to be clean before the new boiler goes on, because boiler makers make it a warranty condition. A system clean is included in our price. If the radiators are badly sludged, cold at the bottom for example, a full power flush is the better option. Power flushing is from £395.' },
  { q: 'Can I still get a gas boiler?', a: 'Yes. You can replace a gas boiler in an existing home with a new gas boiler. The rules that limit gas boilers apply to newly built homes.' },
  { q: 'Can I fit a boiler myself?', a: 'No. By law, gas boilers must be fitted by a Gas Safe registered engineer. A badly fitted boiler can leak gas or carbon monoxide. You can check any engineer on the Gas Safe Register website.' },
  { q: 'Do you offer finance?', a: 'No, we do not offer finance. You get one fixed price, agreed in writing before any work starts.' },
  { q: 'Do I need new radiators with a new boiler?', a: 'Usually not. Most radiators work fine with a new boiler. We check them on the survey and only suggest replacing one if it is leaking, badly corroded or too small for the room. The system is cleaned before the new boiler goes on.' },
  { q: 'Will a new boiler lower my gas bill?', a: 'It can. Older boilers, especially ones over 15 years old, waste more gas than a modern A-rated condensing boiler. How much you save depends on your old boiler, your home and how you use the heating. Good controls, such as a smart thermostat, help too.' },
  { q: 'Do you do like-for-like boiler replacement?', a: 'Yes. Replacing an old combi with a new combi in the same place is our most common job, and it is usually done in one day. We also replace system and regular boilers, and convert tank systems to a combi.' },
  { q: 'How long does a boiler last?', a: 'Most gas boilers last 10 to 15 years. One that is serviced every year usually lasts longer. After about 10 years, parts get harder to find and breakdowns become more frequent.' },
  { q: 'Is my boiler worth repairing instead?', a: 'Often it is. If the boiler is under 10 years old and the fault is a single part, a repair is usually the better value. A repair visit is from £120 for the first hour, including diagnosis, and we will tell you honestly whether to repair or replace.' },
  { q: 'Are there free boiler grants in Liverpool?', a: 'Some households on certain benefits may qualify for a free boiler through the government ECO4 scheme. We do not install under ECO4. Our ECO4 guide explains who qualifies and how to apply.' },
];

const toc = [
  ['choose', 'Which package is right for me?'],
  ['compare', 'Compare all five'],
  ['cost', 'What can change the price?'],
  ['included', 'What is included?'],
  ['replace', 'Do you need a new boiler?'],
  ['type', 'Combi, system or regular?'],
  ['size', 'What size boiler?'],
  ['brands', 'Which brands?'],
  ['install-day', 'What happens on the day?'],
  ['older-homes', 'Older Liverpool homes'],
  ['rules', 'The rules'],
  ['reviews', 'Reviews'],
  ['faq', 'More questions'],
];

const schemaFaq = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const schemaService = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Boiler Installation Liverpool', serviceType: 'Gas boiler installation and replacement', url: URL_,
  alternateName: ['New boiler Liverpool', 'Boiler replacement Liverpool'],
  description: 'Five fixed-price combi boiler packages from £2,195 fully fitted, from Baxi, Worcester Bosch and Vaillant, fitted across Liverpool and Merseyside by Gas Safe registered engineers. Free survey, written fixed price, up to 12-year manufacturer warranty.',
  provider: { '@id': 'https://liverpoolemergencyplumber.co.uk/#business' },
  areaServed: [{ '@type': 'City', name: 'Liverpool' }, { '@type': 'City', name: 'Wirral' }, { '@type': 'City', name: 'St Helens' }, { '@type': 'City', name: 'Formby' }],
  offers: packages.map((p) => ({ '@type': 'Offer', name: `${p.name} combi boiler, fully fitted (${p.tier} package)`, price: p.price.replace(/,/g, ''), priceCurrency: 'GBP', url: `${URL_}#${p.id}` })),
};
const schemaPage = {
  '@context': 'https://schema.org', '@type': 'WebPage', '@id': URL_ + '#webpage', url: URL_,
  name: 'Boiler Installation Liverpool: new boiler prices, types, sizes and what to expect',
  dateModified: '2026-11-26', inLanguage: 'en-GB',
  about: { '@id': 'https://liverpoolemergencyplumber.co.uk/#business' },
};
const schemaCrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://liverpoolemergencyplumber.co.uk' },
    { '@type': 'ListItem', position: 2, name: 'Boiler Installation Liverpool', item: URL_ },
  ],
};
---

<BaseLayout
  title="New Boiler Liverpool | Boiler Installation From £2,195 Fitted"
  description="Need a new boiler in Liverpool? Boiler replacement with five fixed-price packages from £2,195 fully fitted. Baxi, Worcester Bosch and Vaillant, up to 12-year warranty, free survey. Call 0151 558 0334."
  canonical={URL_}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaService)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaFaq)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaPage)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaCrumbs)} />

  <!-- HERO -->
  <section class="page-hero" id="hero">
    <div class="container">
      <div class="page-hero-badge"><span class="badge-dot"></span>New boilers fitted across Merseyside</div>
      <h1>New Boiler Installation in Liverpool</h1>
      <p class="page-hero-sub">Need a new boiler in Liverpool? Choose from five fixed-price combi boiler packages, from a Baxi 600 at £2,195 to a Worcester Bosch 8000+ Style at £3,295. Every price is fully fitted, with a free survey and a written fixed price before any work starts. Our team of Gas Safe registered engineers is led by James.</p>
      <div class="bi-stats">
        <div class="br-stat"><div class="br-stat-n">£2,195</div><div class="br-stat-l">Fully fitted, from</div></div>
        <div class="br-stat"><div class="br-stat-n">12 yr</div><div class="br-stat-l">Warranty, up to</div></div>
      </div>
      <div class="bi-ctas">
        <a href={TEL} class="btn btn-orange btn-lg btn-full">CALL {PHONE}</a>
        <a href="#packages" class="btn btn-lg btn-full bi-btn-navy">See the 5 packages</a>
      </div>
      <div class="sg-hero-ticks">
        <span class="br-tick"><span>✓</span> Gas Safe Registered</span>
        <span class="br-tick"><span>✓</span> Free Survey</span>
        <span class="br-tick"><span>✓</span> Fixed Price</span>
        <span class="br-tick"><span>✓</span> 5.0 on Google</span>
      </div>
    </div>
  </section>

  <!-- PACKAGES -->
  <section class="bi-pk-sec" id="packages">
    <div class="bi-pk-wrap">
      <h2>Choose your new boiler</h2>
      <p class="bi-pk-lede">Five fixed-price combi packages. Every price is fully fitted and includes a smart thermostat, magnetic filter, system clean, carbon monoxide alarm and removal of your old boiler.</p>
      <p class="bi-swipe" aria-hidden="true">Swipe to see all 5 boilers →</p>
      <div class="bi-pk-grid">
        {packages.map((p, i) => (
          <article class={`bi-pk${p.popular ? ' bi-pk-pop' : ''}`} id={p.id}>
            {p.popular ? <p class="bi-pk-badge">Most popular</p> : <p class="bi-pk-tier">{p.tier}</p>}
            <picture>
              <source type="image/webp" srcset={`/images/boilers/${p.img}-400.webp 400w, /images/boilers/${p.img}-800.webp 800w`} sizes="(max-width: 640px) 60vw, 220px" />
              <img src={`/images/boilers/${p.img}-400.jpg`} alt={p.imgAlt || `${p.name} combi boiler`} width="400" height="400" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            </picture>
            <h3>{p.name}</h3>
            <p class="bi-pk-price">£{p.price}<span>fully fitted</span></p>
            <dl class="bi-pk-specs">
              <div><dt>Size</dt><dd>{p.size}</dd></div>
              <div><dt>Hot water</dt><dd>{p.flow} litres a minute</dd></div>
              <div><dt>Warranty</dt><dd>{p.warranty}</dd></div>
              <div><dt>Best for</dt><dd>{p.best}</dd></div>
            </dl>
            <ul class="bi-pk-points">{p.points.map((t) => <li>{t}</li>)}</ul>
            <a href={TEL} class="bi-pk-btn">Call {PHONE}</a>
            <a href="/get-started" class="bi-pk-link">Book a free survey</a>
          </article>
        ))}
      </div>
      <p class="bi-pk-note">Need a bigger boiler? The next size up is £200 more. Ideal Logic Max is also available, at £2,695. Hot water is at a 35°C rise. Warranties are the manufacturer's: "up to" means the longest cover, which needs the boiler registered (we do it on the day) and serviced every year. System and regular boilers are priced after a free survey.</p>
    </div>
  </section>

  <div class="brx">

  <!-- CHOOSE -->
  <section class="brx-sec" id="choose">
    <div class="brx-wrap">
      <h2>Which boiler package is right for you?</h2>
      <p class="brx-answer">Paying more buys three things: more years of warranty, more hot water, and a better-rated brand or design. Here is how to decide.</p>
      <div class="bi-quick">
        <p><strong>Flat, small terrace or rental?</strong> <a href="#pk-essential">Essential, Baxi 600</a></p>
        <p><strong>Staying put, on a budget?</strong> <a href="#pk-value">Value, Baxi 800</a></p>
        <p><strong>Most 2 to 4 bed homes</strong> <a href="#pk-popular">Most popular, Worcester Bosch 4000</a></p>
        <p><strong>Two bathrooms or lots of hot water?</strong> <a href="#pk-premium">Premium, Vaillant ecoTEC plus</a></p>
        <p><strong>Boiler on show in the kitchen?</strong> <a href="#pk-flagship">Flagship, Worcester Bosch 8000+ Style</a></p>
      </div>
      <details class="bi-qa" data-mcollapse open>
        <summary><h3>Baxi 600 or Baxi 800: is the extra £300 worth it?</h3><span class="brx-chev" aria-hidden="true"></span></summary>
        <p>They are the same boiler. The Baxi 800 adds a magnetic filter in the box and 3 more years of manufacturer cover: 10 years instead of 7. If you are staying in the house, it is worth it. Spread over the warranty, it works out cheaper per year of cover. If you are a landlord or expect to move within 5 years, the Baxi 600 is the sensible buy.</p>
      </details>
      <details class="bi-qa" data-mcollapse open>
        <summary><h3>Baxi 800 or Worcester Bosch 4000: why pay £200 more?</h3><span class="brx-chev" aria-hidden="true"></span></summary>
        <p>Both give about the same hot water and up to 10 years of cover. The Worcester is the brand homeowners rate highest: it was the only five-star brand in the 2025 Which? owner survey, with 92% satisfied against Baxi's 83%. It is also quiet, and turns down to a tenth of its power, so on mild days it ticks over gently instead of switching on and off. The Baxi keeps the price down and has a stainless steel heat exchanger.</p>
      </details>
      <details class="bi-qa" data-mcollapse open>
        <summary><h3>Worcester Bosch 4000 or Vaillant ecoTEC plus: do you need the extra hot water?</h3><span class="brx-chev" aria-hidden="true"></span></summary>
        <p>The Vaillant 832 gives about 13 litres of hot water a minute, against about 12.3 from the 30kW Worcester. That helps if two showers or a bath and a tap run at once. With one bathroom used at a time, you would not notice the difference, so the Worcester is better value.</p>
      </details>
      <details class="bi-qa" data-mcollapse open>
        <summary><h3>Vaillant or Worcester Bosch 8000+ Style: what does the flagship add?</h3><span class="brx-chev" aria-hidden="true"></span></summary>
        <p>Looks, extra features and the longest cover. The 8000+ Style is gloss black with a colour touchscreen. It can be fitted to top up its own pressure, and it carries up to 12 years of cover. If the boiler lives in a cupboard, the Vaillant gives you the performance for £300 less.</p>
      </details>
      <details class="bi-qa" data-mcollapse open>
        <summary><h3>Is it worth paying more at all?</h3><span class="brx-chev" aria-hidden="true"></span></summary>
        <p>If you are staying 10 years or more, usually yes, up to the Worcester Bosch 4000. Longer cover protects you from the most expensive repairs, and big brands keep parts easy to get. Above that, you are paying for hot water and design, which is worth it in bigger or busier homes. One limit: a bigger combi only gives more hot water if your mains can supply it. Many older Liverpool terraces have limited flow, so we test it at the survey before recommending a size.</p>
      </details>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="brx-sec brx-tint" id="compare">
    <div class="brx-wrap">
      <h2>Compare all five boilers</h2>
      <div class="brx-table-wrap">
        <table class="brx-table bi-cmp">
          <thead><tr><th>Package</th><th>Price</th><th>Hot water (litres a minute)</th><th>Warranty</th><th>Best for</th></tr></thead>
          <tbody>
            {packages.map((p) => <tr><td><a href={`#${p.id}`}><strong>{p.tier}</strong></a><br />{p.name}</td><td><strong>£{p.price}</strong></td><td>{p.flow}</td><td>{p.warranty}</td><td>{p.best}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="brx-cta">
        <p><strong>Not sure which?</strong> Ring us. We'll ask a few questions and recommend one, then confirm it at the free survey.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>

  <!-- AT A GLANCE -->
  <section class="brx-sec" id="key-facts">
    <div class="brx-wrap">
      <div class="brx-facts">
        <h2 class="brx-facts-h">A new boiler with us at a glance</h2>
        <dl>
          <div><dt>Price</dt><dd>Five combi packages from £2,195 to £3,295, fully fitted</dd></div>
          <div><dt>Quote</dt><dd>Free survey, then a written fixed price. No finance, no add-ons on the day.</dd></div>
          <div><dt>Time</dt><dd>A like-for-like combi swap is usually done in one day</dd></div>
          <div><dt>Warranty</dt><dd>7 to 12 years from the manufacturer, depending on the boiler, plus our 12-month workmanship guarantee</dd></div>
          <div><dt>Brands</dt><dd>Baxi, Worcester Bosch and Vaillant, with Ideal on request</dd></div>
          <div><dt>Covered</dt><dd>Every Liverpool postcode, the Wirral, Sefton, Knowsley and St Helens</dd></div>
        </dl>
      </div>
      <nav class="brx-toc" aria-label="On this page">
        <p class="brx-toc-h">On this page</p>
        <ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol>
      </nav>
      <p class="brx-updated">Updated {UPDATED}</p>
    </div>
  </section>

  <!-- COST -->
  <section class="brx-sec brx-tint" id="cost">
    <div class="brx-wrap">
      <h2>What can change the price?</h2>
      <p class="brx-answer">The package prices cover a like-for-like combi swap. These extras are priced openly, so you know before the survey.</p>
      <div class="brx-table-wrap">
        <table class="brx-table">
          <thead><tr><th>Extra</th><th>Price</th></tr></thead>
          <tbody>{extras.map(([h, p]) => <tr><td>{h}</td><td><strong>{p}</strong></td></tr>)}</tbody>
        </table>
      </div>
      <h3>Why might a job cost more?</h3>
      <ul class="brx-list">
        <li><strong>Moving the boiler</strong> to another room, which needs new pipes and a new flue.</li>
        <li><strong>Changing the system</strong>, for example from a tank-fed regular boiler to a combi.</li>
        <li><strong>A bigger gas pipe.</strong> Modern boilers need enough gas, and some older homes need the pipe upgrading.</li>
        <li><strong>A longer or vertical flue</strong> through the roof instead of straight out of a wall.</li>
        <li><strong>The boiler model</strong> and its output.</li>
      </ul>
      <p>All of this is checked at the survey and included in your fixed price, so there are no surprises on the day.</p>
      <h3>How do you compare boiler quotes?</h3>
      <ul class="brx-list">
        <li><strong>Check what is included.</strong> A fair quote names the boiler model and output and says whether the flue, controls, magnetic filter, system clean and inhibitor are included. Some quotes leave these out and add them later.</li>
        <li><strong>Check the warranty</strong>: how many years, and what you have to do to keep it.</li>
        <li><strong>Check the engineer</strong> on the <a href="https://www.gassaferegister.co.uk/" target="_blank" rel="noopener">Gas Safe Register</a> before any work starts.</li>
        <li><strong>Get it in writing.</strong> A written fixed price protects you if anything changes on the day.</li>
        <li><strong>Plan ahead if you can.</strong> Replacing an old boiler before it fails means you choose the date, rather than going without heating in the middle of winter.</li>
      </ul>
      <div class="brx-cta">
        <p><strong>Want an exact price?</strong> The survey is free and there is no obligation.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>

  <!-- INCLUDED -->
