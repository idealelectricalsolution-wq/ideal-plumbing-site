---
import BaseLayout from '../layouts/BaseLayout.astro';

const URL_ = 'https://liverpoolemergencyplumber.co.uk/boiler-installation-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';
const UPDATED = '26 November 2026';

const prices = [
  { type: 'Combi boiler', fits: 'Most 1 to 3 bed homes with one bathroom', price: '£1,800' },
  { type: 'System boiler', fits: 'Larger homes, two or more bathrooms, with a hot water cylinder', price: '£2,200' },
  { type: 'Regular boiler', fits: 'Older homes with a cylinder and a cold water tank in the loft', price: '£2,500' },
];

const included = [
  ['The new boiler', 'A-rated combi, system or regular boiler from Worcester Bosch, Vaillant, Ideal or Baxi, sized for your home.'],
  ['Controls', 'A new programmer and room thermostat, set up for you. Smart controls such as Hive or Nest on request.'],
  ['Magnetic filter', 'Fitted on the return pipe to catch sludge before it reaches the new boiler.'],
  ['System clean and inhibitor', 'The heating system is cleaned and dosed with inhibitor. Boiler makers ask for this to keep the warranty valid.'],
  ['Flue and fittings', 'All flue parts, valves and fittings for a safe, compliant install.'],
  ['Old boiler taken away', 'We disconnect it, remove it and dispose of it. No skip needed.'],
  ['Commissioning and handover', 'Gas pressure and combustion checked, radiators balanced, and we show you how the controls work.'],
  ['Paperwork', 'Benchmark checklist filled in, the manufacturer warranty registered for you, and the install notified to Gas Safe Register.'],
];

const signs = [
  ['It is over 10 to 15 years old', 'And it is breaking down more often. Parts for older models get harder to find and more expensive.'],
  ['Repairs are adding up', 'If you are paying for repairs every winter, the money is often better put towards a new boiler.'],
  ['A major part has failed', 'A cracked heat exchanger on an older boiler usually costs more to fix than the boiler is worth.'],
  ['The flame is yellow or orange', 'Or there are soot marks around the boiler. Stop using it and call us. If you smell gas, call 0800 111 999 first.'],
  ['Your gas bills keep rising', 'With no change in how you use the heating. An old non-condensing boiler wastes far more gas than a modern one.'],
  ['It takes ages to heat up', 'If the radiators take much longer to warm than they used to, the boiler or the system is struggling. Sludge is often the cause, which a power flush can fix if the boiler is otherwise sound.'],
  ['Some rooms never get warm', 'Common in homes that have been extended. The boiler was sized for a smaller house and now cannot keep up.'],
  ['It bangs, whistles or kettles', 'Kettling is limescale in the heat exchanger making the water boil. On a younger boiler it can be cleared. On an old boiler it often means the heat exchanger is close to failing.'],
  ['The pilot light keeps going out', 'On older boilers this is usually a thermocouple or gas valve. Fixable on its own, but on an old boiler with other faults it is a sign it is near the end.'],
  ['You want to change the system', 'For example, swapping a tank-fed system for a combi to free up the airing cupboard and loft.'],
];

const sizes = [
  ['1 to 2 bed flat or terrace, one bathroom', '24 to 28kW combi'],
  ['3 bed semi or terrace, one bathroom', '28 to 32kW combi'],
  ['4 bed or larger, one main bathroom', '32 to 40kW combi'],
  ['Two or more bathrooms used at once', 'System or regular boiler with a cylinder'],
];

const brands = [
  ['Worcester Bosch', 'Greenstar range. A common choice in Liverpool homes, with good parts availability.'],
  ['Vaillant', 'ecoTEC range. Quiet, well built and a good fit for larger homes.'],
  ['Ideal', 'Logic and Vogue ranges. Built in Hull. Good value, popular with landlords.'],
  ['Baxi', 'A reliable option when budget matters most.'],
];

const steps = [
  ['Free survey', 'An engineer visits, looks at your boiler, pipework, flue route, gas supply and water pressure, and asks how you use your hot water. You get a written fixed price.'],
  ['You choose a date', 'Once you are happy with the quote, we book the install for a day that suits you. Boiler broken and need it urgently? Tell us and we will give you our earliest slot.'],
  ['Clean the system', 'Before the new boiler goes on, the heating system is cleaned so old sludge does not damage it.'],
  ['Out with the old', 'The old boiler and any old controls or pipework being replaced are taken out and taken away.'],
  ['Fit and commission', 'The new boiler, flue, filter and controls are fitted. Gas pressure, combustion and safety devices are checked, and the radiators are balanced.'],
  ['Handover', 'We show you how to use the boiler and controls, fill in the Benchmark checklist and register the warranty. A like-for-like combi swap is usually done in one day.'],
];

const reviews = [
  { n: 'Brendan C', t: 'James was amazing and was at my house within 30 mins of calling on a sunday. He has not only fixed my boiler but improved it and taught me how to fix the problem in future. Affordable and easygoing great plumber and gas fitter!' },
  { n: 'Edward M', t: 'James came out and fixed a leaking pipe and even got my boiler up and running by fixing an air lock. Professional , on time, cleaned up after himself and charged a fair rate.' },
  { n: 'David H', t: 'Amazing service James was very professional. Fixed my boiler and leaking tap very knowledgeable very fast and polite great company 100% recommended' },
];

const faqs = [
  { q: 'How much does a new boiler cost in Liverpool?', a: 'With us, a combi boiler is from £1,800 fully fitted, a system boiler from £2,200 and a regular boiler from £2,500. That includes the boiler, controls, magnetic filter, system clean, flue, removal of the old boiler and all the paperwork. Your exact price is fixed in writing after a free survey.' },
  { q: 'How long does it take to fit a new boiler?', a: 'A like-for-like combi swap is usually done in one day. Moving the boiler, converting from a regular or system boiler to a combi, or adding a cylinder can take 2 to 3 days. We tell you how long at the survey.' },
  { q: 'What warranty do I get?', a: 'Our boilers come with a 10-year manufacturer warranty, which we register for you on the day. The boiler needs a service every year to keep it valid. On top of that, our own workmanship is guaranteed for 12 months.' },
  { q: 'Can I swap my old tank system for a combi?', a: 'Usually, yes. A combi heats water straight from the mains, so we check your water pressure and flow at the survey. If they are good enough, we can remove the cylinder and the loft tanks and fit a combi. In homes with two or more bathrooms used at the same time, a system boiler with a cylinder often works better.' },
  { q: 'Can you move my boiler to a different room?', a: 'Yes. Moving a boiler means new gas, water and condensate pipes and a new flue route, so it costs more than a straight swap. We price it at the survey.' },
  { q: 'Do I need a power flush with a new boiler?', a: 'The system has to be clean before the new boiler goes on, because boiler makers make it a warranty condition. A system clean is included in our price. If the radiators are badly sludged, cold at the bottom for example, a full power flush is the better option. Power flushing is from £350.' },
  { q: 'Can I still get a gas boiler?', a: 'Yes. You can replace a gas boiler in an existing home with a new gas boiler. The rules that limit gas boilers apply to newly built homes.' },
  { q: 'Can I fit a boiler myself?', a: 'No. By law, gas boilers must be fitted by a Gas Safe registered engineer. A badly fitted boiler can leak gas or carbon monoxide. You can check any engineer on the Gas Safe Register website.' },
  { q: 'Do you offer finance?', a: 'No, we do not offer finance. You get one fixed price, agreed in writing before any work starts.' },
  { q: 'How long does a boiler last?', a: 'Most gas boilers last 10 to 15 years. One that is serviced every year usually lasts longer. After about 10 years, parts get harder to find and breakdowns become more frequent.' },
  { q: 'Is my boiler worth repairing instead?', a: 'Often it is. If the boiler is under 10 years old and the fault is a single part, a repair is usually the better value. Our fault diagnosis is £95, and we will tell you honestly whether to repair or replace.' },
  { q: 'Are there free boiler grants in Liverpool?', a: 'Some households on certain benefits may qualify for a free boiler through the government ECO4 scheme. We do not install under ECO4. Our ECO4 guide explains who qualifies and how to apply.' },
];

const toc = [
  ['cost', 'How much does a new boiler cost?'],
  ['included', 'What is included?'],
  ['replace', 'Do you need a new boiler?'],
  ['type', 'Combi, system or regular?'],
  ['size', 'What size boiler?'],
  ['brands', 'Which brands?'],
  ['install-day', 'What happens on the day?'],
  ['older-homes', 'Older Liverpool homes'],
  ['rules', 'The rules'],
  ['reviews', 'Reviews'],
  ['faq', 'More questions'],
];

const schemaFaq = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const schemaService = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Boiler Installation Liverpool', serviceType: 'Gas boiler installation and replacement', url: URL_,
  alternateName: ['New boiler Liverpool', 'Boiler replacement Liverpool'],
  description: 'New combi, system and regular boilers fitted across Liverpool and Merseyside by Gas Safe registered engineers. Free survey, written fixed price, 10-year manufacturer warranty.',
  provider: { '@id': 'https://liverpoolemergencyplumber.co.uk/#business' },
  areaServed: [{ '@type': 'City', name: 'Liverpool' }, { '@type': 'City', name: 'Wirral' }, { '@type': 'City', name: 'St Helens' }, { '@type': 'City', name: 'Formby' }],
  offers: prices.map((p) => ({ '@type': 'Offer', name: `${p.type} installation, fully fitted`, price: p.price.replace(/[£,]/g, ''), priceCurrency: 'GBP' })),
};
const schemaPage = {
  '@context': 'https://schema.org', '@type': 'WebPage', '@id': URL_ + '#webpage', url: URL_,
  name: 'Boiler Installation Liverpool: new boiler prices, types, sizes and what to expect',
  dateModified: '2026-11-26', inLanguage: 'en-GB',
  about: { '@id': 'https://liverpoolemergencyplumber.co.uk/#business' },
};
const schemaCrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://liverpoolemergencyplumber.co.uk' },
    { '@type': 'ListItem', position: 2, name: 'Boiler Installation Liverpool', item: URL_ },
  ],
};
---

<BaseLayout
  title="Boiler Installation Liverpool | New Boiler Fitted From £1,800 | Gas Safe"
  description="New boiler installation in Liverpool from £1,800 fully fitted. Free survey, written fixed price, 10-year manufacturer warranty. Worcester Bosch, Vaillant, Ideal and Baxi. Call 0151 558 0334."
  canonical={URL_}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaService)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaFaq)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaPage)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaCrumbs)} />

  <!-- HERO -->
  <section class="page-hero" id="hero">
    <div class="container">
      <div class="page-hero-badge"><span class="badge-dot"></span>New boilers fitted across Merseyside</div>
      <h1>Boiler Installation in Liverpool</h1>
      <p class="page-hero-sub">A new combi boiler fitted from £1,800, with a free survey and a written fixed price before any work starts. Our team of Gas Safe registered engineers, led by James, fits Worcester Bosch, Vaillant, Ideal and Baxi boilers with a 10-year manufacturer warranty.</p>
      <div class="bi-stats">
        <div class="br-stat"><div class="br-stat-n">£1,800</div><div class="br-stat-l">Combi, fully fitted</div></div>
        <div class="br-stat"><div class="br-stat-n">10 yr</div><div class="br-stat-l">Boiler warranty</div></div>
      </div>
      <div class="bi-ctas">
        <a href={TEL} class="btn btn-orange btn-lg btn-full">CALL {PHONE}</a>
        <a href="/get-started" class="btn btn-lg btn-full bi-btn-navy">Book a Free Survey</a>
      </div>
      <div class="bi-ticks">
        <span class="br-tick"><span>✓</span> Gas Safe Registered</span>
        <span class="br-tick"><span>✓</span> Free Survey</span>
        <span class="br-tick"><span>✓</span> Fixed Price</span>
        <span class="br-tick"><span>✓</span> 5.0 on Google</span>
      </div>
    </div>
  </section>

  <div class="brx">

  <!-- AT A GLANCE -->
  <section class="brx-sec" id="key-facts">
    <div class="brx-wrap">
      <div class="brx-facts">
        <h2 class="brx-facts-h">A new boiler with us at a glance</h2>
        <dl>
          <div><dt>Price</dt><dd>Combi from £1,800, system from £2,200, regular from £2,500, fully fitted</dd></div>
          <div><dt>Quote</dt><dd>Free survey, then a written fixed price. No finance, no add-ons on the day.</dd></div>
          <div><dt>Time</dt><dd>A like-for-like combi swap is usually done in one day</dd></div>
          <div><dt>Warranty</dt><dd>10-year manufacturer warranty, plus our 12-month workmanship guarantee</dd></div>
          <div><dt>Brands</dt><dd>Worcester Bosch, Vaillant, Ideal and Baxi</dd></div>
          <div><dt>Covered</dt><dd>Every Liverpool postcode, the Wirral, Sefton, Knowsley and St Helens</dd></div>
        </dl>
      </div>
      <nav class="brx-toc" aria-label="On this page">
        <p class="brx-toc-h">On this page</p>
        <ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol>
      </nav>
      <p class="brx-updated">Updated {UPDATED}</p>
    </div>
  </section>

  <!-- COST -->
  <section class="brx-sec brx-tint" id="cost">
    <div class="brx-wrap">
      <h2>How much does a new boiler cost in Liverpool?</h2>
      <p class="brx-answer">With us, a new <strong>combi boiler costs from £1,800 fully fitted</strong>. System boilers are from £2,200 and regular boilers from £2,500. You get a written fixed price after a free survey, and that is the price you pay.</p>
      <div class="brx-table-wrap">
        <table class="brx-table">
          <thead><tr><th>Boiler</th><th>Best for</th><th>Fitted from</th></tr></thead>
          <tbody>
            {prices.map((p) => <tr><td><strong>{p.type}</strong></td><td>{p.fits}</td><td><strong>{p.price}</strong></td></tr>)}
          </tbody>
        </table>
      </div>
      <h3>What can change the price?</h3>
      <ul class="brx-list">
        <li><strong>Moving the boiler</strong> to another room, which needs new pipes and a new flue.</li>
        <li><strong>Changing the system</strong>, for example from a tank-fed regular boiler to a combi.</li>
        <li><strong>A bigger gas pipe.</strong> Modern boilers need enough gas, and some older homes need the pipe upgrading.</li>
        <li><strong>A longer or vertical flue</strong> through the roof instead of straight out of a wall.</li>
        <li><strong>The boiler model</strong> and its output.</li>
      </ul>
      <p>All of this is checked at the survey and included in your fixed price, so there are no surprises on the day.</p>
      <h3>How do you compare boiler quotes?</h3>
      <ul class="brx-list">
        <li><strong>Check what is included.</strong> A fair quote names the boiler model and output and says whether the flue, controls, magnetic filter, system clean and inhibitor are included. Some quotes leave these out and add them later.</li>
        <li><strong>Check the warranty</strong>: how many years, and what you have to do to keep it.</li>
        <li><strong>Check the engineer</strong> on the <a href="https://www.gassaferegister.co.uk/" target="_blank" rel="noopener">Gas Safe Register</a> before any work starts.</li>
        <li><strong>Get it in writing.</strong> A written fixed price protects you if anything changes on the day.</li>
        <li><strong>Plan ahead if you can.</strong> Replacing an old boiler before it fails means you choose the date, rather than going without heating in the middle of winter.</li>
      </ul>
      <div class="brx-cta">
        <p><strong>Want an exact price?</strong> The survey is free and there is no obligation.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>

  <!-- INCLUDED -->
  <section class="brx-sec" id="included">
    <div class="brx-wrap bi-inc">
      <div>
        <h2>What is included in the price?</h2>
        <p class="brx-answer">Everything needed for a safe, finished install. Our fitted price includes:</p>
        <ul class="bi-checks">
          {included.map(([h, t]) => <li><strong>{h}.</strong> {t}</li>)}
        </ul>
        <p class="brx-small">After the install, Gas Safe Register sends you a Building Regulations Compliance Certificate by post. Keep it with the Benchmark checklist. You will need both if you sell the house.</p>
      </div>
      <figure class="br-photo">
        <picture>
          <source type="image/webp" srcset="/images/jobs/boiler-smart-thermostat-fitted-480.webp 480w, /images/jobs/boiler-smart-thermostat-fitted-960.webp 960w" sizes="(max-width: 800px) 100vw, 300px" />
          <img src="/images/jobs/boiler-smart-thermostat-fitted-960.jpg" alt="Boiler and smart thermostat receiver fitted by our team in a Liverpool home" loading="lazy" decoding="async" width="960" height="1280" />
        </picture>
        <figcaption>A recent job: boiler controls fitted by our team.</figcaption>
      </figure>
    </div>
  </section>

  <!-- REPLACE OR REPAIR -->
  <section class="brx-sec brx-tint" id="replace">
    <div class="brx-wrap">
      <h2>Do you need a new boiler, or just a repair?</h2>
      <p class="brx-answer">Not every broken boiler needs replacing. These are the signs that a new one is the better buy:</p>
      <div class="brx-parts">
        {signs.map(([h, t]) => <div class="brx-part"><h3>{h}</h3><p>{t}</p></div>)}
      </div>
      <div class="brx-note">
        <p><strong>Not sure?</strong> Most boilers last 10 to 15 years. The age is on the data label, often inside the front cover, or on the Benchmark checklist. A common rule of thumb: if one repair would cost more than half the price of a new boiler, replace it. If the boiler is under 10 years old and one part has failed, a repair is usually better value. Book a <a href="/boiler-repair-liverpool">boiler repair</a> visit (fault diagnosis £95) and we will tell you honestly which makes sense.</p>
      </div>
    </div>
  </section>

  <!-- TYPES -->
  <section class="brx-sec" id="type">
    <div class="brx-wrap">
      <h2>Which boiler do you need: combi, system or regular?</h2>
      <p class="brx-answer">It depends on how many bathrooms you have, your water pressure and the system you already have.</p>
      <div class="brx-types">
        <div><h3>Combi</h3><p>Heats water straight from the mains when you turn a tap on. No cylinder or loft tanks. Best for most homes with one bathroom. <strong>From £1,800.</strong></p></div>
        <div><h3>System</h3><p>Stores hot water in a cylinder, with no tank in the loft. Good for homes with two or more bathrooms in use at once. <strong>From £2,200.</strong></p></div>
        <div><h3>Regular</h3><p>Also called conventional or heat-only. Uses a cylinder and a cold water tank in the loft. Often the simplest swap in older homes. <strong>From £2,500.</strong></p></div>
      </div>
      <p style="margin-top:1rem;">A combi needs good mains water pressure and flow. We measure both at the survey before recommending one.</p>
    </div>
  </section>

  <!-- SIZE -->
  <section class="brx-sec brx-tint" id="size">
    <div class="brx-wrap">
      <h2>What size boiler do you need?</h2>
      <p class="brx-answer">Boiler size is its output in kilowatts (kW). For a combi, size depends mostly on how much hot water you need at once, not the number of radiators.</p>
      <div class="brx-table-wrap">
        <table class="brx-table bi-size">
          <thead><tr><th>Your home</th><th>Usual size</th></tr></thead>
          <tbody>{sizes.map(([h, s]) => <tr><td>{h}</td><td><strong>{s}</strong></td></tr>)}</tbody>
        </table>
      </div>
      <p>These are a guide. Too small and the shower runs lukewarm. Too big and the boiler wastes gas switching on and off. We work out the right size at the survey.</p>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="brx-sec" id="brands">
    <div class="brx-wrap">
      <h2>Which boiler brands do you fit?</h2>
      <p class="brx-answer">We fit four of the most popular UK brands. Every boiler we fit is A-rated and comes with a 10-year manufacturer warranty.</p>
      <div class="brx-parts">
        {brands.map(([h, t]) => <div class="brx-part"><h3>{h}</h3><p>{t}</p></div>)}
      </div>
      <h3 style="margin-top:1.5rem;">What keeps the 10-year warranty valid?</h3>
      <p>Two things. The boiler must be registered with the manufacturer, which we do for you on install day. And it must be serviced every year by a Gas Safe registered engineer. Miss a service and the maker can refuse a claim. Our <a href="/boiler-service-liverpool">annual boiler service</a> is £120 and updates your Benchmark record.</p>
      <h3>Is a big-name brand worth paying more for?</h3>
      <p>For most homeowners planning to stay 10 years or more, yes. You get a longer warranty, and parts stay easy to get as the boiler ages, so repairs are quicker. All four brands we fit are well supported in Liverpool. Lesser-known brands can be cheaper to buy, but parts can be harder to find later. We will talk you through the options at the survey.</p>
    </div>
  </section>

  <!-- INSTALL DAY -->
  <section class="brx-sec brx-tint" id="install-day">
    <div class="brx-wrap">
      <h2>What happens when you book a new boiler?</h2>
      <ol class="bi-steps">
        {steps.map(([h, t]) => <li><h3>{h}</h3><p>{t}</p></li>)}
      </ol>
      <div class="brx-cta">
        <p><strong>Book your free survey.</strong> Ring us or book online and we will arrange a time.</p>
        <a href={TEL} class="brx-btn">Call {PHONE}</a>
      </div>
    </div>
  </section>

  <!-- OLDER HOMES -->
  <section class="brx-sec" id="older-homes">
    <div class="brx-wrap">
      <h2>What if you live in an older Liverpool house?</h2>
      <p class="brx-answer">Many Liverpool homes are Victorian, Edwardian or 1930s, and their heating has often been changed several times. That is fine, but it needs checking first.</p>
      <ul class="brx-list">
        <li><strong>Back boilers</strong> behind a gas fire are still found in older terraces. They are taken out and replaced with a wall-mounted boiler, and the fireplace is made good or capped.</li>
        <li><strong>Gravity-fed systems</strong> with tanks in the loft can be kept with a new regular boiler, or converted to a combi or system boiler if the water pressure allows.</li>
        <li><strong>Old pipework and radiators</strong> often hold years of sludge. They are cleaned before the new boiler goes on, or <a href="/power-flushing-liverpool">power flushed</a> if they are badly blocked.</li>
        <li><strong>Condensate pipes</strong> that run outside can freeze in a cold snap and stop the boiler. We route and insulate them to reduce the risk.</li>
      </ul>
    </div>
  </section>

  <!-- RULES -->
  <section class="brx-sec brx-tint" id="rules">
    <div class="brx-wrap">
      <h2>What are the rules for fitting a new boiler?</h2>
      <div class="brx-two">
        <div>
          <h3>Gas Safe registration</h3>
          <p>By law, gas boilers must be fitted by a Gas Safe registered engineer. You can check any engineer on the <a href="https://www.gassaferegister.co.uk/" target="_blank" rel="noopener">Gas Safe Register</a> website.</p>
        </div>
        <div>
          <h3>Controls</h3>
          <p>New boilers in England must be fitted with time and temperature controls. Combi boilers also need an extra energy-saving feature, such as a smart thermostat with automation and optimisation. That is included in our price.</p>
        </div>
        <div>
          <h3>Notifying Building Control</h3>
          <p>A new boiler has to be notified to Building Control. We do that through Gas Safe Register, and you get the certificate by post.</p>
        </div>
        <div>
          <h3>Gas boilers are still allowed</h3>
          <p>You can replace a gas boiler in an existing home with a new gas boiler. The rules that limit gas boilers apply to newly built homes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="brx-sec" id="reviews">
    <div class="brx-wrap">
      <h2>What do customers say about James and the team?</h2>
      <p class="brx-rating"><strong>5.0</strong> <span aria-hidden="true">★★★★★</span> from 53 Google reviews</p>
      <div class="brx-reviews">
        {reviews.map((r) => (
          <figure class="brx-review"><blockquote>“{r.t}”</blockquote><figcaption>{r.n} · Google review</figcaption></figure>
        ))}
      </div>
      <p><a class="brx-link" href="https://www.google.com/search?q=Liverpool+Emergency+Plumber+reviews" target="_blank" rel="noopener">See all reviews on Google →</a></p>
    </div>
  </section>

  <!-- AREAS -->
  <section class="brx-sec brx-tint" id="areas">
    <div class="brx-wrap">
      <h2>Do you fit boilers in my area?</h2>
      <p>Yes. We cover every Liverpool postcode from L1 to L40, plus the Wirral, Sefton, Knowsley and St Helens.</p>
      <ul class="brx-jump">
        <li><a href="/boiler-installation-wirral">Wirral</a></li>
        <li><a href="/boiler-installation-formby">Formby</a></li>
        <li><a href="/boiler-installation-st-helens">St Helens</a></li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="brx-sec" id="faq">
