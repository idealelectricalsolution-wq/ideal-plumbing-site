---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/plumber-prices-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'weekday', tier: 'Weekdays 9am to 4pm', popular: true, name: 'First hour, weekdays', price: '£120', unit: 'first hour, inc VAT',
    points: ['No call-out fee', 'Includes finding the fault', 'Most small repairs done inside the hour'] },
  { id: 'evening', tier: 'Evenings, nights, weekends', name: 'First hour, out of hours', price: '£150', unit: 'first hour, inc VAT',
    points: ['Weekdays after 4pm and before 9am', 'All day Saturday and Sunday', 'No call-out fee'] },
  { id: 'bank-holiday', tier: 'Bank holidays', name: 'First hour, bank holidays', price: '£180', unit: 'first hour, inc VAT',
    points: ['Every bank holiday, day or night', 'No call-out fee', 'A real person answers'] },
];

const faqs = [
  { q: 'How much does a plumber cost per hour in Liverpool?', a: 'With us, the first hour is £120 on weekdays from 9am to 4pm, £150 in the evenings, at night and at weekends, and £180 on bank holidays. All prices include VAT. If a job needs more time, we tell you the price before we carry on.' },
  { q: 'How much does an emergency plumber cost in Liverpool?', a: 'The same rates. There is no extra emergency charge and no call-out fee. You pay £120 for the first hour on weekdays, £150 out of hours and £180 on bank holidays. Parts are priced before we fit them.' },
  { q: 'Do you charge a call-out fee?', a: 'No. There is no call-out fee on any job, day or night. You only pay for the work.' },
  { q: 'Are your prices including VAT?', a: 'Yes. Every price on this page includes VAT. The price you see is the price you pay.' },
  { q: 'Is a cheap plumber worth it?', a: 'Look at the full price, not the hourly rate. A low hourly rate can come with a call-out fee, a high charge for parts or extra time. We publish our prices, charge no call-out fee and tell you the price before any extra work.' },
  { q: 'Do you charge more at weekends?', a: 'Yes, a little. The first hour is £150 at weekends and in the evenings, against £120 on weekdays from 9am to 4pm. Bank holidays are £180.' },
  { q: 'Do you charge for travel or parking?', a: 'No. There is no call-out fee and no travel charge anywhere we cover.' },
  { q: 'Do you give free quotes?', a: 'Yes, for fitting work such as new boilers, bathrooms and central heating. We visit, look at the job and give you a fixed price in writing. Repairs are charged by time, because the fault is not known until we find it.' },
  { q: 'How much does a boiler repair cost?', a: 'Boiler repairs use the same hourly rates. The first hour is £120 on weekdays and includes finding the fault. If a part is needed, we tell you the price first.' },
  { q: 'How much is a new boiler in Liverpool?', a: 'Our combi boiler packages run from £2,195 for a Baxi 600 to £3,295 for a Worcester Bosch Greenstar 8000+ Style, fully fitted, including VAT.' },
  { q: 'Do you unblock drains?', a: 'No. We do not do blocked drains. Drain specialists do that job.' },
  { q: 'Do you guarantee your work?', a: 'Yes. Every job has our 12-month workmanship guarantee. We also carry £2 million public liability insurance.' },
];
