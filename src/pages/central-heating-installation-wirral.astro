const packages = [
  { id: 'two-bed', tier: 'Flats and small homes', name: '2-bed home', price: '£4,495', from: true, unit: 'full system, inc VAT',
    points: ['New A-rated combi boiler', 'New radiators with TRVs', 'All new pipework', 'Smart or programmable controls', 'Magnetic filter and inhibitor'] },
  { id: 'three-bed', tier: 'Family homes', popular: true, name: '3-bed home', price: '£5,295', from: true, unit: 'full system, inc VAT',
    points: ['New A-rated boiler, combi or system', 'New radiators with TRVs', 'All new pipework', 'Smart or programmable controls', 'System cleaned to BS 7593', 'Old system taken away'] },
  { id: 'four-bed', tier: 'Bigger homes', name: '4-bed home', price: '£6,295', from: true, unit: 'full system, inc VAT',
    points: ['Boiler sized for a bigger home', 'New radiators with TRVs', 'Zone controls where needed', 'All new pipework', 'Benchmark and gas safety checks'] },
  { id: 'combi-conversion', tier: 'Tank to combi', name: 'Combi conversion', price: '£2,890', from: true, unit: 'fitted, inc VAT',
    points: ['Cylinder system changed to a combi', 'Hot water cylinder and loft tanks removed', 'Keeps your radiators if they are sound', 'Usually 1 to 2 days'] },
];

const faqs = [
  { q: 'How much does central heating installation cost on the Wirral?', a: 'A full new system starts from £4,495 for a 2-bed home, £5,295 for a 3-bed and £6,295 for a 4-bed, including VAT. A combi conversion starts from £2,890. We give you a fixed written price after a free survey.' },
  { q: 'Do you cover all CH postcodes?', a: 'Yes. We fit central heating across the whole Wirral, from Birkenhead CH41 and Wallasey CH44 to Hoylake CH47, West Kirby CH48, Heswall CH60 and Neston CH64. The survey is free wherever you are.' },
  { q: 'Will a combi work in my Birkenhead or Wallasey terrace?', a: 'Often, yes, but only if the mains water pressure is good enough. Some older terraces in Birkenhead and Wallasey have low pressure. We test it at every survey before we recommend a boiler. If it is low, a system boiler with a cylinder may be better.' },
  { q: 'What system suits a big house in Heswall or Neston?', a: 'Larger homes with two or more bathrooms usually suit a system boiler with an unvented cylinder. Upstairs and downstairs can run as separate zones. All our engineers are G3 qualified for unvented cylinders.' },
  { q: 'Can you fit central heating in a West Kirby or Hoylake period house?', a: 'Yes. Many period houses there have no full system, or only heat some rooms. Solid walls and tight floor spaces affect where pipes can go. We plan every route at the survey to protect original features.' },
  { q: 'Do I need a whole new system or just a new boiler?', a: 'Many post-war homes in Prenton, Moreton and Upton have sound radiators and pipes. A new boiler from £2,195, plus a power flush or an extra radiator, can be enough. We tell you honestly at the survey.' },
  { q: 'How long does it take?', a: 'A full system usually takes 3 to 5 days. A large south Wirral home with zones and a cylinder can take 5 to 7 days. A combi conversion takes 1 to 2 days. Solid-wall terraces with no floor space can add a day or two.' },
  { q: 'What warranty do I get?', a: 'The boiler comes with a maker\'s warranty of 7 to 12 years, depending on the model. We register it for you. Our own work has a 12-month workmanship guarantee.' },
  { q: 'Do you offer finance?', a: 'No, we do not offer finance. You get a fixed written price, so you know the full cost before we start.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. All gas work is done by our Gas Safe registered engineers. You can check any engineer on the Gas Safe Register before they start.' },
];
---

