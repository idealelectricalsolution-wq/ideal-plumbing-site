const PHONE = '0151 558 0334';

const packages = [
  { id: 'electric', tier: 'Electric shower', name: 'Electric shower replaced', price: '£375', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['New electric shower unit', 'Fitted on your existing circuit', 'Old shower taken away', 'Usually done in 2 to 4 hours'] },
  { id: 'bar-mixer', tier: 'Mixer shower', popular: true, name: 'Thermostatic bar mixer shower', price: '£395', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Holds the heat when a tap runs', 'Anti-scald protection', 'Riser rail, hose and head', 'Suits combi and unvented systems'] },
  { id: 'concealed', tier: 'Neat finish', name: 'Concealed thermostatic shower', price: '£695', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Valve and pipes hidden in the wall', 'Fixed head, rail or both', 'Clean, modern look', 'Walls made good after'] },
  { id: 'power', tier: 'Low pressure fix', name: 'Power shower', price: '£650', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Built-in pump boosts the flow', 'For gravity systems with a hot water tank', 'Not for combi boilers', 'Old shower taken away'] },
];

const faqs = [
  { q: 'How much does shower installation cost in Liverpool?', a: 'With us, an electric shower supplied and fitted is from £375. A thermostatic bar mixer is from £395. A power shower is from £650 and a concealed thermostatic shower is from £695. A digital shower is from £850. If you have bought your own shower, fitting is from £195. All prices include VAT.' },
  { q: 'How long does it take to fit a new shower?', a: 'Swapping an electric shower for a new one takes 2 to 4 hours. A bar mixer is often done in half a day. Concealed showers take longer, because the pipes go into the wall. A bath to shower conversion takes 2 to 3 days.' },
  { q: 'Will you fit a shower I have bought?', a: 'Yes. Fitting your own shower is from £195. Before you buy, tell us what boiler or hot water tank you have. We will check the shower will work with it.' },
  { q: 'Do you take the old shower away?', a: 'Yes. We remove the old shower and take it with us. It is included in the price.' },
  { q: 'What shower is best with a combi boiler?', a: 'A thermostatic mixer, concealed or bar style, is the usual choice. A combi gives mains pressure hot water, so a mixer works well. An electric shower also works. Do not fit a power shower to a combi.' },
  { q: 'Can I have a power shower with a combi boiler?', a: 'No. A power shower has a pump inside. It must only be fed from a cold water tank and a hot water cylinder, known as a gravity system. Pumping straight from the mains is not allowed under the water rules.' },
  { q: 'Do I need an electrician for an electric shower?', a: 'For a like-for-like swap on a suitable circuit, no. We do that. If you need a new circuit, or a bigger shower than the cable can take, an electrician must do it. Our partner firm Ideal Electrical Solutions does this, and we book the work together.' },
  { q: 'What size electric shower do I need?', a: 'Most electric showers are 7.5kW to 10.8kW. A higher number gives a stronger flow in winter. But the cable and fuse must suit the shower. We check your circuit first. If it needs an upgrade, our partner electricians quote for it.' },
  { q: 'Why is my shower pressure so low?', a: 'The most common cause is limescale in the shower head. Other causes are a gravity system with a low tank, a failing pump or a kinked hose. If every tap is weak, the problem is the water supply, not the shower. We find the cause before we suggest anything.' },
  { q: 'Do you repair showers?', a: 'Yes. Shower repairs are charged by time. The first hour is £120 on weekdays from 9am to 4pm, £150 in the evenings, at night and at weekends, and £180 on bank holidays. There is no call-out fee. If a new shower is the better buy, we will say so. See our shower repair page for common faults and checks.' },
  { q: 'What shower brands do you fit?', a: 'We fit all the main brands, including Mira, Triton, Aqualisa, Bristan, Grohe, Hansgrohe, Vado and Crosswater. We can supply one for you, or fit one you have bought.' },
  { q: 'Can you replace my bath with a shower?', a: 'Yes. A bath to shower conversion is from £2,395 including VAT. It takes 2 to 3 days. See our bathroom fitters page for what is included.' },
  { q: 'Is the work guaranteed?', a: 'Yes. Our work comes with a 12-month workmanship guarantee. The shower itself also has the maker\'s own warranty. We hold £2 million public liability insurance.' },
];
