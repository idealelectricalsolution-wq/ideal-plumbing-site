const URL_ = 'https://liverpoolemergencyplumber.co.uk/gas-safety-certificate-wirral';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'cp12', tier: 'Landlord certificate', name: 'CP12 Wirral', price: '£100', unit: 'up to 2 appliances, inc VAT',
    points: ['Each extra appliance after two: £20', 'Certificate emailed the same day', 'Free reminder next year'] },
  { id: 'combined', tier: 'Best value', popular: true, name: 'CP12 + boiler service', price: '£199', unit: 'one visit, inc VAT',
    points: ['Save £21 on booking them apart', 'Keeps the boiler warranty valid', 'Both records emailed the same day'] },
  { id: 'portfolio', tier: 'Landlords and agents', name: '3 or more properties', price: '£80', unit: 'per certificate, inc VAT',
    points: ['Save £20 on every certificate', 'We arrange access with tenants', 'Renewal dates tracked for you'] },
];

const faqs = [
  { q: 'Is a gas safe certificate the same as a gas safety certificate?', a: 'Yes. People call it a gas safe certificate, a landlord gas safety record or a CP12. They all mean the same yearly check, done by a Gas Safe registered engineer. In the Wirral ours costs £100 for up to two appliances.' },
  { q: 'How much is a CP12 on the Wirral?', a: 'A CP12 on the Wirral is £100 including VAT for up to two gas appliances, usually the boiler and hob. A third appliance, such as a gas oven, is £20 more. A CP12 and a boiler service together are £199. With 3 or more properties, each certificate is £80.' },
  { q: 'Do you cover all CH postcodes?', a: 'Yes. We cover the whole Wirral, from Birkenhead CH41 and Wallasey CH44 to Heswall CH60, Bebington CH63 and Neston CH64. The price is the same in every CH postcode, with no call-out fee.' },
  { q: 'Does the CP12 need to cover the gas fire?', a: 'If you supply the gas fire, yes. Every gas appliance you provide must be on the record. We do not check gas fires. We can disconnect and cap it safely, or it must be checked by an engineer registered for gas fires.' },
  { q: 'I live away from the Wirral. Do I need to be there?', a: 'No. Many of our Wirral landlords live elsewhere. We arrange a time with your tenant or agent, do the check, and email the certificate to you the same day.' },
  { q: 'Does the CP12 work for a Wirral Council HMO licence?', a: 'Yes. An HMO licence needs a valid gas safety certificate, renewed every year. We check every boiler, gas cooker and hob in one visit and list each one on the certificate.' },
  { q: 'How long does the check take?', a: 'Most homes take under an hour. A flat with a combi boiler and a gas hob is often done in 30 to 45 minutes.' },
  { q: 'Can I renew early without losing months?', a: 'Yes. If the check is done up to 2 months before the old certificate runs out, the new one keeps the old expiry date.' },
  { q: 'What if something fails?', a: 'We explain the fault and give you a fixed price to put it right before we do any work. Often we can fix it on the same visit. Once it is safe, we issue the certificate.' },
  { q: 'Can I get a CP12 on the Wirral today?', a: 'Often, yes, when we have a free slot. Call 0151 558 0334 to check. The certificate is emailed the same day.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Every check is done by our Gas Safe registered engineers. You or your tenant can ask to see the Gas Safe ID card on the day.' },
];
---

