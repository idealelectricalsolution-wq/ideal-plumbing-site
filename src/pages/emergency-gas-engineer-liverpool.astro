---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/emergency-gas-engineer-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

// Scope (owner, Nov 2026): Gas Safe registered for boilers and gas cookers/hobs, and regularly
// disconnects and caps gas fires. Comes out 24/7 after a leak is made safe, but often cheaper/better to wait until next day (parts).
// Do NOT claim gas fire servicing, meters or other appliances. No fixed parts price list. Prices match the rest of the site.
const packages = [
  { id: 'weekday', tier: 'Weekdays', name: 'Monday to Friday, 9am to 4pm', price: '£120', unit: 'first hour, inc VAT',
    points: ['No call-out fee', 'Finding the fault is included', 'Cheapest time for most jobs'] },
  { id: 'evening', tier: 'Out of hours', popular: true, name: 'Evenings, nights and weekends', price: '£150', unit: 'first hour, inc VAT',
    points: ['No call-out fee', '24 hours, including Sundays', 'Typically with you within 30 minutes'] },
  { id: 'bank', tier: 'Bank holidays', name: 'Bank holidays', price: '£180', unit: 'first hour, inc VAT',
    points: ['No call-out fee', 'Christmas Day and Boxing Day included', 'Same price day or night'] },
];

const faqs = [
  { q: 'I can smell gas. Who do I call first?', a: 'Call the National Gas Emergency Service on 0800 111 999 first. It is free and open 24 hours. They will make the leak safe, which often means capping the supply. Once that is done, ring us on 0151 558 0334 to find the fault, repair it and get your gas back on.' },
  { q: 'How much does an emergency gas engineer cost in Liverpool?', a: 'There is no call-out fee. It is £120 for the first hour on weekdays 9am to 4pm, £150 on evenings, nights and weekends, and £180 on bank holidays. Any extra time is priced before we carry on. You agree the price of any parts before they are fitted.' },
  { q: 'Is there a call-out fee?', a: 'No. You only pay for the time we spend, starting with the first hour. Finding the fault is part of that hour.' },
  { q: 'How fast can you get here?', a: 'We come out the same day, 24 hours a day. We are typically with you within 30 minutes. Call 0151 558 0334 and we will give you a time.' },
  { q: 'My gas has been capped. Can you reconnect it?', a: 'Yes. When the gas has been capped because of a leak or an unsafe appliance, we find the cause, repair it, test the installation for leaks and turn the gas back on once it is safe. We can only reconnect when the fault has been put right.' },
  { q: 'Should I get it fixed tonight or wait until the morning?', a: 'We can come out 24/7. But once the gas has been capped and the house is safe, it is often cheaper and better to wait until the next day. The first hour on a weekday is £120 instead of £150 at night, and parts suppliers are open, so the right part can be fitted first time. When you ring, we will tell you honestly which makes more sense.' },
  { q: 'My gas meter is faulty. Can you fix it?', a: 'No. The gas meter belongs to your energy supplier, so a fault with the meter is for them. A leak at the meter or on the pipe into the house is for the National Gas Emergency Service on 0800 111 999. We look after the pipework after the meter and the appliances.' },
  { q: 'I have no gas at all. Is it a leak?', a: 'Not always. Check the yellow lever by the meter is on, in line with the pipe. If you have a prepayment meter, check it has credit. If neighbours have no gas either, it is likely a supply fault, so call 0800 111 999. If only one appliance has no gas, call us.' },
  { q: 'My carbon monoxide alarm has gone off. What should I do?', a: 'Turn off your gas appliances if you can, open doors and windows, get everyone outside into fresh air and call the National Gas Emergency Service on 0800 111 999. If anyone has a headache, dizziness or sickness, get medical help. Once it is safe, we can check the boiler, cooker or hob for the cause.' },
  { q: 'Which gas appliances do you work on?', a: 'Gas boilers, gas cookers and gas hobs, and the gas pipework that supplies them. We do not service or repair gas fires, but we disconnect and safely cap them, for example when an old back boiler and fire are taken out.' },
  { q: 'Can you fit or disconnect a gas cooker or hob?', a: 'Yes. We connect new gas cookers and hobs, disconnect old ones and test them for safety. Fitting a gas cooker or hob must be done by a Gas Safe registered engineer.' },
  { q: 'I am a landlord and my tenant smells gas. What do I do?', a: 'Tell your tenant to call 0800 111 999 straight away. Once it is made safe, call us. We can deal with your tenant directly, repair the fault and send you the paperwork. An appliance marked unsafe must not be used until it is fixed.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. All gas work is done by our Gas Safe registered engineers. Anyone working on gas must be on the Gas Safe Register by law. You can check an engineer on the register before they start.' },
];
---

<ServiceGuide
  url={URL_}
  title="Emergency Gas Engineer Liverpool | 24/7 From £120 | No Call-Out Fee"
  description="Emergency gas engineer in Liverpool, 24/7. Gas Safe registered. Gas leaks repaired and gas reconnected, boilers, cookers and hobs. No call-out fee, from £120 for the first hour inc VAT. Call 0151 558 0334."
  h1="Emergency Gas Engineer Liverpool"
  badge="Gas Safe registered · 24/7"
  intro="Smell gas? Leave the house and call the National Gas Emergency number 0800 111 999 first. Once it is made safe, call us. Our Gas Safe registered engineers come out 24/7 to find the fault, repair it and get your gas back on. No call-out fee."
