const packages = [
  { id: 'new-radiator', tier: 'Supply and fit', name: 'New radiator supplied and fitted', price: '£245', from: true, unit: 'inc VAT',
    points: ['Standard double panel radiator with a new TRV', 'Sized for the room first', 'Old radiator taken away'] },
  { id: 'five-radiators', tier: 'Whole house', popular: true, name: 'Five radiators supplied and fitted', price: '£1,195', from: true, unit: 'inc VAT',
    points: ['Five new double panel radiators', 'Usually done in one day', 'Inhibitor topped up, system balanced'] },
  { id: 'pk-column', tier: 'Period rooms', name: 'Column or designer radiator, fit only', price: '£250', from: true, unit: 'inc VAT',
    points: ['Column, vertical or designer styles', 'Heat output checked before you buy', 'Pipes kept out of sight where we can'] },
  { id: 'new-position', tier: 'Extensions', name: 'New radiator in a new position', price: '£325', from: true, unit: 'inc VAT',
    points: ['New pipes from the nearest circuit', 'Right heating zone checked', 'About 2 to 4 hours'] },
];

const faqs = [
  { q: 'How much does a new radiator cost in Formby?', a: 'A standard double panel radiator supplied and fitted is from £245 including VAT. Five radiators are from £1,195. Column and designer radiators are from £250 to fit. Fitting one you bought is from £95.' },
  { q: 'Do you cover all of Formby?', a: 'Yes. We cover all of L37, including Formby Village and Freshfield. We also cover Hightown, Ainsdale, Crosby and Maghull. The price is the same everywhere, with no call-out fee.' },
  { q: 'My Formby sitting room has always been cold. Is the radiator too small?', a: 'Very often, yes. Large rooms with high ceilings and bay windows need a lot of heat. Many have a radiator sized for an average room. We work out the heat the room needs and tell you if yours falls short.' },
  { q: 'Can you fit column radiators in a Freshfield period house?', a: 'Yes. Column radiators suit high ceilings and bay windows. We size the height and number of columns for the heat the room needs, not just the look. Styles up to 1800mm tall are available.' },
  { q: 'Can you add a radiator to my kitchen extension?', a: 'Yes. We check the pipe route and that the boiler can cope. If your home has separate heating zones, we connect the radiator to the right zone. A new radiator in a new position is from £325.' },
  { q: 'Is the quote visit free?', a: 'Yes. We do not charge to visit and price the job. You get a fixed written price before any work starts.' },
  { q: 'How long does it take to fit a radiator?', a: 'A straight swap takes 1 to 2 hours. A new radiator with new pipes takes 2 to 4 hours. Five radiators are usually done in one day.' },
  { q: 'How much is a radiator repair?', a: 'Repairs are charged by time. The first hour is £120 on weekdays 9am to 4pm, £150 evenings, nights and weekends, and £180 on bank holidays. There is no call-out fee.' },
  { q: 'Why is my radiator cold at the bottom?', a: 'Usually sludge has settled in it. Bleeding will not fix it. If several radiators are cold at the bottom, the system needs a power flush before new radiators go on.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Radiator work on the heating circuit is done by our Gas Safe registered engineers. You can check any engineer on the Gas Safe Register.' },
];
---

