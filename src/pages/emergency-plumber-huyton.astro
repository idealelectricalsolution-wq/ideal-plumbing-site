      { "@type": "Question", "name": "Are you a local Knowsley plumber?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We're at 29 Park Road, Kirkby, L32 2AL. Same Knowsley Council as Huyton. The other plumbers ranking for emergency plumber Huyton are based in Liverpool, Lancashire or run national call centres. We're the local Knowsley team." } },
      { "@type": "Question", "name": "Do you work on the old council-built semis?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The 1950s and 1960s council-built semis are the bulk of Huyton stock. Most have been bought through right-to-buy and upgraded over decades. We know the typical pipe layouts. We carry common parts on the van." } },
      { "@type": "Question", "name": "My boiler is over 20 years old. Should I repair or replace?", "acceptedAnswer": { "@type": "Answer", "text": "A boiler over 20 years old with regular faults is almost always cheaper to replace than to repair. Parts get hard to find. Old boilers run at 70 to 75% efficiency. A modern combi runs at 92 to 94%. A new boiler from £1,800 pays for itself in lower gas bills inside 7 to 10 years." } },
      { "@type": "Question", "name": "Do you cover Stockbridge Village and Page Moss?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Stockbridge Village, Page Moss, Court Hey, Bakers Green, Roby and the rest of L36 are all covered at the same fixed rates. Same 15 minute response from Kirkby." } },
