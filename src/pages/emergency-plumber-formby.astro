  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Are you genuinely available 24 hours in Formby including nights?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We are genuinely available 24 hours a day, 7 days a week in Formby, including late nights, bank holidays and Christmas Day. A real person answers within 3 rings at any hour. We do not stop at 8pm. We do not use voicemail or an out-of-hours answering service." } },
