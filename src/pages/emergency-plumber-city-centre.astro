    "areaServed": [
      { "@type": "Place", "name": "Liverpool City Centre, L1" },
      { "@type": "Place", "name": "Liverpool L2" },
      { "@type": "Place", "name": "Liverpool L3" },
      { "@type": "Place", "name": "Ropewalks" },
      { "@type": "Place", "name": "Baltic Triangle" },
      { "@type": "Place", "name": "Knowledge Quarter" },
      { "@type": "Place", "name": "Georgian Quarter" },
      { "@type": "Place", "name": "Waterfront" },
      { "@type": "Place", "name": "Commercial District" }
    ],
    "hoursAvailable": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "00:00", "closes": "23:59" },
    "offers": [
      { "@type": "Offer", "name": "Weekday Emergency Plumber Liverpool City Centre", "price": "80", "priceCurrency": "GBP", "description": "Monday to Friday 9am to 5pm. 1 hour minimum charge." },
      { "@type": "Offer", "name": "Weekend Emergency Plumber Liverpool City Centre", "price": "120", "priceCurrency": "GBP", "description": "Saturday and Sunday 9am to 1pm. 1 hour minimum charge." },
      { "@type": "Offer", "name": "Out of Hours Emergency Plumber Liverpool City Centre", "price": "150", "priceCurrency": "GBP", "description": "Nights, bank holidays and out of hours. 24/7 availability." }
    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does an emergency plumber cost in Liverpool city centre?", "acceptedAnswer": { "@type": "Answer", "text": "£80 an hour weekdays 9am to 5pm. £120 an hour weekends 9am to 1pm. £150 an hour out of hours, nights and bank holidays. 1 hour minimum on every call-out. Parts at cost. Most jobs cost £80 to £350. Same fixed rates for residential and commercial. Written quote before work starts. No separate call-out fee." } },
      { "@type": "Question", "name": "How quickly can you reach Liverpool city centre?", "acceptedAnswer": { "@type": "Answer", "text": "We guarantee a 30 minute response across L1, L2 and L3. Out of hours, when traffic clears, typical arrival is 20 to 25 minutes from our Kirkby base. A real person answers the phone 24 hours a day, every day of the year." } },
      { "@type": "Question", "name": "Do you cover commercial premises in Liverpool city centre?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Bars, restaurants, hotels, offices, salons, gyms, shops. Same fixed rates as residential. £80 weekdays, £120 weekends, £150 out of hours. No commercial premium. No separate call-out fee. We work with kitchen managers, hotel duty managers and bar owners to fix faults fast so trading can carry on." } },
      { "@type": "Question", "name": "Do you cover Airbnb and short-let properties?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We work with Airbnb hosts and short-let managers across the city centre. We handle emergencies between guest changeovers and provide written reports for host insurance claims. Same fixed rates. We can usually attend within the 30-minute window even on a turnover day." } },
      { "@type": "Question", "name": "Do you handle student accommodation in Liverpool city centre?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We cover student blocks across L1 and L3 including Mount Pleasant, Marybone, Bold Street and Renshaw Street. We carry out CP12 gas safety certificates ahead of each academic year in July and August. Multi-room HMOs and shared student houses are familiar work for us." } },
      { "@type": "Question", "name": "Can you coordinate with building management?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Most city centre apartment blocks have a concierge or managing agent. We're used to liaising with building management to access communal risers, isolate floor-level water supplies and turn off booster pumps when needed. Bring us the management contact number if you have it. If you don't, we'll find it." } },
      { "@type": "Question", "name": "Are you Gas Safe registered?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All gas work is carried out by our Gas Safe registered engineers. Verify us at gassaferegister.co.uk. We provide CP12 certificates for residential, HMO and commercial gas work." } },
      { "@type": "Question", "name": "Do you guarantee your work?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every job carries a 12-month workmanship guarantee. If something we fixed fails because of our work, we come back. No charge." } }
    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
