---
import BaseLayout from '../layouts/BaseLayout.astro';

const URL_ = 'https://liverpoolemergencyplumber.co.uk/leak-detection-liverpool';

// Method (owner, Nov 2026): James finds leaks by checking pipework and lifting floorboards, tracing by eye.
// Owner confirmed: pressure testing, cutting into ceilings below laminate/tiled floors, insurance leak reports. No thermal/acoustic kit claimed.
// Prices match the rest of the site: first hour £120 weekdays 9am-4pm, £150 evenings/nights/weekends, £180 bank holidays, no call-out fee.
const faqs = [
  { tag: 'COST', q: 'How much does it cost to find a leak in Liverpool?', a: 'There is no call-out fee. It is £120 for the first hour on weekdays 9am to 4pm, £150 on weekday evenings, nights and weekends, and £180 on bank holidays. Any extra time is priced before we carry on. Most leaks are found and fixed on the same visit. If a part or more work is needed, you get the price first.' },
  { tag: 'METHOD', q: 'How do you find a hidden leak?', a: 'The practical way. Our engineers check the pipework, joints, valves and appliances you can see first, as most leaks start there. He can pressure test the pipework to confirm whether a section is leaking. Then he lifts floorboards along the pipe run and follows the water back to the source. Where the floor above is laminate or a tiled bathroom, it is often cheaper to cut a small opening in the ceiling below instead. He agrees with you what needs opening up before he starts.' },
  { tag: 'INSURANCE', q: 'Do you provide leak reports for insurance claims?', a: 'Yes. We can write a leak report for your insurer, covering what caused the leak, where it was and what was repaired, so you have the evidence for your claim.' },
  { tag: 'CEILING', q: 'Water is coming through my ceiling. What do I do?', a: 'Turn the water off at the stopcock, usually under the kitchen sink. If water is near a light fitting, do not use that light and switch it off at the fuse box if you can do so safely. Put a bucket under the drip, then ring us on 0151 558 0334. Most ceiling leaks come from a bath, shower, toilet or pipe joint in the room above.' },
  { tag: 'METER', q: 'How can I tell if I have a hidden leak?', a: 'Turn off every tap and appliance that uses water, then look at your water meter. If the numbers are still moving, water is escaping somewhere. Other signs are a damp patch that keeps growing, a musty smell, boiler pressure that keeps dropping, or a water bill that has gone up for no reason.' },
  { tag: 'FLOORS', q: 'Can you find a leak under a concrete floor?', a: 'Leaks under solid concrete floors or deep inside walls are harder to reach than leaks under floorboards. We will look at the pipe runs and tell you honestly what we can find and what it would take. Where a leak needs specialist detection equipment, we will tell you so before you spend money.' },
  { tag: 'AWAY', q: 'I am not at the property. Can you still help?', a: 'Yes. Landlords and owners often are not there when a leak starts. We can arrange access, and we can send you photos of what caused the leak and the repair, as several of our Google reviews mention.' },
  { tag: 'EMERGENCY', q: 'Do you come out at night and at weekends?', a: 'Yes. We answer 24 hours a day, 7 days a week, including bank holidays. Reviews mention James arriving within 20 to 30 minutes for leaks, including on Sundays.' },
];

const signs = [
  { t: 'Water through the ceiling', d: 'Usually a bath, shower, toilet or pipe joint in the room above. Turn the water off at the stopcock first.' },
  { t: 'Damp patch that keeps growing', d: 'On a wall, floor or ceiling. A slow leak from a joint or a corroded pipe behind it.' },
  { t: 'Boiler pressure keeps dropping', d: 'Water is escaping from the heating system: a radiator valve, a joint or a pipe under the floor.' },
  { t: 'Water meter moving with taps off', d: 'The clearest sign of a hidden leak on the water supply.' },
  { t: 'Wet floor by the sink, toilet or bath', d: 'Often a split waste pipe, a worn seal or a corroded flexi pipe hidden behind a panel.' },
  { t: 'Sound of running water', d: 'When nothing is turned on. Often a pipe under the floor or a toilet cistern.' },
];

const reviews = [
  { n: 'Sara R', t: 'James came out within twenty minutes and checked for the source of a leak in our kitchen, he was very thorough, dealt with the immediate problem and gave us good advice on what to do next. All in all he was extremely pleasant and helpful and really put our minds at rest about the cause of the leak, and we were really happy with the service that we got.' },
  { n: 'Tonia K', t: 'Called them in a panic as our bathroom sink pipe was gushing water. James arrived within 20 minutes, isolated and dealt with the problem. By this time, part of the ceiling had collapsed and he cleaned that up for us too. He took photos of what caused the issue (we were not at the property at the time) and it was a corroded flexi pipe as well as before and after photos so we could see what had been done. Fantastic service. Wouldn\'t hesitate to use again.' },
  { n: 'James G', t: 'Very impressed, attended same day diagnosed the issue. Gave options of how to fix the problem we had which was a leak in an old pipe under the flooring. Come back a day later and it was all sorted. Would highly recommend, this is from someone who has used a number of different trades over the past 12 months during a renovation.' },
  { n: 'Frank B', t: 'James and Ben arrived as quickly as they could and got the bottom of the issue I was having with a leaky pipe and dripping ceiling in no time. Everything was professionally assessed and skilfully sorted in just over an hour. Really friendly and obviously talented plumbers, very impressed and definitely recommended.' },
  { n: 'Chris C', t: 'A team to trust. I’m not from Liverpool but own a rental property there. When I needed some water ingress investigation it helped so much to feel well supported when there is water coming from your ceiling! The costs are clear, very reasonable and James who was the plumber they sent was everything you need in a difficulty time. Michel who took my late evening call was also very helpful and reassuring… If 6 stars existed they would have them from me. Chris' },
];

const areas = [
  ['West Derby','west-derby'],['Old Swan','old-swan'],['Huyton','huyton'],['Woolton','woolton'],['Wavertree','wavertree'],['Allerton','allerton'],
  ['Childwall','childwall'],['Anfield','anfield'],['Walton','walton'],['Bootle','bootle'],['Crosby','crosby'],['Kirkby','kirkby'],
  ['Aintree','aintree'],['Garston','garston'],['Toxteth','toxteth'],['Maghull','maghull'],['Formby','formby'],['Wirral','wirral'],['St Helens','st-helens'],
];

const schemaFaq = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const schemaService = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Leak Detection and Repair Liverpool', serviceType: 'Water leak finding, pressure testing, repair and insurance leak reports', url: URL_,
  provider: { '@id': 'https://liverpoolemergencyplumber.co.uk/#business' },
  areaServed: [{ '@type': 'City', name: 'Liverpool' }, { '@type': 'City', name: 'Wirral' }, { '@type': 'City', name: 'St Helens' }, { '@type': 'City', name: 'Formby' }],
  offers: [
    { '@type': 'Offer', name: 'Leak finding and repair, first hour, weekdays 9am to 4pm, no call-out fee', price: '120', priceCurrency: 'GBP' },
    { '@type': 'Offer', name: 'Emergency leak repair, first hour, weekday evenings, nights and weekends', price: '150', priceCurrency: 'GBP' },
    { '@type': 'Offer', name: 'Emergency leak repair, first hour, bank holidays', price: '180', priceCurrency: 'GBP' },
  ],
};
const schemaCrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://liverpoolemergencyplumber.co.uk' },
    { '@type': 'ListItem', position: 2, name: 'Leak Detection Liverpool', item: URL_ },
  ],
};
const card = 'background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:1.25rem 1.35rem;';
---

<BaseLayout
  title="Leak Detection Liverpool | Find & Fix Water Leaks 24/7 | No Call-Out Fee"
  description="Water leak in Liverpool? We find and fix leaks through ceilings, under floors and behind walls, 24/7. Pressure testing and insurance leak reports. No call-out fee, from £120 for the first hour. Call 0151 558 0334."
  canonical={URL_}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaService)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaFaq)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaCrumbs)} />

  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-badge" style="margin:0 auto 1rem;"><span class="badge-dot"></span>Water leak? We answer 24/7</div>
      <h1>Leak Detection Liverpool</h1>
      <p class="page-hero-sub">Water through the ceiling, a damp patch that keeps spreading or pressure that keeps dropping? We find where the water is coming from and fix it, day or night. No call-out fee, and you get the price before any work starts.</p>
      <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:0.8rem 1rem;max-width:460px;margin:1.25rem auto;">
        <p style="margin:0;font-size:0.92rem;color:#7f1d1d;"><strong>Leaking now?</strong> Turn the water off at the stopcock (usually under the kitchen sink), keep away from wet lights and sockets, then ring us.</p>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;max-width:320px;margin:0 auto 1.25rem;">
        <a href="tel:0151 558 0334" class="btn btn-orange btn-lg btn-full" style="box-shadow:0 4px 14px rgba(249,115,22,0.4);font-size:1.15rem;color:#ffffff;">CALL 0151 558 0334</a>
        <a href="/get-started" class="btn btn-lg btn-full" style="background:var(--navy);color:#ffffff;font-weight:700;">Book Online</a>
      </div>
      <div style="display:flex;justify-content:center;gap:1.5rem;flex-wrap:wrap;padding-top:1.25rem;border-top:1px solid #e2e8f0;">
        <span style="font-size:0.82rem;font-weight:700;color:var(--navy);"><span style="color:#15803d;">✓</span> No Call-Out Fee</span>
        <span style="font-size:0.82rem;font-weight:700;color:var(--navy);"><span style="color:#15803d;">✓</span> 24/7, Including Sundays</span>
        <span style="font-size:0.82rem;font-weight:700;color:var(--navy);"><span style="color:#15803d;">✓</span> Insurance Leak Reports</span>
        <span style="font-size:0.82rem;font-weight:700;color:var(--navy);"><span style="color:#15803d;">✓</span> 5.0 on Google</span>
      </div>
    </div>
  </section>

  <div class="pf">

  <!-- QUICK ANSWER -->
  <section class="pf-section" style="background:#ffffff;padding-bottom:1rem;">
    <div class="container" style="max-width:760px;">
      <div style="background:#f1f5f9;border-left:4px solid var(--orange);border-radius:10px;padding:1.1rem 1.35rem;">
        <p style="margin:0;line-height:1.7;"><strong>Quick answer:</strong> finding and fixing a water leak in Liverpool with us has no call-out fee. It costs £120 for the first hour on weekdays 9am to 4pm, £150 on weekday evenings, nights and weekends, and £180 on bank holidays. Most leaks come from a joint, valve, waste pipe or appliance and are fixed on the same visit. We can also write a leak report for your insurance claim.</p>
      </div>
    </div>
  </section>

  <!-- SIGNS -->
  <section class="pf-section" style="background:#ffffff;padding-top:1.5rem;">
    <div class="container">
      <h2>Signs You Have a Water Leak</h2>
      <p class="pf-sub">If you see any of these, the sooner the leak is found the less damage it does.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;">
        {signs.map((f) => (
          <div style={card + 'border-left:4px solid var(--orange);'}><h3 style="font-size:1.02rem;margin:0 0 0.35rem;">{f.t}</h3><p style="margin:0;font-size:0.92rem;line-height:1.6;color:#334155;">{f.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW WE FIND IT -->
  <section class="pf-section" style="background:#f1f5f9;">
    <div class="container" style="max-width:760px;">
      <h2>How We Find a Leak</h2>
      <p class="pf-sub">No guesswork and no smashing walls on a hunch. We follow the water.</p>
      <div style="display:flex;flex-direction:column;gap:0.75rem;">
        <div style={card}><strong>1. Stop the water.</strong> If it is still leaking, we isolate the supply first to stop the damage spreading.</div>
        <div style={card}><strong>2. Check what can be seen.</strong> Joints, valves, waste pipes, flexi pipes, toilets, baths, showers and radiators. Most leaks start here.</div>
        <div style={card}><strong>3. Pressure test.</strong> Testing the pipework under pressure confirms whether there is a leak and helps narrow down which section it is in.</div>
        <div style={card}><strong>4. Open up the right spot.</strong> He lifts floorboards along the pipe and traces the water back to its source. Where the floor above is laminate or a tiled bathroom, cutting a small opening in the ceiling below is often cheaper than ripping up the floor. He agrees with you what needs opening up first.</div>
        <div style={card}><strong>5. Fix it and show you.</strong> The leak is repaired and tested. If you are not at the property, he can send photos of the cause and the repair. Need it for an insurance claim? We can write you a leak report.</div>
      </div>
      <p style="margin:1.25rem 0 0;line-height:1.7;">Leaks under solid concrete floors or deep inside walls are harder to reach. We will tell you honestly what we can find, and if a leak needs specialist detection equipment, we will say so before you spend money.</p>
    </div>
  </section>

  <!-- PRICING -->
  <section class="pf-section" style="background:#ffffff;">
    <div class="container">
      <h2>Leak Repair Prices in Liverpool</h2>
      <p class="pf-sub">No call-out fee. One fixed price for the first hour, and you agree the price of any parts or extra work first.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;max-width:760px;margin:0 auto;">
        <div style={card + 'border-top:4px solid var(--orange);text-align:center;'}><div style="font-size:0.72rem;font-weight:800;color:#c2410c;letter-spacing:0.08em;">WEEKDAYS 9AM TO 4PM</div><div style="font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-size:2.6rem;font-weight:900;color:var(--navy);line-height:1.1;">£120<span style="font-size:1rem;"> first hour</span></div></div>
        <div style={card + 'border-top:4px solid var(--navy);text-align:center;'}><div style="font-size:0.72rem;font-weight:800;color:var(--navy);letter-spacing:0.08em;">EVENINGS, NIGHTS, WEEKENDS</div><div style="font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-size:2.6rem;font-weight:900;color:var(--navy);line-height:1.1;">£150<span style="font-size:1rem;"> first hour</span></div></div>
        <div style={card + 'border-top:4px solid var(--navy);text-align:center;'}><div style="font-size:0.72rem;font-weight:800;color:var(--navy);letter-spacing:0.08em;">BANK HOLIDAYS</div><div style="font-family:'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif;font-size:2.6rem;font-weight:900;color:var(--navy);line-height:1.1;">£180<span style="font-size:1rem;"> first hour</span></div></div>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="pf-section" style="background:#f1f5f9;">
    <div class="container">
      <div style="margin-bottom:1.5rem;">
        <h2 style="margin-bottom:0.1rem;">Leaks We Have Found and Fixed</h2>
        <div style="font-size:2.5rem;font-weight:900;color:var(--navy);line-height:1;">5.0</div>
        <div style="color:#b45309;font-size:1rem;">★★★★★</div>
        <div style="font-size:0.75rem;color:var(--muted);">Google · 53 reviews</div>
      </div>
      <div class="pf-reviews">
        {reviews.map((r) => (
          <div class="pf-review"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.25rem;"><div class="pf-review-quote">"</div><span style="font-size:0.68rem;font-weight:700;background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;border-radius:999px;padding:0.15rem 0.5rem;">Google Review</span></div><p>{r.t}</p><div class="pf-review-footer"><div class="pf-review-avatar">{r.n[0].toUpperCase()}</div><div><div class="pf-review-name">{r.n}</div><div class="pf-review-loc">Google Review</div></div><div class="pf-review-stars">★★★★★</div></div></div>
        ))}
      </div>
      <div style="text-align:center;margin-top:1.5rem;"><a href="https://www.google.com/search?q=Liverpool+Emergency+Plumber+reviews" target="_blank" rel="noopener" style="font-size:0.88rem;font-weight:700;color:var(--navy);">See all reviews on Google →</a></div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="pf-section" style="background:#ffffff;">
    <div class="container" style="max-width:760px;">
      <h2>Leak From the Heating or the Boiler?</h2>
      <p style="line-height:1.75;margin-bottom:0;">If your boiler pressure keeps dropping, the leak is in the heating system. See <a href="/boiler-repair-liverpool" style="font-weight:700;">boiler repair in Liverpool</a> or <a href="/radiators-liverpool" style="font-weight:700;">radiator repairs and replacement</a>. For a burst pipe or flood right now, see our <a href="/" style="font-weight:700;">24/7 emergency plumber</a> page. If water has reached your lights or sockets, our partner firm <a href="https://www.idealelectricalsolutions.co.uk/emergency-electrician" style="font-weight:700;">Ideal Electrical Solutions, a 24/7 emergency electrician</a>, can make the electrics safe.</p>
    </div>
  </section>

  <!-- AREAS -->
  <section class="pf-section" style="background:#f1f5f9;">
    <div class="container">
      <h2>Leak Detection Across Liverpool and Merseyside</h2>
      <p class="pf-sub">Every Liverpool postcode, plus the Wirral, Sefton, Knowsley and St Helens.</p>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;justify-content:center;max-width:860px;margin:0 auto;">
        {areas.map(([n, s]) => (
          <a href={`/emergency-plumber-${s}`} style="background:#ffffff;border:1px solid #e2e8f0;border-radius:999px;padding:0.4rem 0.9rem;font-size:0.88rem;font-weight:600;color:var(--navy);text-decoration:none;">{n}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="pf-section" style="background:#ffffff;">
    <div class="container">
      <h2>Leak Detection Questions</h2>
      <div class="pf-faq" style="display:flex;flex-direction:column;gap:0.5rem;">
        {faqs.map((f) => (
          <details class="pf-faq-item" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:0.5rem;padding:0;"><summary style="cursor:pointer;padding:1rem 1.25rem;font-weight:700;color:#1a3a5c;display:flex;align-items:center;gap:0.5rem;"><span class="pf-faq-tag pf-tag-orange">{f.tag}</span>&nbsp; {f.q}</summary><div class="pf-faq-body" style="padding:0 1.25rem 1.25rem;border-top:1px solid #f1f5f9;"><p>{f.a}</p></div></details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="pf-section" style="background:var(--navy);text-align:center;">
    <div class="container" style="max-width:640px;">
      <h2 style="color:#ffffff;">Got a Leak? Ring Us Now.</h2>
      <p style="color:rgba(255,255,255,0.85);margin-bottom:1.5rem;">24 hours a day, 7 days a week. No call-out fee. The price agreed before any work.</p>
      <a href="tel:0151 558 0334" class="btn btn-orange btn-lg" style="color:#ffffff;">CALL 0151 558 0334</a>
    </div>
  </section>

  </div>
</BaseLayout>
