      { "@type": "Question", "name": "My hot water cylinder is leaking. What should I do?", "acceptedAnswer": { "@type": "Answer", "text": "Turn off the water supply at the isolation valve on the cold feed pipe (the pipe entering at the bottom). If the leak is from the cylinder body itself, the cylinder must be replaced. If the leak is from a fitting or valve, we may be able to repair it. Call us on 0151 558 0334. New cylinders from £600 fitted." } },
      { "@type": "Question", "name": "Do you cover Lydiate and Melling?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Lydiate, Melling, Aughton borders, and the rest of L31 are all covered at the same fixed rates. Same 15 minute response from Kirkby." } },
