---
import ServiceGuide from '../components/ServiceGuide.astro';
const URL_ = 'https://liverpoolemergencyplumber.co.uk/hot-water-cylinders-liverpool';
const TEL = 'tel:01515580334';
const PHONE = '0151 558 0334';

const packages = [
  { id: 'vented', tier: 'Loft tank systems', name: 'Vented cylinder replaced', price: '£750', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Like-for-like swap on a loft tank system', 'Immersion heater fitted', 'Old cylinder taken away', 'Usually done in one day'] },
  { id: 'unvented-150', tier: 'Mains pressure', popular: true, name: 'Unvented cylinder, 150 litres', price: '£1,450', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Suits 1 to 2 people, one bathroom', 'Fitted by a G3 qualified engineer', 'All safety valves fitted and tested', 'Notified as Building Regulations require'] },
  { id: 'unvented-210', tier: 'Family homes', name: 'Unvented cylinder, 210 litres', price: '£1,695', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Suits 3 to 4 people', 'One bathroom, or a bath and en-suite shower', 'Expansion vessel and discharge pipe', 'Old cylinder taken away'] },
  { id: 'unvented-250', tier: 'Bigger homes', name: 'Unvented cylinder, 250 to 300 litres', price: '£1,995', from: true, unit: 'supplied and fitted, inc VAT',
    points: ['Suits 4 or more people', 'Two bathrooms used at once', 'Mains pressure at every tap', 'Free survey to confirm the size'] },
];

const faqs = [
  { q: 'How much does a hot water cylinder cost in Liverpool?', a: 'With us, a vented cylinder replaced starts from £750 including VAT. An unvented cylinder starts from £1,450 for 150 litres, £1,695 for 210 litres and £1,995 for 250 to 300 litres. Changing from vented to unvented starts from £1,895. We give you a fixed written price after a free survey.' },
  { q: 'What is the difference between a vented and unvented cylinder?', a: 'A vented cylinder is fed by a cold water tank in the loft, so the pressure is low. An unvented cylinder is fed straight from the mains, so you get mains pressure hot water. Unvented cylinders must be fitted by a G3 qualified engineer.' },
  { q: 'Should I get a cylinder or a combi boiler?', a: 'A combi heats water as you use it, with no tank. It suits flats and homes with one bathroom. A system boiler with an unvented cylinder suits homes with two bathrooms or more, because two showers can run at once. We will tell you which suits you at the free survey.' },
  { q: 'What size hot water cylinder do I need?', a: 'As a guide, 150 litres for 1 to 2 people, 210 litres for 3 to 4 people, and 250 to 300 litres for bigger families or two bathrooms. We check your home and how you use hot water before we pick a size.' },
  { q: 'Will an unvented cylinder work with my water pressure?', a: 'It needs a good mains supply, with enough pressure and flow. We test both at the survey before we quote. If your supply is too weak, we tell you straight away and suggest the best option.' },
  { q: 'How long does it take to fit a new cylinder?', a: 'Most cylinder swaps are done in one day. A tight airing cupboard or a change from vented to unvented can take a little longer. We tell you the time at the survey.' },
  { q: 'Are your engineers G3 qualified?', a: 'Yes. All our engineers are G3 qualified to fit and service unvented cylinders. The work is notified as the Building Regulations require, and you get the paperwork to keep.' },
  { q: 'Does an unvented cylinder need a yearly service?', a: 'Yes. Makers ask for a service every year to keep the warranty valid, and it keeps the safety valves working. Our unvented cylinder service is £120 including VAT.' },
  { q: 'How much is a new immersion heater?', a: 'An immersion heater on a vented cylinder is £175 including VAT. On an unvented cylinder it is £275, because it needs the right part for that cylinder. Both are supplied and fitted.' },
  { q: 'Can you run out of hot water with a cylinder?', a: 'Yes. A cylinder holds a set amount of hot water. If it is all used, you wait while it heats up again. That is why getting the right size matters.' },
  { q: 'Can a leaking cylinder be repaired?', a: 'If the leak is from a valve or a fitting, often yes. If the tank itself is leaking, it needs replacing. We find out which it is on the visit. Repairs are charged at our first-hour rate, from £120.' },
  { q: 'Do you take the old cylinder away?', a: 'Yes. We drain it, take it out and take it away. This is included in the price.' },
  { q: 'Which cylinder brands do you fit?', a: 'We fit leading UK brands, including Megaflo, Gledhill, Telford, Joule and Ariston. We pick the right one for your space, your budget and your boiler.' },
  { q: 'Are you Gas Safe registered?', a: 'Yes. Gas work is done by our Gas Safe registered engineers. You can check any engineer on the Gas Safe Register before they start.' },
];
---

