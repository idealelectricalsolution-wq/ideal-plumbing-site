  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How a bathroom installation in Liverpool works",
    "description": "The six stages of a bathroom installation carried out by Liverpool Emergency Plumber, from free survey to handover.",
    "totalTime": "P5D",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Free survey", "text": "We visit your home, measure the room, check the existing pipe runs and waste position, and talk through what you want." },
      { "@type": "HowToStep", "position": 2, "name": "Fixed price quote", "text": "You get a written quote with the full spec listed. The price is fixed before any work starts." },
      { "@type": "HowToStep", "position": 3, "name": "Strip out and disposal", "text": "The old bathroom comes out and goes with us. No skip needed on your street." },
      { "@type": "HowToStep", "position": 4, "name": "First fix plumbing", "text": "New supply and waste pipework is run and clipped. Any damp or rot found under the old suite is flagged before we go further." },
