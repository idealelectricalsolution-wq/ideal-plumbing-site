  <style>
    .cmp-wrap { margin-top: 1.5rem; overflow: hidden; }
    .cmp-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      background: #ffffff;
      border: 1px solid #d1d9e6;
      border-radius: 10px;
      overflow: hidden;
    }
    .cmp-table th, .cmp-table td {
      padding: 0.7rem 0.85rem;
      text-align: left;
      border-bottom: 1px solid #e2e8f0;
      vertical-align: top;
    }
    .cmp-table thead th {
      background: #1a3a5c;
      color: #ffffff;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 1rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .cmp-table tbody th {
      font-weight: 800;
      color: #1a3a5c;
      width: 34%;
    }
    .cmp-table tr:last-child th, .cmp-table tr:last-child td { border-bottom: none; }
    .cmp-win { color: #16a34a; font-weight: 800; }

    @media (max-width: 560px) {
      .cmp-table, .cmp-table tbody, .cmp-table tr, .cmp-table td, .cmp-table th { display: block; width: auto; }
      .cmp-table thead { position: absolute; left: -9999px; }
      .cmp-table tbody tr {
        border-bottom: 1px solid #e2e8f0;
        padding: 0.5rem 0;
      }
      .cmp-table tbody tr:last-child { border-bottom: none; }
      .cmp-table tbody th {
        width: auto;
        background: #f8fafc;
        border-bottom: none;
        padding-bottom: 0.35rem;
        font-size: 0.95rem;
      }
      .cmp-table tbody td {
        border-bottom: none;
        padding-top: 0.2rem;
        padding-bottom: 0.2rem;
      }
      .cmp-table tbody td::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        margin-bottom: 0.1rem;
      }
    }

    .scope-note {
      background: #fff7ed;
      border: 1px solid #fed7aa;
      border-radius: 10px;
      padding: 1rem 1.15rem;
      margin-top: 1.5rem;
    }
    .scope-note strong { color: #1a3a5c; display: block; margin-bottom: 0.35rem; }
    .scope-note p { margin: 0; font-size: 0.92rem; }

    .price-strip {
      background: #ffffff;
      border: 1px solid #d1d9e6;
      border-radius: 10px;
      margin-top: 1.5rem;
      overflow: hidden;
    }
    .price-strip-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      padding: 0.7rem 1rem;
      border-bottom: 1px solid #e2e8f0;
    }
    .price-strip-row:last-child { border-bottom: none; }
    .price-strip-row span:first-child { font-weight: 700; color: #1e293b; font-size: 0.9rem; }
    .price-strip-row span:last-child {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900;
      font-size: 1.35rem;
      color: #f97316;
      white-space: nowrap;
    }
  </style>

