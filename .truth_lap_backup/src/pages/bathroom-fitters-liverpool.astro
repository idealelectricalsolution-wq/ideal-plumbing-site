    ]
  }
  </script>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much do bathroom fitters in Liverpool cost?", "acceptedAnswer": { "@type": "Answer", "text": "A full bathroom installation in Liverpool costs from £3,500 supply and fit. An en suite is from £3,000. A bath to shower conversion is from £2,200. A shower enclosure and tray is from £900. A like for like shower swap is from £200. The price covers the suite, the waterproof wall panels, all plumbing and waste work and the fitting. Floor covering and any wall tiling are arranged separately by you." } },
      { "@type": "Question", "name": "What is included in the £3,500 bathroom installation?", "acceptedAnswer": { "@type": "Answer", "text": "The £3,500 price covers the full strip out and disposal, all plumbing and waste work, waterproof wall panels, the bath or shower enclosure, the toilet, the basin and vanity, all taps and valves, sealing, testing and a clean on the day we hand over. It does not include floor covering, wall tiling, plastering or decorating." } },
      { "@type": "Question", "name": "Do you tile bathrooms?", "acceptedAnswer": { "@type": "Answer", "text": "No. We fit waterproof wall panels instead of tiles. Panels are fully waterproof, have no grout to go black, and go up in hours rather than days. If you want a tiled bathroom you arrange your own tiler and we work around them. We will tell you at the survey which option suits your room." } },
      { "@type": "Question", "name": "Do you lay bathroom floors?", "acceptedAnswer": { "@type": "Answer", "text": "No. Floor covering is arranged by you, whether that is floor tiles, vinyl or LVT. We leave the floor clean and ready for your fitter. Most customers book their floor for the day after we finish." } },
      { "@type": "Question", "name": "How long does a bathroom installation in Liverpool take?", "acceptedAnswer": { "@type": "Answer", "text": "A full bathroom installation takes 3 to 5 working days. An en suite takes 2 to 4 days. A bath to shower conversion takes 2 to 3 days. A shower swap takes half a day. Wall panels are a large part of why the job is quicker than a tiled bathroom." } },
      { "@type": "Question", "name": "Are bathroom wall panels better than tiles?", "acceptedAnswer": { "@type": "Answer", "text": "Panels are cheaper, faster to fit and have no grout to clean or reseal. Tiles win on choice of pattern and on resale appeal in higher value homes. For a working family bathroom, panels are usually the better buy. For a period property or a high end refit, tiles are often worth the extra. We give you the honest answer for your room at the survey." } },
      { "@type": "Question", "name": "How much does it cost to replace a bath with a shower?", "acceptedAnswer": { "@type": "Answer", "text": "A bath to shower conversion in Liverpool starts at £2,200. That covers removing the bath, capping and adapting the old supplies and waste, fitting the tray and enclosure, fitting the valve and panelling the walls. The job takes 2 to 3 days. It is our most requested single job." } },
      { "@type": "Question", "name": "Do you supply the bathroom suite?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The price includes the suite, the taps and the enclosure, supplied and fitted. If you would rather buy your own suite we will fit it and quote you for labour only. Tell us at the survey which you prefer." } },
      { "@type": "Question", "name": "Are you Gas Safe registered and insured?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All plumbing work is carried out by Gas Safe registered engineers. We hold £2 million public liability cover and every job carries a 12 month workmanship guarantee. Manufacturer cover on the suite and taps runs separately and varies by product." } },
      { "@type": "Question", "name": "Who does the electrical work?", "acceptedAnswer": { "@type": "Answer", "text": "Our sister firm Ideal Electrical Solutions handles it. We have a Part P and NICEIC registered electrician on the team who wires the lights, the extractor fan and the shower where needed. It is booked into the same schedule so you are not chasing a second trade." } },
      { "@type": "Question", "name": "How much do you need paying up front?", "acceptedAnswer": { "@type": "Answer", "text": "Nothing before the survey, and the survey is free. Payment terms are agreed in writing with the quote before the job is booked in." } },
      { "@type": "Question", "name": "Do you fit accessible bathrooms?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We fit low level shower trays, grab rails and raised toilet seats. Replacing a bath with a level access shower is the most common change we make for customers who are struggling to get in and out of a bath. Call 0151 558 0334 and we will talk it through." } }
    ]
  }
  </script>

