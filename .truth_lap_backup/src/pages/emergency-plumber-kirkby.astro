      { "@type": "Question", "name": "Do you guarantee your work?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every job carries a 12-month workmanship guarantee. If something we fixed fails because of our work, we come back. No charge." } }
    ]
  }
